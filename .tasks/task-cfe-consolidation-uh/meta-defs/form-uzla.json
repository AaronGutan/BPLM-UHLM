{
  "title": "Узел обмена консолидации",
  "properties": {
    "windowOpeningMode": "LockOwnerWindow",
    "autoTitle": true
  },
  "events": {
    "OnCreateAtServer": "ПриСозданииНаСервере",
    "OnReadAtServer": "ПриЧтенииНаСервере",
    "OnOpen": "ПриОткрытии",
    "OnWriteAtServer": "ПриЗаписиНаСервере",
    "BeforeClose": "ПередЗакрытием",
    "OnClose": "ПриЗакрытии"
  },
  "elements": [
    {
      "group": "vertical",
      "name": "ГруппаОсновная",
      "showTitle": false,
      "children": [
        {
          "group": "horizontal",
          "name": "КодНаименование",
          "showTitle": false,
          "children": [
            { "input": "Код", "path": "Объект.Code" },
            { "input": "Наименование", "path": "Объект.Description" }
          ]
        },
        {
          "label": "ПояснениеЭтотУзел",
          "title": "Этот узел описывает текущую информационную базу. Ограничения регистрации изменений настраиваются на узлах корреспондентов в базах-источниках.",
          "visible": false
        },
        {
          "label": "ПояснениеКорреспондент",
          "title": "Узел корреспондента. Настройки регистрации определяют, какие данные будут передаваться в базу-приемник консолидации.",
          "visible": false
        },
        {
          "group": "vertical",
          "name": "ГруппаОграниченияРегистрации",
          "title": "Ограничения регистрации",
          "showTitle": true,
          "children": [
            {
              "input": "ДатаНачалаВыгрузкиДокументов",
              "path": "Объект.ДатаНачалаВыгрузкиДокументов",
              "title": "Начальная дата для выгрузки документов"
            },
            {
              "input": "РежимВыгрузкиОбъектов",
              "path": "Объект.РежимВыгрузкиОбъектов"
            },
            {
              "check": "РегистрироватьИзменения",
              "path": "Объект.РегистрироватьИзменения"
            },
            {
              "check": "ИспользоватьОтборПоОрганизациям",
              "path": "Объект.ИспользоватьОтборПоОрганизациям",
              "title": "Передавать данные только по выбранным организациям",
              "on": ["OnChange"],
              "handlers": {
                "OnChange": "ИспользоватьОтборПоОрганизациямПриИзменении"
              }
            },
            {
              "table": "Организации",
              "path": "Объект.Организации",
              "changeRowSet": true,
              "changeRowOrder": true,
              "columns": [
                {
                  "input": "ОрганизацииОрганизация",
                  "path": "Объект.Организации.Организация",
                  "title": "Организация"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "attributes": [
    {
      "name": "Объект",
      "type": "ExchangePlanObject.Консолидация",
      "main": true
    }
  ]
}
