{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1C: Сборка CFE",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/scripts/cfe-build.ps1",
                "-ConfigDir",
                "${workspaceFolder}/${input:cfeConfigDir}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "1C: Сборка CFE (режим агента)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/scripts/cfe-build.ps1",
                "-ConfigDir",
                "${workspaceFolder}/${input:cfeConfigDir}",
                "-UseAgentMode",
                "-KeepAgentConnected",
                "-RecreateExtension",
                "-DebugAgent"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": false
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "cfeConfigDir",
            "type": "pickString",
            "description": "Расширение для сборки",
            "options": [
                {
                    "label": "КонсолидацияУХ (УХ)",
                    "value": "ICORUHM/uh-cfe-consolidation"
                },
                {
                    "label": "EMS",
                    "value": "EMS"
                }
            ],
            "default": "EMS"
        }
    ]
}
