				<ПослеЗагрузки>Для Каждого Реквизит Из Объект.Метаданные().Реквизиты Цикл
	Если Реквизит.Тип.Типы().Количество() = 1 И Реквизит.Тип.СодержитТип(Тип("Булево")) Тогда
		Объект[Реквизит.Имя] = (Объект[Реквизит.Имя] = Истина);
	КонецЕсли;
КонецЦикла;
Объект.ПометкаУдаления = (Объект.ПометкаУдаления = Истина);
Если НЕ ЗначениеЗаполнено(Объект.ВидСчета) Тогда
	Объект.ВидСчета = "Расчетный";
КонецЕсли;
Если НЕ (Объект.Метаданные().Реквизиты.Найти("Закрыт") = Неопределено) Тогда
	Объект.Закрыт = ЗначениеЗаполнено(Объект.ДатаЗакрытия);
КонецЕсли;
Если ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.Организации")
	И ЗначениеЗаполнено(Объект.Владелец)
	И НЕ (Метаданные.Справочники.Организации.Реквизиты.Найти("ИспользоватьВРегламентированномУчете") = Неопределено) Тогда
	ОрганизацияОбъект = Неопределено;
	Если ОбщегоНазначения.СсылкаСуществует(Объект.Владелец) Тогда
		ОрганизацияОбъект = Объект.Владелец.ПолучитьОбъект();
	Иначе
		ОрганизацияОбъект = Справочники.Организации.СоздатьЭлемент();
		ОрганизацияОбъект.УстановитьСсылкуНового(Объект.Владелец);
