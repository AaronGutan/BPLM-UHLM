&НаСервере
Функция СоздатьПоGUIDПодрНаСервере()
	
	Если Объект.Организация.Пустая() Тогда
		ОбщегоНазначения.СообщитьПользователю("Укажи организацию.");
		Возврат Ложь;
	КонецЕсли;
	
	Если Объект.Подразделение.Пустая() Тогда
		ОбщегоНазначения.СообщитьПользователю("Укажи подразделение.");
		Возврат Ложь;
	КонецЕсли;
	
	Идентификатор = Новый УникальныйИдентификатор(Объект.GUIDПодр);
	Ссылка = Справочники.ПодразделенияОрганизаций.ПолучитьСсылку(Идентификатор);
	НовОбъект = Ссылка.ПолучитьОбъект();
	Если НовОбъект = Неопределено Тогда
		НовОбъект = Справочники.ПодразделенияОрганизаций.СоздатьЭлемент();
		НовОбъект.УстановитьСсылкуНового(Ссылка);
		НовОбъект.ОбменДанными.Загрузка = Истина;
		
		ЗаполнитьЗначенияСвойств(НовОбъект, Объект.Подразделение,,"Код");
		НовОбъект.УстановитьНовыйКод();
		
		Для Каждого ТЧ Из Объект.Подразделение.Метаданные().ТабличныеЧасти Цикл
			НовОбъект[ТЧ.Имя].Загрузить(Объект.Подразделение[ТЧ.Имя].Выгрузить());
		КонецЦикла;
		
		СтарЭл = Объект.Подразделение.ПолучитьОбъект();
		СтарЭл.ОбменДанными.Загрузка = Истина;
		СтарЭл.ПометкаУдаления = Истина;
		
		НачатьТранзакцию();
		Попытка
			НовОбъект.Записать();
			СтарЭл.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
		
		Объект.Подразделение = НовОбъект.Ссылка;
		Возврат Истина;
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Найден объект с таким GUID");
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура СоздатьПоGUIDПодр(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.GUIDПодр) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Организация.Пустая() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Укажи организацию (Владелец)");
		Возврат;
	КонецЕсли;
	
	Если Объект.Подразделение.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если СоздатьПоGUIDПодрНаСервере() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Завершено.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьНесколькоОрганизаций(Команда)
	
	Если СброситьНесколькоОрганизацийНаСервере() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Константа ""Использовать несколько организаций"" сброшена в Ложь.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СброситьНесколькоОрганизацийНаСервере()
	
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Константы.ИспользоватьНесколькоОрганизаций.Установить(Ложь);
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции
