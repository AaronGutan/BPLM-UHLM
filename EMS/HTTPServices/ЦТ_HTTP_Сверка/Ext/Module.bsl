Функция ИзмененияЗарегистрировать(Запрос)

	Ответ = Новый HTTPСервисОтвет(200);
	УстановитьПривилегированныйРежим(Истина);

	Попытка
		Данные = ОбменДаннымиПереопределяемый.unJSON(Запрос.ПолучитьТелоКакСтроку());
	Исключение
		Ответ.УстановитьТелоИзСтроки(ОбменДаннымиПереопределяемый.JSON(
			Новый Структура("Успех, ТекстОшибки", Ложь, ОписаниеОшибки()), Ложь));
		Возврат Ответ;
	КонецПопытки;

	ЭлементыПакета = Данные;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ЭлементыПакета") Тогда
		ЭлементыПакета = Данные.ЭлементыПакета;
	КонецЕсли;
	Если ТипЗнч(ЭлементыПакета) <> Тип("Массив") Тогда
		Ответ.УстановитьТелоИзСтроки(ОбменДаннымиПереопределяемый.JSON(
			Новый Структура("Успех, ТекстОшибки", Ложь, "Ожидается массив элементов пакета"), Ложь));
		Возврат Ответ;
	КонецЕсли;

	Результаты = EMS_ИзмененияПланаОбмена.ЗарегистрироватьИзмененияПоСообщениям(ЭлементыПакета);
	Успех = Истина;
	Для Каждого РезультатЭлемента Из Результаты Цикл
		Если Не РезультатЭлемента.Success Тогда
			Успех = Ложь;
		КонецЕсли;
	КонецЦикла;
	Ответ.УстановитьТелоИзСтроки(ОбменДаннымиПереопределяемый.JSON(
		Новый Структура("Успех, Результаты", Успех, Результаты), Ложь));
	Возврат Ответ;

КонецФункции


