
Функция commandPost(Запрос)     
	ТелоJSON = Запрос.ПолучитьТелоКакСтроку();
	ПараметрыJSON = Неопределено;
	Попытка
		ПараметрыJSON = ЧтениеJSON(ТелоJSON); 
		ЗаписатьЛогВходящейКомандыExpress("Начало", ПараметрыJSON, 0, "");
		ПараметрыЗапроса = Новый Массив;  
		ПараметрыЗапроса.Добавить(ПараметрыJSON.bot_id);
		ПараметрыЗапроса.Добавить(ПараметрыJSON.from.group_chat_id);
		ПараметрыЗапроса.Добавить(ПараметрыJSON.command.body);
		ПараметрыЗапроса.Добавить(ПараметрыJSON.sync_id);
		ФоновыеЗадания.Выполнить(
			"EMS_Express.ОбработатьКомандыExpress", ПараметрыЗапроса);
		Ответ = Новый HTTPСервисОтвет(202);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");  
		ТелоОтвета = "{""status"":""accepted"",""message"":""Команда принята в обработку""}";
		Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
		ЗаписатьЛогВходящейКомандыExpress("Принято", ПараметрыJSON, Ответ.КодСостояния, ТелоОтвета);
		Возврат Ответ;
	Исключение
		ТелоОтвета = Новый Структура("status,message", "error", ОписаниеОшибки());
		ЗаписатьЛогВходящейКомандыExpress(
			"Ошибка", ПараметрыJSON, 400, СтрокаJSON(ТелоОтвета), УровеньЖурналаРегистрации.Ошибка);
		Возврат ОтветJSON(400, ТелоОтвета);
	КонецПопытки;
КонецФункции

Функция statusGet(Запрос)
	Попытка
		ПараметрыСтатуса = ПолучитьПараметрыСтатусаКоманд(Запрос);
		СтатусКоманд = СформироватьСтатусКомандExpress(ПараметрыСтатуса);
		Возврат ОтветJSON(200, СтатусКоманд);
	Исключение
		ЗаписатьЛогСтатусаExpress("Ошибка", ОписаниеОшибки(), УровеньЖурналаРегистрации.Ошибка);
		Возврат ОтветJSON(400, Новый Структура("status,message", "error", ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

Функция statusPost(Запрос)
	Возврат statusGet(Запрос);
КонецФункции

Функция notificationCallbackPost(Запрос)
	ТелоJSON = Запрос.ПолучитьТелоКакСтроку();
	Попытка
		ПараметрыJSON = ЧтениеJSON(ТелоJSON);
		ЗаписатьСтатусОтправкиКартинкиExpress(ПараметрыJSON, ТелоJSON);
	Исключение
		RSN_eXpress.ЗаписатьВЖурналCallbackExpress(
			УровеньЖурналаРегистрации.Ошибка,
			"",
			"",
			ОписаниеОшибки(),
			ТелоJSON,
			"Уведомление");
		Возврат ОтветJSON(400, Новый Структура("error,message", Истина, ОписаниеОшибки()));
	КонецПопытки;
	Возврат ОтветJSON(200, Новый Структура("error", Ложь));
КонецФункции

Функция ЧтениеJSON(ТелоJSON)
	Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ТелоJSON);
    Возврат ПрочитатьJSON(Чтение);	
КонецФункции

Процедура ЗаписатьСтатусОтправкиКартинкиExpress(ПараметрыJSON, ТелоJSON)
	SyncId = ПолучитьЗначениеПоляCallback(ПараметрыJSON, МассивИменПолей("sync_id", "syncId", "syncID"));
	Статус = ПолучитьЗначениеПоляCallback(ПараметрыJSON, МассивИменПолей("status", "delivery_status", "notification_status"));
	Ошибка = ПолучитьЗначениеПоляCallback(ПараметрыJSON, МассивИменПолей("error", "errors", "reason", "message", "description"));
	Уровень = УровеньСтатусаExpress(Статус, Ошибка);
	RSN_eXpress.ЗаписатьВЖурналCallbackExpress(Уровень, SyncId, Статус, Ошибка, ТелоJSON, "Уведомление");
КонецПроцедуры

Функция ОтветJSON(КодСостояния, ТелоОтвета)
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ТелоОтвета);
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Возврат Ответ;
КонецФункции

Функция ПолучитьПараметрыСтатусаКоманд(Запрос)
	ПараметрыСтатуса = Новый Структура;
	ПараметрыСтатуса.Вставить("ИдентификаторБота", ПолучитьПараметрЗапроса(Запрос, "bot_id"));
	ПараметрыСтатуса.Вставить("ИдентификаторПользователя", ПолучитьПараметрЗапроса(Запрос, "user_huid"));
	ПараметрыСтатуса.Вставить("ТипЧата", ПолучитьТипЧатаСтатуса(ПолучитьПараметрЗапроса(Запрос, "chat_type")));
	Возврат ПараметрыСтатуса;
КонецФункции

Функция СформироватьСтатусКомандExpress(ПараметрыСтатуса)
	Результат = Новый Структура;
	ДанныеСтатуса = Новый Структура;
	ДанныеСтатуса.Вставить("enabled", Истина);
	ДанныеСтатуса.Вставить("status_message", "Bot is available");
	ДанныеСтатуса.Вставить("commands", ПолучитьКомандыЧатаExpress(ПараметрыСтатуса));
	Результат.Вставить("status", "ok");
	Результат.Вставить("result", ДанныеСтатуса);
	Возврат Результат;
КонецФункции

Функция ПолучитьКомандыЧатаExpress(ПараметрыСтатуса)
	Команды = Новый Массив;
	Если Не ЗначениеЗаполнено(ПараметрыСтатуса.ИдентификаторБота)
		Или Не ЗначениеЗаполнено(ПараметрыСтатуса.ИдентификаторПользователя)
		Или ПараметрыСтатуса.ТипЧата <> Перечисления.RSN_ТипыЧатов.chat Тогда
		Возврат Команды;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЧатыКоманды.Описание КАК Описание,
		|	ЧатыКоманды.Имя КАК Имя,
		|	ЧатыКоманды.Тело КАК Тело
		|ИЗ
		|	Справочник.Чаты.Команды КАК ЧатыКоманды
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Чаты.Участники КАК ЧатыУчастники
		|		ПО (ЧатыКоманды.Ссылка = ЧатыУчастники.Ссылка)
		|ГДЕ
		|	НЕ ЧатыКоманды.Ссылка.ПометкаУдаления
		|	И ЧатыКоманды.Ссылка.Бот.BotID = &ИдентификаторБота
		|	И ЧатыКоманды.Ссылка.ТипЧата = &ТипЧата
		|	И ЧатыКоманды.Вид = ЗНАЧЕНИЕ(Перечисление.RSN_ВидыКомандЧата.command)
		|	И ЧатыКоманды.Использовать = ИСТИНА
		|	И ЧатыУчастники.Huid = &ИдентификаторПользователя
		|	И ЧатыКоманды.Имя <> """"
		|	И ЧатыКоманды.Тело <> """"
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЧатыКоманды.НомерСтроки";
	Запрос.УстановитьПараметр("ИдентификаторБота", ПараметрыСтатуса.ИдентификаторБота);
	Запрос.УстановитьПараметр("ИдентификаторПользователя", ПараметрыСтатуса.ИдентификаторПользователя);
	Запрос.УстановитьПараметр("ТипЧата", ПараметрыСтатуса.ТипЧата);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Команды.Добавить(Новый Структура("description,name,body", Выборка.Описание, Выборка.Имя, Выборка.Тело));
	КонецЦикла;
	Возврат Команды;
КонецФункции

Функция ПолучитьПараметрЗапроса(Запрос, ИмяПараметра)
	Если Запрос.ПараметрыЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ЗначениеПараметра = Запрос.ПараметрыЗапроса.Получить(ИмяПараметра);
	Возврат ?(ЗначениеПараметра = Неопределено, "", Строка(ЗначениеПараметра));
КонецФункции

Функция ПолучитьТипЧатаСтатуса(КодТипаЧата)
	Если КодТипаЧата = "chat" Тогда
		Возврат Перечисления.RSN_ТипыЧатов.chat;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ЗаписатьЛогСтатусаExpress(Этап, Комментарий, Уровень = Неопределено)
	Если Уровень = Неопределено Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	ЗаписьЖурналаРегистрации("Express.Status", Уровень, , , СтрШаблон("Этап=%1; %2", Этап, Комментарий));
КонецПроцедуры

Процедура ЗаписатьЛогВходящейКомандыExpress(Этап, ПараметрыJSON, КодСостояния, ТекстОтвета,
	Уровень = Неопределено)
	Если Уровень = Неопределено Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	КодПредставление = ?(КодСостояния = 0, "<нет>", Формат(КодСостояния, "ЧГ="));
	Комментарий = СтрШаблон(
		"Этап=%1; command=%2; sync_id=%3; chat=%4; bot_id=%5; HTTP=%6; response=%7",
		Этап,
		ЗначениеПоляВходящейКомандыExpress(ПараметрыJSON, "command.body"),
		ЗначениеПоляВходящейКомандыExpress(ПараметрыJSON, "sync_id"),
		ЗначениеПоляВходящейКомандыExpress(ПараметрыJSON, "from.group_chat_id"),
		ЗначениеПоляВходящейКомандыExpress(ПараметрыJSON, "bot_id"),
		КодПредставление,
		Лев(Строка(ТекстОтвета), 1000));
	ЗаписьЖурналаРегистрации("Express.CommandHTTP", Уровень, , , Комментарий);
КонецПроцедуры

Функция ЗначениеПоляВходящейКомандыExpress(ПараметрыJSON, ПутьПоля)
	Если ПараметрыJSON = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТекущееЗначение = ПараметрыJSON;
	ЧастиПути = СтрРазделить(ПутьПоля, ".", Ложь);
	Для Каждого ИмяПоля Из ЧастиПути Цикл
		СледующееЗначение = Неопределено;
		Если ТипЗнч(ТекущееЗначение) <> Тип("Структура")
			Или Не ТекущееЗначение.Свойство(ИмяПоля, СледующееЗначение) Тогда
			Возврат "";
		КонецЕсли;
		ТекущееЗначение = СледующееЗначение;
	КонецЦикла;
	Возврат Строка(ТекущееЗначение);
КонецФункции

Функция ПредставлениеПараметровСтатуса(Запрос, ПараметрыСтатуса)
	Возврат СтрШаблон(
		"raw=%1; bot_id=%2; user_huid=%3; chat_type=%4",
		ПредставлениеПараметровЗапроса(Запрос),
		ПараметрыСтатуса.ИдентификаторБота,
		ПараметрыСтатуса.ИдентификаторПользователя,
		ПараметрыСтатуса.ТипЧата);
КонецФункции

Функция ПредставлениеОтветаСтатуса(СтатусКоманд)
	Команды = СтатусКоманд.result.commands;
	Возврат СтрШаблон("commands=%1; response=%2", Команды.Количество(), СтрокаJSON(СтатусКоманд));
КонецФункции

Функция ПредставлениеПараметровЗапроса(Запрос)
	Если Запрос.ПараметрыЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Параметры = Новый Массив;
	Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл
		Параметры.Добавить(СтрШаблон("%1=%2", Параметр.Ключ, Параметр.Значение));
	КонецЦикла;
	Возврат СтрСоединить(Параметры, "; ");
КонецФункции

Функция СтрокаJSON(Значение)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция МассивИменПолей(ИмяПоля1, ИмяПоля2 = Неопределено, ИмяПоля3 = Неопределено, ИмяПоля4 = Неопределено, ИмяПоля5 = Неопределено)
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить(ИмяПоля1);
	Если ИмяПоля2 <> Неопределено Тогда
		ИменаПолей.Добавить(ИмяПоля2);
	КонецЕсли;
	Если ИмяПоля3 <> Неопределено Тогда
		ИменаПолей.Добавить(ИмяПоля3);
	КонецЕсли;
	Если ИмяПоля4 <> Неопределено Тогда
		ИменаПолей.Добавить(ИмяПоля4);
	КонецЕсли;
	Если ИмяПоля5 <> Неопределено Тогда
		ИменаПолей.Добавить(ИмяПоля5);
	КонецЕсли;
	Возврат ИменаПолей;
КонецФункции

Функция ПолучитьЗначениеПоляCallback(Данные, ИменаПолей)
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Значение = НайтиЗначениеПоляCallback(Данные, ИмяПоля);
		Если Значение <> Неопределено Тогда
			Возврат Строка(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция НайтиЗначениеПоляCallback(Данные, ИмяПоля)
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство(ИмяПоля) Тогда
			Возврат Данные[ИмяПоля];
		КонецЕсли;
		Для Каждого ЭлементДанных Из Данные Цикл
			Значение = НайтиЗначениеПоляCallback(ЭлементДанных.Значение, ИмяПоля);
			Если Значение <> Неопределено Тогда
				Возврат Значение;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Возврат НайтиЗначениеПоляCallbackВМассиве(Данные, ИмяПоля);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НайтиЗначениеПоляCallbackВМассиве(Данные, ИмяПоля)
	Для Каждого ЭлементДанных Из Данные Цикл
		Значение = НайтиЗначениеПоляCallback(ЭлементДанных, ИмяПоля);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция УровеньСтатусаExpress(Статус, Ошибка)
	Если СтатусУспешныйExpress(Статус, Ошибка) Тогда
		Возврат УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	Если ОшибкаExpressЗаполнена(Ошибка) Или СтатусОшибочныйExpress(Статус) Тогда
		Возврат УровеньЖурналаРегистрации.Ошибка;
	КонецЕсли;
	Возврат УровеньЖурналаРегистрации.Предупреждение;
КонецФункции

Функция СтатусУспешныйExpress(Статус, Ошибка)
	Если ОшибкаExpressЗаполнена(Ошибка) Тогда
		Возврат Ложь;
	КонецЕсли;
	СтатусВерхний = ВРег(Статус);
	Возврат СтатусВерхний = "OK"
		Или СтатусВерхний = "SUCCESS"
		Или СтатусВерхний = "DELIVERED"
		Или СтатусВерхний = "SENT";
КонецФункции

Функция СтатусОшибочныйExpress(Статус)
	СтатусВерхний = ВРег(Статус);
	Возврат СтатусВерхний = "ERROR"
		Или СтатусВерхний = "FAILED"
		Или СтатусВерхний = "FAIL"
		Или СтатусВерхний = "UNDELIVERED";
КонецФункции

Функция ОшибкаExpressЗаполнена(Ошибка)
	ОшибкаВерхний = ВРег(Ошибка);
	Возврат ЗначениеЗаполнено(Ошибка)
		И ОшибкаВерхний <> "FALSE"
		И ОшибкаВерхний <> "ЛОЖЬ"
		И ОшибкаВерхний <> "НЕТ";
КонецФункции