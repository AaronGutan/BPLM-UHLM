Функция commandPost(Запрос)
	ТелоJSON = Запрос.ПолучитьТелоКакСтроку();
	ДанныеЗапроса = Неопределено;
	Попытка
		ДанныеЗапроса = ПрочитатьJSONИзСтроки(ТелоJSON);
		ЗаписатьЛогСервисаExpress("Начало", ДанныеЗапроса, 0, "");
		РезультатКоманды = ОбработатьКомандуExpress(ДанныеЗапроса);
		ТелоОтвета = Новый Структура("status,result", "ok", РезультатКоманды);
		ТекстОтвета = СтрокаJSON(ТелоОтвета);
		ЗаписатьЛогСервисаExpress("Конец", ДанныеЗапроса, 200, ТекстОтвета);
		Возврат ОтветJSON(200, ТелоОтвета);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ТелоОтвета = Новый Структура("status,message", "error", ТекстОшибки);
		ЗаписатьЛогСервисаExpress(
			"Ошибка", ДанныеЗапроса, 400, СтрокаJSON(ТелоОтвета), УровеньЖурналаРегистрации.Ошибка);
		Возврат ОтветJSON(400, ТелоОтвета);
	КонецПопытки;
КонецФункции

Функция ОбработатьКомандуExpress(Знач ДанныеЗапроса)
	Если ТипЗнч(ДанныеЗапроса) <> Тип("Структура") Тогда
		ВызватьИсключение "Тело запроса должно быть JSON-объектом.";
	КонецЕсли;
	ИмяКоманды = ЗначениеПоляJSON(ДанныеЗапроса, "ИмяКоманды");
	Если ИмяКоманды = "/VacationDays" Тогда
		Возврат ПолучитьОстатокДнейОтпуска(ДанныеЗапроса);
	КонецЕсли;
	ВызватьИсключение СтрШаблон("Команда '%1' не поддерживается нижним сервисом EMS.", ИмяКоманды);
КонецФункции

Функция ПолучитьОстатокДнейОтпуска(Знач ДанныеЗапроса)
	ИдентификаторСотрудника = ЗначениеПоляJSON(ДанныеЗапроса, "ИдентификаторСотрудника");
	Если Не ЗначениеЗаполнено(ИдентификаторСотрудника) Тогда
		ВызватьИсключение "Не заполнен идентификатор сотрудника.";
	КонецЕсли;
	Сотрудник = Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторСотрудника));
	Если Сотрудник.Пустая() Тогда
		ВызватьИсключение СтрШаблон(
			"Сотрудник с идентификатором '%1' не найден.", ИдентификаторСотрудника);
	КонецЕсли;
	ДатаОстатка = ДатаОстаткаИзДанныхЗапроса(ДанныеЗапроса);
	ОстатокДнейОтпуска = ОстаткиОтпусков.ОстатокОтпускаСотрудникаНаДату(Сотрудник, ДатаОстатка);
	Возврат Новый Структура("ОстатокНаДату", ОстатокДнейОтпуска.ОстатокНаДату);
КонецФункции

Функция ДатаОстаткаИзДанныхЗапроса(Знач ДанныеЗапроса)
	ДатаОстатка = ЗначениеПоляJSON(ДанныеЗапроса, "ДатаОстатка");
	Если Не ЗначениеЗаполнено(ДатаОстатка) Тогда
		Возврат '00010101';
	КонецЕсли;
	Если ТипЗнч(ДатаОстатка) = Тип("Дата") Тогда
		Возврат ДатаОстатка;
	КонецЕсли;
	Возврат ДатаИзСтрокиExpress(Строка(ДатаОстатка));
КонецФункции

Функция ДатаИзСтрокиExpress(Знач СтрокаДаты)
	СтрокаДаты = Лев(СтрокаДаты, 10);
	Если СтрНайти(СтрокаДаты, "-") > 0 Тогда
		ЧастиДатыИзСтроки = СтрРазделить(СтрокаДаты, "-", Ложь);
		Если ЧастиДатыИзСтроки.Количество() = 3 Тогда
			Возврат Дата(Число(ЧастиДатыИзСтроки[0]), Число(ЧастиДатыИзСтроки[1]), Число(ЧастиДатыИзСтроки[2]));
		КонецЕсли;
	КонецЕсли;
	Если СтрНайти(СтрокаДаты, ".") > 0 Тогда
		ЧастиДатыИзСтроки = СтрРазделить(СтрокаДаты, ".", Ложь);
		Если ЧастиДатыИзСтроки.Количество() = 3 Тогда
			Возврат Дата(Число(ЧастиДатыИзСтроки[2]), Число(ЧастиДатыИзСтроки[1]), Число(ЧастиДатыИзСтроки[0]));
		КонецЕсли;
	КонецЕсли;
	ВызватьИсключение СтрШаблон("Некорректная дата остатка отпуска: '%1'.", СтрокаДаты);
КонецФункции

Функция ЗначениеПоляJSON(Знач ДанныеJSON, Знач ИмяПоля)
	ЗначениеПоля = Неопределено;
	Если ТипЗнч(ДанныеJSON) = Тип("Структура")
		И ДанныеJSON.Свойство(ИмяПоля, ЗначениеПоля) Тогда
		Возврат ЗначениеПоля;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ОтветJSON(Знач КодСостояния, Знач ТелоОтвета)
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON(ТелоОтвета));
	Возврат Ответ;
КонецФункции

Функция СтрокаJSON(Знач ДанныеJSON)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеJSON);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ПрочитатьJSONИзСтроки(Знач ТекстJSON)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат Результат;
КонецФункции

Процедура ЗаписатьЛогСервисаExpress(Знач Этап, Знач ДанныеЗапроса, Знач КодСостояния, Знач ТекстОтвета,
	Знач Уровень = Неопределено)
	Если Уровень = Неопределено Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	КодПредставление = ?(КодСостояния = 0, "<нет>", Формат(КодСостояния, "ЧГ="));
	Комментарий = СтрШаблон(
		"Этап=%1; command=%2; employee=%3; date=%4; sync_id=%5; HTTP=%6; response=%7",
		Этап,
		ЗначениеПоляJSON(ДанныеЗапроса, "ИмяКоманды"),
		ЗначениеПоляJSON(ДанныеЗапроса, "ИдентификаторСотрудника"),
		ЗначениеПоляJSON(ДанныеЗапроса, "ДатаОстатка"),
		ПредставлениеИдентификатораСинхронизации(ДанныеЗапроса),
		КодПредставление,
		Лев(Строка(ТекстОтвета), 1000));
	ЗаписьЖурналаРегистрации("Express.LowerBaseService", Уровень, , , Комментарий);
КонецПроцедуры

Функция ПредставлениеИдентификатораСинхронизации(Знач ДанныеЗапроса)
	ИдентификаторСинхронизации = ЗначениеПоляJSON(ДанныеЗапроса, "sync_id");
	Возврат ?(ЗначениеЗаполнено(ИдентификаторСинхронизации), ИдентификаторСинхронизации, "<нет>");
КонецФункции
