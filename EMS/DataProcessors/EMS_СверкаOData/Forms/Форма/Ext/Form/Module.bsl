#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Период.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
	Допуск = 0.01;
	ВыполнятьСтупень2 = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сверить(Команда)

	Элементы.Сверить.Доступность = Ложь;
	ДлительнаяОперация = ЗапуститьСверкуНаСервере();
	Если ДлительнаяОперация = Неопределено Тогда
		Элементы.Сверить.Доступность = Истина;
		Возврат;
	КонецЕсли;
	Если ДлительнаяОперация.Статус = "Ошибка" Тогда
		Элементы.Сверить.Доступность = Истина;
		ПоказатьПредупреждение(, ДлительнаяОперация.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	Если ДлительнаяОперация.Статус = "Выполнено" Тогда
		ЗагрузитьРезультатНаСервере(ДлительнаяОперация.АдресРезультата);
		Элементы.Сверить.Доступность = Истина;
		Возврат;
	КонецЕсли;

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Сверка данных...'");
	Оповещение = Новый ОписаниеОповещения("СверитьЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура СверитьЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Элементы.Сверить.Доступность = Истина;
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	ЗагрузитьРезультатНаСервере(Результат.АдресРезультата);

КонецПроцедуры

&НаКлиенте
Процедура Зарегистрировать(Команда)

	Текст = ЗарегистрироватьНаСервере();
	Если ЗначениеЗаполнено(Текст) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Текст);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗапуститьСверкуНаСервере()

	ПараметрыСверки = Новый Структура;
	ПараметрыСверки.Вставить("КодОрганизации", КодОрганизации);
	ПараметрыСверки.Вставить("ДатаНачала", Период.ДатаНачала);
	ПараметрыСверки.Вставить("ДатаОкончания", Период.ДатаОкончания);
	ПараметрыСверки.Вставить("АдресOData", АдресOData);
	ПараметрыСверки.Вставить("ПользовательOData", ПользовательOData);
	ПараметрыСверки.Вставить("ПарольOData", ПарольOData);
	ПараметрыСверки.Вставить("Допуск", Допуск);
	ПараметрыСверки.Вставить("ВыполнятьСтупень2", ВыполнятьСтупень2);

	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ИмяОбработки", "EMS_СверкаOData");
	ПараметрыМетода.Вставить("ИмяМетода", "СверитьВФоне");
	ПараметрыМетода.Вставить("ПараметрыВыполнения", ПараметрыСверки);
	ПараметрыМетода.Вставить("ЭтоВнешняяОбработка", Ложь);

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Сверка'");
	ПараметрыВыполнения.ОжидатьЗавершение = 0;

	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
		ПараметрыМетода,
		ПараметрыВыполнения);

КонецФункции

&НаСервере
Процедура ЗагрузитьРезультатНаСервере(АдресРезультата)

	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Сообщение = НСтр("ru = 'Пустой результат сверки.'");
		Возврат;
	КонецЕсли;

	Расхождения.Очистить();
	КРегистрации.Очистить();
	ЗаполнитьТаблицу(Расхождения, Результат.Расхождения);
	ЗаполнитьТаблицу(КРегистрации, Результат.КРегистрации);

	Текст = Новый Массив;
	Если Не Результат.Успех И ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		Текст.Добавить(Результат.ТекстОшибки);
	КонецЕсли;
	Для Каждого СтрокаСообщения Из Результат.Сообщение Цикл
		Текст.Добавить(СтрокаСообщения);
	КонецЦикла;
	Текст.Добавить(СтрШаблон(
		НСтр("ru = 'К регистрации: %1. Ступень регистраторов: %2.'"),
		КРегистрации.Количество(),
		Результат.Ступень2Выполнена));
	Сообщение = СтрСоединить(Текст, Символы.ПС);

КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьНаСервере()

	Пакет = Новый Массив;
	Для Каждого СтрокаТаблицы Из КРегистрации Цикл
		Если Не СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Пакет.Добавить(Новый Структура(
			"Вид, ПолноеИмя, КлючJSON, Представление, Пометка",
			СтрокаТаблицы.Вид,
			СтрокаТаблицы.ПолноеИмя,
			СтрокаТаблицы.КлючJSON,
			СтрокаТаблицы.Представление,
			Истина));
	КонецЦикла;

	Результат = ЦТ_СверкаODataСервер.Зарегистрировать(Пакет);
	Текст = СтрШаблон(
		НСтр("ru = 'Зарегистрировано: %1.'"),
		Результат.Зарегистрировано);
	Если Не Результат.Успех И ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		Текст = Текст + Символы.ПС + Результат.ТекстОшибки;
	КонецЕсли;
	Сообщение = Текст;
	Возврат Текст;

КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицу(Таблица, Строки)

	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаДанных Из Строки Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
