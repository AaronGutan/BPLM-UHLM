// Запускается длительной операцией. Результат сверки помещается во временное хранилище.
//
// Параметры:
//  Параметры - Структура - параметры сверки.
//  АдресРезультата - Строка - адрес временного хранилища.
//
Процедура СверитьВФоне(Параметры, АдресРезультата) Экспорт

	Результат = ЦТ_СверкаODataСервер.Сверить(Параметры);
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

