Функция ПолучитьТаблицуИзМассиваСтруктур(МассивСтруктур) Экспорт
	
	ТЗ=Новый ТаблицаЗначений;
	
	Если МассивСтруктур.Количество()=0 Тогда
		Возврат ТЗ;
	КонецЕсли;
	
	// Определим колонки таблицы значений
	
	Для Каждого Колонка ИЗ МассивСтруктур[0] Цикл
			
		ТЗ.Колонки.Добавить(Колонка.Ключ,Колонка.Значение);
		
	КонецЦикла;
	
	// Заполним таблицу значений
	
	Для Индекс=1 ПО МассивСтруктур.Количество()-1 Цикл
		
		СтруктураСтрока=МассивСтруктур[Индекс];
		
		НоваяСтрока=ТЗ.Добавить();
		
		Для Каждого ЗначениеКолонки ИЗ СтруктураСтрока Цикл
			
			НоваяСтрока[ЗначениеКолонки.Ключ]=ЗначениеКолонки.Значение;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТЗ;
 
КонецФункции // ПолучитьТаблицуИзМассиваСтруктур()

// Внимание не сохраняю шапку, в обратной функции учесть
Функция ПолучитьМассивСтруктурИЗТаблицы(ТаблицаЗначений, ДобавитьШапкуВСтроку = Истина) Экспорт
	
	МассивСтруктур = Новый Массив;
	
	Если ДобавитьШапкуВСтроку Тогда
		// Первым элементом массива идет структура, содержащая имена и типы колонок ТЗ
		СтруктураТип=Новый Структура;
		Для Каждого Колонка ИЗ ТаблицаЗначений.Колонки Цикл
			СтруктураТип.Вставить(Колонка.Имя,Колонка.ТипЗначения);
		КонецЦикла;
		МассивСтруктур.Вставить(0,СтруктураТип);
	КонецЕсли;
		
	Для Каждого Строка ИЗ ТаблицаЗначений Цикл
		
		СтруктураСтрока=Новый Структура;
		
		Для Каждого Колонка ИЗ ТаблицаЗначений.Колонки Цикл
			
			СтруктураСтрока.Вставить(Колонка.Имя,Строка[Колонка.Имя]);
			
		КонецЦикла;
			
		МассивСтруктур.Добавить(СтруктураСтрока);
		
	КонецЦикла;
	
	Возврат МассивСтруктур
	
КонецФункции // МассивСтруктурИЗТаблицы()

&НаСервере
Функция ПолучитьВедомостьХозрасчетный(Организация, ДатаНачала, ДатаОкончания, ОтборОбъектНеНайден = Ложь) Экспорт
	Объ = РеквизитФормыВЗначение("Объект");
	ТЗ = Объ.ПолучитьВедомостьХозрасчетный(Организация, ДатаНачала, ДатаОкончания, ОтборОбъектНеНайден);
	МС = ПолучитьМассивСтруктурИЗТаблицы(ТЗ, Ложь);
	Возврат МС;
КонецФункции

&НаСервере
Функция ПолучитьКарточку(РегистрБухгалтерии, Организация, ДатаНачала, ДатаОкончания, Счет, ВыводитьИзмерения, ВыводитьИзмеренияМСФО, ОтборСубконто1, Субконто1, ОтборСубконто2, Субконто2, ОтборСубконто3, Субконто3) Экспорт
	Объ = РеквизитФормыВЗначение("Объект");
	ТЗ = Объ.ПолучитьКарточку(РегистрБухгалтерии, Организация, ДатаНачала, ДатаОкончания, Счет, ВыводитьИзмерения, ВыводитьИзмеренияМСФО, ОтборСубконто1, Субконто1, ОтборСубконто2, Субконто2, ОтборСубконто3, Субконто3);
	МС = ПолучитьМассивСтруктурИЗТаблицы(ТЗ, Ложь);
	Возврат МС;
КонецФункции

&НаСервере
Функция СтрВыв()
	Возврат Новый Структура(
		"Хозрасчетный, МСФО, Измерения, ИзмеренияМСФО, Субконто1, Субконто2, Субконто3, ТипыПустыхЗначений",
		ХозрасчетныйВыводить, МСФОВыводить, ВыводитьИзмерения, ВыводитьИзмеренияМСФО, ВыводитьСубконто1, ВыводитьСубконто2, ВыводитьСубконто3, ВыводитьТипыПустыхЗначений
	);
КонецФункции

#Область ФормированиеВедомости

&НаКлиенте
Процедура Сформировать(Команда)
	
	УстановитьДоступностьКнопкиСформировать(Ложь);
	
	РезультатЗапуска = ЗапуститьФормированиеНаСервере();
	
	Если РезультатЗапуска = Неопределено Тогда
		УстановитьДоступностьКнопкиСформировать(Истина);
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Свойство("ТребуетсяЗагрузкаФайла")
		И РезультатЗапуска.ТребуетсяЗагрузкаФайла Тогда
		
		Оповещение = Новый ОписаниеОповещения("СформироватьПослеЗагрузкиФайла", ЭтотОбъект);
		НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);
		Возврат;
		
	КонецЕсли;
	
	ОбработатьЗапускДлительнойОперации(РезультатЗапуска);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПослеЗагрузкиФайла(ФайлПомещен, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Не ФайлПомещен Тогда
		УстановитьДоступностьКнопкиСформировать(Истина);
		Возврат;
	КонецЕсли;
	
	РезультатЗапуска = ЗапуститьФормированиеСЗагруженнымФайломНаСервере(Адрес);
	
	Если РезультатЗапуска = Неопределено Тогда
		УстановитьДоступностьКнопкиСформировать(Истина);
		Возврат;
	КонецЕсли;
	
	ОбработатьЗапускДлительнойОперации(РезультатЗапуска);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	УстановитьДоступностьКнопкиСформировать(Истина);
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ТекстОшибки = НСтр("ru='Не удалось сформировать ведомость: %1';en='Failed to generate statement: %1'");
		ПоказатьПредупреждение(, СтрШаблон(ТекстОшибки, Результат.КраткоеПредставлениеОшибки));
		Возврат;
	КонецЕсли;
	
	ЗагрузитьРезультатФормированияНаСервере(Результат.АдресРезультата);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗапускДлительнойОперации(ДлительнаяОперация)
	
	Если ДлительнаяОперация.Статус = "Ошибка" Тогда
		УстановитьДоступностьКнопкиСформировать(Истина);
		ТекстОшибки = НСтр("ru='Не удалось запустить формирование ведомости: %1';en='Failed to start statement generation: %1'");
		ПоказатьПредупреждение(, СтрШаблон(ТекстОшибки, ДлительнаяОперация.КраткоеПредставлениеОшибки));
		Возврат;
	КонецЕсли;
	
	Если ДлительнаяОперация.Статус = "Выполнено" Тогда
		ЗагрузитьРезультатФормированияНаСервере(ДлительнаяОперация.АдресРезультата);
		УстановитьДоступностьКнопкиСформировать(Истина);
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ТекстСообщения = НСтр("ru='Формирование ведомости...';en='Generating statement...'");
	
	Оповещение = Новый ОписаниеОповещения("СформироватьЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКнопкиСформировать(Доступность)
	
	Элементы.Сформировать.Доступность = Доступность;
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьФормированиеНаСервере()
	
	ПараметрыФормирования = ПараметрыФормированияНаСервере();
	ПараметрыВыполнения = ПараметрыВыполненияФоновогоЗадания();
	
	ДополнительнаяОбработкаСсылка = ПолучитьСсылкуДополнительнойОбработки();
	
	Если ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
		// БСП: ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки загружает EPF из справочника.
		Возврат ЗапуститьФормированиеЧерезБСП(ПараметрыФормирования, ПараметрыВыполнения, ДополнительнаяОбработкаСсылка);
	КонецЕсли;
	
	ДвоичныеДанныеОбработки = ПолучитьДвоичныеДанныеОбработки();
	
	Если ДвоичныеДанныеОбработки = Неопределено Тогда
		Возврат Новый Структура("ТребуетсяЗагрузкаФайла", Истина);
	КонецЕсли;
	
	Возврат ЗапуститьФормированиеЧерезEMS(ПараметрыФормирования, ПараметрыВыполнения, ДвоичныеДанныеОбработки);
	
КонецФункции

&НаСервере
Функция ЗапуститьФормированиеСЗагруженнымФайломНаСервере(АдресДвоичныхДанных)
	
	ДвоичныеДанныеОбработки = ПолучитьИзВременногоХранилища(АдресДвоичныхДанных);
	
	Если ДвоичныеДанныеОбработки = Неопределено Тогда
		Возврат ОписаниеОшибкиЗапуска(
			НСтр("ru='Не удалось получить файл обработки из временного хранилища.';en='Failed to get processor file from temporary storage.'"));
	КонецЕсли;
	
	ПараметрыФормирования = ПараметрыФормированияНаСервере();
	ПараметрыВыполнения = ПараметрыВыполненияФоновогоЗадания();
	
	Возврат ЗапуститьФормированиеЧерезEMS(ПараметрыФормирования, ПараметрыВыполнения, ДвоичныеДанныеОбработки);
	
КонецФункции

&НаСервере
Функция ПараметрыФормированияНаСервере()
	
	Возврат Новый Структура(
		"Выводить, Период, Организация, ХозрасчетныйСчет, МСФОСчет, ВыводитьРасшифровки, ОтборОбъектНеНайден",
		СтрВыв(),
		Период,
		Организация,
		ХозрасчетныйСчет,
		МСФОСчет,
		ВыводитьРасшифровки,
		ОтборОбъектНеНайден);
	
КонецФункции

&НаСервере
Функция ПараметрыВыполненияФоновогоЗадания()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Формирование детальной ведомости';en='Generating detailed statement'");
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ПараметрыВыполнения;
	
КонецФункции

&НаСервере
Функция ЗапуститьФормированиеЧерезБСП(ПараметрыФормирования, ПараметрыВыполнения, ДополнительнаяОбработкаСсылка)
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ИмяОбработки", "ДетальныеВедомости");
	ПараметрыМетода.Вставить("ИмяМетода", "СформироватьВФоне");
	ПараметрыМетода.Вставить("ПараметрыВыполнения", ПараметрыФормирования);
	ПараметрыМетода.Вставить("ЭтоВнешняяОбработка", Истина);
	ПараметрыМетода.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
		ПараметрыМетода,
		ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Функция ЗапуститьФормированиеЧерезEMS(ПараметрыФормирования, ПараметрыВыполнения, ДвоичныеДанныеОбработки)
	
	Если Метаданные.ОбщиеМодули.Найти("EMS_ВыполнениеВнешнихОбработок") = Неопределено Тогда
		Возврат ОписаниеОшибкиЗапуска(
			НСтр("ru='Обработка открыта из файла. Для фонового формирования требуется расширение EMS или подключение через справочник дополнительных обработок.';en='The processor was opened from a file. Background generation requires the EMS extension or registration in additional processors catalog.'"));
	КонецЕсли;
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ДвоичныеДанныеОбработки", ДвоичныеДанныеОбработки);
	ПараметрыМетода.Вставить("ИмяМетода", "СформироватьВФоне");
	ПараметрыМетода.Вставить("ПараметрыМетода", ПараметрыФормирования);
	
	// Фолбэк для EPF, открытого из файла: EMS создает обработку из двоичных данных во временном файле.
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"EMS_ВыполнениеВнешнихОбработок.ВыполнитьМетодВнешнейОбработки",
		ПараметрыМетода,
		ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Функция ОписаниеОшибкиЗапуска(ТекстОшибки)
	
	Возврат Новый Структура("Статус, КраткоеПредставлениеОшибки", "Ошибка", ТекстОшибки);
	
КонецФункции

&НаСервере
Функция ПолучитьСсылкуДополнительнойОбработки()
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки") Тогда
		Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
	|ГДЕ
	|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
	|	И НЕ ДополнительныеОтчетыИОбработки.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ИмяОбъекта", "ДетальныеВедомости");
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	КонецПопытки;
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция ПолучитьДвоичныеДанныеОбработки()
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ИмяФайла = ОбъектОбработки.ИспользуемоеИмяФайла;
	
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ФайлОбработки = Новый Файл(ИмяФайла);
	
	Если Не ФайлОбработки.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьРезультатФормированияНаСервере(АдресРезультата)
	
	ТабличныйДокумент = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если ТабличныйДокумент = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Результат формирования не найден во временном хранилище.';en='Generation result was not found in temporary storage.'");
	КонецЕсли;
	
	Результат.Очистить();
	Результат.Вывести(ТабличныйДокумент);
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция РезультатОбработкаРасшифровкиНаСервере(Период, Организация, Расшифровка)
	Объ = РеквизитФормыВЗначение("Объект");
	Рез = Объ.КарточкаНаСервере(СтрВыв(), Период, Организация, Расшифровка, РезультатРасшифровки, ОтборСубконто1, ОтборСубконто2, ОтборСубконто3);
КонецФункции

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	Если Расшифровка.Отчет = "Ведомость" Тогда
		РезультатОбработкаРасшифровкиНаСервере(Период, Организация, Расшифровка);
		СтандартнаяОбработка = Ложь;
	ИначеЕсли Расшифровка.Отчет = "Карточка" Тогда
		ОткрытьЗначение(Расшифровка.Регистратор);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)
	ТД = Новый ТабличныйДокумент;
	Для НомСтр = 1 По Результат.ВысотаТаблицы Цикл
		Для НомКол = 1 По Результат.ШиринаТаблицы Цикл
			Если Результат.Область(НомСтр, НомКол).Текст = "" Тогда
				Продолжить;
			КонецЕсли;
			ТД.Область(НомСтр, НомКол).Текст = Результат.Область(НомСтр, НомКол).Текст;
		КонецЦикла;
	КонецЦикла;
	ТД.Показать();
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьРасшифровок()
	Элементы.ГруппаРасшифровки.Видимость = ВыводитьРасшифровки;
КонецПроцедуры

