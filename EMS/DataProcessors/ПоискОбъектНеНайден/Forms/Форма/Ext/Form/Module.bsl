
&НаСервере
Процедура ВыполнитьПоискНаСервере()

	Если Не ЗначениеЗаполнено(ВыборкаФункция) Тогда
		СообщитьПользователю(НСтр("ru='Выберите режим поиска: Справочники, Документы, Регистры сведений, Обороты, Иерархия или ДокументыБезПроводок.'"));
		Возврат;
	КонецЕсли;

	ВыбратьОбъектНеНайден = Истина;
	мРезультат = Новый Массив;

	Если ПочиститьРС Тогда
		ОбменДаннымиПереопределяемый.ЗаписатьВРСОбъектНеНайден(мРезультат, Истина, ВыборкаФункция);
	КонецЕсли;

	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("ВыбратьОбъектНеНайден", ВыбратьОбъектНеНайден);
	ПараметрыВыполнения.Вставить("МетаданныеПроверяемогоРС", МетаданныеПроверяемогоРС);
	ПараметрыВыполнения.Вставить("МетаданныеПроверяемогоСправочника", МетаданныеПроверяемогоСправочника);
	ПараметрыВыполнения.Вставить("ОбъектПроверяемый", МетаданныеПроверяемогоСправочника);
	ПараметрыВыполнения.Вставить("ТолькоВерхнийУровень", ТолькоВерхнийУровень);
	ПараметрыВыполнения.Вставить("ВыборкаФункция", ВыборкаФункция);

	Откуда = ВыборкаФункция;
	Если ВыборкаФункция = "РегистрыСведений" Тогда
		Откуда = ВыборкаФункция + "." + МетаданныеПроверяемогоРС;
	КонецЕсли;

	Если ВыборкаФункция = "Справочники" Тогда
		мРезультат = ОбменДаннымиПереопределяемый.цМетаданныеНаСервере(ПараметрыВыполнения);
	ИначеЕсли ВыборкаФункция = "Документы" Тогда
		мРезультат = ОбменДаннымиПереопределяемый.цМетаданныеНаСервере(ПараметрыВыполнения);
	ИначеЕсли ВыборкаФункция = "РегистрыСведений" Тогда
		мРезультат = ОбменДаннымиПереопределяемый.цМетаданныеНаСервереРС(ПараметрыВыполнения);
	ИначеЕсли ВыборкаФункция = "Обороты" Тогда
		Если Не ЗначениеЗаполнено(ОргИД) Тогда
			СообщитьПользователю(НСтр("ru='Организация не заполнена.'"));
			Возврат;
		КонецЕсли;
		Если Период.ДатаНачала = Дата(1, 1, 1) Или Период.ДатаОкончания = Дата(1, 1, 1) Тогда
			СообщитьПользователю(НСтр("ru='Период не заполнен.'"));
			Возврат;
		КонецЕсли;

		ЗапросПараметры = Новый Структура;
		ЗапросПараметры.Вставить("НачалоПериода", Период.ДатаНачала);
		ЗапросПараметры.Вставить("КонецПериода", КонецДня(Период.ДатаОкончания));
		ЗапросПараметры.Вставить("Организация", ОргИД);

		мРезультат = ОбменДаннымиПереопределяемый.ВыполнитьЗапросОбъектНеНайденСервер(
			ЗапросПараметры, ВыбратьОбъектНеНайден);
	ИначеЕсли ВыборкаФункция = "Иерархия" Тогда
		мРезультат = ОбменДаннымиПереопределяемый.цМетаданныеИерархия(
			МетаданныеПроверяемогоСправочника, ВыбратьОбъектНеНайден);
	ИначеЕсли ВыборкаФункция = "ДокументыБезПроводок" Тогда
		мРезультат = ОбменДаннымиПереопределяемый.цПоДокументамБезПроводок(ВыбратьОбъектНеНайден);
	КонецЕсли;

	КоличествоНайденных = 0;
	Если ТипЗнч(мРезультат) = Тип("Массив") Тогда
		КоличествоНайденных = мРезультат.Количество();
		ОбменДаннымиПереопределяемый.ЗаписатьВРСОбъектНеНайден(мРезультат, Ложь, Откуда);
	КонецЕсли;

	ТекстСообщения = СтрШаблон(
		НСтр("ru='Найдено битых ссылок: %1. Результат записан в регистр EMS_ОбъектыОбмен.'"),
		КоличествоНайденных);
	СообщитьПользователю(ТекстСообщения);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоиск(Команда)
	ВыполнитьПоискНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	МетаданныеПроверяемогоСправочника = "БанковскиеСчета";
	МетаданныеПроверяемогоРС = "СоответствияОбъектовИнформационныхБаз";
	Если Не ЗначениеЗаполнено(ВыборкаФункция) Тогда
		ВыборкаФункция = "Обороты";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СообщитьПользователю(Знач ТекстСообщения)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();

КонецПроцедуры
