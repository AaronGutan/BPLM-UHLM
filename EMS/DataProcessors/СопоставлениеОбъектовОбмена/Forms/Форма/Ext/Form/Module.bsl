&НаСервере
Процедура ЗаполнитьСписокВыбораИсточника()
	
	Элементы.ТипИсточника.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(УзелИнформационнойБазы) Тогда
		Для каждого ТекЭлемент Из УзелИнформационнойБазы.Метаданные().Состав Цикл
			Если Метаданные.Справочники.Содержит(ТекЭлемент.Метаданные) Тогда
				Элементы.ТипИсточника.СписокВыбора.Добавить("Справочник." + ТекЭлемент.Метаданные.Имя);
			КонецЕсли;
			Если Метаданные.ПланыВидовХарактеристик.Содержит(ТекЭлемент.Метаданные) Тогда
				Элементы.ТипИсточника.СписокВыбора.Добавить("ПланВидовХарактеристик." + ТекЭлемент.Метаданные.Имя);
			КонецЕсли;
			Если Метаданные.ПланыСчетов.Содержит(ТекЭлемент.Метаданные) Тогда
				Элементы.ТипИсточника.СписокВыбора.Добавить("ПланСчетов." + ТекЭлемент.Метаданные.Имя);
			КонецЕсли;
			Если Метаданные.ПланыВидовРасчета.Содержит(ТекЭлемент.Метаданные) Тогда
				Элементы.ТипИсточника.СписокВыбора.Добавить("ПланВидовРасчета." + ТекЭлемент.Метаданные.Имя);
			КонецЕсли;
		КонецЦикла;
		Элементы.ТипИсточника.СписокВыбора.СортироватьПоЗначению();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораПриемника()
	
	// TODO: Переделать на загрузку списка метеданных из базы-приемника
	Элементы.ТипПриемника.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(УзелИнформационнойБазы) Тогда
		Для каждого ТекЭлемент Из Метаданные.Справочники Цикл
			Элементы.ТипПриемника.СписокВыбора.Добавить("Справочник." + ТекЭлемент.Имя);
		КонецЦикла;
		Для каждого ТекЭлемент Из Метаданные.ПланыВидовХарактеристик Цикл
			Элементы.ТипПриемника.СписокВыбора.Добавить("ПланВидовХарактеристик." + ТекЭлемент.Имя);
		КонецЦикла;
		Для каждого ТекЭлемент Из Метаданные.ПланыСчетов Цикл
			Элементы.ТипПриемника.СписокВыбора.Добавить("ПланСчетов." + ТекЭлемент.Имя);
		КонецЦикла;
		Для каждого ТекЭлемент Из Метаданные.ПланыВидовРасчета Цикл
			Элементы.ТипПриемника.СписокВыбора.Добавить("ПланВидовРасчета." + ТекЭлемент.Имя);
		КонецЦикла;
		Элементы.ТипПриемника.СписокВыбора.СортироватьПоЗначению();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображение()
	
	Элементы.СписокИсточника.Обновить();
	ОбновитьДанныеПриемника();
	
КонецПроцедуры

&НаКлиенте
Процедура ОпределитьПриемникПоИсточнику()
	
	Если ЗначениеЗаполнено(ТипИсточника) Тогда
		НайденноеЗначение = Элементы.ТипПриемника.СписокВыбора.НайтиПоЗначению(ТипИсточника);
		Если НайденноеЗначение <> Неопределено Тогда
			ТипПриемника = НайденноеЗначение.Значение;
		КонецЕсли;
	Иначе
		ТипПриемника = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеИсточника()
	Если Не ЗначениеЗаполнено(ТипИсточника) Тогда
		СписокИсточника.ТекстЗапроса =
			"ВЫБРАТЬ
			|	НЕОПРЕДЕЛЕНО КАК Ссылка,
			|	ВЫРАЗИТЬ("""" КАК СТРОКА(150)) КАК Наименование,
			|	ВЫРАЗИТЬ("""" КАК СТРОКА(150)) КАК Код,
			|	ДАТАВРЕМЯ(1, 1, 1) КАК Дата,
			|	ЛОЖЬ КАК ЭтоГруппа,
			|	НЕОПРЕДЕЛЕНО КАК ЗначениеПриемника,
			|	ЛОЖЬ КАК ЕстьСоответствие";
		Возврат;
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ТипИсточника);
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Таблица.Ссылка КАК Ссылка,
		|	//ПолеКод
		|	//ПолеНаименование
		|	//ПолеЭтоГруппа
		|	//ДопРеквизиты
		|	Таблица.ПометкаУдаления КАК ПометкаУдаления,
		|	МАКСИМУМ(СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника) КАК ЗначениеПриемника,
		|	НЕ СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника ЕСТЬ NULL КАК ЕстьСоответствие
		|ИЗ
		|	" + ТипИсточника + " КАК Таблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
		|		ПО Таблица.Ссылка = СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника
		|			И (СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы = &УзелИнформационнойБазы)
		|			И (СоответствияОбъектовИнформационныхБаз.ТипИсточника = &ТипИсточника)
		|			И (СоответствияОбъектовИнформационныхБаз.ТипПриемника = &ТипПриемника)
		|
		|СГРУППИРОВАТЬ ПО
		|	Таблица.Ссылка,
		|	//ПолеКод
		|	//ПолеНаименование
		|	//ПолеЭтоГруппа
		|	//ДопРеквизиты
		|	Таблица.ПометкаУдаления,
		|	НЕ СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника ЕСТЬ NULL";
	
	Попытка
		СтРеквизит = ОбъектМетаданных.СтандартныеРеквизиты.Наименование;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//ПолеНаименование", "Таблица.Наименование,");
	Исключение
	КонецПопытки;	
	Попытка
		СтРеквизит = ОбъектМетаданных.СтандартныеРеквизиты.Код;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//ПолеКод", "Таблица.Код,");
	Исключение
	КонецПопытки;	
	Попытка
		СтРеквизит = ОбъектМетаданных.СтандартныеРеквизиты.ЭтоГруппа;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//ПолеЭтоГруппа", "Таблица.ЭтоГруппа,");
	Исключение
	КонецПопытки;
	
	ДопРеквизиты = ПолучитьМассивДопРеквизитов();
	ДопРеквизитыДляЗапроса = "";
	Для каждого ИмяРеквизита Из ДопРеквизиты Цикл
		ДопРеквизитыДляЗапроса = ДопРеквизитыДляЗапроса + "Таблица." + ИмяРеквизита + ", ";
	КонецЦикла;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//ДопРеквизиты", ДопРеквизитыДляЗапроса);
	
	СписокИсточника.ТекстЗапроса = ТекстЗапроса;
	СписокИсточника.ОсновнаяТаблица = ТипИсточника;
	СписокИсточника.ДинамическоеСчитываниеДанных = Истина;
	
	СписокИсточника.Параметры.УстановитьЗначениеПараметра("УзелИнформационнойБазы", УзелИнформационнойБазы);
	СписокИсточника.Параметры.УстановитьЗначениеПараметра("ТипИсточника", СтрЗаменить(ТипИсточника, ".", "Ссылка."));
	СписокИсточника.Параметры.УстановитьЗначениеПараметра("ТипПриемника", СтрЗаменить(ТипПриемника, ".", "Ссылка."));
	
	// Удалим добавленные колонки
	Для каждого ТекКолонка Из ДобавленныеКолонкиИсточника Цикл
		Элементы.Удалить(Элементы.Найти("СписокИсточника" + ТекКолонка.Значение));
	КонецЦикла;
	ДобавленныеКолонкиИсточника.Очистить();
	
	// Добавим колонки
	Для каждого ИмяРеквизита Из ДопРеквизиты Цикл
		НовЭлементы = Элементы.Добавить("СписокИсточника" + ИмяРеквизита, Тип("ПолеФормы"), Элементы.СписокИсточника);
		НовЭлементы.Вид = ВидПоляФормы.ПолеНадписи;
		НовЭлементы.ПутьКДанным = "СписокИсточника." + ИмяРеквизита;
		ДобавленныеКолонкиИсточника.Добавить(ИмяРеквизита);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеПриемника()
	
	СписокПриемника.Очистить();
	Если ЗначениеЗаполнено(ТипПриемника) Тогда
		
		ДопРеквизиты = ПолучитьМассивДопРеквизитов();
		
		// Удалим добавленные колонки
		УдаляемыеРеквизиты = Новый Массив;
		Для каждого ТекКолонка Из ДобавленныеКолонкиПриемника Цикл
			Элементы.Удалить(Элементы.Найти("СписокПриемника" + ТекКолонка.Значение));
			УдаляемыеРеквизиты.Добавить("СписокПриемника." + ТекКолонка.Значение);
		КонецЦикла;
		ДобавленныеКолонкиПриемника.Очистить();
		
		// Добавим колонки
		ДобавляемыеРеквизиты = Новый Массив;
		Для каждого ИмяРеквизита Из ДопРеквизиты Цикл
			РеквизитМД = Метаданные.НайтиПоПолномуИмени(ТипИсточника).Реквизиты.Найти(ИмяРеквизита);
			Если ОбщегоНазначения.ЭтоСсылка(РеквизитМД.Тип.Типы()[0]) Тогда
				ТипРеквизита = Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(150));
			Иначе
				ТипРеквизита = РеквизитМД.Тип;
			КонецЕсли;
			НовРеквизит = Новый РеквизитФормы(ИмяРеквизита, ТипРеквизита, "СписокПриемника", РеквизитМД.Синоним);
			ДобавляемыеРеквизиты.Добавить(НовРеквизит);
		КонецЦикла;
		ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);
		
		Для каждого ИмяРеквизита Из ДопРеквизиты Цикл
			НовЭлементы = Элементы.Добавить("СписокПриемника" + ИмяРеквизита, Тип("ПолеФормы"), Элементы.СписокПриемника);
			НовЭлементы.Вид = ВидПоляФормы.ПолеНадписи;
			НовЭлементы.ПутьКДанным = "СписокПриемника." + ИмяРеквизита;
			ДобавленныеКолонкиПриемника.Добавить(ИмяРеквизита);
		КонецЦикла;
		
		// Получение данных из базы-приемника
		ДанныеЗапроса = Новый Структура("ИмяПланаОбмена, КодУзлаКорреспондента, ТипИсточника, ТипПриемника, ДопРеквизиты",,,,, ДопРеквизиты);
		ЗаполнитьЗначенияСвойств(ДанныеЗапроса, ЭтаФорма);
		
		Если ОтборПоОрганизациям Тогда
			ДанныеЗапроса.Вставить("ОтборОрганизации", ПолучитьМассивТекущихОрганизаций());
		КонецЕсли;
		
		ДанныеОтвета = ЗапросКБазеПриемнику("getlist", ДанныеЗапроса);
		
		Если ДанныеОтвета = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеОтвета.ОписаниеОшибки) Тогда
			Сообщить(ДанныеОтвета.ОписаниеОшибки);
			Возврат;
		КонецЕсли;
		
		Для каждого ТекСтрока Из ДанныеОтвета.СписокОбъектов Цикл
			НоваяСтрока = СписокПриемника.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСоответствиеНаСервере(ЗначениеИсточника, ЗначениеПриемника)
	
	// Прямая связь
	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("УзелИнформационнойБазы", УзелИнформационнойБазы);
	СтруктураЗаписи.Вставить("УникальныйИдентификаторПриемника", ЗначениеПриемника);
	СтруктураЗаписи.Вставить("УникальныйИдентификаторИсточника", ЗначениеИсточника);
	СтруктураЗаписи.Вставить("ТипПриемника", СтрЗаменить(ТипПриемника, ".", "Ссылка."));
	СтруктураЗаписи.Вставить("ТипИсточника", СтрЗаменить(ТипИсточника, ".", "Ссылка."));
	//СтруктураЗаписи.Вставить("УникальныйИдентификаторИсточникаСтрокой", Строка(ЗначениеИсточника.УникальныйИдентификатор()));
	РегистрыСведений.СоответствияОбъектовИнформационныхБаз.ДобавитьЗапись(СтруктураЗаписи, Истина);
	
	// Обратная связь
	ДанныеЗапроса = Новый Структура("ИмяПланаОбмена, КодУзлаКорреспондента, ТипИсточника, ТипПриемника");
	ЗаполнитьЗначенияСвойств(ДанныеЗапроса, ЭтаФорма);
	ДанныеЗапроса.Вставить("ЗначениеИсточника", Строка(ЗначениеИсточника.УникальныйИдентификатор()));
	ДанныеЗапроса.Вставить("ЗначениеПриемника", ЗначениеПриемника);
	
	ДанныеОтвета = ЗапросКБазеПриемнику("setlink", ДанныеЗапроса);
	
	Если ДанныеОтвета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеОтвета.ОписаниеОшибки) Тогда
		Сообщить(ДанныеОтвета.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьСоответствиеНаСервере(ЗначениеИсточника, ЗначениеПриемника)
	
	// Прямая связь
	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("УзелИнформационнойБазы", УзелИнформационнойБазы);
	СтруктураЗаписи.Вставить("УникальныйИдентификаторПриемника", ЗначениеПриемника);
	СтруктураЗаписи.Вставить("УникальныйИдентификаторИсточника", ЗначениеИсточника);
	СтруктураЗаписи.Вставить("ТипПриемника", СтрЗаменить(ТипПриемника, ".", "Ссылка."));
	СтруктураЗаписи.Вставить("ТипИсточника", СтрЗаменить(ТипИсточника, ".", "Ссылка."));
	РегистрыСведений.СоответствияОбъектовИнформационныхБаз.УдалитьЗапись(СтруктураЗаписи, Истина);
	
	// Удалим соответствие в правой части
	НайденныеСтроки = СписокПриемника.НайтиСтроки(Новый Структура("Ссылка", ЗначениеПриемника));
	Для каждого ТекСтрока Из НайденныеСтроки Цикл
		ТекСтрока.ЕстьСоответствие = Ложь;
	КонецЦикла;
	
	// Обратная связь
	ДанныеЗапроса = Новый Структура("ИмяПланаОбмена, КодУзлаКорреспондента, ТипИсточника, ТипПриемника");
	ЗаполнитьЗначенияСвойств(ДанныеЗапроса, ЭтаФорма);
	ДанныеЗапроса.Вставить("ЗначениеИсточника", Строка(ЗначениеИсточника.УникальныйИдентификатор()));
	ДанныеЗапроса.Вставить("ЗначениеПриемника", ЗначениеПриемника);
	
	ДанныеОтвета = ЗапросКБазеПриемнику("dellink", ДанныеЗапроса);
	
	Если ДанныеОтвета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеОтвета.ОписаниеОшибки) Тогда
		Сообщить(ДанныеОтвета.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьТаблицуРеквизитов()
	
	ТаблицаРеквизитов.Очистить();
	
	Если ЗначениеЗаполнено(ТипИсточника) Тогда
		НовСтрока = ТаблицаРеквизитов.Добавить();
		НовСтрока.ИмяРеквизита = "Код";
		НовСтрока.Предопределенный = Истина;
		НовСтрока = ТаблицаРеквизитов.Добавить();
		НовСтрока.ИмяРеквизита = "Наименование";
		НовСтрока.Предопределенный = Истина;
		НовСтрока = ТаблицаРеквизитов.Добавить();
		НовСтрока.ИмяРеквизита = "ЭтоГруппа";
		НовСтрока.Предопределенный = Истина;
	КонецЕсли;
	
	Элементы.СписокПриемникаОтменитьОтборПоРеквизиту.Доступность = Ложь;
	УстановитьОтборПриемникаПоСвойствамИсточника();
	
КонецПроцедуры

