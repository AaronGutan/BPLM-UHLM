&НаСервере
Функция СопоставитьНаСервере()
	мСоответствия = Новый Массив;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Приемник.Ссылка КАК Ссылка,
						  //|	Приемник.Код КАК Код,
						  //|	Приемник.Наименование КАК Наименование,
	                      //|	Приемник.ЭтоГруппа КАК ЭтоГруппа,
	                      |	Приемник.ЕстьСоответствие КАК ЕстьСоответствие
	                      |ПОМЕСТИТЬ втПриемник
	                      |ИЗ
	                      |	&Приемник КАК Приемник
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ТаблицаИБ.Ссылка КАК Ссылка,
						  //|	ТаблицаИБ.Код КАК Код,
						  //|	ТаблицаИБ.Наименование КАК Наименование,
	                      //|	ТаблицаИБ.ЭтоГруппа КАК ЭтоГруппа,
	                      |	втПриемник.Ссылка КАК ПриемникСсылка
						  //|	втПриемник.Код КАК ПриемникКод,
						  //|	втПриемник.Наименование КАК ПриемникНаименование,
	                      //|	втПриемник.ЭтоГруппа КАК ПриемникЭтоГруппа
	                      |ИЗ
	                      |	втПриемник КАК втПриемник
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втИсходнаяТаблица КАК ТаблицаИБ
	                      |		ПО (НЕ втПриемник.ЕстьСоответствие)
	                      |			И (&Условие)");
						  
	СтрРеквизиты = "";
	
	ЭтоСправочник = Лев(ТипИсточника, 11) = "Справочник.";
	ЭтоПВР = Лев(ТипИсточника, 17) = "ПланВидовРасчета.";
	ЭтоПС = Лев(ТипИсточника, 11) = "ПланСчетов.";
	
	Если ЭтоСправочник Тогда
		МД = Метаданные.Справочники[СтрЗаменить(ТипИсточника, "Справочник.", "")];
	КонецЕсли;
	Если ЭтоПВР Тогда
		МД = Метаданные.ПланыВидовРасчета[СтрЗаменить(ТипИсточника, "ПланВидовРасчета.", "")];
	КонецЕсли;
	Если ЭтоПС Тогда
		МД = Метаданные.ПланыСчетов[СтрЗаменить(ТипИсточника, "ПланСчетов.", "")];
	КонецЕсли;
	
	Если ЭтоСправочник Или ЭтоПВР Или ЭтоПС Тогда
		Если МД.ДлинаКода > 0 Тогда
			СтрРеквизиты = СтрРеквизиты + ?(СтрРеквизиты <> "", ",", "") + "Код";
		КонецЕсли;
		Если МД.ДлинаНаименования > 0 Тогда
			СтрРеквизиты = СтрРеквизиты + ?(СтрРеквизиты <> "", ",", "") + "Наименование";
		КонецЕсли;
	КонецЕсли;
	Если ЭтоСправочник Тогда
		Если МД.Иерархический Тогда
			СтрРеквизиты = СтрРеквизиты + ?(СтрРеквизиты <> "", ",", "") + "ЭтоГруппа";
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Табл Из СтрРазделить("Приемник,ТаблицаИБ,втПриемник", ",", Ложь) Цикл
		Для Каждого Рекв Из СтрРазделить(СтрРеквизиты, ",", Ложь) Цикл
			Запрос.Текст = СтрЗаменить(
				Запрос.Текст,
				Табл + ".Ссылка КАК " + ?(Табл = "втПриемник", "Приемник", "") + "Ссылка",
				Табл + ".Ссылка КАК " + ?(Табл = "втПриемник", "Приемник", "") + "Ссылка, "
				+ Табл + "." + Рекв + " КАК " + ?(Табл = "втПриемник", "Приемник", "") + Рекв
			);
		КонецЦикла;
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "втИсходнаяТаблица", ТипИсточника);
	
	Условие = "";
	Реквизиты = "";
	Для Каждого Рекв Из РеквизитФормыВЗначение("ТаблицаРеквизитов") Цикл
		Если Не Рекв.ОтборПоРеквизиту Тогда
			Продолжить;
		КонецЕсли;
		
		Условие = Условие
			+ ?(Условие <> "", " И ", "")
			+ "втПриемник." + Рекв.ИмяРеквизита + " <> """"" + Символы.ПС
			+ "И втПриемник." + Рекв.ИмяРеквизита + " = ТаблицаИБ." + Рекв.ИмяРеквизита + Символы.ПС
		;
		
		Если Рекв.ИмяРеквизита <> "Код" И Рекв.ИмяРеквизита <> "Наименование" Тогда
			Реквизиты = Реквизиты
				+ ","
				+ Символы.ПС + " Приемник." + Рекв.ИмяРеквизита
			;
		КонецЕсли;
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", Условие);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Приемник.ЕстьСоответствие КАК ЕстьСоответствие", "Приемник.ЕстьСоответствие КАК ЕстьСоответствие" + Реквизиты);
	
	ЕстьГруппы = Лев(ТипИсточника, 11) = "Справочник."
		И Метаданные.Справочники[СтрЗаменить(ТипИсточника, "Справочник.", "")].Иерархический;
	Если Не ЕстьГруппы Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "	Приемник.ЭтоГруппа", "	Ложь");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "	ТаблицаИБ.ЭтоГруппа", "	Ложь");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Приемник", РеквизитФормыВЗначение("СписокПриемника"));
//	Запрос.УстановитьПараметр("ЕстьГруппы", ЕстьГруппы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекСтр = Новый Структура;
		Для Каждого Рекв Из СтрРазделить("Ссылка," + СтрРеквизиты, ",", Ложь) Цикл
			Для Каждого ИстПри Из СтрРазделить("Источник,Приемник", ",", Ложь) Цикл
				ТекСтр.Вставить(ИстПри + Рекв, Выборка[?(ИстПри = "Источник", "", ИстПри) + Рекв]);
			КонецЦикла;
		КонецЦикла;
		мСоответствия.Добавить(ТекСтр);
	КонецЦикла;
	
	Возврат мСоответствия;
КонецФункции

&НаКлиенте
Функция ПриведенноеИмяКонтрагента(Знач Стр)
	Стр = Врег(Стр);
	
	Стр = СтрЗаменить(Стр, "ФГУП", "");
	Стр = СтрЗаменить(Стр, "ООО", "");
	Стр = СтрЗаменить(Стр, "ОБЩЕСТВО С ОГРАНИЧЕННОЙ ОТВЕТСТВЕННОСТЬЮ", "");
	Стр = СтрЗаменить(Стр, "ОАО", "");
	Стр = СтрЗаменить(Стр, "ОТКРЫТОЕ АКЦИОНЕРНОЕ ОБЩЕСТВО", "");
	Стр = СтрЗаменить(Стр, "ЗАО", "");
	Стр = СтрЗаменить(Стр, "ЗАКРЫТОЕ АКЦИОНЕРНОЕ ОБЩЕСТВО", "");
	Стр = СтрЗаменить(Стр, "ПАО", "");
	Стр = СтрЗаменить(Стр, "АО", "");
	Стр = СтрЗаменить(Стр, """", "");
	Стр = СтрЗаменить(Стр, "«", "");
	Стр = СтрЗаменить(Стр, "»", "");
	Стр = СтрЗаменить(Стр, " - ", "-");
	Стр = СтрЗаменить(Стр, "  ", " ");
	Стр = СокрЛП(Стр);
	
	Возврат Стр;
КонецФункции

&НаКлиенте
Процедура Сопоставить(Команда)
	Список = СопоставитьНаСервере();
	
	Сч = 0; КолВо = Список.Количество();
	Для Каждого Стр Из Список Цикл
		Сч = Сч + 1;
		Состояние("" + Стр.ИсточникНаименование + " => " + Стр.ПриемникНаименование, Сч / Колво * 100, "Прогресс сопоставления");
		ОбработкаПрерыванияПользователя();
		
		КонтрагентСравним = Ложь;
		Если Не СопоставитьБезВопроса И СопоставитьБезВопросаДляКонтрагентов Тогда
//			Сообщить("" + ПриведенноеИмяКонтрагента(Стр.ИсточникНаименование) + " => " + ПриведенноеИмяКонтрагента(Стр.ПриемникНаименование));
			КонтрагентСравним = ПриведенноеИмяКонтрагента(Стр.ИсточникНаименование) = ПриведенноеИмяКонтрагента(Стр.ПриемникНаименование);
		КонецЕсли;
		
		Если СопоставитьБезВопроса Тогда
			Ответ = КодВозвратаДиалога.Да;
		ИначеЕсли КонтрагентСравним Тогда
			Ответ = КодВозвратаДиалога.Да;
		Иначе
			Ответ = Вопрос(""
					+ "Сопоставить элементы (" + Сч + " / " + Колво + "):" + Символы.ПС
					//+ Стр.ИсточникКод + " "
					+ Стр.ИсточникНаименование + Символы.ПС
					//+ Стр.ПриемникКод + " "
					+ Стр.ПриемникНаименование + Символы.ПС
				, РежимДиалогаВопрос.ДаНетОтмена,, КодВозвратаДиалога.Нет
			);
		КонецЕсли;
		
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Продолжить;
		ИначеЕсли Ответ = КодВозвратаДиалога.Отмена Тогда
			Прервать;
		КонецЕсли;
		
		
		УстановитьСоответствиеНаСервере(Стр.ИсточникСсылка, Стр.ПриемникСсылка);
		
		СписокПриемника.НайтиСтроки(Новый Структура("Ссылка", Стр.ПриемникСсылка))[0].ЕстьСоответствие = Истина;
		
	КонецЦикла;

	Элементы.СписокИсточника.Обновить();
КонецПроцедуры

#КонецОбласти
