 
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВариантОтбораСоответствийИсточника = "Все";
	ВариантОтбораСоответствийПриемника = "Все";
	Элементы.СписокПриемникаОтменитьОтборПоРеквизиту.Доступность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//ЗаполнитьПараметрыПодключения();
	ЗаполнитьСписокВыбораИсточника();
	ЗаполнитьСписокВыбораПриемника();
	ИнициализироватьТаблицуРеквизитов();
	ОбновитьДанныеИсточника();
	ОбновитьДанныеПриемника();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьСоответствие(Команда)
	
	Если Элементы.СписокИсточника.ТекущиеДанные = Неопределено 
			ИЛИ Элементы.СписокПриемника.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Элементы.СписокИсточника.ТекущиеДанные.ЗначениеПриемника) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьСоответствиеНаСервере(Элементы.СписокИсточника.ТекущиеДанные.Ссылка, Элементы.СписокПриемника.ТекущиеДанные.Ссылка);
	Элементы.СписокПриемника.ТекущиеДанные.ЕстьСоответствие = Истина;
	
	Элементы.СписокИсточника.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьСоответствие(Команда)
	
	Если Элементы.СписокИсточника.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Элементы.СписокИсточника.ТекущиеДанные.ЗначениеПриемника) Тогда
		Возврат
	КонецЕсли;
	
	ОтменитьСоответствиеНаСервере(Элементы.СписокИсточника.ТекущиеДанные.Ссылка, Элементы.СписокИсточника.ТекущиеДанные.ЗначениеПриемника);
	
	Элементы.СписокИсточника.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗначениеКоманда(Команда)
	
	Если ТекущийЭлемент.ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущийЭлемент.ТекущиеДанные.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРеквизиты(Команда)
	
	Если ЗначениеЗаполнено(ТипИсточника) Тогда
		Оповещение = Новый ОписаниеОповещения("НастроитьРеквизитыЗавершение", ЭтаФорма);
		ПараметрыФормы = Новый Структура("ТипИсточника,АдресХранилищаТаблицыРеквизитов", ТипИсточника, ПолучитьАдресХранилищаТаблицыРеквизитов());
		ОткрытьФорму("ВнешняяОбработка.СопоставлениеОбъектовОбмена.Форма.ФормаНастройкиРеквизитов", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор,,, Оповещение);
	Иначе
		ТекстСообщения = НСтр("ru = 'Поле ""Тип источника"" не заполнено'");
		ПоказатьПредупреждение(, ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРеквизитыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		
		ИзменитьНастройкиРеквизитов(Результат);
		ОбновитьДанныеИсточника();
		ОбновитьДанныеПриемника();
		
		Элементы.СписокПриемникаОтменитьОтборПоРеквизиту.Доступность = ТаблицаРеквизитов.НайтиСтроки(Новый Структура("ОтборПоРеквизиту", Истина)).Количество() > 0;
		ПодключитьОбработчикОжидания("Подключаемый_ОбновитьОтборПриемника", 0.1, Истина);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьОбъектыПоПравилу(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		ПоказатьПредупреждение(, "Не выбрано правило конвертации.");
		Возврат;
	КонецЕсли;
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗарегистрироватьОбъектыПоПравилуЗавершение", ЭтаФорма),
		НСтр("ru = 'Зарегистрировать все объекты ИБ источника по правилу?
			|Это может занять продолжительное время.'"),
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ЗарегистрироватьОбъектыПоПравилуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Состояние("Выполняется регистрация конвертации объектов по правилу");
		ЗарегистрироватьОбъектыПоПравилуСервер(УзелИнформационнойБазы, ТипИсточника);
		Состояние("");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставитьПоПравилу(Команда)
	
	СопоставитьПоПравилуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОтборПоРеквизиту(Команда)
	
	Элементы.СписокПриемникаОтменитьОтборПоРеквизиту.Доступность = Ложь;
	Для каждого ТекСтрока Из ТаблицаРеквизитов Цикл
		ТекСтрока.ОтборПоРеквизиту = Ложь;
	КонецЦикла;
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьОтборПриемника", 0.1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура УзелИнформационнойБазыПриИзменении(Элемент)
	
	//ЗаполнитьПараметрыПодключения();
	
	Элементы.ТипИсточника.СписокВыбора.Очистить();
	Элементы.ТипПриемника.СписокВыбора.Очистить();
	
	ТипИсточника = "";
	ТипПриемника = "";
	
	ИнициализироватьТаблицуРеквизитов();
	
	ЗаполнитьСписокВыбораИсточника();
	ЗаполнитьСписокВыбораПриемника();
		
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипИсточникаПриИзменении(Элемент)
	
	ОпределитьПриемникПоИсточнику();
	ИнициализироватьТаблицуРеквизитов();
	ОбновитьДанныеИсточника();
	ОбновитьДанныеПриемника();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПриемникаПриИзменении(Элемент)
	
	ОбновитьДанныеПриемника();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоОрганизациямПриИзменении(Элемент)
	
	ОбновитьДанныеПриемника();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантОтбораСоответствийИсточникаПриИзменении(Элемент)
	
	ИзменитьЭлементОтбораСписка(
			СписокИсточника,
			"ЕстьСоответствие",
			Истина,
			НЕ ВариантОтбораСоответствийИсточника = "Все", 
			?(ВариантОтбораСоответствийИсточника = "Связанные", ВидСравненияКомпоновкиДанных.Равно, ВидСравненияКомпоновкиДанных.НеРавно));
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантОтбораСоответствийПриемникаПриИзменении(Элемент)
	
	Если ВариантОтбораСоответствийПриемника = "Связанные" Тогда
		Элементы.СписокПриемника.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ЕстьСоответствие", Истина));
	ИначеЕсли ВариантОтбораСоответствийПриемника = "НеСвязанные" Тогда
		Элементы.СписокПриемника.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ЕстьСоответствие", Ложь));
	Иначе
		Элементы.СписокПриемника.ОтборСтрок = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокИсточникаПриАктивизацииСтроки(Элемент)
	
	Если Элементы.СписокПриемникаОтменитьОтборПоРеквизиту.Доступность Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ОбновитьОтборПриемника", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокИсточникаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ЗначениеПриемника) Тогда
		НайденныеСтроки = СписокПриемника.НайтиСтроки(Новый Структура("Ссылка", Элемент.ТекущиеДанные.ЗначениеПриемника));
		Если НайденныеСтроки.Количество() > 0 Тогда
			Элементы.СписокПриемника.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УправлениеФормой()
	
	Элементы.ТипИсточника.ТолькоПросмотр = Не ЗначениеЗаполнено(УзелИнформационнойБазы);
	Элементы.ТипПриемника.ТолькоПросмотр = Не ЗначениеЗаполнено(УзелИнформационнойБазы);
	
КонецПроцедуры

