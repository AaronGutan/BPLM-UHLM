	НайденныеСтроки = ТаблицаРеквизитов.НайтиСтроки(Новый Структура("ОтборПоРеквизиту", Истина));
	Если ТекущиеДанные = Неопределено
			Или НайденныеСтроки.Количество() = 0 Тогда
