Функция ПолучитьРегистраторы() Экспорт
	
	мРез = Новый Массив;
	Для Каждого Эл Из НайденныеОбъекты Цикл
		мРез.Добавить(Эл);
	КонецЦикла;
	
	Возврат мРез;
КонецФункции

&НаКлиенте
Функция ПолучитьНайденныеОбъекты() Экспорт 
	
	мРез = Новый Массив;
	Для Каждого Эл Из НайденныеОбъекты Цикл
		мРез.Добавить(Эл.Объект);
	КонецЦикла;
	
	Возврат мРез;
	
КонецФункции // ПолучитьНайденныеОбъекты()

