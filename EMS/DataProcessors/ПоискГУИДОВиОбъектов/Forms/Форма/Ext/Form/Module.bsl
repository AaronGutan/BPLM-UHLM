&НаСервере
Процедура СоздатьОбьектПоГУИДуНаСервере()
	
	ТвояОбласть    = СписокОбъектов.ПолучитьОбласть();
	к=1;
	Для к = 1 По ТвояОбласть.ВысотаТаблицы   Цикл
		ГУИД = ТвояОбласть.Область(к,1,к,1).Текст;
		Идентификатор = Новый УникальныйИдентификатор(ГУИД);
		Ссылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Идентификатор);
		ОбъектПоГуиду = Ссылка.ПолучитьОбъект();
		Если ОбъектПоГуиду = Неопределено Тогда
			ОбъектПоГуиду = Справочники.ФизическиеЛица.СоздатьЭлемент();
			ОбъектПоГуиду.УстановитьСсылкуНового(Ссылка);
			ОбъектПоГуиду.УстановитьНовыйКод();
			ОбъектПоГуиду.Записать();
			к=к+1;  
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОбьектПоГУИДу(Команда)
	СоздатьОбьектПоГУИДуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗапросОборотыНаСервере()
	МассивДляЗагрузки 	= Новый Массив;
	Рез 				= Новый Массив; 
	МассивДляЗагрузкиРС = Новый Массив; 
 
	
	ЗапросПараметры = Новый Структура;
	ЗапросПараметры.Вставить("НачалоПериода",Период.ДатаНачала);
	ЗапросПараметры.Вставить("КонецПериода",КонецДня(Период.ДатаОкончания));  
	ЗапросПараметры.Вставить("Организация",Организация); 
	//ЗапросПараметры.Вставить("Регистратор",Документы.АвансовыйОтчет.НайтиПоНомеру("ТОУХ-000002",Дата('2018.03.01 00:00:00'))); 
	
	ЗапросТекст = 
	"ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &КонецПериода, Регистратор, , , Организация В ИЕРАРХИИ (&Организация), , ) КАК ХозрасчетныйОбороты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Субконто1
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &КонецПериода, Регистратор, , , Организация В ИЕРАРХИИ (&Организация), , ) КАК ХозрасчетныйОбороты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Субконто2
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &КонецПериода, Регистратор, , , Организация В ИЕРАРХИИ (&Организация), , ) КАК ХозрасчетныйОбороты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Субконто3
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &КонецПериода, Регистратор, , , Организация В ИЕРАРХИИ (&Организация), , ) КАК ХозрасчетныйОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблица.Регистратор КАК Регистратор
	|ИЗ
	|	ВременнаяТаблица КАК ВременнаяТаблица
	|
	|СГРУППИРОВАТЬ ПО
	|	ВременнаяТаблица.Регистратор";
	
	
	//мИзмерения = СтрРазделить("Организация, Подразделение, Счет, Субконто1, Субконто2, Субконто3, КорСчет, Регистратор, СуммаОборотДт, СуммаОборотКт, СуммаНУОборотДт, СуммаНУОборотКт, СуммаПРОборотДт, СуммаПРОборотКт, СуммаВРОборотДт, СуммаВРОборотКт", ", ", Ложь);
	мИзмерения = СтрРазделить("Регистратор",",",Ложь);
	
	Если ВыполнитьЗапросОбщийМодуль Тогда
		 
		Если ВыбратьОбъектНеНайден  Тогда
		     МассивДляЗагрузки =	ОбменДаннымиПереопределяемый.ВыполнитьЗапросОбъектНеНайденСервер(ЗапросПараметры,ВыбратьОбъектНеНайден);  
		 Иначе 
			 МассивДляЗагрузки =	ОбменДаннымиПереопределяемый.ВыполнитьЗапрос(ЗапросТекст, ЗапросПараметры, мИзмерения);
		КонецЕсли;
		
	Иначе
		МассивДляЗагрузки =	ВыполнитьЗапросОбороты(ЗапросТекст,ЗапросПараметры,мИзмерения); 
		МассивДляЗагрузкиРС = СобратьИзРС(Организация,МассивДляЗагрузкиРС);
	КонецЕсли;
	
	Если Отчет Тогда
		Если МассивДляЗагрузки.Количество()>0  Тогда
			Рез =	  КоличествоОбъектовПоТипу(МассивДляЗагрузки); 	
		КонецЕсли;
		
		СписокОбъектов.Очистить();
		ТвояОбласть    = СписокОбъектов.ПолучитьОбласть();
		к=2;
		ТвояОбласть.Область(1,1,1,1).Текст =  "Вид";
		ТвояОбласть.Область(1,2,1,2).Текст =  "Тип";
		ТвояОбласть.Область(1,3,1,3).Текст =  "Иерархия";
		ТвояОбласть.Область(1,4,1,4).Текст = "Владелец";
		ТвояОбласть.Область(1,5,1,5).Текст =  "Организация";
		ТвояОбласть.Область(1,6,1,6).Текст =  "Ссылка";
		
		Для каждого эл  Из Рез  Цикл
			ТвояОбласть.Область(к,1,к,1).Текст =  эл.Вид;
			ТвояОбласть.Область(к,2,к,2).Текст =  эл.Тип;
			ТвояОбласть.Область(к,3,к,3).Текст =  эл.Иерархия;
			ТвояОбласть.Область(к,4,к,4).Текст =  эл.Владелец;
			ТвояОбласть.Область(к,5,к,5).Текст =  эл.Организация;
			ТвояОбласть.Область(к,6,к,6).Текст =  эл.Ссылка;
			к=к+1;
		КонецЦикла;
		
		Для каждого эл Из МассивДляЗагрузкиРС Цикл
			ТвояОбласть.Область(к,1,к,1).Текст =  эл;
			к=к+1;
		КонецЦикла;	
		СписокОбъектов.Вывести(ТвояОбласть);
	КонецЕсли;	
	
	Для каждого эл  Из  МассивДляЗагрузки Цикл
		новаястрока = НайденныеОбъекты.Добавить();
