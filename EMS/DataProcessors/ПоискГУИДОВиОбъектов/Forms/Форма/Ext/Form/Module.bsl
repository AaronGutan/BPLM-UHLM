Функция КоличествоОбъектовПоТипу(МассивДляЗагрузки)
	
	оОписание = ПолучитьОписаниеТиповДляТаблицыЗначениий();
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	сОписание = Новый ОписаниеТипов(МассивТипов);  
	
	бМассивТипов = Новый Массив;
	бМассивТипов.Добавить(Тип("Булево"));
	бОписание = Новый ОписаниеТипов(бМассивТипов);
	
	НоваяТЗ = Новый ТаблицаЗначений;
	НоваяТЗ.Колонки.Добавить("Ссылка",оОписание);  
	НоваяТЗ.Колонки.Добавить("Вид",сОписание);
	НоваяТЗ.Колонки.Добавить("Тип",сОписание); 
	НоваяТЗ.Колонки.Добавить("Иерархия",сОписание);
	НоваяТЗ.Колонки.Добавить("Владелец",сОписание); 
	НоваяТЗ.Колонки.Добавить("Организация",бОписание);

	Для Каждого Строка Из МассивДляЗагрузки Цикл 
		СтрокаНоваяТЗ = НоваяТЗ.Добавить();
		СтрокаНоваяТЗ.Ссылка =  Строка;       
		СтрокаНоваяТЗ.Вид 	 = ВидОбъектаПоСсылке(Строка);
		м = Строка.Метаданные(); 
		СтрокаНоваяТЗ.Тип =    м.Имя;
		Дерево = "";
		Владелец = "";	
		ЕстьОрганизация = Ложь;
		
		ТипЗначения = ТипЗнч(Строка);
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения); 
		Если  Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
			Если м.Владельцы.Количество()>0 Тогда
				Владелец = "Владелец";
			Иначе
				Владелец = "";	
			КонецЕсли;
			
			Если  м.Иерархический Тогда
				Дерево = "Родитель";  
			Иначе 
				Дерево = "";	
			КонецЕсли;
			СтрокаНоваяТЗ.Иерархия = Дерево;
			СтрокаНоваяТЗ.Владелец = Владелец;  
		КонецЕсли; 
		
		Если  Метаданные.Справочники.Содержит(ОбъектМетаданных) или Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
			р = м.Реквизиты;
			ЕстьОрганизация  =     НайтиРеквизитОрганизация(р);
			
			Если ЕстьОрганизация Тогда
				СтрокаНоваяТЗ.Организация = ЕстьОрганизация;  
			Иначе 
				СтрокаНоваяТЗ.Организация = ЕстьОрганизация;  
			КонецЕсли; 
		КонецЕсли;
		
	КонецЦикла;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаСсылок.Ссылка КАК Ссылка,
	|	ВЫРАЗИТЬ(ТаблицаСсылок.Вид КАК СТРОКА(150)) КАК Вид,
	|	ВЫРАЗИТЬ(ТаблицаСсылок.Тип КАК СТРОКА(150)) КАК Тип,
	|	ВЫРАЗИТЬ(ТаблицаСсылок.Иерархия КАК СТРОКА(150)) КАК Иерархия,
	|	ВЫРАЗИТЬ(ТаблицаСсылок.Владелец КАК СТРОКА(150)) КАК Владелец,
	|	ВЫРАЗИТЬ(ТаблицаСсылок.Организация КАК БУЛЕВО) КАК Организация
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТаблицаСсылок КАК ТаблицаСсылок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Вид КАК Вид,
	|	ВТ.Тип КАК Тип,
	|	ВТ.Иерархия КАК Иерархия,
	|	ВТ.Владелец КАК Владелец,
	|	ВТ.Организация КАК Организация,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ.Ссылка) КАК Ссылка
	|ИЗ
	|	ВТ КАК ВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Вид,
	|	ВТ.Тип,
	|	ВТ.Иерархия,
	|	ВТ.Владелец,
	|	ВТ.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ";
	
	Запрос.УстановитьПараметр("ТаблицаСсылок",НоваяТЗ);
	РезультатЗапроса = Запрос.Выполнить();
	//МенеджерВТ.Закрыть();
	
	Возврат Запрос.Выполнить().Выгрузить();	
	
КонецФункции // КоличествоОбъектовПоТипу()

