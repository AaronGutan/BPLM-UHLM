&НаСервере
Процедура ВосстановитьБитыеСсылкиСервер()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦТ_ОбъектыОбмен.ОбъектВнутр КАК ОбъектВнутр
	|ИЗ
	|	РегистрСведений.ЦТ_ОбъектыОбмен КАК ЦТ_ОбъектыОбмен
	|ГДЕ
	//|	ЦТ_ОбъектыОбмен.ВИсточникеНет = ИСТИНА   И
	|  ЦТ_ОбъектыОбмен.БылВосстановлен = ЛОЖЬ";
	
	Если ВосстановитьОбъектыВДочке Тогда
		
		Запрос.Текст =  СтрЗаменить(Запрос.Текст,  "ЦТ_ОбъектыОбмен.БылВосстановлен = ЛОЖЬ", "ЦТ_ОбъектыОбмен.ВИсточникеНет = ИСТИНА   И   ЦТ_ОбъектыОбмен.БылВосстановлен = ЛОЖЬ");
	
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	эл = РезультатЗапроса.Выбрать();
	сч = 0;	
	Пока эл.Следующий() Цикл
		Если сч>0  Тогда
			//Прервать;	
		КонецЕсли;	
		МенеджерЗаписи = РегистрыСведений.ЦТ_ОбъектыОбмен.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ОбъектВнутр = эл.ОбъектВнутр;   
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.ОбъектСтрока = ЗначениеИзСтрокиВнутр(эл.ОбъектВнутр);
		МенеджерЗаписи.Откуда =  МенеджерЗаписи.Откуда;
		МенеджерЗаписи.ВИсточникеНет =  МенеджерЗаписи.ВИсточникеНет; 
		Попытка
					МенеджерЗаписи.ТипОбъекта = СтрТипЗнч(эл.ОбъектВнутр);  
		Исключение
		     Сообщить("Не типизируется обьект: " + эл.ОбъектВнутр); 
			 Продолжить;
		КонецПопытки;
  
		Если  СсылкаСуществует(ЗначениеИзСтрокиВнутр(эл.ОбъектВнутр)) Тогда
			МенеджерЗаписи.БылВосстановлен = Истина;	
			Попытка
				МенеджерЗаписи.Записать();
			Исключение
				Сообщить("Объект не найден: " + эл + " не записан!");
			КонецПопытки;  
			
			Продолжить;	
		КонецЕсли;
	
		Рез = СоздатьИзГУИДА(ЗначениеИзСтрокиВнутр(эл.ОбъектВнутр),СтрТипЗнч(эл.ОбъектВнутр));
		Если Рез = Истина Тогда
			МенеджерЗаписи.БылВосстановлен = Истина;	
			Попытка
				МенеджерЗаписи.Записать();
			Исключение
				Сообщить("Объект не найден: " + эл + " не записан!");
			КонецПопытки;  
		сч = сч + 1;	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ВосстановитьБитыеСсылкиСервер()

