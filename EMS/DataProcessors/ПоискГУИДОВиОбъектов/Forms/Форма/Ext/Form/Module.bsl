&НаСервере
Процедура ПолучитьГУИДСервер()
	//ГУИД = НайденныеОбъекты[0].Объект.УникальныйИдентификатор ();
	СписокОбъектов.Очистить();
	ТвояОбласть    = СписокОбъектов.ПолучитьОбласть();
	к=1;
	Для каждого эл  Из НайденныеОбъекты  Цикл
		ГУИД = эл.Объект.УникальныйИдентификатор ();
		ТвояОбласть.Область(к,1,к,1).Текст =  ГУИД;
		к=к+1;
	КонецЦикла;
	СписокОбъектов.Вывести(ТвояОбласть);
КонецПроцедуры // ПолучитьГУИДСервер()

