&НаСервере
Процедура ОтчетПоОбъектНеНайденНаСервере()
	    	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЦТ_ОбъектыОбмен.ОбъектВнутр) КАК ОбъектВнутр,
	|	ЦТ_ОбъектыОбмен.ТипОбъекта КАК ТипОбъекта,
	|	ЦТ_ОбъектыОбмен.БылВосстановлен КАК БылВосстановлен
	|ИЗ
	|	РегистрСведений.ЦТ_ОбъектыОбмен КАК ЦТ_ОбъектыОбмен
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦТ_ОбъектыОбмен.ТипОбъекта,
	|	ЦТ_ОбъектыОбмен.БылВосстановлен
	|
	|УПОРЯДОЧИТЬ ПО
	|	БылВосстановлен";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СписокОбъектов.Очистить();
	ТвояОбласть    = СписокОбъектов.ПолучитьОбласть();
	к=2;
	ТвояОбласть.Область(1,1,1,1).Текст =  "ОбъектВнутр";
	ТвояОбласть.Область(1,2,1,2).Текст =  "ТипОбъекта";
	ТвояОбласть.Область(1,3,1,3).Текст =  "БылВосстановлен";
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТвояОбласть.Область(к,1,к,1).Текст =  ВыборкаДетальныеЗаписи.ОбъектВнутр;
		ТвояОбласть.Область(к,2,к,2).Текст =  ВыборкаДетальныеЗаписи.ТипОбъекта;
		ТвояОбласть.Область(к,3,к,3).Текст =  ВыборкаДетальныеЗаписи.БылВосстановлен;
		к=к+1;
	КонецЦикла;
	СписокОбъектов.Вывести(ТвояОбласть);

	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА

КонецПроцедуры

