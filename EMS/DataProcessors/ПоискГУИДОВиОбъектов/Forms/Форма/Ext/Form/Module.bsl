Процедура ПоДокументамБезПроводокНаСервере()
	мРезультатРС = Новый Массив;
    мРезультат = Новый Массив;

	Если ВыполнитьЗапросОбщийМодуль Тогда
		Если РегистрыСведенийСобратьПоМетаданным  Тогда
			  // мРезультат =    ОбменДаннымиПереопределяемый.цМетаданныеНаСервереРС(ВыбратьОбъектНеНайден);
		Иначе 
			   //мРезультат =    ОбменДаннымиПереопределяемый.цМетаданныеНаСервере(ВыбратьОбъектНеНайден);
		КонецЕсли;
	Иначе 
			Для каждого м Из Метаданные.Документы Цикл
				Если не  м.Имя = "ПлатежноеПоручение" Тогда       //тест
					 Продолжить;
				КонецЕсли;
				
				ЗапросТекст = "";
				ЗапросТекст = ТекстЗапроса("Документы",м.Имя);
				Запрос	= Новый Запрос;
				Запрос.Текст = ЗапросТекст;
				Выборка = Запрос.Выполнить().Выбрать();
				сч = 0;	    
				Пока Выборка.Следующий() Цикл
						сч = МетаданныеОбъекта(Выборка.Ссылка,сч,мРезультат);
						сч=сч+1;
				КонецЦикла;
				
				тМассив = Запрос.Выполнить().Выгрузить();     
				Сообщить(""+м.Имя+":"+тМассив.Количество()); 
			КонецЦикла; 
 
	КонецЕсли;
	
	СписокОбъектов.Очистить();
	ТвояОбласть    = СписокОбъектов.ПолучитьОбласть();
	Колонка=1;
	сч = 1;
	Для каждого эл Из мРезультатРС Цикл
		ТвояОбласть.Область(сч,Колонка,сч,Колонка).Текст = эл;
		сч = сч + 1;
	КонецЦикла; 
	СписокОбъектов.Вывести(ТвояОбласть);
	
	СвернутыйМассив = Новый Массив;
	Для каждого Элемент Из мРезультат Цикл
		Если СвернутыйМассив.Найти(Элемент) = Неопределено Тогда
			СвернутыйМассив.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Сообщить("СвернутыйМассив:" + СвернутыйМассив.Количество());
	
	
	//МассивДляЗагрузки =	ОбменДаннымиПереопределяемый.ВыполнитьЗапросОбъектНеНайден(ЗапросПараметры);
	НайденныеОбъекты.Очистить();
	Для каждого эл  Из  СвернутыйМассив Цикл
		новаястрока = НайденныеОбъекты.Добавить();
		Если СтрокуВнутр Тогда
			новаястрока.Объект = ЗначениеИзСтрокиВнутр(эл);
		Иначе 
			новаястрока.Объект = эл;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

