Процедура УдалитьНепосредственно()
	Для каждого эл Из НайденныеОбъекты Цикл
		Об =  эл.Объект.ПолучитьОбъект(); 
		Об.ОбменДанными.Загрузка = Истина;
		Об.Удалить();
	КонецЦикла; 
	Для каждого эл Из Буфер Цикл
		Если   СтрНайти(Строка(ТипЗнч(эл.Значение)),"Регистр сведений")>0 Тогда
			МенеджерЗаписи =  РегистрыСведений[Вид].СоздатьМенеджерЗаписи();  
			//МенеджерЗаписи.Заполнить(эл.Значение);     
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, эл.Значение);
			
			//Если  МенеджерЗаписи.Прочитать() Тогда
				МенеджерЗаписи.Удалить(); 
			//КонецЕсли;
		ИначеЕсли   МетаданныеТип(эл.Значение) = "Справочник" Тогда
			Об =  эл.Значение.ПолучитьОбъект(); 
			Об.ОбменДанными.Загрузка = Истина;
			Об.Удалить();
		КонецЕсли;
	КонецЦикла;
	Буфер.Очистить();
	НайденныеОбъекты.Очистить();	
КонецПроцедуры // УдалитьНепосредственно()     


