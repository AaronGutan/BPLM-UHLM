&НаСервере
Функция Орг(ИД)
	Если      ИД = "" Тогда
		Возврат Справочники.Организации.ПустаяСсылка();
	ИначеЕсли ИД = "ДД_ИС" Тогда
		Возврат XMLЗначение(Тип("CatalogRef.Организации"), "339f85b9-e23d-11ec-80db-005056014a17");
	ИначеЕсли ИД = "ДД_МЦП" Тогда
		Возврат XMLЗначение(Тип("CatalogRef.Организации"), "30e6d974-e9a7-11ec-80db-005056014a17");
	ИначеЕсли ИД = "ДД_ТЗ" Тогда
		Возврат XMLЗначение(Тип("CatalogRef.Организации"), "9cec02c1-a5cf-11ec-80d8-005056014a17");
	ИначеЕсли ИД = "ДД_ИМ" Тогда
		Возврат XMLЗначение(Тип("CatalogRef.Организации"), "d062db69-e513-11ec-80db-005056014a17");
	ИначеЕсли ИД = "ДД_ДД" Тогда
		Возврат XMLЗначение(Тип("CatalogRef.Организации"), "364d726d-9fa4-11ec-80d8-005056014a17");
	ИначеЕсли ИД = "ДД" Тогда
		Рез = Новый Массив;
		Рез.Добавить(Орг("ДД_ИС"));
		Рез.Добавить(Орг("ДД_МЦП"));
		Рез.Добавить(Орг("ДД_ТЗ"));
		Рез.Добавить(Орг("ДД_ИМ"));
		Рез.Добавить(Орг("ДД_ДД"));
		Возврат Рез;
	ИначеЕсли ИД = "ДД+" Тогда
		Рез = Новый Массив;
		Рез.Добавить(Орг("ДД_ИС"));
		Рез.Добавить(Орг("ДД_МЦП"));
		Рез.Добавить(Орг("ДД_ТЗ"));
		Возврат Рез;
	ИначеЕсли ИД = "ОТ" Тогда	
		Возврат XMLЗначение(Тип("CatalogRef.Организации"), "73c02013-d82d-11ec-80da-005056014a17");	
	ИначеЕсли ИД = "ТОТ" Тогда	
		Возврат XMLЗначение(Тип("CatalogRef.Организации"), "fa5f4157-98d4-11ed-8b1e-7cb27df52e94");
	ИначеЕсли ИД = "ТОТ_К" Тогда	
		Возврат XMLЗначение(Тип("CatalogRef.Организации"), " ");	
	ИначеЕсли ИД = "ДЛГ" Тогда	
		Возврат XMLЗначение(Тип("CatalogRef.Организации"), "a5cce63b-bbf8-11ed-8105-005056014a17");	
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

