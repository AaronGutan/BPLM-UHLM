&НаСервере
Процедура СтрокаВнутрАнализ(СтрВн, Смв = "", Тип = "", Код = "", УИД = "")
	Смв = ""; Тип = ""; Код = ""; УИД = "";
	
	мСтр = СтрРазделить(Сред(СтрВн, 2, СтрДлина(СтрВн) - 2), ",", Истина);
	КолВо = мСтр.Количество();
	
	Смв = Сред(мСтр[0], 2, 1);
	
	Если КолВо < 2 Тогда
		Возврат;
	КонецЕсли;
	
	Тип = мСтр[1];
	
	Если КолВо < 3 Тогда
		Возврат;
	КонецЕсли;
	
	мКодУИД = СтрРазделить(мСтр[2], ":", Истина);
	Код = мКодУИД[0];
	УИД = мКодУИД[1];
КонецПроцедуры

&НаСервере
Функция ПолучитьРодителяРекурсия(Ссылка,сРодители,Вид,Дерево)
	Тип = "Справочник";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	"+Вид+"."+Дерево+" КАК "+Дерево+"
	|ИЗ
	|	"+Тип+"."+Вид+" КАК "+Вид+"
	|ГДЕ
	|	"+Вид+".Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи[Дерево])  Тогда
			Если СтрокуВнутр  Тогда
				сРодители.Добавить(ЗначениеВСтрокуВнутр(ВыборкаДетальныеЗаписи[Дерево]));
			Иначе
				сРодители.Добавить(ВыборкаДетальныеЗаписи[Дерево]); 
			КонецЕсли;  
			Если Дерево = "Родитель"  Тогда
				ПолучитьРодителяРекурсия(ВыборкаДетальныеЗаписи.Родитель,сРодители,Вид,Дерево);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат  сРодители;
	
КонецФункции

&НаСервере
Функция МДИзмерения(Знач Тип, Вид)
	
	мИзмерения = Новый Массив;
	
	Если      Тип = "Константы" Тогда
		//Если Внешняя Тогда // ? Запрос ?
		//	Возврат Подключение.Константы[Вид].Получить();
		//Иначе
		//	Возврат Подключение.Константы[Вид].Получить();
		//КонецЕсли;
	ИначеЕсли Тип = "Справочники" Или Тип = "Документы" Или Тип = "ПланыВидовХарактеристик" Тогда
		мИзмерения.Добавить("Ссылка");
		
	ИначеЕсли Тип = "РегистрыСведений" или Тип = "РегистрСведений" Тогда  
		Тип = "РегистрыСведений";
		#Если НаКлиенте Тогда
			МД = Подключение.Метаданные[Тип][Вид];
			Независимый = Подключение.Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый;
			Непериодический = Подключение.Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
		#Иначе
			МД = Метаданные[Тип][Вид];
			Независимый = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый;
			Непериодический = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
		#КонецЕсли
		
		Для Каждого ТекИзм Из МД.Измерения Цикл
			Если Тип = "РегистрыСведений" И Не ТекИзм.ОсновнойОтбор Тогда
				Продолжить;
			КонецЕсли;
			мИзмерения.Добавить(ТекИзм.Имя);
		КонецЦикла;
		
		Если Тип = "РегистрыСведений" Тогда
			Если Не МД.РежимЗаписи = Независимый Тогда
				мИзмерения.Добавить("Регистратор");
			КонецЕсли;
			Если МД.ПериодичностьРегистраСведений <> Непериодический Тогда
				мИзмерения.Добавить("Период");
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		мИзмерения.Добавить("Регистратор");
		
	ИначеЕсли Тип = "Последовательности" Тогда
		мИзмерения.Добавить("Организация"); // ?
		мИзмерения.Добавить("Регистратор");
		мИзмерения.Добавить("Период");
		мИзмерения.Добавить("МоментВремени");
		мИзмерения.Добавить("СостояниеПроведения");
		
	КонецЕсли;
	
	Возврат мИзмерения;
КонецФункции

&НаСервере
Функция ТекстЗапроса(Тип,Вид)  //количество объектов
	
	Результат = "";    
	
	Если ОтчетТипыДанных  Тогда
	    Результат = "Количество";
	КонецЕсли;
	
	Если Результат = "Количество" Тогда
		мИзмерения = Новый Массив;
		мИзмерения.Добавить("Количество");
	Иначе
		мИзмерения = МДИзмерения(Тип, Вид);
	КонецЕсли;
	//Рез.Вставить("Поля", мИзмерения);
	
	Если Тип = "Справочники" Тогда
		Тип = "Справочник";
	ИначеЕсли Тип = "Документы"  Тогда 
		 Тип = "Документ";
	ИначеЕсли Тип = "РегистрыСведений"  Тогда 
		 Тип = "РегистрСведений";
	КонецЕсли;

	ЗапросТекст = 
	"ВЫБРАТЬ // Первые 100
	|	" + ?(Результат = "Количество", "Сумма(1) КАК Количество", СтрСоединить(мИзмерения, ", ")) + "
	|ИЗ
	|	" + Тип + "." + Вид + "
	|";
	
	ЗапросПараметры = Новый Структура;
	
	//ЗапросТекст = ЗапросТекст + ЗапросУсловие(Тип, Вид, РеквОрг, ОргИд, Рекурсия, ЗапросПараметры);
	Возврат ЗапросТекст;
	
КонецФункции // ТекстЗапроса()  

