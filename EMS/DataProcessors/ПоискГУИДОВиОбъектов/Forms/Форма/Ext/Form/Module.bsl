&НаСервере
Функция МетаданныеОбъекта(ВыбОбъект,сч,мРезультат)
	сч = МетаданныеРеквизиты(ВыбОбъект,сч,мРезультат);
	
	Если ТипЗнч(ВыбОбъект)=Тип("Число") или ТипЗнч(ВыбОбъект)=Тип("Строка")
		или ТипЗнч(ВыбОбъект)=Тип("Булево") или ТипЗнч(ВыбОбъект)=Тип("Неопределено")
		или ТипЗнч(ВыбОбъект)=Тип("Дата") или ТипЗнч(ВыбОбъект)=Тип("Null")
		или  ТипЗнч(ВыбОбъект)=Тип("ХранилищеЗначения") или ТипЗнч(ВыбОбъект)=Тип("УникальныйИдентификатор")
		Тогда
		Возврат сч;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(ВыбОбъект);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения); 
	Если Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
		Возврат сч;
	КонецЕсли;	
	
	мИменаТЧ  = ВыбОбъект.Метаданные().ТабличныеЧасти;
	Для каждого эл Из  мИменаТЧ Цикл
		Для каждого мСтрокаТЧ Из ВыбОбъект[эл.Имя] Цикл
			Для каждого   мКолонкаТабЧасти Из эл.Реквизиты  Цикл  
				зн = мСтрокаТЧ[мКолонкаТабЧасти.Имя];
				сч = МетаданныеРеквизиты(зн,сч,мРезультат);	
			КонецЦикла;	
			
		КонецЦикла;	
	КонецЦикла;
	
	Возврат сч;
КонецФункции // МетаданныеОбъекта()

&НаСервере
Функция МетаданныеРеквизиты(ВыбОбъект,сч,мРезультат)
	Попытка
		Если ТипЗнч(ВыбОбъект)=Тип("Число") или ТипЗнч(ВыбОбъект)=Тип("Строка")
			или ТипЗнч(ВыбОбъект)=Тип("Булево") или ТипЗнч(ВыбОбъект)=Тип("Неопределено")
			или ТипЗнч(ВыбОбъект)=Тип("Дата") или ТипЗнч(ВыбОбъект)=Тип("Null") 
			или  ТипЗнч(ВыбОбъект)=Тип("ХранилищеЗначения") или ТипЗнч(ВыбОбъект)=Тип("УникальныйИдентификатор")
			Тогда
			Возврат сч;
		КонецЕсли;
		ТипЗначения = ТипЗнч(ВыбОбъект);
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения); 
		Если Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
			Возврат сч;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ВыбОбъект) Тогда
			Если ВыбратьОбъектНеНайден Тогда
				Если Не СсылкаСуществует(ВыбОбъект) Тогда
					Если СтрокуВнутр Тогда 
						Если мРезультат.Найти(ВыбОбъект) = Неопределено Тогда
							мРезультат.Добавить(ЗначениеВСтрокуВнутр(ВыбОбъект));
							сч= сч+1;	
						КонецЕсли;
					Иначе 
						Если мРезультат.Найти(ВыбОбъект) = Неопределено Тогда
							мРезультат.Добавить(ВыбОбъект);
							сч= сч+1;  
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			Иначе 
				Если СтрокуВнутр Тогда
					Если мРезультат.Найти(ВыбОбъект) = Неопределено Тогда
						мРезультат.Добавить(ЗначениеВСтрокуВнутр(ВыбОбъект));
						сч= сч+1; 
					КонецЕсли;
				Иначе 	
					Если мРезультат.Найти(ВыбОбъект) = Неопределено Тогда
						мРезультат.Добавить(ВыбОбъект);
						сч= сч+1;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
		
		ВыбМетаданные = ВыбОбъект.Метаданные().Реквизиты;
		Для каждого эл Из ВыбМетаданные Цикл
			ПроверяемыйОбъект = ВыбОбъект[эл.Имя];       //вот это можно запихнуть в рекурсию в эту же функцию
			Попытка
				Если ТипЗнч(ПроверяемыйОбъект)=Тип("Число") или ТипЗнч(ПроверяемыйОбъект)=Тип("Строка")
					или ТипЗнч(ПроверяемыйОбъект)=Тип("Булево") или ТипЗнч(ПроверяемыйОбъект)=Тип("Неопределено")
					или ТипЗнч(ПроверяемыйОбъект)=Тип("Дата") или ТипЗнч(ПроверяемыйОбъект)=Тип("Null")
					или ТипЗнч(ПроверяемыйОбъект)=Тип("ХранилищеЗначения") или ТипЗнч(ПроверяемыйОбъект)=Тип("УникальныйИдентификатор") 
					Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(ПроверяемыйОбъект) Тогда
					Если ВыбратьОбъектНеНайден Тогда
						Если Не СсылкаСуществует(ПроверяемыйОбъект) Тогда
							Если СтрокуВнутр Тогда  
								Если мРезультат.Найти(ПроверяемыйОбъект) = Неопределено Тогда
									мРезультат.Добавить(ЗначениеВСтрокуВнутр(ПроверяемыйОбъект));
									сч= сч+1; 
								КонецЕсли;
							Иначе 	
								Если мРезультат.Найти(ПроверяемыйОбъект) = Неопределено Тогда
									мРезультат.Добавить(ПроверяемыйОбъект);
									сч= сч+1;   
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					Иначе 
						Если СтрокуВнутр Тогда
							Если мРезультат.Найти(ПроверяемыйОбъект) = Неопределено Тогда
								мРезультат.Добавить(ЗначениеВСтрокуВнутр(ПроверяемыйОбъект));
								сч= сч+1;
							КонецЕсли;
						Иначе 	
							Если мРезультат.Найти(ПроверяемыйОбъект) = Неопределено Тогда
								мРезультат.Добавить(ПроверяемыйОбъект);
								сч= сч+1; 
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			Исключение
				
			КонецПопытки;
		КонецЦикла;   
	Исключение
		
	КонецПопытки;
	Возврат сч; 
КонецФункции // МетаданныеРеквизиты()

&НаСервере
Функция МетаданныеТип(ВыбОбъект)
	ТипМетаданных = "";
	Если ТипЗнч(ВыбОбъект)=Тип("Число") или ТипЗнч(ВыбОбъект)=Тип("Строка")
		или ТипЗнч(ВыбОбъект)=Тип("Булево") или ТипЗнч(ВыбОбъект)=Тип("Неопределено")
		или ТипЗнч(ВыбОбъект)=Тип("Дата") или ТипЗнч(ВыбОбъект)=Тип("Null") 
		или  ТипЗнч(ВыбОбъект)=Тип("ХранилищеЗначения") или ТипЗнч(ВыбОбъект)=Тип("УникальныйИдентификатор")
		Тогда
		Возврат "Неопределено";
	КонецЕсли;
	ТипЗначения = ТипЗнч(ВыбОбъект);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения); 
	Если Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
		ТипМетаданных	= "Перечисление";
	ИначеЕсли Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		ТипМетаданных	= "Справочник";	
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных) Тогда
		ТипМетаданных	= "РегистрСведений";	
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		ТипМетаданных	= "Документ";	
	КонецЕсли;
	Возврат ТипМетаданных;
КонецФункции
	
