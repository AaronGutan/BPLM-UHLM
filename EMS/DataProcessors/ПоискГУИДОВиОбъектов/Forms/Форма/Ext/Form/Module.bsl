Функция УпкаоватьСоставОбъекта(м,СодержаниеОбьекта)
	
	мРеквизиты = м.Реквизиты;
	
	Если      ТипЗнч(мРеквизиты) = Тип("КоллекцияОбъектовМетаданных") Тогда
		Рез = Новый Структура;
		Для Каждого Стр Из мРеквизиты Цикл
			НоваяСтрока = СодержаниеОбьекта.Добавить();  
			НоваяСтрока.ОбъектМетаданных  =   Стр.Имя;
			НоваяСтрока.Представление     =   Стр.Синоним;
			ТипД                          =   Стр.Тип.Типы()[0];
			Если Метаданные.НайтиПоТипу(ТипД)<> Неопределено  Тогда
				
				Если  Метаданные.Справочники.Содержит(Метаданные.НайтиПоТипу(ТипД)) Тогда
					НоваяСтрока.Вид               =   "Справочники";	
					
					//Пустая = Справочники[Стр.Имя].ПустаяСсылка();
					//ОбъектМетаданных =   Справочники; 
					//ТипXml = СтрТипЗнч((ЗначениеВСтрокуВнутр(ОбъектМетаданных[Стр.Имя].ПустаяСсылка())));
				КонецЕсли;			
				
			ИначеЕсли ТипД = Тип("Строка") Тогда  
					НоваяСтрока.Вид               =   "Строка";
			ИначеЕсли ТипД = Тип("Булево") Тогда  
					НоваяСтрока.Вид               =   "Булево";
			ИначеЕсли ТипД = Тип("Число") Тогда  
					НоваяСтрока.Вид               =   "Число";
		
			Иначе
				    НоваяСтрока.Вид               =   "Неопределен";	
			КонецЕсли;
						
