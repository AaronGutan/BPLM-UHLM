&НаКлиенте
Процедура ИзДетальнойВедомости(Команда)
	Попытка
		ФормаДВ = ПолучитьФорму("ВнешняяОбработка.ДетальныеВедомости.Форма");
	Исключение
		Предупреждение("Ошибка открытия формы ""Детальные ведомости""" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Для Каждого Рег Из ФормаДВ.ПолучитьРегистраторы() Цикл
		НоваяСтрока = НайденныеОбъекты.Добавить();
		НоваяСтрока.Объект =  Рег;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзОбъектаНаСервере()
	
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НематериальныеАктивы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НематериальныеАктивы КАК НематериальныеАктивы";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	НайденныеОбъекты.Очистить();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока =   НайденныеОбъекты.Добавить();  
		НоваяСтрока.Объект = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	
КонецПроцедуры

