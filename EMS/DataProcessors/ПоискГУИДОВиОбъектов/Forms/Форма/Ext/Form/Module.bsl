Процедура ОбновитьИменаПредопределенныхДанныхНаСервере()   
	ОбъектПроверяемый = "СтатьиЗатрат";
	Выб  = ОбменДаннымиПереопределяемый.ПолучитьИменаПредопределенныхДанных(ОбъектПроверяемый);	// Вставить содержимое обработчика. 
	
	мРезультат = Новый Массив;
	Для Каждого эл Из Выб Цикл
	  мРезультат.Добавить(эл);
	КонецЦикла;

	
	КС = Новый КвалификаторыСтроки(150);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
	НоваяТЗ = Новый ТаблицаЗначений;
	НоваяТЗ.Колонки.Добавить("ИмяПредопределенныхДанных",ОписаниеТиповС);  
	пСоответствие = Новый Соответствие;

	Для Каждого Строка Из Выб Цикл 
		СтрокаНоваяТЗ = НоваяТЗ.Добавить();
		зн = Справочники.СтатьиЗатрат[Строка];  
		Если Строка = "АмортизационнаяПремия" Тогда
		    пСоответствие.Вставить(Строка,"АмортизационнаяПремия1");
		Иначе 	
			пСоответствие.Вставить(Строка,зн.Наименование);
		КонецЕсли;
		
		//СтрокаНоваяТЗ.ИмяПредопределенныхДанных = Строка;
	КонецЦикла;
	
	Для Каждого Строка Из пСоответствие Цикл 
		зн = Справочники.СтатьиЗатрат[Строка.Ключ];   
		Если зн.Наименование = Строка.Значение Тогда
			Продолжить;
		КонецЕсли; 
		спрОб =  зн.ПолучитьОбъект();  
		спрОб.Наименование = Строка.Значение;
		спрОб.Записать();
	КонецЦикла;
	
	//Возврат пСоответствие;

КонецПроцедуры

