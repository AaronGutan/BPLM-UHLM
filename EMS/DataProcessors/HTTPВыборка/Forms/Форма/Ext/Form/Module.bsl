&НаСервере
Функция ПустойКлючСверки()

	Возврат "{L}";

КонецФункции

// Для сверки Null, Неопределено, пустая ссылка и пустая строка — одно значение.
&НаСервере
Функция ЭтоПустоеЗначениеДляСверки(Зн)

	Если Зн = Неопределено Или Зн = Null Тогда
		Возврат Истина;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Зн);

	Если ТипЗначения = Тип("Строка") Тогда

		Если ПустаяСтрока(Зн) Тогда
			Возврат Истина;
		КонецЕсли;

		Если Зн = "{""L""}" Или Зн = "{L}"
			Или Зн = "{""U""}" Или Зн = "{U}" Тогда
			Возврат Истина;
		КонецЕсли;

		Если Лев(Зн, 1) = "#" Тогда
			УидСтрокой = НРег(Сред(Зн, 2));
			Возврат Не ЗначениеЗаполнено(УидСтрокой)
				Или УидСтрокой = "00000000-0000-0000-0000-000000000000";
		КонецЕсли;

		Если Лев(Зн, 1) = "{" Тогда

			Если СтрНачинаетсяС(Зн, "{""N""") Или СтрНачинаетсяС(Зн, "{""#"",""N""") Тогда
				Возврат Ложь;
			КонецЕсли;

			Уид = УидОбъектаИзСтрокиВнутр(Зн);
			Если Уид = "00000000-0000-0000-0000-000000000000" Тогда
				Возврат Истина;
			КонецЕсли;

			// Пустая ссылка / Null во внутреннем виде без UUID (L, U и т.п.)
			Если Не ЗначениеЗаполнено(Уид) Тогда
				Тело = Сред(Зн, 2, СтрДлина(Зн) - 2);
				Маркер = ВРег(СокрЛП(СтрЗаменить(Лев(Тело, 3), """", "")));
				Если Маркер = "L" Или Маркер = "U" Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;

		Возврат Ложь;

	КонецЕсли;

	Если ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Возврат Не ЗначениеЗаполнено(Зн);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервере
Функция КлючСчетаПоУид(Уид, КодыСчетовПоУид)

	Если КодыСчетовПоУид = Неопределено Или Не ЗначениеЗаполнено(Уид) Тогда
		Возврат Неопределено;
	КонецЕсли;

	КодСчета = КодыСчетовПоУид.Получить(Уид);
	Если КодСчета = Неопределено Тогда
		КодСчета = КодыСчетовПоУид.Получить(НРег(Уид));
	КонецЕсли;

	Если КодСчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат "Счет:" + СокрЛП(Строка(КодСчета));

КонецФункции

&НаСервере
Функция КаноническийКлючЧислаИзЗначения(ЗначениеЧисла)

	Попытка
		Возврат Формат(Число(ЗначениеЧисла), "ЧГ=0; ЧРД=.; ЧН=0");
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаСервере
Функция КаноническийКлючИзСтрокиВнутрЧисла(СтрокаВнутр)

	Тело = Сред(СтрокаВнутр, 2, СтрДлина(СтрокаВнутр) - 2);
	Части = СтрРазделить(Тело, ",", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Представление = СокрЛП(Части[Части.ВГраница()]);
	Представление = СтрЗаменить(Представление, """", "");
	Возврат КаноническийКлючЧислаИзЗначения(Представление);

КонецФункции

&НаСервере
Функция ЗначениеДляКлючаСравнения(Зн, УидПриемникаВУидИсточника = Неопределено, КодыСчетовПоУид = Неопределено)

	Если ЭтоПустоеЗначениеДляСверки(Зн) Тогда
		Возврат ПустойКлючСверки();
	КонецЕсли;

	ТипЗначения = ТипЗнч(Зн);

	Если ТипЗначения = Тип("Число") Тогда
		КлючЧисла = КаноническийКлючЧислаИзЗначения(Зн);
		Возврат ?(КлючЧисла = Неопределено, "0", КлючЧисла);
	КонецЕсли;

	Если ТипЗначения <> Тип("Строка") Тогда
		Попытка
			Возврат ЗначениеДляКлючаСравнения(ЗначениеВСтрокуВнутр(Зн), УидПриемникаВУидИсточника, КодыСчетовПоУид);
		Исключение
			Возврат XMLСтрока(Зн);
		КонецПопытки;
	КонецЕсли;

	Если СтрНачинаетсяС(Зн, "{""N""") Или СтрНачинаетсяС(Зн, "{""#"",""N""") Тогда
		КлючЧисла = КаноническийКлючИзСтрокиВнутрЧисла(Зн);
		Если КлючЧисла <> Неопределено Тогда
			Возврат КлючЧисла;
		КонецЕсли;
	КонецЕсли;

	Уид = "";

	// Формат HTTP/адаптации: #uuid
	Если Лев(Зн, 1) = "#" И СтрДлина(Зн) >= 37 Тогда
		Уид = НРег(Сред(Зн, 2));
	ИначеЕсли Лев(Зн, 1) = "{" Тогда
		Уид = УидОбъектаИзСтрокиВнутр(Зн);
	КонецЕсли;

	Если ЗначениеЗаполнено(Уид) Тогда

		Уид = НРег(Уид);

		Если УидПриемникаВУидИсточника <> Неопределено Тогда
			УидИсточника = УидПриемникаВУидИсточника.Получить(Уид);
			Если УидИсточника = Неопределено Тогда
				УидИсточника = УидПриемникаВУидИсточника.Получить(НРег(Уид));
			КонецЕсли;
			Если УидИсточника <> Неопределено Тогда
				Уид = НРег(УидИсточника);
			КонецЕсли;
		КонецЕсли;

		КлючСчета = КлючСчетаПоУид(Уид, КодыСчетовПоУид);
		Если КлючСчета <> Неопределено Тогда
			Возврат КлючСчета;
		КонецЕсли;

		Возврат "#" + Уид;

	КонецЕсли;

	Если Лев(Зн, 1) = "{" Тогда
		Нормализованная = НормализоватьСтрокуВнутр(Зн);
		Если ЭтоПустоеЗначениеДляСверки(Нормализованная) Тогда
			Возврат ПустойКлючСверки();
		КонецЕсли;
		Если СтрНачинаетсяС(Нормализованная, "{""N""") Тогда
			КлючЧисла = КаноническийКлючИзСтрокиВнутрЧисла(Нормализованная);
			Если КлючЧисла <> Неопределено Тогда
				Возврат КлючЧисла;
			КонецЕсли;
		КонецЕсли;
		Возврат Нормализованная;
	КонецЕсли;

	КлючЧисла = КаноническийКлючЧислаИзЗначения(Зн);
	Если КлючЧисла <> Неопределено Тогда
		Возврат КлючЧисла;
	КонецЕсли;

	Возврат Зн;

КонецФункции

&НаСервере
Функция ПривестиВыборкуКФорматуКлючей(Выборка, УидПриемникаВУидИсточника = Неопределено, КодыСчетовПоУид = Неопределено)

	Результат = Новый Массив;

	Для Каждого СтрокаВыборки Из Выборка Цикл

		НоваяСтрока = Новый Массив;
		Для Каждого Значение Из СтрокаВыборки Цикл
			НоваяСтрока.Добавить(ЗначениеДляКлючаСравнения(Значение, УидПриемникаВУидИсточника, КодыСчетовПоУид));
		КонецЦикла;

		Результат.Добавить(НоваяСтрока);

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ВставитьСоответствиеСторон(СоответствияОбъектов, СтрокаВнешняя, СтрокаЛокальная)

	СтрокаВнешняя = НормализоватьСтрокуВнутр(СтрокаВнешняя);
	СтрокаЛокальная = НормализоватьСтрокуВнутр(СтрокаЛокальная);

	Если ПустаяСтрока(СтрокаВнешняя) Или ПустаяСтрока(СтрокаЛокальная) Тогда
		Возврат;
	КонецЕсли;

	Если СтрокаВнешняя = СтрокаЛокальная Тогда
		Возврат;
	КонецЕсли;

	Если СоответствияОбъектов.ВнешняяВЛокальную.Получить(СтрокаВнешняя) = Неопределено Тогда
		СоответствияОбъектов.ВнешняяВЛокальную.Вставить(СтрокаВнешняя, СтрокаЛокальная);
	КонецЕсли;

	Если СоответствияОбъектов.ЛокальнаяВоВнешнюю.Получить(СтрокаЛокальная) = Неопределено Тогда
		СоответствияОбъектов.ЛокальнаяВоВнешнюю.Вставить(СтрокаЛокальная, СтрокаВнешняя);
	КонецЕсли;

	УидВнешний = НРег(УидОбъектаИзСтрокиВнутр(СтрокаВнешняя));
	УидЛокальный = НРег(УидОбъектаИзСтрокиВнутр(СтрокаЛокальная));

	Если ЗначениеЗаполнено(УидВнешний) Тогда
		Если СоответствияОбъектов.ЛокальнаяСтрокаПоУидПриемника.Получить(УидВнешний) = Неопределено Тогда
			СоответствияОбъектов.ЛокальнаяСтрокаПоУидПриемника.Вставить(УидВнешний, СтрокаЛокальная);
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(УидВнешний) И ЗначениеЗаполнено(УидЛокальный) И УидВнешний <> УидЛокальный Тогда
		Если СоответствияОбъектов.УидПриемникаВУидИсточника.Получить(УидВнешний) = Неопределено Тогда
			СоответствияОбъектов.УидПриемникаВУидИсточника.Вставить(УидВнешний, УидЛокальный);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СтрокаСоответствияИзУИД(ТипИсточника, УникальныйИдентификатор)

	ТипСтр = ТипИсточника;
	Если ТипЗнч(ТипИсточника) <> Тип("Строка") Тогда
		ТипСтр = XMLТип(ТипИсточника).ИмяТипа;
	КонецЕсли;

	УидСтрокой = УникальныйИдентификатор;
	Если ТипЗнч(УникальныйИдентификатор) = Тип("УникальныйИдентификатор") Тогда
		УидСтрокой = Строка(УникальныйИдентификатор);
	КонецЕсли;

	Ссылка = XMLЗначение(Тип(ТипСтр), УидСтрокой);

	Возврат ЗначениеВСтрокуВнутр(Ссылка);

КонецФункции

&НаСервере
Процедура ДобавитьСоответствиеИсточникПриемник(СоответствияОбъектов, СтрокаИсточника, СтрокаПриемника, ЛокальнаяБазаИсточник)

	Если ЛокальнаяБазаИсточник Тогда
		ВставитьСоответствиеСторон(СоответствияОбъектов, СтрокаПриемника, СтрокаИсточника);
	Иначе
		ВставитьСоответствиеСторон(СоответствияОбъектов, СтрокаИсточника, СтрокаПриемника);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОпределитьУзелДляHTTPНаСервере(ТекущийУзел)
	// Для HTTP к УХ нужен код/наименование ЭТОЙ БП (ЭтотУзел), а не узел приёмника.

	ЭтотУзелСсылка = ПланыОбмена[ПланОбмена].ЭтотУзел();

	ТекстЗапроса = "ВЫБРАТЬ
	|	ПланОбмена.Код КАК Код,
	|	ПланОбмена.Наименование КАК Наименование
	|ИЗ
	|	ПланОбмена.[ПланОбмена] КАК ПланОбмена
	|ГДЕ
	|	ПланОбмена.Ссылка = &ЭтотУзел";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[ПланОбмена]", ПланОбмена);

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ЭтотУзел", ЭтотУзелСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Код;
	КонецЕсли;

	Возврат ТекущийУзел;

КонецФункции

&НаСервере
Функция НайтиУзелСМаксимальнымКоличествомСоответствий()
	// На БП соответствия БП↔УХ хранятся под узлом приёмника (IR).

	ТекстЗапроса = "ВЫБРАТЬ
	|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы.Наименование КАК НаименованиеУзла,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	|СГРУППИРОВАТЬ ПО
	|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы.Наименование
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ";

	Запрос = Новый Запрос(ТекстЗапроса);
	Результат = Запрос.Выполнить().Выгрузить();

	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].НаименованиеУзла;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ПолучитьСоответствияОбъектовНаСервере(ЗапросТекст, Узел, ЛокальнаяБазаИсточник)

	СоответствияОбъектов = НоваяСтруктураСоответствийОбъектов();

	ЗапросПроверкиУзла = Новый Запрос;
	ЗапросПроверкиУзла.Текст = ТекстЗапросаПланОбмена_Узел();
	ЗапросПроверкиУзла.УстановитьПараметр("Узел", Узел);

	ВыборкаУзлов = ЗапросПроверкиУзла.Выполнить().Выбрать();
	Если ВыборкаУзлов.Количество() = 0 Тогда
		Возврат СоответствияОбъектов;
	КонецЕсли;

	Запрос = Новый Запрос(ЗапросТекст);
	Запрос.УстановитьПараметр("Узел", Узел);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат СоответствияОбъектов;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл

		УидПриемника = НРег(Строка(Выборка.УникальныйИдентификаторПриемника));
		УидИсточника = НРег(Строка(Выборка.УникальныйИдентификаторИсточника));

		СтрокаПриемника = СтрокаСоответствияИзУИД(Выборка.ТипИсточника, Выборка.УникальныйИдентификаторПриемника);
		СтрокаИсточника = СтрокаСоответствияИзУИД(Выборка.ТипИсточника, Выборка.УникальныйИдентификаторИсточника);

		ДобавитьСоответствиеИсточникПриемник(СоответствияОбъектов, СтрокаИсточника, СтрокаПриемника, ЛокальнаяБазаИсточник);

		Если УидПриемника <> УидИсточника
			И СоответствияОбъектов.УидПриемникаВУидИсточника.Получить(УидПриемника) = Неопределено Тогда
			СоответствияОбъектов.УидПриемникаВУидИсточника.Вставить(УидПриемника, УидИсточника);
		КонецЕсли;

		Если СоответствияОбъектов.ЛокальнаяСтрокаПоУидПриемника.Получить(УидПриемника) = Неопределено Тогда
			СоответствияОбъектов.ЛокальнаяСтрокаПоУидПриемника.Вставить(УидПриемника, СтрокаИсточника);
		КонецЕсли;

	КонецЦикла;

	Возврат СоответствияОбъектов;

КонецФункции

&НаСервере
Процедура ДополнитьКодыСчетовПоУид(КодыСчетовПоУид, УидИлиСтрока, КодСчета)

	Если Не ЗначениеЗаполнено(КодСчета) Тогда
		Возврат;
	КонецЕсли;

	Уид = УидИлиСтрока;
	Если ТипЗнч(УидИлиСтрока) = Тип("Строка") И Лев(УидИлиСтрока, 1) = "{" Тогда
		Уид = УидОбъектаИзСтрокиВнутр(УидИлиСтрока);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Уид) Тогда
		Возврат;
	КонецЕсли;

	Уид = НРег(Уид);
	Если КодыСчетовПоУид.Получить(Уид) = Неопределено Тогда
		КодыСчетовПоУид.Вставить(Уид, СокрЛП(Строка(КодСчета)));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция КодСчетаИзЗначенияПлана(КодСчета)

	Если ЭтоВнутреннееПредставление(КодСчета) Тогда
		Попытка
			КодСчета = ЗначениеИзСтрокиВнутр(КодСчета);
		Исключение
			// оставляем как есть
		КонецПопытки;
	КонецЕсли;

	Если ТипЗнч(КодСчета) = Тип("Массив") И КодСчета.Количество() > 0 Тогда
		КодСчета = КодСчета[КодСчета.ВГраница()];
	КонецЕсли;

	Возврат СокрЛП(Строка(КодСчета));

КонецФункции

&НаСервере
Процедура ДополнитьСоответствияПланСчетовПоКодуНаСервере(СоответствияОбъектов, ПланСчетовВнешний)

	ПланСчетовЛокальный = ПолучитьПланСчетовЛокал();

	Для Каждого ЭлементПлана Из ПланСчетовЛокальный Цикл
		ДополнитьКодыСчетовПоУид(СоответствияОбъектов.КодыСчетовПоУид, ЭлементПлана.Значение, ЭлементПлана.Ключ);
	КонецЦикла;

	Если ПланСчетовВнешний = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаПлана Из ПланСчетовВнешний Цикл

		КодСчета = КодСчетаИзЗначенияПлана(СтрокаПлана.Код);
		СтрокаВнешняя = НормализоватьСтрокуВнутр(СтрокаПлана.Строка);
		СтрокаЛокальная = НормализоватьСтрокуВнутр(ПланСчетовЛокальный.Получить(КодСчета));

		ДополнитьКодыСчетовПоУид(СоответствияОбъектов.КодыСчетовПоУид, СтрокаВнешняя, КодСчета);

		Если Не ЗначениеЗаполнено(СтрокаЛокальная) Тогда
			Продолжить;
		КонецЕсли;

		ВставитьСоответствиеСторон(СоответствияОбъектов, СтрокаВнешняя, СтрокаЛокальная);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДополнитьСоответствияИзПодготовленныхСтрок(СоответствияОбъектов, мРезультат, ЛокальнаяБазаИсточник)

	Для Каждого мСтр Из мРезультат Цикл

		СтрокаПриемника = НормализоватьСтрокуВнутр(мСтр[0]);
		СтрокаИсточника = НормализоватьСтрокуВнутр(мСтр[1]);
		ДобавитьСоответствиеИсточникПриемник(СоответствияОбъектов, СтрокаИсточника, СтрокаПриемника, ЛокальнаяБазаИсточник);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СобратьСоответствияОбъектов(ЗапросТекст, Узел, ЛокальнаяБазаИсточник, ДанныеОтветаHTTP, ПланСчетовВнешний)

	СоответствияОбъектов = ПолучитьСоответствияОбъектовНаСервере(ЗапросТекст, Узел, ЛокальнаяБазаИсточник);

	Если ДанныеОтветаHTTP <> Неопределено Тогда
		// Данные с УХ: Источник = объект УХ, Приемник = объект БП → ЛокальнаяБазаИсточник = Ложь.
		ДополнитьСоответствияИзПодготовленныхСтрок(СоответствияОбъектов, ДанныеОтветаHTTP, Ложь);
	КонецЕсли;

	ДополнитьСоответствияПланСчетовПоКодуНаСервере(СоответствияОбъектов, ПланСчетовВнешний);

	Возврат СоответствияОбъектов;

КонецФункции

&НаКлиенте
Функция ТекстЗапросаСоответствийОбъектов(ТолькоОтличия)

	ЗапросТекст = "ВЫБРАТЬ
	|	СоответствияОбъектовИнформационныхБаз.ТипИсточника КАК ТипИсточника,
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника КАК УникальныйИдентификаторПриемника,
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточникаСтрокой КАК УникальныйИдентификаторИсточника
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	|ГДЕ
	|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы В
	|			(" + ТекстЗапросаПланОбмена() + ")
	|	И СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы В
	|			(" + ТекстЗапросаПланОбмена_Узел() + ")";

	Если ТолькоОтличия Тогда
		ЗапросТекст = ЗапросТекст
		+ "
	|	И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника <> СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточникаСтрокой";
	КонецЕсли;

	Возврат ЗапросТекст;

КонецФункции

&НаКлиенте
Функция ПолучитьПланСчетовВнешнийHTTP()

	Если Не поHTTP Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("ЗапросТекст",
		"ВЫБРАТЬ
		|	Хозрасчетный.Код КАК Код,
		|	Хозрасчетный.Ссылка КАК Ссылка
		|ИЗ
		|	ПланСчетов.Хозрасчетный КАК Хозрасчетный");
	ДанныеЗапроса.Вставить("ЗапросПараметры", Новый Структура);
	ДанныеЗапроса.Вставить("Поля", СтрРазделить("Код, Ссылка", ", ", Ложь));

	ВыборкаHTTPСохраненное = ВыборкаHTTP;
	ВыборкаHTTP = "Объекты";

	Рез = ЗапросКБазеПриемнику("", ДанныеЗапроса, "");

	ВыборкаHTTP = ВыборкаHTTPСохраненное;

	Если Рез = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Рез) <> Тип("Массив") Или Рез.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПланСчетовВнешний = Новый Массив;
	Для Каждого СтрокаПлана Из Рез[0] Цикл
		ПланСчетовВнешний.Добавить(Новый Структура("Код, Строка", СтрокаПлана[0], СтрокаПлана[1]));
	КонецЦикла;

	Возврат ПланСчетовВнешний;

КонецФункции

&НаКлиенте
Функция ПолучитьСоответствияОбъектов1(ТолькоОтличия = Истина, Новые = Ложь) Экспорт

	Если КэшСоответствияОбъектовИнформационныхБаз <> Неопределено И Не Новые Тогда
		Возврат КэшСоответствияОбъектовИнформационныхБаз;
	КонецЕсли;

	// HTTP к приёмнику УХ: локальная ИБ = источник (БП).
	ЛокальнаяБазаИсточник = Истина;

	// Для сверки нужны все соответствия, не только с разными UUID.
	ЗапросТекст = ТекстЗапросаСоответствийОбъектов(Ложь);

	УзелАвто = НайтиУзелСМаксимальнымКоличествомСоответствий();
	Если УзелАвто <> Неопределено Тогда
		Узел = УзелАвто;
	КонецЕсли;

	ДанныеОтвета = Неопределено;
	ПланСчетовВнешний = Неопределено;

	Соединение = ПолучитьПодключениеHTTPКлиент();
	Если Соединение <> Неопределено Тогда
		// Локально: узел приёмника (IR); для HTTP к УХ — ЭтотУзел этой БП (PG).
		УзелДляHTTP = ОпределитьУзелДляHTTPНаСервере(Узел);
		ДанныеОтвета = ПолучитьМассивРегистраСоотвествия(Соединение, ЗапросТекст, УзелДляHTTP);
		ПланСчетовВнешний = ПолучитьПланСчетовВнешнийHTTP();
	КонецЕсли;

	СоответствияОбъектовИнформационныхБаз = СобратьСоответствияОбъектов(
		ЗапросТекст, Узел, ЛокальнаяБазаИсточник, ДанныеОтвета, ПланСчетовВнешний);

	КэшСоответствияОбъектовИнформационныхБаз = СоответствияОбъектовИнформационныхБаз;

	Возврат СоответствияОбъектовИнформационныхБаз;

КонецФункции

&НаКлиенте
Функция ПолучитьМассивРегистраСоотвествия(Соединение, ЗапросТекст, УзелДляHTTP = Неопределено)
	ПутьНаСервере = "";
	Если ЗначениеЗаполнено(WSИмяБазы) Тогда
	   ПутьНаСервере = WSИмяБазы +   "/hs/sverka/V1/ВыборкаСоответствия";
	Иначе
		Сообщить("Заполните путь, базу!");
	КонецЕсли;

	ЗапросТекст = ЗапросТекст;

	ЗапросПараметры = Новый Структура;
	// Используем переданный узел для HTTP, если он указан, иначе реквизит формы
	УзелДляЗапроса = ?(УзелДляHTTP <> Неопределено, УзелДляHTTP, Узел);
	ЗапросПараметры.Вставить("Узел", УзелДляЗапроса);

	ДанныеЗапроса = Новый Структура();
	ДанныеЗапроса.Вставить("ЗапросПараметры",ЗапросПараметры);
	ДанныеЗапроса.Вставить("ЗапросТекст",ЗапросТекст);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8");//"Content-Type","text/html; charset=utf-8");
	Запрос = Новый HTTPЗапрос(ПутьНаСервере, Заголовки);
	Запрос.УстановитьТелоИзСтроки(JSON(ДанныеЗапроса, Ложь), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос);//ВызватьHTTPМетод("GET", Запрос);//;
	ПутьНаСервере = СтрЗаменить(ПутьНаСервере,"/hs/sverka/V1/ВыборкаСоответствия","");

	Если Ответ.КодСостояния = 200 Тогда

		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();

		Попытка
			ДанныеОтвета = unJSON(ТекстОтвета);
		Исключение
			ТекстСообщения = "Ошибка получения структуры из json. Причина: " + ОписаниеОшибки();
			Сообщить(ТекстСообщения);
			Возврат Неопределено;
		КонецПопытки;

		Возврат ДанныеОтвета;
	Иначе
		Элементы.ДекорацияПодключение.Подсказка = "Подключение установлено";
		Элементы.ДекорацияПодключение.Картинка = БиблиотекаКартинок.ОформлениеКругКрасный;

		ТекстСообщения = "Не удалось выполнить запрос веб-сервиса. Код ответа: " + Ответ.КодСостояния;
		Сообщить(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
