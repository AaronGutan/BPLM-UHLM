Процедура СообщитьМассивСтроку(Знач мСтр, Пре)
	Сооб = "";
	Сооб = Пре + "|";
	Для Каждого Стр Из мСтр Цикл
		Зн = ЗначениеИзСтрокиВнутр(Стр);
		Попытка  
			Если ТипЗнч(Зн)  = Тип("Строка") 
				или  ТипЗнч(Зн)  = Тип("Булево")
				или  Зн = Null
				Тогда
