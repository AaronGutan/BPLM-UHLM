Функция ПереименоватьПредопределенныеСтатьиНаСервере(Выб)
	Запрос = Новый Запрос;
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МассивПредопределенных.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&МассивПредопределенных КАК МассивПредопределенных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтатьиЗатрат.Наименование КАК Наименование,
	|	СтатьиЗатрат.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	|ИЗ
	|	Справочник.СтатьиЗатрат КАК СтатьиЗатрат
	|ГДЕ
	|	СтатьиЗатрат.ИмяПредопределенныхДанных В
	|			(ВЫБРАТЬ
	|				ВТ.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	|			ИЗ
	|				ВТ КАК ВТ)";

	Запрос.УстановитьПараметр("МассивПредопределенных",Выб);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	пСоответствие = Новый Соответствие;

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		пСоответствие.Вставить(ВыборкаДетальныеЗаписи.ИмяПредопределенныхДанных,ВыборкаДетальныеЗаписи.Наименование);
	КонецЦикла;
Возврат пСоответствие
