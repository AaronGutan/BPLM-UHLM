				Соединение = Новый HTTPСоединение(WSИмяСервера,,,,Прокси,100,SSL1,);
			Иначе
				Соединение = Новый HTTPСоединение(WSИмяСервера,, WSИмяПользователя, WSПароль,,100,SSL1,);
			КонецЕсли;
		Иначе
			Если Proxy Тогда
				Прокси = Новый ИнтернетПрокси;
				Прокси.Пользователь = WSИмяПользователя;
				Прокси.Пароль =       WSПароль;
				Соединение = Новый HTTPСоединение(WSИмяСервера,,,,Прокси,100,,);
			Иначе
				Соединение = Новый HTTPСоединение(WSИмяСервера,, WSИмяПользователя, WSПароль,,100,,);
			КонецЕсли;
		КонецЕсли;


		Элементы.ДекорацияПодключение.Подсказка = "Подключение установлено";
		Элементы.ДекорацияПодключение.Картинка = БиблиотекаКартинок.ОформлениеКругЗеленый;

	Исключение
		ТекстСообщения = "Ошибка получения http соединения с базой. Причина: " + ОписаниеОшибки();
		Сообщить(ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;

	Возврат Соединение;

