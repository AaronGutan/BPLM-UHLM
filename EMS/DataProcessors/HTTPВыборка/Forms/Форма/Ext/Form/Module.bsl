	Стр = СтрРазделить(Стр, ",", Истина);
	Стр = Стр[2];
	Стр = Сред(Стр, СтрНайти(Стр, ":") + 1);
	// 12345678901234567890123456789012
	// a7a1c69a2240a3ee11ec90c8c4a3db7a
