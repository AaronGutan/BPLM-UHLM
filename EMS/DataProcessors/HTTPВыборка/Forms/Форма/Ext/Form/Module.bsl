Функция ТекстЗапросаПланОбмена() Экспорт
	Текст = "ВЫБРАТЬ
	|				ПланОбмена.Ссылка КАК Узел
	|			ИЗ
	|				ПланОбмена.[ПланОбмена] КАК ПланОбмена
	|			ГДЕ
	|				НЕ ПланОбмена.ЭтотУзел";
	Текст = СтрЗаменить(Текст, "[ПланОбмена]", ПланОбмена);
	Возврат Текст;
КонецФункции

Функция ТекстЗапросаПланОбмена_Узел() Экспорт
	// Ищем узел по наименованию ИЛИ по коду
	Текст = "ВЫБРАТЬ
	|	ПланОбмена.Ссылка КАК Узел
	|ИЗ
	|	ПланОбмена.[ПланОбмена] КАК ПланОбмена
	|ГДЕ
	|	(ПланОбмена.Ссылка.Наименование = &Узел
	|	ИЛИ ПланОбмена.Ссылка.Код = &Узел)";
	Текст = СтрЗаменить(Текст, "[ПланОбмена]", ПланОбмена);
	Возврат Текст;
КонецФункции

