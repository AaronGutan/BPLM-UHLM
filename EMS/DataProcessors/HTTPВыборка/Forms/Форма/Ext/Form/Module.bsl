		|ГДЕ
		|	EMS_КодСопоставленияОрганизации.Code = &Code";
	
	Запрос.УстановитьПараметр("Code", ИД);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат XMLЗначение(Тип("CatalogRef.Организации"),ВыборкаДетальныеЗаписи.ГУИД); 
	КонецЦикла;
	
 	Возврат Неопределено; 
