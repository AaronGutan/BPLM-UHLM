		//Поля = СтрРазделить("Организация, Подразделение, Счет, Субконто1, Субконто2, Субконто3, КорСчет, Регистратор, СуммаОборотДт, СуммаОборотКт, СуммаНУОборотДт, СуммаНУОборотКт, СуммаПРОборотДт, СуммаПРОборотКт, СуммаВРОборотДт, СуммаВРОборотКт", ", ", Ложь);
		//Текст = СтрЗаменить(Шаблон, "&Условие", "Организация В ИЕРАРХИИ (&Организация)");
		//ИнРег = Поля.Найти("Регистратор");

	Иначе
		Рез   =   ОбъектыВыборкаОтбор(Ложь,Тип,Вид,ВыборкаОргРекв,ОргИД,,,Истина);
		Поля  =   Рез.мИзмерения;
		Текст =   Рез.ЗапросТекст;
		//Текст = СтрЗаменить(Шаблон, "&Условие", "Организация В ИЕРАРХИИ (&Организация)");
	КонецЕсли;

	//
	ЗапросПараметры = Новый Структура;
	Если Период = Неопределено Тогда
		Период = ВыборкаПериод;
	КонецЕсли;
	Если Период <> Неопределено Тогда
		ЗапросПараметры.Вставить("НачалоПериода", Период.ДатаНачала);
		ЗапросПараметры.Вставить("КонецПериода" , КонецДня(Период.ДатаОкончания));
	КонецЕсли;

	ЗапросПараметры.Вставить("Организация", ОргИД);

