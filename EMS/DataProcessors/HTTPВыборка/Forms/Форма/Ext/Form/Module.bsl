Процедура Выбрать(Команда)
	ВыборкаВнешняя = ВыборкаБаза = "Внешняя";
	ВыборкаРежим = ?(ВыборкаБаза <> "Разница", ВыборкаБаза = "Локальная", Неопределено);

	Если      ВыборкаФункция = "Объекты" Тогда
		Если ВыборкаБаза <> "Разница" Тогда
			Выб = ОбъектыВыборка(ВыборкаВнешняя,
				ВыборкаТип, ВыборкаВид,
				ВыборкаОргРекв, ВыборкаОргИД, ВыборкаРекурсия,
				ВыборкаРезультат
			);

			Если ВыборкаРезультат = "Количество" Тогда
				Сообщить(Выб);
				Возврат;
			КонецЕсли;

		Иначе
			Выб = ОбъектыРазница(
				ВыборкаТип, ВыборкаВид,
				ВыборкаОргРекв, ВыборкаОргИД, ВыборкаРекурсия
			);

		КонецЕсли;

	ИначеЕсли ВыборкаФункция = "Обороты" Тогда
		Выб = Обороты(
			ВыборкаОргИД, ВыборкаПериод, "",
			ВыборкаБаза, ВыборкаРезультат, РеквизитЛево, РеквизитПраво, Истина
		);

	ИначеЕсли ВыборкаФункция = "Реквизит" Тогда
		Выб = Реквизит(
		ВыборкаТип, ВыборкаВид, РеквизитИмя, ВыборкаОргРекв, ВыборкаОргИД, ВыборкаРекурсия,
		ВыборкаБаза, ВыборкаРезультат, РеквизитЛево, РеквизитПраво, Истина
		);
	ИначеЕсли ВыборкаФункция = "Родитель" Тогда
		Выб = Родитель(
		ВыборкаТип, ВыборкаВид, РеквизитИмя, ВыборкаОргРекв, ВыборкаОргИД, ВыборкаРекурсия,
		ВыборкаБаза, ВыборкаРезультат, РеквизитЛево, РеквизитПраво, Истина
		);

	ИначеЕсли ВыборкаФункция = "ВСписке" Тогда
		Выб = ВСписке(
			ВыборкаТип, ВыборкаВид, Неопределено,
			ВыборкаБаза, ВыборкаРезультат, РеквизитЛево, РеквизитПраво, Истина
		);

	ИначеЕсли ВыборкаФункция = "Запрос" Тогда
		Выб = Запрос(
			"", "",
			ВыборкаБаза, ВыборкаРезультат, РеквизитЛево, РеквизитПраво, Истина
		);

	ИначеЕсли ВыборкаФункция = "ОборотыHTTP" Тогда
		//Выб = ОбъектыВыборка(ВыборкаВнешняя,
		//ВыборкаТип, ВыборкаВид,
		//ВыборкаОргРекв, ВыборкаОргИД, ВыборкаРекурсия,
		//ВыборкаРезультат
		//);
		//

	ИначеЕсли ВыборкаФункция = "ВыборкаСоответствияHTTP" Тогда
	ИначеЕсли ВыборкаФункция = "ВыборкаОбъекНеНайденHTTP" Тогда

	КонецЕсли;

	СообщитьМассив(Выб);
