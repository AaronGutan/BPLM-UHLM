	Для Каждого Строка Из Выб Цикл
		СтрокаНоваяТЗ = НоваяТЗ.Добавить();
		зн = Справочники[ОбъектПроверяемый][Строка];
		пСоответствие.Вставить(Строка,зн.Наименование);

