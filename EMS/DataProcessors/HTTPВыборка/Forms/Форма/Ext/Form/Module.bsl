		ВыборкаHTTP = "ВыборкаОтправкаКонтроль";
		
		Путь = "";
		Рез  = ЗапросКБазеПриемнику("V1/Список", ДанныеЗапроса, Путь)
	Иначе
		Подключение = ПолучитьПодключение();
		мРезультатВ = Адаптировать(мРезультат, Истина, Подключение, СоответствияОбъектов, КэшТипы.Наружу); 
		Выб = Подключение.ОбменДаннымиПереопределяемый.ЗаписатьБитыеВРС(мРезультатВ);
	КонецЕсли;
	
		
