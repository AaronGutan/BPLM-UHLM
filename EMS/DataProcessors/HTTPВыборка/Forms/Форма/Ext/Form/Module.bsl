&НаСервере
Функция ПолучитьРодителяРекурсия(Ссылка,сРодители)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Родитель КАК Родитель
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		сРодители.Добавить(ВыборкаДетальныеЗаписи.Родитель);
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Родитель)  Тогда
		    ПолучитьРодителяРекурсия(ВыборкаДетальныеЗаписи.Родитель,сРодители)
		КонецЕсли;
	КонецЦикла;
	
	Возврат  сРодители;
	
КонецФункции // ПолучитьРодителяРекурсия()

	 
