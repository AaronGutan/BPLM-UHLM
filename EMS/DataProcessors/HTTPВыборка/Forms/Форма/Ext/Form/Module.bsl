&НаКлиенте
Функция ОбъектыРазница(Тип, Вид, ОргРекв, ОргИД, Рекурсия) Экспорт
	Локальн = ОбъектыВыборка(Ложь  , Тип, Вид, ОргРекв, ОргИД, Рекурсия,, Истина);
	Внешняя = ОбъектыВыборка(Истина, Тип, Вид, ОргРекв, ОргИД,         ,, Истина);

	соВнешняя = Новый Соответствие;
	Для Каждого Тек Из Внешняя.Выборка Цикл
		Ключ = "";
		Для Каждого Зн Из Тек Цикл
			Ключ = Ключ + Зн + ",";
		КонецЦикла;
		соВнешняя.Вставить(Ключ, Тек);
	КонецЦикла;

	мРазница = Новый Массив;
	Для Каждого Тек Из Локальн.Выборка Цикл
		Ключ = "";
		Для Каждого Зн Из Тек Цикл
			Ключ = Ключ + Зн + ",";
		КонецЦикла;

		Если соВнешняя.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		мРазница.Добавить(Тек);
	КонецЦикла;

	Выб = Новый Структура("Тип, Вид, Результат, Внутр, Поля, Выборка", Тип, Вид, "Выборка", Ложь, Локальн.Поля, мРазница);

	МассивИзВыборки(Выб);

	Возврат Выб.Результат;
КонецФункции

&НаКлиенте
Функция ПолучитьШаблонЗапроса(СчетКод, ВариантаШаблона)

	Если ВариантаШаблона = "бух" Тогда

		Шаблон = "ВЫБРАТЬ
		|	ХозрасчетныйОбороты.Организация КАК Организация,
		|	ХозрасчетныйОбороты.Подразделение КАК Подразделение,
		|	ХозрасчетныйОбороты.Счет КАК Счет,
		|	ХозрасчетныйОбороты.Субконто1 КАК Субконто1,
		|	ХозрасчетныйОбороты.Субконто2 КАК Субконто2,
		|	ХозрасчетныйОбороты.Субконто3 КАК Субконто3,
		|	ХозрасчетныйОбороты.КорСчет КАК КорСчет,
		|	ХозрасчетныйОбороты.Регистратор КАК Регистратор,
		|	ХозрасчетныйОбороты.СуммаОборотДт КАК СуммаОборотДт,
		|	ХозрасчетныйОбороты.СуммаОборотКт КАК СуммаОборотКт,
		|	ХозрасчетныйОбороты.СуммаНУОборотДт КАК СуммаНУОборотДт,
		|	ХозрасчетныйОбороты.СуммаНУОборотКт КАК СуммаНУОборотКт,
		|	ХозрасчетныйОбороты.СуммаПРОборотДт КАК СуммаПРОборотДт,
		|	ХозрасчетныйОбороты.СуммаПРОборотКт КАК СуммаПРОборотКт,
		|	ХозрасчетныйОбороты.СуммаВРОборотДт КАК СуммаВРОборотДт,
		|	ХозрасчетныйОбороты.СуммаВРОборотКт КАК СуммаВРОборотКт
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(, , Регистратор, &УсловиеСчета, , &Условие, , ) КАК ХозрасчетныйОбороты
		|ГДЕ
		|	ХозрасчетныйОбороты.Регистратор.Дата МЕЖДУ &НачалоПериода И &КонецПериода";


		Шаблон = СтрЗаменить(Шаблон, "&УсловиеСчета", ?(СчетКод <> "", "Счет.Код = """ + СчетКод + """", ""));


	ИначеЕсли  ВариантаШаблона = "зуп"  тогда
			Шаблон = "ВЫБРАТЬ
		|	Начисления.Регистратор КАК Регистратор,
		|	Начисления.Сотрудник КАК Сотрудник,
		|	Начисления.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Начисления.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Начисления.СторноТекущегоПериода КАК СторноТекущегоПериода,
		|	Начисления.Результат КАК Результат
		|ИЗ
		|	РегистрРасчета.Начисления КАК Начисления
		|	&Условие"


	КонецЕсли;



	Возврат Шаблон;

КонецФункции // ПолучитьШаблон()

