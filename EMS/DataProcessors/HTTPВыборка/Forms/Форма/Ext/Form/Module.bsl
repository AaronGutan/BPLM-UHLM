&НаКлиенте
Функция ВыполнитьЗапросОборотыВнешнийОбъектНеНайден(ЗапросПараметры,АдаптироватьПоСоответствиям = Истина)
    Подключение = ПолучитьПодключение();
	
	Если КэшТипы = Неопределено Тогда
		КэшТипы = Новый Структура("Наружу, Внутрь", Новый Соответствие, Новый Соответствие);
	КонецЕсли;
	
	
	//ЗапросПараметрыВнешний = СтуктураВИзСтрокиВнутр(ЗапросПараметры, Истина);
	
	СоответствияОбъектов = ?(АдаптироватьПоСоответствиям, ПолучитьСоответствияОбъектов().ЛокальнаяВоВнешнюю, Неопределено);
	ЗапросПараметрыВнешний = Адаптировать(ЗапросПараметрыВнешний, Истина, Подключение, СоответствияОбъектов, КэшТипы.Наружу);
	
	Выб = Подключение.ОбменДаннымиПереопределяемый.ВыполнитьЗапросОбъектНеНайденСервер(ЗапросПараметры, ВыбратьОбъектНеНайден);
	
	мРезультат = Новый Массив;
	Для Каждого ТекСтр Из Выб Цикл
		мРезультат.Добавить(ТекСтр);
