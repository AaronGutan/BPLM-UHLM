&НаКлиенте
Функция ОбъектыРазница(Тип, Вид, ОргРекв, ОргИД, Рекурсия) Экспорт
	Локальн = ОбъектыВыборка(Ложь  , Тип, Вид, ОргРекв, ОргИД, Рекурсия,, Истина);
	Внешняя = ОбъектыВыборка(Истина, Тип, Вид, ОргРекв, ОргИД,         ,, Истина);
	
	соВнешняя = Новый Соответствие;
	Для Каждого Тек Из Внешняя.Выборка Цикл
		Ключ = "";
		Для Каждого Зн Из Тек Цикл
			Ключ = Ключ + Зн + ",";
		КонецЦикла;
		соВнешняя.Вставить(Ключ, Тек);
	КонецЦикла;
	
	мРазница = Новый Массив;
	Для Каждого Тек Из Локальн.Выборка Цикл
		Ключ = "";
		Для Каждого Зн Из Тек Цикл
			Ключ = Ключ + Зн + ",";
		КонецЦикла;
		
		Если соВнешняя.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
			
		мРазница.Добавить(Тек);
	КонецЦикла;
	
	Выб = Новый Структура("Тип, Вид, Результат, Внутр, Поля, Выборка", Тип, Вид, "Выборка", Ложь, Локальн.Поля, мРазница);
	
	МассивИзВыборки(Выб);
	
	Возврат Выб.Результат;
КонецФункции

&НаКлиенте
Функция ПолучитьШаблонЗапроса(СчетКод, ВариантаШаблона)
	
	Если ВариантаШаблона = "бух" Тогда
		
		Шаблон = "ВЫБРАТЬ
		|	ХозрасчетныйОбороты.Организация КАК Организация,
		|	ХозрасчетныйОбороты.Подразделение КАК Подразделение,
		|	ХозрасчетныйОбороты.Счет КАК Счет,
		|	ХозрасчетныйОбороты.Субконто1 КАК Субконто1,
		|	ХозрасчетныйОбороты.Субконто2 КАК Субконто2,
		|	ХозрасчетныйОбороты.Субконто3 КАК Субконто3,
		|	ХозрасчетныйОбороты.КорСчет КАК КорСчет,
		|	ХозрасчетныйОбороты.Регистратор КАК Регистратор,
		|	ХозрасчетныйОбороты.СуммаОборотДт КАК СуммаОборотДт,
		|	ХозрасчетныйОбороты.СуммаОборотКт КАК СуммаОборотКт,
		|	ХозрасчетныйОбороты.СуммаНУОборотДт КАК СуммаНУОборотДт,
		|	ХозрасчетныйОбороты.СуммаНУОборотКт КАК СуммаНУОборотКт,
		|	ХозрасчетныйОбороты.СуммаПРОборотДт КАК СуммаПРОборотДт,
		|	ХозрасчетныйОбороты.СуммаПРОборотКт КАК СуммаПРОборотКт,
		|	ХозрасчетныйОбороты.СуммаВРОборотДт КАК СуммаВРОборотДт,
		|	ХозрасчетныйОбороты.СуммаВРОборотКт КАК СуммаВРОборотКт
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &КонецПериода, Регистратор, &УсловиеСчета, , &Условие, , ) КАК ХозрасчетныйОбороты";
		
		Шаблон = СтрЗаменить(Шаблон, "&УсловиеСчета", ?(СчетКод <> "", "Счет.Код = """ + СчетКод + """", ""));

			
	ИначеЕсли  ВариантаШаблона = "зуп"  тогда 
			Шаблон = "ВЫБРАТЬ
		|	Начисления.Регистратор КАК Регистратор,
		|	Начисления.Сотрудник КАК Сотрудник,
		|	Начисления.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Начисления.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	Начисления.СторноТекущегоПериода КАК СторноТекущегоПериода,
		|	Начисления.Результат КАК Результат
		|ИЗ
		|	РегистрРасчета.Начисления КАК Начисления
		|	&Условие"

				
	КонецЕсли; 
	
	Возврат Шаблон; 
	
КонецФункции // ПолучитьШаблон()

&НаКлиенте
Функция ОборотыОбъект(Тип, Вид
	, ОргИД = Неопределено, Период= Неопределено, СчетКод="",   Режим="Разница", Результат = "Выборка", Лево = Ложь, Право = Ложь, Сообщать = Ложь
	)       
	СчетКод="";
	Результат = "Выборка";
	Режим="Разница";
	//Лево = Истина;
	//Право = Истина; 
	Сообщать = Ложь;
	
	Рез = Новый Структура;
	
	// Внешняя = ОбъектыВыборка(Истина, Тип, Вид, ОргРекв, ОргИД,         ,, Истина);   
	
	Если  Тип = "РегистрыРасчета" Тогда 
		Шаблон = ПолучитьШаблонЗапроса(СчетКод,"зуп");
		Текст = СтрЗаменить(Шаблон, "&Условие", " Где ГоловнаяОрганизация В ИЕРАРХИИ (&Организация)"); 
		Поля =  СтрРазделить("Регистратор,Сотрудник,ФизическоеЛицо,ГоловнаяОрганизация,СторноТекущегоПериода,Результат",",",Ложь);
		Рез.Вставить("мИзмерения", Поля);
		Рез.Вставить("ЗапросТекст", Текст);  
		Рез.Вставить("Тип", "РегистрыРасчета");
		
	Иначе 
		Рез   =   ОбъектыВыборкаОтбор(Ложь,Тип,Вид,ВыборкаОргРекв,ОргИД,,,Истина); 
		Поля  =   Рез.мИзмерения;
		Текст =   Рез.ЗапросТекст;
		//Текст = СтрЗаменить(Шаблон, "&Условие", "Организация В ИЕРАРХИИ (&Организация)");	
	КонецЕсли;
	
	//	
	ЗапросПараметры = Новый Структура;
	Если Период <> Неопределено Тогда
		ЗапросПараметры.Вставить("НачалоПериода", Период.ДатаНачала);
		ЗапросПараметры.Вставить("КонецПериода" , КонецДня(Период.ДатаОкончания));
	КонецЕсли;
	
	ЗапросПараметры.Вставить("Организация", ОргИД);
	
	//Поля = СтрРазделить("Организация, Подразделение, Счет, Субконто1, Субконто2, Субконто3, КорСчет, Регистратор, СуммаОборотДт, СуммаОборотКт, СуммаНУОборотДт, СуммаНУОборотКт, СуммаПРОборотДт, СуммаПРОборотКт, СуммаВРОборотДт, СуммаВРОборотКт", ", ", Ложь);
	//Поля =  СтрРазделить("Регистратор,Сотрудник,ФизическоеЛицо,ГоловнаяОрганизация,СторноТекущегоПериода,Результат",",",Ложь);
	
	//Текст = Рез.ЗапросТекст;
	
	Если Рез.Тип = "РегистрБухгалтерии" Или Рез.Тип = "РегистрНакопления" или Рез.Тип = "РегистрыРасчета"  Тогда
		ИнРег = Поля.Найти("Регистратор");
	Иначе  
		ИнРег = Неопределено;  
	КонецЕсли;
	
	соРазница = ПолучитьРезультат(Текст, Поля, ЗапросПараметры, Режим, Результат, Лево, Право, ИнРег, Сообщать, Рез);
	
	Если ИнРег = Неопределено  Тогда
		Рез.Вставить("Выборка", соРазница);
		Если Рез.Тип = "РегистрыСведений" Тогда 	
			МассивИзВыборки(Рез); 
			Возврат Рез.Результат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат соРазница

КонецФункции

&НаСервере
Процедура ОбъединитьРез(соРазница, Рез, Тип)
	
	Для каждого эл Из соРазница Цикл
		
		Если Тип = "РегистрыСведений"  Тогда
			Рез.Добавить(эл);	
		Иначе
			Если эл.ПолучитьОбъект()<> Неопределено Тогда 
				Рез.Добавить(эл);	                               
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ОбъединитьРез()


&НаКлиенте
Функция Обороты(ОргИД = Неопределено, Период= Неопределено, СчетКод="",   Режим="Разница", Результат = "Выборка", Лево = Истина, Право = Истина, Сообщать = Ложь
	) Экспорт
	
	Если ОргИД = Неопределено Тогда
		ОргИД = ВыборкаОргИД;
	КонецЕсли;
	Если Период = Неопределено Тогда
		Период = ВыборкаПериод;
	КонецЕсли;
	
	Рез = Новый Массив;
	
	Для каждого эл Из ВыборкаМетаданные Цикл
		Если эл.Выбор Тогда
			соРазница =  ОборотыОбъект(эл.Тип, эл.Вид,ОргИД,Период,,,,Лево,Право);//, ,,,   Режим="Разница", Результат = "Выборка", 
			//Лево = Истина, Право = Истина, Сообщать = Ложь);
				ОбъединитьРез(соРазница, Рез, эл.Тип);
		КонецЕсли;
	КонецЦикла;  
	Возврат Рез;
КонецФункции

&НаКлиенте
Функция Реквизит(Тип, Вид, Имя, РеквОрг, ОргИд, Рекурсия,   Режим, Результат = "Выборка", Лево = Ложь, Право = Истина, Сообщать = Ложь) Экспорт
	Если      Тип = "Справочники" Тогда
		ТипЗапрос = "Справочник";
	ИначеЕсли Тип = "Документы" Тогда
		ТипЗапрос = "Документ";
	Иначе
		Возврат Новый Массив;
	КонецЕсли;

	Текст = "ВЫБРАТЬ Ссылка, " + Имя + " ИЗ " + ТипЗапрос + "." + Вид;
	
	ЗапросПараметры = Новый Структура;
	Текст = Текст + ЗапросУсловие(Тип, Вид, РеквОрг, ОргИд, Рекурсия, ЗапросПараметры);

	Поля = СтрРазделить("Ссылка, " + Имя, ", ", Ложь);
	
	соРазница = Реквизит(Текст, Поля, ЗапросПараметры, Режим, Результат, Лево, Право, 0, Сообщать);
	
	Возврат соРазница;
