	ДействиеЗаписать = Команда.Имя = "СоответствияЗаписать";

	ОчиститьСообщения();

	Выб = ОбъектыВыборка(Истина, "РегистрыСведений", "СоответствияОбъектовИнформационныхБаз",,,,,, Ложь);

	СоответствияПрочитатьЗаписатьНаСервере(ДействиеЗаписать, Выб, ТекстЗапросаПланОбмена());
КонецПроцедуры

&НаКлиенте
Функция СуффиксКлючаПоСуммам(КлючСравнения)

	Части = СтрРазделить(КлючСравнения, ",", Истина);
	// Хвостовая запятая ключа даёт пустой элемент — убираем.
	Пока Части.Количество() > 0 И ПустаяСтрока(Части[Части.ВГраница()]) Цикл
		Части.Удалить(Части.ВГраница());
	КонецЦикла;

	КоличествоСумм = 8;
	Если Части.Количество() < КоличествоСумм Тогда
		Возврат "";
	КонецЕсли;

	Начало = Части.Количество() - КоличествоСумм;
	Суффикс = Новый Массив;
	Для Индекс = Начало По Части.ВГраница() Цикл
		Суффикс.Добавить(Части[Индекс]);
	КонецЦикла;

	Возврат СтрСоединить(Суффикс, ",");

КонецФункции

&НаКлиенте
Функция НайтиПохожиеКлючиДругойСтороны(КлючСравнения, соДругаяСторона, Максимум = 3)

	Результат = Новый Массив;
	Если соДругаяСторона = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Суффикс = СуффиксКлючаПоСуммам(КлючСравнения);
	Если ПустаяСтрока(Суффикс) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из соДругаяСторона Цикл
		Если СуффиксКлючаПоСуммам(Элемент.Ключ) = Суффикс Тогда
			Результат.Добавить(Элемент.Ключ);
			Если Результат.Количество() >= Максимум Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура СообщитьКлючиСверки(Направление, КлючСтороны, соДругаяСторона)

	Если Направление = "Л<В" Тогда
		КлючИст = КлючСтороны;
		Похожие = НайтиПохожиеКлючиДругойСтороны(КлючСтороны, соДругаяСторона);
		Если Похожие.Количество() = 0 Тогда
			КлючПрм = НСтр("ru='(нет на приёмнике)'");
		Иначе
			КлючПрм = СтрСоединить(Похожие, " || ");
		КонецЕсли;
	Иначе
		КлючПрм = КлючСтороны;
		Похожие = НайтиПохожиеКлючиДругойСтороны(КлючСтороны, соДругаяСторона);
		Если Похожие.Количество() = 0 Тогда
			КлючИст = НСтр("ru='(нет на источнике)'");
		Иначе
			КлючИст = СтрСоединить(Похожие, " || ");
		КонецЕсли;
	КонецЕсли;

	Сообщить(Направление + "|Ист=" + КлючИст);
	Сообщить(Направление + "|Прм=" + КлючПрм);

КонецПроцедуры

&НаКлиенте
Функция ПолучитьРазницуПоКлючам(соЛокал, соВнешн, Лево = Истина, Право = Истина, Индекс = 0, Сообщать = Ложь)

	Сообщать = ВыводитьСообщение;

	Если Сообщать Тогда
		ОчиститьСообщения();
	КонецЕсли;

	соРазница = Новый Соответствие;
	мРазница = Новый Соответствие;
	мКлючЗаписиРС = Новый Массив;
	//	Состояние("Внутренний запрос - сравнение");
	Если ЗначениеЗаполнено(СтрокаВнтурПредставление) Тогда
		Сообщать = ложь;
	КонецЕсли;

	Если Лево Тогда
		Для Каждого Стр Из соЛокал Цикл
			Если соВнешн.Получить(Стр.Ключ) = Неопределено Тогда
				мСтр = Стр.Значение;
				Если Сообщать Тогда
					СообщитьКлючиСверки("Л<В", Стр.Ключ, соВнешн);
					Если УпрощенныйВывод Тогда
					 СообщитьМассивСтрокуЗн(мСтр, "Л<В");
					Иначе
					 СообщитьМассивСтроку(мСтр, "Л<В");
					КонецЕсли;
				КонецЕсли;
				Если Индекс = Неопределено Тогда
				  мКлючЗаписиРС.Добавить(Стр.Значение);
				Иначе
				   соРазница.Вставить(мСтр[Индекс]);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

//	Состояние("Внешний запрос - сравнение");
	Если Право Тогда
		Для Каждого Стр Из соВнешн Цикл
			Если соЛокал.Получить(Стр.Ключ) = Неопределено Тогда
				мСтр = Стр.Значение;
				Если Сообщать Тогда
					СообщитьКлючиСверки("В<Л", Стр.Ключ, соЛокал);
					Если УпрощенныйВывод Тогда
					  СообщитьМассивСтрокуЗн(мСтр, "В<Л");
					Иначе
					 СообщитьМассивСтроку(мСтр, "В<Л");
					КонецЕсли;
				КонецЕсли;
				Если Индекс = Неопределено Тогда
				  мКлючЗаписиРС.Добавить(Стр.Значение);
				Иначе
				соРазница.Вставить(мСтр[Индекс]);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

//	Рез = МассивРазниц(соРазница);
	Рез = Новый Массив;
	Для Каждого Стр Из соРазница Цикл
		мСтр = Новый Массив;
		мСтр.Добавить(Стр.Ключ);
//		Зн = Стр.Ключ;
//		Зн = ЗначениеИзСтрокиВнутр(Зн);
		Рез.Добавить(мСтр);
	КонецЦикла;

	Если Сообщать Тогда
		Сообщить("Л " + соЛокал.Количество() + ", В " + соВнешн.Количество()
			+ ", разниц: " + ?(мКлючЗаписиРС.Количество() > 0, мКлючЗаписиРС.Количество(), Рез.Количество()));
	КонецЕсли;

	Если мКлючЗаписиРС.Количество()>0   Тогда
		 Возврат мКлючЗаписиРС;
	КонецЕсли;

	Возврат Рез;
КонецФункции

&НаКлиенте
Функция ПолучитьКлючиСтр(Внешн, ИнС = Неопределено) Экспорт
	соВнешн = Новый Соответствие;
	//ИнС = Поля.Найти("ИдентификаторЗаписи");
	Для Каждого Стр Из Внешн Цикл
		Ключ = "";
		сч = 0;
		Для Каждого Зн Из Стр Цикл
			Если ИнС = сч Тогда
				сч = сч + 1;
				Продолжить;
			КонецЕсли;

			Ключ = Ключ + Зн + ",";
			сч = сч + 1;
		КонецЦикла;

		соВнешн.Вставить(Ключ, Стр);
	КонецЦикла;

	Возврат соВнешн;
КонецФункции

// Ключ строится по нормализованным значениям (для сравнения),
// а в значении хранится исходная строка (для передачи в УправляемаяСинхронизация).
&НаКлиенте
Функция ПолучитьКлючиСтрИзНормализованных(Исходные, Нормализованные, ИнС = Неопределено) Экспорт

	соКлючи = Новый Соответствие;
	КоличествоСтрок = Мин(Исходные.Количество(), Нормализованные.Количество());

	Для ИндексСтроки = 0 По КоличествоСтрок - 1 Цикл

		Ключ = "";
		сч = 0;
		Для Каждого Зн Из Нормализованные[ИндексСтроки] Цикл
			Если ИнС = сч Тогда
				сч = сч + 1;
				Продолжить;
			КонецЕсли;
			Ключ = Ключ + Зн + ",";
			сч = сч + 1;
		КонецЦикла;

		соКлючи.Вставить(Ключ, Исходные[ИндексСтроки]);

	КонецЦикла;

	Возврат соКлючи;

КонецФункции

&НаКлиенте
Функция ПолучитьРезультат(Текст, Поля, ЗапросПараметры, База, Результат = "Выборка", Лево = Ложь, Право = Истина, Индекс = 0, Сообщать = Ложь, Рез = Неопределено)
	Внутр = База <> "Локальная";

	Если База = "Локальная" // Внутренний запрос
	 Или База = "Разница"
	Тогда
		Локал = ВыполнитьЗапрос       (Текст, Поля, ЗапросПараметры, Внутр);
	КонецЕсли;

	Если База = "Внешняя" // Внешний запрос
	 Или База = "Разница"
	Тогда
		Внешн = ВыполнитьЗапросВнешний(Текст, Поля, ЗапросПараметры, Истина);
	КонецЕсли;

	Если      База = "Локальная" Тогда
		Выборка = Локал;

	ИначеЕсли База = "Внешняя"   Тогда
		Выборка = Внешн;

	ИначеЕсли База = "Разница" Тогда

		// Разница в составе субконто
		//ИнСчет = Поля.Найти("ИдентификаторЗаписи");
		ИнСбк1 = Поля.Найти("ИдентификаторЗаписи");
		//ИнСбк2 = Поля.Найти("Субконто2");
		//ИнСбк3 = Поля.Найти("Субконто3");

		//Для Каждого Стр Из Локал Цикл
			//Если Стр[ИнСчет] = "{""#"",6f58a5c7-f511-498f-abeb-390cf5afab39,41:9bd9000c2954055e11e8845deff5c205}" Тогда // 90.02.1
			//	Стр[ИнСбк1] = "{""L""}";
			//КонецЕсли;
			//Если Стр[ИнСчет] = "{""#"",6f58a5c7-f511-498f-abeb-390cf5afab39,41:9bd9000c2954055e11e8845deff5c163}" Тогда // 66.03
			//	Стр[ИнСбк1] = "{""L""}";
			//КонецЕсли;
			//Если Стр[ИнСчет] = "{""#"",6f58a5c7-f511-498f-abeb-390cf5afab39,41:9bd9000c2954055e11e8845deff5c170}" Тогда // 67.03
			//	Стр[ИнСбк1] = "{""L""}";
			//КонецЕсли;

	//КонецЦикла;
	УидПриемникаВУидИсточника = Неопределено;
	КодыСчетовПоУид = Неопределено;
	СоответствияПолные = ПолучитьСоответствияОбъектов();
	Если СоответствияПолные <> Неопределено Тогда
		УидПриемникаВУидИсточника = СоответствияПолные.УидПриемникаВУидИсточника;
		Если СоответствияПолные.Свойство("КодыСчетовПоУид") Тогда
			КодыСчетовПоУид = СоответствияПолные.КодыСчетовПоУид;
		КонецЕсли;
	КонецЕсли;

	// Исключаем из ключа только служебные поля (ИдентификаторЗаписи), регистратор — часть ключа проводки.
	ИнИсключенияИзКлюча = ИнСбк1;

	ЛокалНормализованный = ПривестиВыборкуКФорматуКлючей(Локал, , КодыСчетовПоУид);
	соЛокал = ПолучитьКлючиСтрИзНормализованных(Локал, ЛокалНормализованный, ИнИсключенияИзКлюча);

	ВнешнНормализованный = ПривестиВыборкуКФорматуКлючей(Внешн, УидПриемникаВУидИсточника, КодыСчетовПоУид);
	соВнешн = ПолучитьКлючиСтрИзНормализованных(Внешн, ВнешнНормализованный, ИнИсключенияИзКлюча);

		Выборка = ПолучитьРазницуПоКлючам(соЛокал, соВнешн, Лево, Право, Индекс, Сообщать);

	КонецЕсли;

	Если      Результат = "Выборка" Тогда

		Если Рез.Тип = "Справочники" или Рез.Тип = "Документы" или  Индекс <> Неопределено Тогда

			Если Внутр Тогда
				Выборка = СтуктураВИзСтрокиВнутрНорм(Выборка);
			КонецЕсли;
			Возврат Выборка;
		Иначе

			Возврат Выборка;
		КонецЕсли;

	ИначеЕсли Результат = "Ссылки" Тогда
		соСсылки = Новый Соответствие;
		Для Каждого Стр Из Выборка Цикл
			Для Каждого Зн Из Стр Цикл
				ЭтоСсылка = Ложь;
				Если Внутр Тогда
					ЭтоСсылка = Лев(Зн, 5) = "{""#"",";
				Иначе
					Тип = ТипЗнч(Зн);
					ЭтоСсылка = Истина
						И Тип <> Тип("Число")
						И Тип <> Тип("Дата")
						И Тип <> Тип("Булево")
						И Тип <> Тип("Неопределено")
						И Тип <> Тип("NULL")
					;
				КонецЕсли;

				Если ЭтоСсылка Тогда
					соСсылки.Вставить(Зн, );
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		Ссылки = Новый Массив;
		Для Каждого Зн Из соСсылки Цикл
			Ссылки.Добавить(Зн.Ключ);
		КонецЦикла;

		Если Внутр Тогда
			Ссылки = СтуктураВИзСтрокиВнутр(Ссылки, Ложь);
		КонецЕсли;

		Возврат Ссылки;

	ИначеЕсли Результат = "Количество" Тогда
		Возврат Выборка.Количество();

	КонецЕсли;
КонецФункции

&НаКлиенте
Функция ОбъектыВыборка(Внешняя, Тип, Вид, РеквОрг = Неопределено, ОргИД = Неопределено, Рекурсия = Неопределено,  Результат = "Выборка", Внутр = Ложь, АдаптироватьПоСоответствиям = Истина) Экспорт
	Если Внешняя Тогда
		 Подключение = ПолучитьПодключениеHTTPКлиент();
	КонецЕсли;

	Рез = Новый Структура("Тип, Вид, Результат, Внутр", Тип, Вид, Результат, Внутр);

	Если      Тип = "Справочники" Тогда
		ТипЗапрос = "Справочник";
	ИначеЕсли Тип = "Документы" Тогда
		ТипЗапрос = "Документ";
	ИначеЕсли Тип = "РегистрыСведений" Тогда
		ТипЗапрос = "РегистрСведений";
	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		ТипЗапрос = "РегистрНакопления";
	ИначеЕсли Тип = "ПланыВидовХарактеристик" Тогда
		ТипЗапрос = "ПланВидовХарактеристик";
	ИначеЕсли Тип = "Последовательности" Тогда
		ТипЗапрос = "Последовательность";
	КонецЕсли;

	Если Результат = "Количество" Тогда
		мИзмерения = Новый Массив;
		мИзмерения.Добавить("Количество");
	Иначе
		мИзмерения = МДИзмерения(Внешняя, Подключение, Тип, Вид);
	КонецЕсли;
	Рез.Вставить("Поля", мИзмерения);

	ЗапросТекст =
		"ВЫБРАТЬ // Первые 100
		|	" + ?(Результат = "Количество", "Сумма(1) КАК Количество", СтрСоединить(мИзмерения, ", ")) + "
		|ИЗ
		|	" + ТипЗапрос + "." + Вид + "
		|";

	ЗапросПараметры = Новый Структура;

	ЗапросТекст = ЗапросТекст + ЗапросУсловие(Тип, Вид, РеквОрг, ОргИд, Рекурсия, ЗапросПараметры);

	Если Внешняя Тогда
		СделатьВыборкуВнешний(Рез, ЗапросТекст, ЗапросПараметры, Внутр, АдаптироватьПоСоответствиям);
	Иначе
		СделатьВыборку       (Рез, ЗапросТекст, ЗапросПараметры, Внутр);
	КонецЕсли;

	Если Результат = "Количество" Тогда
		Возврат Рез.Количество;
	КонецЕсли;

	Если Не Внутр Тогда
		Возврат Рез.Результат;
	КонецЕсли;

	Возврат Рез;
КонецФункции

