Процедура СообщитьМассивСтроку(Знач мСтр, Пре)
	Сооб = "";
	Сооб = Пре + "|";
	Для Каждого Стр Из мСтр Цикл
		Если ЭтоВнутреннееПредставление(Стр) Тогда
			Попытка
				Зн = ЗначениеИзСтрокиВнутр(Стр);
			Исключение
				// Если не удается преобразовать - используем как есть
				Зн = Стр;
			КонецПопытки;
		Иначе
			Зн = Стр;
		КонецЕсли;

		Попытка
			Если ТипЗнч(Зн)  = Тип("Строка")
				или  ТипЗнч(Зн)  = Тип("Булево")
				или  Зн = Null
				Тогда
				Уид = "";
			Иначе
				Уид = Зн.УникальныйИдентификатор();
			КонецЕсли;
		Исключение
			Уид = "";
		КонецПопытки;

		Сооб = Сооб
			+ Зн  + ","
			+ Уид + ","
			+ Стр + "|"
		;
	КонецЦикла;
	Сообщить(Сооб);
КонецПроцедуры

