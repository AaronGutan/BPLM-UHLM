Функция Орг(Знач ИД)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	EMS_КодСопоставленияОрганизации.ГУИД КАК ГУИД
		|ИЗ
		|	РегистрСведений.EMS_КодСопоставленияОрганизации КАК EMS_КодСопоставленияОрганизации
		|ГДЕ
		|	EMS_КодСопоставленияОрганизации.Code = &Code";

	Запрос.УстановитьПараметр("Code", ИД);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат XMLЗначение(Тип("CatalogRef.Организации"),ВыборкаДетальныеЗаписи.ГУИД);
	КонецЦикла;

 	Возврат Неопределено;
КонецФункции

