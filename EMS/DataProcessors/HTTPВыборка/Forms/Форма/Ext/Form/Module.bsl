&НаСервереБезКонтекста
Функция ВыполнитьЗапрос(ЗапросТекст, Поля, ЗапросПараметры, Внутр)
	Запрос = Новый Запрос;
	Запрос.Текст = ЗапросТекст;
	
	Для Каждого ТекПар Из ЗапросПараметры Цикл
		Ключ = ТекПар.Ключ;
		Зн = ТекПар.Значение;
		
		Если Ключ = "Организация" И ТипЗнч(Зн) = Тип("Строка") Тогда // Орг
			Зн = Орг(Зн);
		КонецЕсли;
		
		Запрос.УстановитьПараметр(Ключ, Зн);
	КонецЦикла;
	
	Попытка
	
		Выборка = Запрос.Выполнить().Выбрать();	
	
	Исключение
	    Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ЗапросТекст;
		//Сообщение.Поле = "";
		//Сообщение.УстановитьДанные();
		Сообщение.Сообщить();
	КонецПопытки;
	
	
	мРезультат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Стр = Новый Массив;
		Для Каждого Изм Из Поля Цикл
			Зн = Выборка[Изм];
			Если Внутр Тогда
				Если ТипЗнч(Выборка[Изм]) = Тип("УникальныйИдентификатор") Тогда
					Зн1 = Строка(Выборка[Изм]);   
					Зн = ЗначениеВСтрокуВнутр(Зн1);
				Иначе 	
					Зн = ЗначениеВСтрокуВнутр(Зн);
				КонецЕсли;
				
			КонецЕсли;
			Стр.Добавить(Зн);
		КонецЦикла;
		мРезультат.Добавить(Стр);
	КонецЦикла;
	
	Возврат мРезультат;
КонецФункции
	
