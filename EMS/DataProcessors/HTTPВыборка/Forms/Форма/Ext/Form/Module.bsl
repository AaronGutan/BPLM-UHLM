			КонецЕсли;
		Исключение
			Уид = "";
		КонецПопытки;
		
		Сооб = Сооб
			+ Зн  + ","
			+ Уид + ","
			+ Стр + "|"
		;
	КонецЦикла;
	Сообщить(Сооб);
