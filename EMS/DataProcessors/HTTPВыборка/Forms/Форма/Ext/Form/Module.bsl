Функция ТекстЗапросаПредопределенных(Тип,Вид,ПолучитьСтрокуВнутр)
	Результат = "";
	мИзмерения = Новый Массив;
	Если Результат = "Количество" Тогда
		мИзмерения = Новый Массив;
		мИзмерения.Добавить("Количество");
	ИначеЕсли ПолучитьСтрокуВнутр Тогда
		мИзмерения.Добавить("Ссылка");
		мИзмерения.Добавить("ИмяПредопределенныхДанных");
	Иначе
		мИзмерения.Добавить("Наименование");
		мИзмерения.Добавить("ИмяПредопределенныхДанных");
	КонецЕсли;
	//Рез.Вставить("Поля", мИзмерения);
	Если  Тип = "Справочники" Тогда
		 ТипЗапрос="Справочник";
	ИначеЕсли  Тип = "Документы" Тогда
		 ТипЗапрос="Документ";
	КонецЕсли;


	ЗапросТекст =
	"ВЫБРАТЬ // Первые 100
	|	" + СтрСоединить(мИзмерения, ", ") + "
	|ИЗ
	|	" + ТипЗапрос + "." + Вид + "
	|";

	ЗапросПараметры = Новый Структура;

	//ЗапросТекст = ЗапросТекст + ЗапросУсловие(Тип, Вид, РеквОрг, ОргИд, Рекурсия, ЗапросПараметры);
    Возврат ЗапросТекст;

