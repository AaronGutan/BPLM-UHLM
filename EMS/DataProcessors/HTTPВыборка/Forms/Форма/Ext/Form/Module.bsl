	Сооб = "";
	Сооб = Пре + "|";
	Для Каждого Стр Из мСтр Цикл
		Зн = ЗначениеИзСтрокиВнутр(Стр);
				
		Сооб = Сооб
			+ Зн  + ","
			+ "|"
		;
	КонецЦикла;
	Сообщить(Сооб);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоответствияПрочитатьЗаписатьНаСервере(ДействиеЗаписать, Выб, УзелТекстЗапроса)
	Запрос = Новый Запрос(УзелТекстЗапроса);
	Узел = Запрос.Выполнить().Выгрузить()[0].Узел;
	
	МЗ = РегистрыСведений.СоответствияОбъектовИнформационныхБаз.СоздатьМенеджерЗаписи();
	Стр = Новый Структура(
		"УзелИнформационнойБазы, "
		+ "ТипИсточника, УникальныйИдентификаторИсточника, УникальныйИдентификаторИсточникаСтрокой, "
		+ "ТипПриемника, УникальныйИдентификаторПриемника",
		Узел
	);
	
	Сч = 0;
	Для Каждого Зн Из Выб Цикл
		Сч = Сч + 1;
		
		ТипПриемника = Зн.ТипИсточника;
		УИДПриемника = "" + Зн.УникальныйИдентификаторИсточника.УникальныйИдентификатор();
		СлкПриемника = СсылкаИзУИД(ТипПриемника, УИДПриемника);
		
		ТипИсточника = Зн.ТипПриемника;
		УИДИсточника = Зн.УникальныйИдентификаторПриемника;
		СлкИсточника = СсылкаИзУИД(ТипИсточника, УИДИсточника);
		
		Стр.ТипИсточника = ТипИсточника;
		Стр.УникальныйИдентификаторИсточника = СлкИсточника;
		Стр.УникальныйИдентификаторИсточникаСтрокой = УИДИсточника;
		
		Стр.ТипПриемника = ТипПриемника;
		Стр.УникальныйИдентификаторПриемника = УИДПриемника;
		
		Если Не ДействиеЗаписать Тогда
			ЗаполнитьЗначенияСвойств(МЗ, Стр);
			МЗ.Прочитать();
			Если Не МЗ.Выбран() Тогда
				Сообщить("Не выбран: " + СлкИсточника);
			КонецЕсли;
		Иначе
			ЗаполнитьЗначенияСвойств(МЗ, Стр);
			МЗ.Прочитать();
			Если МЗ.Выбран() Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(МЗ, Стр);
			МЗ.Записать(Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СоответствияПрочитатьЗаписать(Команда)
	Если Вопрос("Выполнить обработку соответствий?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, , ) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ДействиеЗаписать = Команда.Имя = "СоответствияЗаписать";
	
	ОчиститьСообщения();
	
	Выб = ОбъектыВыборка(Истина, "РегистрыСведений", "СоответствияОбъектовИнформационныхБаз",,,,,, Ложь);
	
	СоответствияПрочитатьЗаписатьНаСервере(ДействиеЗаписать, Выб, ПолучитьКомСоединение().ТекстЗапросаПланОбмена());
КонецПроцедуры

&НаКлиенте
Функция ПолучитьРазницуПоКлючам(соЛокал, соВнешн, Лево = Истина, Право = Истина, Индекс = 0, Сообщать = Ложь)
	
	Сообщать = ВыводитьСообщение;
	
	Если Сообщать Тогда
		ОчиститьСообщения();
		Сообщить("Л " + соЛокал.Количество() + ", В " + соВнешн.Количество());
	КонецЕсли;
	
	соРазница = Новый Соответствие;
	мРазница = Новый Соответствие;  
	мКлючЗаписиРС = Новый Массив;
	//	Состояние("Внутренний запрос - сравнение");
	Если ЗначениеЗаполнено(СтрокаВнтурПредставление) Тогда
		Сообщать = ложь;
	КонецЕсли; 
	
	Если Лево Тогда
		Для Каждого Стр Из соЛокал Цикл
			Если соВнешн.Получить(Стр.Ключ) = Неопределено Тогда
				мСтр = Стр.Значение;
				Если Сообщать Тогда
					Если УпрощенныйВывод Тогда
					 СообщитьМассивСтрокуЗн(мСтр, "Л<В");
					Иначе 	
					 СообщитьМассивСтроку(мСтр, "Л<В");
					КонецЕсли;
				КонецЕсли;   
				Если Индекс = Неопределено Тогда
				  мКлючЗаписиРС.Добавить(Стр.Значение);   
				Иначе 	
				   соРазница.Вставить(мСтр[Индекс]); 
				КонецЕсли;
				//Если   СтрНайти(мСтр[2],СтрокаВнтурПредставление)>0 Тогда
				//	СообщитьМассивСтрокуЗн(мСтр, "Л<В");
				//КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
//	Состояние("Внешний запрос - сравнение");
	Если Право Тогда
		Для Каждого Стр Из соВнешн Цикл
			Если соЛокал.Получить(Стр.Ключ) = Неопределено Тогда
				мСтр = Стр.Значение;
				Если Сообщать Тогда
					Если УпрощенныйВывод Тогда
					  СообщитьМассивСтрокуЗн(мСтр, "В<Л");
					Иначе 	
					 СообщитьМассивСтроку(мСтр, "В<Л");
					КонецЕсли;
				КонецЕсли;
				//Если    СтрНайти(мСтр[2],СтрокаВнтурПредставлениеВнеш)>0   Тогда
				//	СообщитьМассивСтрокуЗн(мСтр, "В<Л");
				//КонецЕсли; 
				Если Индекс = Неопределено Тогда
				  мКлючЗаписиРС.Добавить(Стр.Значение);      
				Иначе 
				соРазница.Вставить(мСтр[Индекс]);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
//	Рез = МассивРазниц(соРазница);
	Рез = Новый Массив;
	Для Каждого Стр Из соРазница Цикл
		мСтр = Новый Массив;
		мСтр.Добавить(Стр.Ключ);
//		Зн = Стр.Ключ;
//		Зн = ЗначениеИзСтрокиВнутр(Зн);
		Рез.Добавить(мСтр);
	КонецЦикла; 
	
	Если мКлючЗаписиРС.Количество()>0   Тогда
		 Возврат мКлючЗаписиРС;
	КонецЕсли;
	
	Если Сообщать Тогда
		Сообщить("Разниц: " + Рез.Количество());
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

