&НаСервере
Функция УидОбъектаИзСтрокиВнутр(СтрокаВнутр)

	Если ПустаяСтрока(СтрокаВнутр) Или Лев(СтрокаВнутр, 1) <> "{" Тогда
		Возврат "";
	КонецЕсли;

	Если СтрокаВнутр = "{""L""}" Тогда
		Возврат "";
	КонецЕсли;

	Тело = Сред(СтрокаВнутр, 2, СтрДлина(СтрокаВнутр) - 2);
	Части = СтрРазделить(Тело, ",", Истина);

	Если Части.Количество() < 3 Тогда
		Возврат "";
	КонецЕсли;

	Если Сред(Части[0], 2, 1) <> "#" Тогда
		Возврат "";
	КонецЕсли;

	КодУид = Части[2];
	ПозицияДвоеточия = СтрНайти(КодУид, ":");
	Если ПозицияДвоеточия = 0 Тогда
		Возврат "";
	КонецЕсли;

	УидДвоичный = Сред(КодУид, ПозицияДвоеточия + 1);
	Если СтрДлина(УидДвоичный) < 32 Тогда
		Возврат "";
	КонецЕсли;

	Возврат НРег(
		Сред(УидДвоичный, 25, 8) + "-"
		+ Сред(УидДвоичный, 21, 4) + "-"
		+ Сред(УидДвоичный, 17, 4) + "-"
		+ Сред(УидДвоичный, 1, 4) + "-"
		+ Сред(УидДвоичный, 5, 12));

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоВнутреннееПредставление(Знач Значение)
	// Проверяет, является ли строка внутренним представлением 1С
	// Внутреннее представление всегда начинается с { и заканчивается }

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрДлина(Значение) < 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Лев(Значение, 1) = "{" И Прав(Значение, 1) = "}";

КонецФункции

&НаСервере
Функция НормализоватьСтрокуВнутр(СтрокаВнутр)

	Если ПустаяСтрока(СтрокаВнутр) Тогда
		Возврат СтрокаВнутр;
	КонецЕсли;

	Если Лев(СтрокаВнутр, 1) <> "{" Тогда
		Возврат СтрокаВнутр;
	КонецЕсли;

	Попытка
		Возврат ЗначениеВСтрокуВнутр(ЗначениеИзСтрокиВнутр(СтрокаВнутр));
	Исключение
		Возврат СтрокаВнутр;
	КонецПопытки;

