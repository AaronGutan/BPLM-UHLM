Функция ПолучитьПланСчетовЛокал()  Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Хозрасчетный.Ссылка КАК Ссылка,
		|	Хозрасчетный.Код КАК Код
		|ИЗ
		|	ПланСчетов.Хозрасчетный КАК Хозрасчетный";

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	мПлансСчетов = Новый Соответствие;

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		мПлансСчетов.Вставить(ВыборкаДетальныеЗаписи.Код,ЗначениеВСтрокуВнутр(ВыборкаДетальныеЗаписи.Ссылка));
	КонецЦикла;

    Возврат  мПлансСчетов;

