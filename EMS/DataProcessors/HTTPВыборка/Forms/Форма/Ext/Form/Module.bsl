&НаКлиенте
Функция ПолучитьРезультат(Текст, Поля, ЗапросПараметры, База, Результат = "Выборка", Лево = Ложь, Право = Истина, Индекс = 0, Сообщать = Ложь, Рез = Неопределено)
	Внутр = База <> "Локальная";
	
	Если База = "Локальная" // Внутренний запрос
	 Или База = "Разница"
	Тогда
		Локал = ВыполнитьЗапрос       (Текст, Поля, ЗапросПараметры, Внутр);
	КонецЕсли;
	
	Если База = "Внешняя" // Внешний запрос
	 Или База = "Разница"
	Тогда
		Внешн = ВыполнитьЗапросВнешний(Текст, Поля, ЗапросПараметры, Истина);
	КонецЕсли;
		
	Если      База = "Локальная" Тогда
		Выборка = Локал;
		
	ИначеЕсли База = "Внешняя"   Тогда
		Выборка = Внешн;
		
	ИначеЕсли База = "Разница" Тогда
				
		// Разница в составе субконто
		//ИнСчет = Поля.Найти("ИдентификаторЗаписи");
		ИнСбк1 = Поля.Найти("ИдентификаторЗаписи");
		//ИнСбк2 = Поля.Найти("Субконто2");
		//ИнСбк3 = Поля.Найти("Субконто3");
		
		//Для Каждого Стр Из Локал Цикл
			//Если Стр[ИнСчет] = "{""#"",6f58a5c7-f511-498f-abeb-390cf5afab39,41:9bd9000c2954055e11e8845deff5c205}" Тогда // 90.02.1
			//	Стр[ИнСбк1] = "{""L""}";
			//КонецЕсли; 
			//Если Стр[ИнСчет] = "{""#"",6f58a5c7-f511-498f-abeb-390cf5afab39,41:9bd9000c2954055e11e8845deff5c163}" Тогда // 66.03
			//	Стр[ИнСбк1] = "{""L""}";
			//КонецЕсли;  
			//Если Стр[ИнСчет] = "{""#"",6f58a5c7-f511-498f-abeb-390cf5afab39,41:9bd9000c2954055e11e8845deff5c170}" Тогда // 67.03
			//	Стр[ИнСбк1] = "{""L""}";
			//КонецЕсли;
			
		//КонецЦикла;
		соЛокал = ПолучитьКлючиСтр(Локал,ИнСбк1);
		
		//Для Каждого Стр Из Внешн Цикл
			//Если Стр[ИнСчет] = "{""#"",6f58a5c7-f511-498f-abeb-390cf5afab39,41:9bd9000c2954055e11e8845deff5c205}" Тогда // 90.02.1
			//	Стр[ИнСбк1] = "{""L""}";
			//КонецЕсли;
			//Если Стр[ИнСчет] = "{""#"",6f58a5c7-f511-498f-abeb-390cf5afab39,41:9bd9000c2954055e11e8845deff5c20e}" Тогда // 90.08.1
			//	Стр[ИнСбк2] = "{""L""}";
			//	Стр[ИнСбк3] = "{""L""}";
			//КонецЕсли;  
			//
			//Если Стр[ИнСчет] = "{""#"",6f58a5c7-f511-498f-abeb-390cf5afab39,41:9bd9000c2954055e11e8845deff5c163}" Тогда // 66.03 Деменко Андрей Николаевич  2 записи в рс соответствия 
			//	Стр[ИнСбк1] = "{""L""}";
			//КонецЕсли;  
			//Если Стр[ИнСчет] = "{""#"",6f58a5c7-f511-498f-abeb-390cf5afab39,41:9bd9000c2954055e11e8845deff5c170}" Тогда // 67.03 Деменко Андрей Николаевич
			//	Стр[ИнСбк1] = "{""L""}";
			//КонецЕсли;

		//КонецЦикла;
		соВнешн = ПолучитьКлючиСтр(Внешн,ИнСбк1);
		
		Выборка = ПолучитьРазницуПоКлючам(соЛокал, соВнешн, Лево, Право, Индекс, Сообщать);
		
	КонецЕсли;
	
	Если      Результат = "Выборка" Тогда

		Если Рез.Тип = "Справочники" или Рез.Тип = "Документы" или  Индекс <> Неопределено Тогда
			
			Если Внутр Тогда
				Выборка = СтуктураВИзСтрокиВнутрНорм(Выборка);
			КонецЕсли;  
			Возврат Выборка;
		Иначе 
			
			Возврат Выборка;	
		КонецЕсли;
		
	ИначеЕсли Результат = "Ссылки" Тогда
		соСсылки = Новый Соответствие;
		Для Каждого Стр Из Выборка Цикл
			Для Каждого Зн Из Стр Цикл
				ЭтоСсылка = Ложь;
				Если Внутр Тогда
					ЭтоСсылка = Лев(Зн, 5) = "{""#"",";
				Иначе
					Тип = ТипЗнч(Зн);
					ЭтоСсылка = Истина
						И Тип <> Тип("Число")
						И Тип <> Тип("Дата")
						И Тип <> Тип("Булево")
						И Тип <> Тип("Неопределено")
						И Тип <> Тип("NULL")
					;
				КонецЕсли;
				
				Если ЭтоСсылка Тогда
					соСсылки.Вставить(Зн, );
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Ссылки = Новый Массив;
		Для Каждого Зн Из соСсылки Цикл
			Ссылки.Добавить(Зн.Ключ);
		КонецЦикла;
		
		Если Внутр Тогда
			Ссылки = СтуктураВИзСтрокиВнутр(Ссылки, Ложь);
		КонецЕсли;
		
		Возврат Ссылки;
		
	ИначеЕсли Результат = "Количество" Тогда
		Возврат Выборка.Количество();
		
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция ОбъектыВыборка(Внешняя, Тип, Вид, РеквОрг = Неопределено, ОргИД = Неопределено, Рекурсия = Неопределено,  Результат = "Выборка", Внутр = Ложь, АдаптироватьПоСоответствиям = Истина) Экспорт
	Если Внешняя Тогда
		 Подключение = ПолучитьПодключениеHTTPКлиент();
	КонецЕсли;
	
	Рез = Новый Структура("Тип, Вид, Результат, Внутр", Тип, Вид, Результат, Внутр);
	
	Если      Тип = "Справочники" Тогда
		ТипЗапрос = "Справочник";
	ИначеЕсли Тип = "Документы" Тогда
		ТипЗапрос = "Документ";
	ИначеЕсли Тип = "РегистрыСведений" Тогда
		ТипЗапрос = "РегистрСведений";
	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		ТипЗапрос = "РегистрНакопления";
	ИначеЕсли Тип = "ПланыВидовХарактеристик" Тогда
		ТипЗапрос = "ПланВидовХарактеристик";
	ИначеЕсли Тип = "Последовательности" Тогда
		ТипЗапрос = "Последовательность";
	КонецЕсли;
	
	Если Результат = "Количество" Тогда
		мИзмерения = Новый Массив;
		мИзмерения.Добавить("Количество");
	Иначе
		мИзмерения = МДИзмерения(Внешняя, Подключение, Тип, Вид);
	КонецЕсли;
	Рез.Вставить("Поля", мИзмерения);
	
	ЗапросТекст = 
		"ВЫБРАТЬ // Первые 100
		|	" + ?(Результат = "Количество", "Сумма(1) КАК Количество", СтрСоединить(мИзмерения, ", ")) + "
		|ИЗ
		|	" + ТипЗапрос + "." + Вид + "
		|";
	
	ЗапросПараметры = Новый Структура;
	
	ЗапросТекст = ЗапросТекст + ЗапросУсловие(Тип, Вид, РеквОрг, ОргИд, Рекурсия, ЗапросПараметры);
	
	Если Внешняя Тогда
		СделатьВыборкуВнешний(Рез, ЗапросТекст, ЗапросПараметры, Внутр, АдаптироватьПоСоответствиям);
	Иначе
		СделатьВыборку       (Рез, ЗапросТекст, ЗапросПараметры, Внутр);
	КонецЕсли;
	
	Если Результат = "Количество" Тогда
		Возврат Рез.Количество;
	КонецЕсли;
	
	Если Не Внутр Тогда
		Возврат Рез.Результат;
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

