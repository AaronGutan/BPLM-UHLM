&НаКлиенте
Перем КэшСоответствияОбъектовИнформационныхБаз;


&НаКлиенте
Функция ПолучитьКомСоединение()
	Если КэшКомСоединение <> Неопределено Тогда
		Возврат КэшКомСоединение;
	КонецЕсли;
	
	Попытка
		КэшКомСоединение = ПолучитьФорму("ВнешняяОбработка.COMСоединение.Форма");
		Возврат КэшКомСоединение;
	Исключение
		Сообщить("Ошибка открытия формы ""COM Соединение""" + Символы.ПС + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ПолучитьПодключение()
	КомСоединение = ПолучитьКомСоединение();
	Возврат КомСоединение.ПолучитьПодключение();
КонецФункции

&НаКлиенте
Функция ПолучитьСоответствияОбъектов()
	Если  КэшСоответствияОбъектовИнформационныхБаз<>Неопределено Тогда
	    Возврат  КэшСоответствияОбъектовИнформационныхБаз;
	КонецЕсли;
	
	КомСоединение = ПолучитьКомСоединение();
	Возврат КомСоединение.ПолучитьСоответствияОбъектов();
КонецФункции

&НаСервереБезКонтекста
Процедура МассивИзВыборки(Выб, ИзВнутр = Истина)
	Если Выб.Результат = "Количество" Тогда
		Кол = 0;
		Если Не Выб.Выборка.Количество() = 0 Тогда
			Кол = Выб.Выборка[0][0];
		КонецЕсли;
		Если ИзВнутр Тогда
			Кол = ЗначениеИзСтрокиВнутр(Кол);
		КонецЕсли;
		Если Кол = NULL Тогда
			Кол = 0;
		КонецЕсли;
		Выб.Вставить("Количество", Кол);
		Возврат;
	КонецЕсли;
	
	Кол = Выб.Поля.Количество();
	Тип = Выб.Тип; Вид = Выб.Вид;
	Измерения = Выб.Поля;
	сИзмерения = СтрСоединить(Измерения, ",");
	Отбор = Новый Структура(сИзмерения);
	
	Поля = Новый Соответствие; Сч = 0;
	Для Каждого Поле Из Поля Цикл
		Поля.Вставить(Поле, Сч);
		Сч = Сч + 1;
	КонецЦикла;
	
	Если      Тип = "РегистрыСведений" Тогда
		Рег = РегистрыСведений;
	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		Рег = РегистрыНакопления;
	КонецЕсли;
	
	Рез = Новый Массив;
	
	Для Каждого ТекСтр Из Выб.Выборка Цикл
		Если Тип = "Последовательности" Тогда
			Отбор = Новый Структура(сИзмерения);
		КонецЕсли;
		
		Флаг = Ложь;
		
		Для Сч = 0 По Кол - 1 Цикл
			Поле = ТекСтр[Сч];
			Если ИзВнутр Тогда
				Поле = ЗначениеИзСтрокиВнутр(Поле);  
				ПроверкаНаБитуюСсылку(Поле,Флаг);
			КонецЕсли;
			
			Если Тип = "РегистрыСведений"
			 Или Тип = "РегистрыНакопления"
			 Или Тип = "Последовательности"
			Тогда
				Отбор[Измерения[Сч]] = Поле;
			Иначе
				Значение = Поле; // Ссылка
			КонецЕсли;
		КонецЦикла;
		
		Если Тип = "РегистрыСведений"
		 Или Тип = "РегистрыНакопления"
		Тогда
			Значение = Рег[Вид].СоздатьКлючЗаписи(Отбор);
			Если Тип = "РегистрыСведений" И Вид = "РасчетПоказателейОтложенногоНалога" Тогда
				Значение = Отбор.Регистратор;
			КонецЕсли;
		ИначеЕсли Тип = "Последовательности" Тогда
			Значение = Отбор;
		КонецЕсли;
		
		Если Флаг Тогда
		
			Продолжить;	
		
		КонецЕсли;
		
		Рез.Добавить(Значение);
	КонецЦикла;
	
	Выб.Вставить("Результат", Рез);
КонецПроцедуры

 &НаСервереБезКонтекста
Процедура ПроверкаНаБитуюСсылку(Поле, Флаг) 
	  
	  Попытка
		  Стр = Строка(Поле); 
		  
		  Если СтрНайти(Стр,"<Объект не найден>")>0 Тогда
			  
			  Флаг =  Истина	
			  
		  КонецЕсли;   
		  
	  Исключение
		   Сообщение = Новый СообщениеПользователю;
		   Сообщение.Текст =  ОписаниеОшибки();
		   Сообщение.Сообщить();
	  КонецПопытки;   
	  
 КонецПроцедуры // ПроверкаНаБитуюСсылку()
 

#Если НаКлиенте Тогда // Функция одновременно на клиенте и на сервере )))
&НаКлиенте
Функция МДИзмерения(Знач Внешняя, Подключение, Тип, Вид)
	Внешняя = Ложь;
	Если Не Внешняя Тогда
		Возврат МДНаСервере(Тип, Вид, ВыборкаПроведенные,ПометкаУдаления);
	КонецЕсли;
	#Если НаКлиенте И НаСервере Тогда // Никогда
	КонецФункции
	#КонецЕсли
#Иначе
&НаСервереБезКонтекста
Функция МДНаСервере(Тип, Вид, ВыборкаПроведенные,ПометкаУдаления)
#КонецЕсли
	
	мИзмерения = Новый Массив;
	
	Если      Тип = "Константы" Тогда
		//Если Внешняя Тогда // ? Запрос ?
		//	Возврат Подключение.Константы[Вид].Получить();
		//Иначе
		//	Возврат Подключение.Константы[Вид].Получить();
		//КонецЕсли;
	ИначеЕсли Тип = "Справочники" Или Тип = "Документы" Или Тип = "ПланыВидовХарактеристик" Тогда
		
		мИзмерения.Добавить("Ссылка");
		
		Если Тип = "Документы"  Тогда
			Если  ВыборкаПроведенные Тогда
				//мИзмерения.Добавить("Проведен");
			КонецЕсли;
		КонецЕсли;
		
		Если Тип = "Справочники" Тогда 
			 Если  ПометкаУдаления Тогда
				мИзмерения.Добавить("ПометкаУдаления");
			КонецЕсли;		
		КонецЕсли;
		
	ИначеЕсли Тип = "РегистрыСведений" Тогда
		#Если НаКлиенте Тогда
			МД = Подключение.Метаданные[Тип][Вид];
			Независимый = Подключение.Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый;
			Непериодический = Подключение.Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
		#Иначе
			МД = Метаданные[Тип][Вид];
			Независимый = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый;
			Непериодический = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
		#КонецЕсли
		
		Для Каждого ТекИзм Из МД.Измерения Цикл
			Если Тип = "РегистрыСведений" И Не ТекИзм.ОсновнойОтбор Тогда
				Продолжить;
			КонецЕсли;
			мИзмерения.Добавить(ТекИзм.Имя);
		КонецЦикла;
		
		Если Тип = "РегистрыСведений" Тогда
			Если Не МД.РежимЗаписи = Независимый Тогда
				мИзмерения.Добавить("Регистратор");
			КонецЕсли;
			Если МД.ПериодичностьРегистраСведений <> Непериодический Тогда
				мИзмерения.Добавить("Период");
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		мИзмерения.Добавить("Регистратор");
		
	ИначеЕсли Тип = "Последовательности" Тогда
		мИзмерения.Добавить("Организация"); // ?
		мИзмерения.Добавить("Регистратор");
		мИзмерения.Добавить("Период");
		мИзмерения.Добавить("МоментВремени");
		мИзмерения.Добавить("СостояниеПроведения");
		
	КонецЕсли;

	Возврат мИзмерения;
КонецФункции

&НаКлиенте
Функция ЗапросУсловие(Тип, Вид, РеквОрг, ОргИд, Рекурсия, ЗапросПараметры)
	мУсловие = Новый Массив;
	Если Тип = "РегистрыСведений" И Вид = "СоответствияОбъектовИнформационныхБаз" Тогда
		мУсловие.Добавить("УзелИнформационнойБазы В (" + ПолучитьКомСоединение().ТекстЗапросаПланОбмена() + ")");
		Если СоответствияРазные Тогда
			мУсловие.Добавить("УникальныйИдентификаторПриемника <> УникальныйИдентификаторИсточникаСтрокой");
		КонецЕсли;
	КонецЕсли;
	
	Если Тип = "Документы" Тогда
		Если ЗначениеЗаполнено(ВыборкаПериод) Тогда
			мУсловие.Добавить("Дата Между &НачалоПериода И &КонецПериода");
			ЗапросПараметры.Вставить("НачалоПериода", ВыборкаПериод.ДатаНачала);
			ЗапросПараметры.Вставить("КонецПериода" , КонецДня(ВыборкаПериод.ДатаОкончания));
		КонецЕсли;
		Если ВыборкаПроведенные Тогда
			мУсловие.Добавить("Проведен");
		КонецЕсли;
		Если ВыборкаНеПроведенные Тогда
			мУсловие.Добавить("Не Проведен");
		КонецЕсли;
	КонецЕсли;
	
	
	Если РеквОрг <> Неопределено И РеквОрг <> "" Тогда
		Если ОргИД = "" Тогда
			мУсловие.Добавить(РеквОрг + " = &Организация");
		Иначе
			ПлюсПустая = Ложь;
			Если (Тип = "Справочники" И Вид = "СтатьиЗатрат")
			 Или (Тип = "Справочники" И Вид = "ПрочиеДоходыИРасходы")
			 Или (Тип = "Справочники" И Вид = "Календари")
			 Или (Тип = "РегистрыСведений" И Вид = "СтатьиЗатратПоЗарплате")
			Тогда
				ПлюсПустая = Истина;
			КонецЕсли;
			
			мУсловие.Добавить(
				РеквОрг + " В ИЕРАРХИИ(&Организация)"
				+ ?(ПлюсПустая, " Или " + РеквОрг + " = Значение(Справочник.Организации.ПустаяСсылка)", "")
			);
		КонецЕсли;
		ЗапросПараметры.Вставить("Организация", ОргИД);
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(Рекурсия) Тогда
		мИЛИ = Новый Массив;
		Сч = 0;
		Для Каждого Усл Из СтрРазделить(Рекурсия, ",", Ложь) Цикл
			Сч = Сч + 1;
			мРавно = СтрРазделить(Усл, "=", Ложь);
			мТипВид = СтрРазделить(мРавно[1], ".", Ложь);
			
			мИЛИ.Добавить(мРавно[0] + " В (&Значения" + Сч + ")");
			
			Значения = ОбъектыВыборка(Истина, мТипВид[0], мТипВид[1], РеквОрг, ОргИд);
			ЗапросПараметры.Вставить("Значения" + Сч, Значения);
		КонецЦикла;
		мУсловие.Добавить("(" + СтрСоединить(мИЛИ, Символы.ПС + " ИЛИ ") + ")");
		
		
	КонецЕсли;
	
	Если мУсловие.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат " "
			+ "ГДЕ" + Символы.ПС
			+ СтрСоединить(мУсловие, Символы.ПС + "И ")
			+ Символы.ПС
		;
КонецФункции

&НаКлиенте
Процедура СтрокаВнутрАнализ(СтрВн, Смв = "", Тип = "", Код = "", УИД = "")
	Смв = ""; Тип = ""; Код = ""; УИД = "";
	
	мСтр = СтрРазделить(Сред(СтрВн, 2, СтрДлина(СтрВн) - 2), ",", Истина);
	КолВо = мСтр.Количество();
	
	Смв = Сред(мСтр[0], 2, 1);
	
	Если КолВо < 2 Тогда
		Возврат;
	КонецЕсли;
	
	Тип = мСтр[1];
	
	Если КолВо < 3 Тогда
		Возврат;
	КонецЕсли;
	
	мКодУИД = СтрРазделить(мСтр[2], ":", Истина);
	Код = мКодУИД[0];
	УИД = мКодУИД[1];
КонецПроцедуры
	
&НаКлиенте
Функция СтрокаВнутрСинтез(Смв, Тип, Код, УИД)
	Возврат "{"
		+ """" + Смв + """" + ","
		+ Тип + ","
		+ Код + ":"
		+ УИД
		+ "}"
	;
КонецФункции

&НаСервереБезКонтекста
Функция СтуктураВИзСтрокиВнутр(Зн, ВИстинаИзЛожь)
	Тип = ТипЗнч(Зн);
	Если      Тип = Тип("Структура") Тогда
		Рез = Новый Структура;
		Для Каждого Стр Из Зн Цикл
			Рез.Вставить(Стр.Ключ, СтуктураВИзСтрокиВнутр(Стр.Значение, ВИстинаИзЛожь));
		КонецЦикла;
	ИначеЕсли Тип = Тип("Массив") Тогда
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Рез.Добавить(СтуктураВИзСтрокиВнутр(Стр, ВИстинаИзЛожь));
		КонецЦикла;
	Иначе
		Рез = ?(ВИстинаИзЛожь, ЗначениеВСтрокуВнутр(Зн), ЗначениеИзСтрокиВнутр(Зн));
	КонецЕсли;
	Возврат Рез;
КонецФункции  

