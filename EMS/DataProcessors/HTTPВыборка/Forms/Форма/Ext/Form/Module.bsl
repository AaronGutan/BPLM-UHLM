&НаКлиенте
Перем КэшКомСоединение;
&НаКлиенте
Перем КэшТипы;

&НаКлиенте
Перем КэшСоответствияОбъектовИнформационныхБаз;


&НаКлиенте
Функция ПолучитьКомСоединение()

	Если КэшКомСоединение <> Неопределено Тогда
		Возврат КэшКомСоединение;
	КонецЕсли;

	ИменаФорм = Новый Массив;
	ИменаФорм.Добавить("Обработка.COMСоединение.Форма");
	ИменаФорм.Добавить("ВнешняяОбработка.COMСоединение.Форма");

	Для Каждого ИмяФормы Из ИменаФорм Цикл
		Попытка
			КэшКомСоединение = ПолучитьФорму(ИмяФормы);
			Если КэшКомСоединение <> Неопределено Тогда
				Возврат КэшКомСоединение;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Если Не поHTTP Тогда
		ТекстСообщения = НСтр("ru='Не найдена форма COM-соединения. Подключите обработку COMСоединение или включите режим HTTP.'");
		Сообщить(ТекстСообщения);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция ПолучитьПодключение()

	КомСоединение = ПолучитьКомСоединение();
	Если КомСоединение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат КомСоединение.ПолучитьПодключение();

КонецФункции

&НаКлиенте
Функция ПолучитьСоответствияОбъектов()

	Если КэшСоответствияОбъектовИнформационныхБаз <> Неопределено Тогда
		Возврат КэшСоответствияОбъектовИнформационныхБаз;
	КонецЕсли;

	Если поHTTP Тогда
		Возврат ПолучитьСоответствияОбъектов1();
	КонецЕсли;

	КомСоединение = ПолучитьКомСоединение();
	Если КомСоединение = Неопределено Тогда
		Возврат ПолучитьСоответствияОбъектов1();
	КонецЕсли;

	Возврат КомСоединение.ПолучитьСоответствияОбъектов();

КонецФункции

&НаСервереБезКонтекста
Процедура МассивИзВыборки(Выб, ИзВнутр = Истина)
	Если Выб.Результат = "Количество" Тогда
	Кол = 0;
	Если Не Выб.Выборка.Количество() = 0 Тогда
		Кол = Выб.Выборка[0][0];
	КонецЕсли;
	Если ИзВнутр И ЭтоВнутреннееПредставление(Кол) Тогда
		Попытка
			Кол = ЗначениеИзСтрокиВнутр(Кол);
		Исключение
			// Если не удается преобразовать - используем как есть
		КонецПопытки;
	КонецЕсли;
	Если Кол = NULL Тогда
		Кол = 0;
	КонецЕсли;
		Выб.Вставить("Количество", Кол);
		Возврат;
	КонецЕсли;

	Кол = Выб.Поля.Количество();
	Тип = Выб.Тип; Вид = Выб.Вид;
	Измерения = Выб.Поля;
	сИзмерения = СтрСоединить(Измерения, ",");
	Отбор = Новый Структура(сИзмерения);

	Поля = Новый Соответствие; Сч = 0;
	Для Каждого Поле Из Поля Цикл
		Поля.Вставить(Поле, Сч);
		Сч = Сч + 1;
	КонецЦикла;

	Если      Тип = "РегистрыСведений" Тогда
		Рег = РегистрыСведений;
	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		Рег = РегистрыНакопления;
	КонецЕсли;

	Рез = Новый Массив;

	Для Каждого ТекСтр Из Выб.Выборка Цикл
		Если Тип = "Последовательности" Тогда
			Отбор = Новый Структура(сИзмерения);
		КонецЕсли;

		Флаг = Ложь;

	Для Сч = 0 По Кол - 1 Цикл
		Поле = ТекСтр[Сч];
		Если ИзВнутр Тогда
			Если ЭтоВнутреннееПредставление(Поле) Тогда
				Попытка
					Поле = ЗначениеИзСтрокиВнутр(Поле);
				Исключение
					// Если не удается преобразовать - используем как есть
				КонецПопытки;
			КонецЕсли;
			ПроверкаНаБитуюСсылку(Поле,Флаг);
		КонецЕсли;

			Если Тип = "РегистрыСведений"
			 Или Тип = "РегистрыНакопления"
			 Или Тип = "Последовательности"
			Тогда
				Отбор[Измерения[Сч]] = Поле;
			Иначе
				Значение = Поле; // Ссылка
			КонецЕсли;
		КонецЦикла;

		Если Тип = "РегистрыСведений"
		 Или Тип = "РегистрыНакопления"
		Тогда
			Значение = Рег[Вид].СоздатьКлючЗаписи(Отбор);
			Если Тип = "РегистрыСведений" И Вид = "РасчетПоказателейОтложенногоНалога" Тогда
				Значение = Отбор.Регистратор;
			КонецЕсли;
		ИначеЕсли Тип = "Последовательности" Тогда
			Значение = Отбор;
		КонецЕсли;

		Если Флаг Тогда

			Продолжить;

		КонецЕсли;

		Рез.Добавить(Значение);
	КонецЦикла;

	Выб.Вставить("Результат", Рез);
КонецПроцедуры

 &НаСервереБезКонтекста
Процедура ПроверкаНаБитуюСсылку(Поле, Флаг)

	  Попытка
		  Стр = Строка(Поле);

		  Если СтрНайти(Стр,"<Объект не найден>")>0 Тогда

			  Флаг =  Истина

		  КонецЕсли;

	  Исключение
		   Сообщение = Новый СообщениеПользователю;
		   Сообщение.Текст =  ОписаниеОшибки();
		   Сообщение.Сообщить();
	  КонецПопытки;

 КонецПроцедуры // ПроверкаНаБитуюСсылку()


#Если НаКлиенте Тогда // Функция одновременно на клиенте и на сервере )))
&НаКлиенте
Функция МДИзмерения(Знач Внешняя, Подключение, Тип, Вид)
	Внешняя = Ложь;
	Если Не Внешняя Тогда
		Возврат МДНаСервере(Тип, Вид, ВыборкаПроведенные,ПометкаУдаления);
	КонецЕсли;
	#Если НаКлиенте И НаСервере Тогда // Никогда
	КонецФункции
	#КонецЕсли
#Иначе
&НаСервереБезКонтекста
Функция МДНаСервере(Тип, Вид, ВыборкаПроведенные,ПометкаУдаления)
#КонецЕсли

	мИзмерения = Новый Массив;

	Если      Тип = "Константы" Тогда
		//Если Внешняя Тогда // ? Запрос ?
		//	Возврат Подключение.Константы[Вид].Получить();
		//Иначе
		//	Возврат Подключение.Константы[Вид].Получить();
		//КонецЕсли;
	ИначеЕсли Тип = "Справочники" Или Тип = "Документы" Или Тип = "ПланыВидовХарактеристик" Тогда

		мИзмерения.Добавить("Ссылка");

		Если Тип = "Документы"  Тогда
			Если  ВыборкаПроведенные Тогда
				//мИзмерения.Добавить("Проведен");
			КонецЕсли;
		КонецЕсли;

		Если Тип = "Справочники" Тогда
			 Если  ПометкаУдаления Тогда
				мИзмерения.Добавить("ПометкаУдаления");
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли Тип = "РегистрыСведений" Тогда
		#Если НаКлиенте Тогда
			МД = Подключение.Метаданные[Тип][Вид];
			Независимый = Подключение.Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый;
			Непериодический = Подключение.Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
		#Иначе
			МД = Метаданные[Тип][Вид];
			Независимый = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый;
			Непериодический = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
		#КонецЕсли

		Для Каждого ТекИзм Из МД.Измерения Цикл
			Если Тип = "РегистрыСведений" И Не ТекИзм.ОсновнойОтбор Тогда
				Продолжить;
			КонецЕсли;
			мИзмерения.Добавить(ТекИзм.Имя);
		КонецЦикла;

		Если Тип = "РегистрыСведений" Тогда
			Если Не МД.РежимЗаписи = Независимый Тогда
				мИзмерения.Добавить("Регистратор");
			КонецЕсли;
			Если МД.ПериодичностьРегистраСведений <> Непериодический Тогда
				мИзмерения.Добавить("Период");
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли Тип = "РегистрыНакопления" Тогда
		мИзмерения.Добавить("Регистратор");

	ИначеЕсли Тип = "Последовательности" Тогда
		мИзмерения.Добавить("Организация"); // ?
		мИзмерения.Добавить("Регистратор");
		мИзмерения.Добавить("Период");
		мИзмерения.Добавить("МоментВремени");
		мИзмерения.Добавить("СостояниеПроведения");

	КонецЕсли;

	Возврат мИзмерения;
КонецФункции

&НаКлиенте
Функция ЗапросУсловие(Тип, Вид, РеквОрг, ОргИд, Рекурсия, ЗапросПараметры)
	мУсловие = Новый Массив;
	Если Тип = "РегистрыСведений" И Вид = "СоответствияОбъектовИнформационныхБаз" Тогда
		мУсловие.Добавить("УзелИнформационнойБазы В (" + ТекстЗапросаПланОбмена() + ")");
		Если СоответствияРазные Тогда
			мУсловие.Добавить("УникальныйИдентификаторПриемника <> УникальныйИдентификаторИсточникаСтрокой");
		КонецЕсли;
	КонецЕсли;

	Если Тип = "Документы" Тогда
		Если ЗначениеЗаполнено(ВыборкаПериод) Тогда
			мУсловие.Добавить("Дата Между &НачалоПериода И &КонецПериода");
			ЗапросПараметры.Вставить("НачалоПериода", ВыборкаПериод.ДатаНачала);
			ЗапросПараметры.Вставить("КонецПериода" , КонецДня(ВыборкаПериод.ДатаОкончания));
		КонецЕсли;
		Если ВыборкаПроведенные Тогда
			мУсловие.Добавить("Проведен");
		КонецЕсли;
		Если ВыборкаНеПроведенные Тогда
			мУсловие.Добавить("Не Проведен");
		КонецЕсли;
	КонецЕсли;


	Если РеквОрг <> Неопределено И РеквОрг <> "" Тогда
		Если ОргИД = "" Тогда
			мУсловие.Добавить(РеквОрг + " = &Организация");
		Иначе
			ПлюсПустая = Ложь;
			Если (Тип = "Справочники" И Вид = "СтатьиЗатрат")
			 Или (Тип = "Справочники" И Вид = "ПрочиеДоходыИРасходы")
			 Или (Тип = "Справочники" И Вид = "Календари")
			 Или (Тип = "РегистрыСведений" И Вид = "СтатьиЗатратПоЗарплате")
			Тогда
				ПлюсПустая = Истина;
			КонецЕсли;

			мУсловие.Добавить(
				РеквОрг + " В ИЕРАРХИИ(&Организация)"
				+ ?(ПлюсПустая, " Или " + РеквОрг + " = Значение(Справочник.Организации.ПустаяСсылка)", "")
			);
		КонецЕсли;
		ЗапросПараметры.Вставить("Организация", ОргИД);
	КонецЕсли;


	Если ЗначениеЗаполнено(Рекурсия) Тогда
		мИЛИ = Новый Массив;
		Сч = 0;
		Для Каждого Усл Из СтрРазделить(Рекурсия, ",", Ложь) Цикл
			Сч = Сч + 1;
			мРавно = СтрРазделить(Усл, "=", Ложь);
			мТипВид = СтрРазделить(мРавно[1], ".", Ложь);

			мИЛИ.Добавить(мРавно[0] + " В (&Значения" + Сч + ")");

			Значения = ОбъектыВыборка(Истина, мТипВид[0], мТипВид[1], РеквОрг, ОргИд);
			ЗапросПараметры.Вставить("Значения" + Сч, Значения);
		КонецЦикла;
		мУсловие.Добавить("(" + СтрСоединить(мИЛИ, Символы.ПС + " ИЛИ ") + ")");


	КонецЕсли;

	Если мУсловие.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат " "
			+ "ГДЕ" + Символы.ПС
			+ СтрСоединить(мУсловие, Символы.ПС + "И ")
			+ Символы.ПС
		;
КонецФункции

&НаКлиенте
Процедура СтрокаВнутрАнализ(СтрВн, Смв = "", Тип = "", Код = "", УИД = "")
	Смв = ""; Тип = ""; Код = ""; УИД = "";

	мСтр = СтрРазделить(Сред(СтрВн, 2, СтрДлина(СтрВн) - 2), ",", Истина);
	КолВо = мСтр.Количество();

	Смв = Сред(мСтр[0], 2, 1);

	Если КолВо < 2 Тогда
		Возврат;
	КонецЕсли;

	Тип = мСтр[1];

	Если КолВо < 3 Тогда
		Возврат;
	КонецЕсли;

	мКодУИД = СтрРазделить(мСтр[2], ":", Истина);
	Код = мКодУИД[0];
	УИД = мКодУИД[1];
КонецПроцедуры

&НаКлиенте
Функция СтрокаВнутрСинтез(Смв, Тип, Код, УИД)
	Возврат "{"
		+ """" + Смв + """" + ","
		+ Тип + ","
		+ Код + ":"
		+ УИД
		+ "}"
	;
КонецФункции

&НаСервереБезКонтекста
Функция СтуктураВИзСтрокиВнутр(Зн, ВИстинаИзЛожь)
	Тип = ТипЗнч(Зн);
	Если      Тип = Тип("Структура") Тогда
		Рез = Новый Структура;
		Для Каждого Стр Из Зн Цикл
			Рез.Вставить(Стр.Ключ, СтуктураВИзСтрокиВнутр(Стр.Значение, ВИстинаИзЛожь));
		КонецЦикла;
	ИначеЕсли Тип = Тип("Массив") Тогда
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Рез.Добавить(СтуктураВИзСтрокиВнутр(Стр, ВИстинаИзЛожь));
		КонецЦикла;
	Иначе
		Рез = ?(ВИстинаИзЛожь, ЗначениеВСтрокуВнутр(Зн), ЗначениеИзСтрокиВнутр(Зн));
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция СтуктураВИзСтрокиВнутрНорм(Зн)
	// Разворачивает массив строк вида [[Регистратор], ...] в массив ссылок.
	// Для коннектора: Обороты → ДобавитьВБуфер(УправляемаяСинхронизация).
	Рез = Новый Массив;
	Для Каждого Стр Из Зн Цикл
		Для Каждого мСтр Из Стр Цикл
			Если мСтр = "{""B"",0}" Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(мСтр) <> Тип("Строка") Тогда
				Рез.Добавить(мСтр);
				Продолжить;
			КонецЕсли;
			Если Не ЭтоВнутреннееПредставление(мСтр) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Рез.Добавить(ЗначениеИзСтрокиВнутр(мСтр));
			Исключение
				// Пропускаем некорректное внутреннее представление
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	Возврат Рез;
КонецФункции

&НаКлиенте
Функция Адаптировать(Знач Зн, НаружуИстинаВнутрьЛожь, Подключение, СоответствияОбъектов, Типы)
	Тип = ТипЗнч(Зн);
	Если      Тип = Тип("Структура") Тогда
		Рез = Новый Структура;
		Для Каждого Стр Из Зн Цикл
			Рез.Вставить(Стр.Ключ, Адаптировать(Стр.Значение, НаружуИстинаВнутрьЛожь, Подключение, СоответствияОбъектов, Типы));
		КонецЦикла;

	ИначеЕсли Тип = Тип("Массив") Тогда
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Рез.Добавить(Адаптировать(Стр, НаружуИстинаВнутрьЛожь, Подключение, СоответствияОбъектов, Типы));
		КонецЦикла;

	Иначе
		Рез = Зн;

		Если НаружуИстинаВнутрьЛожь = Ложь И СоответствияОбъектов <> Неопределено Тогда
			Соо = ПолучитьСоответствиеПоСтрокеВнутрь(Рез, СоответствияОбъектов);
			Если Соо <> Неопределено Тогда
				Рез = Соо;
			КонецЕсли;
		КонецЕсли;


		Смв = ""; ТипУИД = ""; КодУИД = ""; УИД = "";
		СтрокаВнутрАнализ(Рез, Смв, ТипУИД, КодУИД, УИД);

		Если Смв = "#" И УИД <> "" Тогда // Ссылка
			Пустое = Типы.Получить(ТипУИД);
			Если Пустое = Неопределено Тогда
				Если НаружуИстинаВнутрьЛожь = Истина Тогда // Наружу
					ТипСтр = СтрТипЗнч(Рез);
					Пустое = Подключение.ОбменДаннымиПереопределяемый.СтрокаПустогоЗначения(ТипСтр);
				Иначе
					ТипСтр = Подключение.ОбменДаннымиПереопределяемый.СтрТипЗнч(Рез);
					Пустое = СтрокаПустогоЗначения(ТипСтр);
				КонецЕсли;
				Типы.Вставить(ТипУИД, Пустое);
			КонецЕсли;

			СтрокаВнутрАнализ(Пустое,, ТипУИД, КодУИД, );

			Рез = СтрокаВнутрСинтез(Смв, ТипУИД, КодУИД, УИД);
		КонецЕсли;


		Если НаружуИстинаВнутрьЛожь = Истина И СоответствияОбъектов <> Неопределено Тогда
			Соо = СоответствияОбъектов.Получить(Рез);
			Если Соо <> Неопределено Тогда
				Рез = Соо;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;
	Возврат Рез;
КонецФункции

&НаКлиенте
Функция ПолучитьСоответствиеПоСтрокеВнутрь(Строка, СоответствияДанные)

	Если СоответствияДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Строка) <> Тип("Строка") Или ПустаяСтрока(Строка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	КартаСтрок = СоответствияДанные;
	КартаУид = Неопределено;

	Если ТипЗнч(СоответствияДанные) = Тип("Структура") Тогда
		КартаСтрок = СоответствияДанные.ВнешняяВЛокальную;
		КартаУид = СоответствияДанные.ЛокальнаяСтрокаПоУидПриемника;
	КонецЕсли;

	Если КартаСтрок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = КартаСтрок.Получить(Строка);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если КартаУид = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Уид = "";
	Если Лев(Строка, 1) = "#" И СтрДлина(Строка) >= 37 Тогда
		Уид = НРег(Сред(Строка, 2));
	ИначеЕсли Лев(Строка, 1) = "{" Тогда
		Уид = УИДИзСтроки(Строка);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Уид) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат КартаУид.Получить(Уид);

КонецФункции

&НаКлиенте
Функция АдаптироватьHTTP(Знач Зн, НаружуИстинаВнутрьЛожь, СоответствияОбъектов, Типы, мТипы)
	Тип = ТипЗнч(Зн);
	Если      Тип = Тип("Структура") Тогда
		Рез = Новый Структура;
		Для Каждого Стр Из Зн Цикл
			Рез.Вставить(Стр.Ключ, АдаптироватьHTTP(Стр.Значение, НаружуИстинаВнутрьЛожь, СоответствияОбъектов, Типы, мТипы));
		КонецЦикла;

	ИначеЕсли Тип = Тип("Массив") Тогда
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Рез.Добавить(АдаптироватьHTTP(Стр, НаружуИстинаВнутрьЛожь, СоответствияОбъектов, Типы, мТипы));
		КонецЦикла;

	Иначе
		Рез = Зн;

		Если Тип <> Тип("Строка") Тогда
			Возврат Рез;
		КонецЕсли;

		СоответствиеПрименено = Ложь;

		Если НаружуИстинаВнутрьЛожь = Ложь И СоответствияОбъектов <> Неопределено Тогда
			Соо = ПолучитьСоответствиеПоСтрокеВнутрь(Рез, СоответствияОбъектов);
			Если Соо <> Неопределено Тогда
				Рез = Соо;
				СоответствиеПрименено = Истина;
			КонецЕсли;
		КонецЕсли;

		Если Не СоответствиеПрименено Тогда

			Смв = ""; ТипУИД = ""; КодУИД = ""; УИД = "";
			СтрокаВнутрАнализ(Рез, Смв, ТипУИД, КодУИД, УИД);

			Если Смв = "#" И УИД <> "" Тогда // Ссылка
				Пустое = Типы.Получить(ТипУИД);
				Если Пустое = Неопределено Тогда
					Если НаружуИстинаВнутрьЛожь = Истина Тогда // Наружу
						ТипСтр = СтрТипЗнч(Рез);
						//Пустое = Подключение.ОбменДаннымиПереопределяемый.СтрокаПустогоЗначения(ТипСтр);
					Иначе
						тТипСтр = мТипы.Получить(ТипУИД);
						Пустое = СтрокаПустогоЗначения(тТипСтр);
					КонецЕсли;
					Типы.Вставить(ТипУИД, Пустое);
				КонецЕсли;

				СтрокаВнутрАнализ(Пустое,, ТипУИД, КодУИД, );

				Рез = СтрокаВнутрСинтез(Смв, ТипУИД, КодУИД, УИД);

				Если НаружуИстинаВнутрьЛожь = Ложь И СоответствияОбъектов <> Неопределено Тогда
					Соо = ПолучитьСоответствиеПоСтрокеВнутрь(Рез, СоответствияОбъектов);
					Если Соо <> Неопределено Тогда
						Рез = Соо;
					КонецЕсли;
				КонецЕсли;

			КонецЕсли;

		КонецЕсли;


		Если НаружуИстинаВнутрьЛожь = Истина И СоответствияОбъектов <> Неопределено Тогда
			КартаСоответствий = СоответствияОбъектов;
			Если ТипЗнч(СоответствияОбъектов) = Тип("Структура") Тогда
				КартаСоответствий = СоответствияОбъектов.ЛокальнаяВоВнешнюю;
			КонецЕсли;
			Соо = КартаСоответствий.Получить(Рез);
			Если Соо <> Неопределено Тогда
				Рез = Соо;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;
	Возврат Рез;
КонецФункции

&НаКлиенте
Функция АдаптироватьТипы(Знач Зн, НаружуИстинаВнутрьЛожь, Подключение, СоответствияОбъектов, Типы)
	Тип = ТипЗнч(Зн);
	Если      Тип = Тип("Структура") Тогда
		Рез = Новый Структура;
		Для Каждого Стр Из Зн Цикл
			Рез.Вставить(Стр.Ключ, АдаптироватьТипы(Стр.Значение, НаружуИстинаВнутрьЛожь, Подключение, СоответствияОбъектов, Типы));
		КонецЦикла;

	ИначеЕсли Тип = Тип("Массив") Тогда
		Рез = Новый Массив;
		Для Каждого Стр Из Зн Цикл
			Рез.Добавить(АдаптироватьТипы(Стр, НаружуИстинаВнутрьЛожь, Подключение, СоответствияОбъектов, Типы));
		КонецЦикла;

	Иначе
		Рез = Зн;

		Если НаружуИстинаВнутрьЛожь = Ложь И СоответствияОбъектов <> Неопределено Тогда
			Соо = ПолучитьСоответствиеПоСтрокеВнутрь(Рез, СоответствияОбъектов);
			Если Соо <> Неопределено Тогда
				Рез = Соо;
			КонецЕсли;
		КонецЕсли;


		Смв = ""; ТипУИД = ""; КодУИД = ""; УИД = "";
		СтрокаВнутрАнализ(Рез, Смв, ТипУИД, КодУИД, УИД);

		Если Смв = "#" И УИД <> "" Тогда // Ссылка
			Пустое = Типы.Получить(ТипУИД);
			Если Пустое = Неопределено Тогда
				ТипСтр =СтрТипЗнч(Рез);
				Пустое = СтрокаПустогоЗначения(ТипСтр);
				Типы.Вставить(ТипУИД, ТипСтр);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Типы;
КонецФункции

&НаКлиенте
Функция СинтезТипов(Результат)

	Типы = Новый Соответствие;
	НаружуИстинаВнутрьЛожь  = Ложь;
	Подключение = Неопределено;
	СоответствияОбъектов  =Неопределено;

	Типы = АдаптироватьТипы(Результат, НаружуИстинаВнутрьЛожь, Подключение, СоответствияОбъектов, Типы);

	тРезультат = Новый Массив;
	Для Каждого КлючЗначение Из Типы Цикл
		кРезультат = Новый Массив;
		кРезультат.Добавить(КлючЗначение.Ключ);
		кРезультат.Добавить(КлючЗначение.Значение);
		тРезультат.Добавить(кРезультат);
	КонецЦикла;
	возврат тРезультат;
КонецФункции

&НаСервереБезКонтекста
Функция СтрТипЗнч(ЗнчСтр) Экспорт
	Если ЭтоВнутреннееПредставление(ЗнчСтр) Тогда
		Попытка
			Знч = ЗначениеИзСтрокиВнутр(ЗнчСтр);
		Исключение
			// Если не удается преобразовать - используем как есть
			Знч = ЗнчСтр;
		КонецПопытки;
	Иначе
		Знч = ЗнчСтр;
	КонецЕсли;
	Тип = ТипЗнч(Знч);
	Возврат XMLТип(Тип).ИмяТипа;
КонецФункции

&НаКлиенте
Функция ВыполнитьЗапросВнешний(ЗапросТекст, Поля, ЗапросПараметры, АдаптироватьПоСоответствиям = Истина)


	Если КэшТипы = Неопределено Тогда
		КэшТипы = Новый Структура("Наружу, Внутрь", Новый Соответствие, Новый Соответствие);
	КонецЕсли;

	ЗапросПараметрыВнешний = СтуктураВИзСтрокиВнутр(ЗапросПараметры, Истина);

	Если поHTTP  Тогда
		СоответствияОбъектов = ?(АдаптироватьПоСоответствиям, ПолучитьСоответствияОбъектов().ЛокальнаяВоВнешнюю, Неопределено);

		ЗапросПараметрыHTTP = Новый Структура;
		Для Каждого ТекПар Из ЗапросПараметры Цикл
			ЗапросПараметрыHTTP.Вставить(ТекПар.Ключ, ТекПар.Значение);
		КонецЦикла;

		ДанныеЗапроса = Новый Структура();
		ДанныеЗапроса.Вставить("ЗапросПараметры", ЗапросПараметрыHTTP);
		ДанныеЗапроса.Вставить("ЗапросТекст", ЗапросТекст);
		ДанныеЗапроса.Вставить("Поля", Поля);

		// Явный путь: не зависим от реквизита ВыборкаHTTP на сервере.
		ПутьНаСервере = "";
		Если ЗначениеЗаполнено(WSИмяБазы) Тогда
			Если ЗапросПараметры.Свойство("НачалоПериода")
				Или ЗапросПараметры.Свойство("КонецПериода") Тогда
				ПутьНаСервере = WSИмяБазы + "/hs/sverka/V1/Обороты";
			ИначеЕсли ЗначениеЗаполнено(ВыборкаHTTP) И ВыборкаHTTP = "ОборотыHTTP" Тогда
				ПутьНаСервере = WSИмяБазы + "/hs/sverka/V1/Обороты";
			Иначе
				ПутьНаСервере = WSИмяБазы + "/hs/sverka/V1/Объекты";
			КонецЕсли;
		КонецЕсли;

		Рез = ЗапросКБазеПриемнику("", ДанныеЗапроса, ПутьНаСервере);

		Если Не ЭтоМассивОтветаHTTP(Рез) Тогда
			ТекстОшибки = НСтр("ru='Внешний HTTP-запрос не вернул выборку.'");
			Если ТипЗнч(Рез) = Тип("Структура") И Рез.Свойство("ОписаниеОшибки") Тогда
				ТекстОшибки = ТекстОшибки + " " + Рез.ОписаниеОшибки;
			КонецЕсли;
			Сообщить(ТекстОшибки);
			Возврат Новый Массив;
		КонецЕсли;

		Выб = Рез[0];
		мТипы = Новый Соответствие;
		Если Рез.Количество() > 1 И ТипЗнч(Рез[1]) = Тип("Массив") Тогда
			Для Каждого стр Из Рез[1] Цикл
				Если ТипЗнч(стр) = Тип("Массив") И стр.Количество() > 1 Тогда
					мТипы.Вставить(стр[0], стр[1]);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	Иначе
		Подключение = ПолучитьПодключение();
		СоответствияОбъектов = ?(АдаптироватьПоСоответствиям, ПолучитьСоответствияОбъектов().ЛокальнаяВоВнешнюю, Неопределено);
		ЗапросПараметрыВнешний = Адаптировать(ЗапросПараметрыВнешний, Истина, Подключение, СоответствияОбъектов, КэшТипы.Наружу);
		Выб = Подключение.ОбменДаннымиПереопределяемый.ВыполнитьЗапрос(ЗапросТекст, ЗапросПараметры, Поля);
	КонецЕсли;

	Если Выб = Неопределено Или ТипЗнч(Выб) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;

	мРезультат = Новый Массив;
	Для Каждого ТекСтр Из Выб Цикл
		мСтр = Новый Массив;
		Для Каждого Зн Из ТекСтр Цикл
			мСтр.Добавить(Зн);
		КонецЦикла;
		мРезультат.Добавить(мСтр);
	КонецЦикла;

	Если поHTTP Тогда

		СоответствияПолные = ?(АдаптироватьПоСоответствиям, ПолучитьСоответствияОбъектов(), Неопределено);
		мРезультат = АдаптироватьHTTP(мРезультат, Ложь, СоответствияПолные, КэшТипы.Внутрь, мТипы);

	Иначе

		СоответствияОбъектов = ?(АдаптироватьПоСоответствиям, ПолучитьСоответствияОбъектов().ВнешняяВЛокальную, Неопределено);
		мРезультат = Адаптировать(мРезультат, Ложь, Подключение, СоответствияОбъектов, КэшТипы.Внутрь);

	КонецЕсли;

	Возврат мРезультат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоМассивОтветаHTTP(Рез)

	Если Рез = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Рез) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Рез.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТипЗнч(Рез[0]) = Тип("Массив");

КонецФункции

&НаКлиенте
Функция СделатьВыборкуВнешний(Рез, ЗапросТекст, ЗапросПараметры, Внутр = Ложь, АдаптироватьПоСоответствиям = Истина)
	Рез.Вставить("Выборка",
		ВыполнитьЗапросВнешний(ЗапросТекст, Рез.Поля, ЗапросПараметры, АдаптироватьПоСоответствиям)
	);

	Если Не Внутр Тогда
		МассивИзВыборки(Рез);
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьЗапрос(ЗапросТекст, Поля, ЗапросПараметры, Внутр)
	Запрос = Новый Запрос;
	Запрос.Текст = ЗапросТекст;

	Для Каждого ТекПар Из ЗапросПараметры Цикл
		Ключ = ТекПар.Ключ;
		Зн = ТекПар.Значение;

		Если Ключ = "Организация" И ТипЗнч(Зн) = Тип("Строка") Тогда // Орг
			Зн = Орг(Зн);
		КонецЕсли;

		Запрос.УстановитьПараметр(Ключ, Зн);
	КонецЦикла;

	Попытка

		Выборка = Запрос.Выполнить().Выбрать();

	Исключение
	    Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ЗапросТекст;
		//Сообщение.Поле = "";
		//Сообщение.УстановитьДанные();
		Сообщение.Сообщить();
	КонецПопытки;


	мРезультат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Стр = Новый Массив;
		Для Каждого Изм Из Поля Цикл
			Зн = Выборка[Изм];
			Если Внутр Тогда
				Если ТипЗнч(Выборка[Изм]) = Тип("УникальныйИдентификатор") Тогда
					Зн1 = Строка(Выборка[Изм]);
					Зн = ЗначениеВСтрокуВнутр(Зн1);
				Иначе
					Зн = ЗначениеВСтрокуВнутр(Зн);
				КонецЕсли;

			КонецЕсли;
			Стр.Добавить(Зн);
		КонецЦикла;
		мРезультат.Добавить(Стр);
	КонецЦикла;

	Возврат мРезультат;
КонецФункции

&НаСервереБезКонтекста
Функция СделатьВыборку(Рез, ЗапросТекст, ЗапросПараметры, Внутр = Ложь)

	Рез.Вставить("Выборка",
		ВыполнитьЗапрос(ЗапросТекст, Рез.Поля, ЗапросПараметры, Внутр)
	);

	Если Не Внутр Тогда
		МассивИзВыборки(Рез, Ложь);
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция ТипСсылкиВСтроку(Зн) Экспорт
	СтрЗнч = ЗначениеВСтрокуВнутр(Зн);
	Если Лев(СтрЗнч, 5) <> "{""#""," Тогда
		Возврат "";
	КонецЕсли;

	Тип = ТипЗнч(Зн);
	Возврат XMLТип(Тип).ИмяТипа;
КонецФункции

&НаСервереБезКонтекста
Функция СсылкаИзУИД(ТипСтр, УИД)
	Возврат XMLЗначение(Тип(ТипСтр), УИД);
КонецФункции

&НаСервереБезКонтекста
Функция ПустоеЗначение(Знач Тип) Экспорт
	Если Тип =  "DocumentRef.Трансляция" или Тип = "DocumentRef.ТрансформационнаяКорректировка" Тогда
	 	Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Тип) = Тип("Строка") Тогда
		ТипСтр = Тип;
		Тип = Тип(Тип);
	Иначе // Тип
		ТипСтр = XMLТип(Тип).ИмяТипа;
	КонецЕсли;

	ТипСтр = СтрРазделить(ТипСтр, ".")[0];

	Если      ТипСтр = "EnumRef" Тогда
		Возврат XMLЗначение(Тип, "");
	Иначе//Если СтрТип = "CatalogRef" Тогда
		Возврат XMLЗначение(Тип, "00000000-0000-0000-0000-000000000000");
	КонецЕсли;

	Возврат Неопределено;
КонецФункции

&НаСервереБезКонтекста
Функция СтрокаПустогоЗначения(Знач Тип) Экспорт
	Возврат ЗначениеВСтрокуВнутр(ПустоеЗначение(Тип));
КонецФункции

&НаКлиенте
Функция СтрокаИзУИД(Знач Стр)


	//// ???????????????????

		// 123456789012345678901234567890123456
		// 1435823d-b0b3-11ec-9871-0050568d2260
		// 98710050568d226011ecb0b31435823d
		Стр = ""
			+ Сред(Стр, 20,  4)
			+ Сред(Стр, 25, 12)
			+ Сред(Стр, 15,  4)
			+ Сред(Стр, 10,  4)
			+ Сред(Стр,  1,  8)
		;


	Возврат Стр;
КонецФункции

&НаКлиенте
Функция УИДИзСтроки(Знач Стр)

	Если ПустаяСтрока(Стр) Или Лев(Стр, 1) <> "{" Тогда
		Возврат "";
	КонецЕсли;

	Если Стр = "{""L""}" Тогда
		Возврат "";
	КонецЕсли;

	Тело = Сред(Стр, 2, СтрДлина(Стр) - 2);
	Части = СтрРазделить(Тело, ",", Истина);

	Если Части.Количество() < 3 Тогда
		Возврат "";
	КонецЕсли;

	Если Сред(Части[0], 2, 1) <> "#" Тогда
		Возврат "";
	КонецЕсли;

	КодУид = Части[2];
	ПозицияДвоеточия = СтрНайти(КодУид, ":");
	Если ПозицияДвоеточия = 0 Тогда
		Возврат "";
	КонецЕсли;

	УидДвоичный = Сред(КодУид, ПозицияДвоеточия + 1);
	Если СтрДлина(УидДвоичный) < 32 Тогда
		Возврат "";
	КонецЕсли;

	Возврат НРег(
		Сред(УидДвоичный, 25, 8) + "-"
		+ Сред(УидДвоичный, 21, 4) + "-"
		+ Сред(УидДвоичный, 17, 4) + "-"
		+ Сред(УидДвоичный, 1, 4) + "-"
		+ Сред(УидДвоичный, 5, 12));

КонецФункции

