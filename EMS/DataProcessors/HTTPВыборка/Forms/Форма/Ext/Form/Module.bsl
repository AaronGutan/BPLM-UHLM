&НаКлиенте
Функция ВыполнитьЗапросВнешний(ЗапросТекст, Поля, ЗапросПараметры, АдаптироватьПоСоответствиям = Истина)
	
	
	Если КэшТипы = Неопределено Тогда
		КэшТипы = Новый Структура("Наружу, Внутрь", Новый Соответствие, Новый Соответствие);
	КонецЕсли;
	
	ЗапросПараметрыВнешний = СтуктураВИзСтрокиВнутр(ЗапросПараметры, Истина);
	
	Если поHTTP  Тогда
		СоответствияОбъектов = ?(АдаптироватьПоСоответствиям, ПолучитьСоответствияОбъектов().ЛокальнаяВоВнешнюю, Неопределено);
		//ЗапросПараметрыВнешний = АдаптироватьHTTP(ЗапросПараметрыВнешний, Истина, СоответствияОбъектов, КэшТипы.Наружу,мТипы);
		
		// Получение данных из базы-приемника
		ДанныеЗапроса = Новый Структура();   
		ДанныеЗапроса.Вставить("ЗапросПараметры",ЗапросПараметры);
		ДанныеЗапроса.Вставить("ЗапросТекст",ЗапросТекст); 
		ДанныеЗапроса.Вставить("Поля",Поля);

		//ЗаполнитьЗначенияСвойств(ДанныеЗапроса, ЭтаФорма);
		
		Путь = "";
		Рез  = ЗапросКБазеПриемнику("V1/Список", ДанныеЗапроса, Путь);
		Выб  = Рез[0];
		мТипы = новый Соответствие;
		тВыб = Рез[1]; 
		Для каждого стр Из тВыб Цикл
				 мТипы.Вставить( стр[0], стр[1]);
		КонецЦикла;
		
		Если Выб = Неопределено Тогда
		КонецЕсли;
	Иначе 
		Подключение = ПолучитьПодключение();
		СоответствияОбъектов = ?(АдаптироватьПоСоответствиям, ПолучитьСоответствияОбъектов().ЛокальнаяВоВнешнюю, Неопределено);
		ЗапросПараметрыВнешний = Адаптировать(ЗапросПараметрыВнешний, Истина, Подключение, СоответствияОбъектов, КэшТипы.Наружу);
		Выб = Подключение.ОбменДаннымиПереопределяемый.ВыполнитьЗапрос(ЗапросТекст,ЗапросПараметры, Поля);    //ЗапросПараметрыВнешний
	КонецЕсли;
	
	мРезультат = Новый Массив;
	Для Каждого ТекСтр Из Выб Цикл
		мСтр = Новый Массив;
		Для Каждого Зн Из ТекСтр Цикл
			мСтр.Добавить(Зн);
		КонецЦикла;
		мРезультат.Добавить(мСтр);
	КонецЦикла;
	
	СоответствияОбъектов = ?(АдаптироватьПоСоответствиям, ПолучитьСоответствияОбъектов().ВнешняяВЛокальную , Неопределено);
	
	
	Если поHTTP  Тогда
		мРезультат = АдаптироватьHTTP(мРезультат, Ложь, СоответствияОбъектов, КэшТипы.Внутрь,мТипы);
	Иначе 
		мРезультат = Адаптировать(мРезультат, Ложь, Подключение, СоответствияОбъектов, КэшТипы.Внутрь);
	КонецЕсли;
	
	Возврат мРезультат;
КонецФункции

&НаКлиенте
Функция СделатьВыборкуВнешний(Рез, ЗапросТекст, ЗапросПараметры, Внутр = Ложь, АдаптироватьПоСоответствиям = Истина)
	Рез.Вставить("Выборка",
		ВыполнитьЗапросВнешний(ЗапросТекст, Рез.Поля, ЗапросПараметры, АдаптироватьПоСоответствиям)
	);
	
	Если Не Внутр Тогда
		МассивИзВыборки(Рез);
	КонецЕсли;
