Процедура СоответствияПрочитатьЗаписатьНаСервере(ДействиеЗаписать, Выб, УзелТекстЗапроса)
	Запрос = Новый Запрос(УзелТекстЗапроса);
	Узел = Запрос.Выполнить().Выгрузить()[0].Узел;

	МЗ = РегистрыСведений.СоответствияОбъектовИнформационныхБаз.СоздатьМенеджерЗаписи();
	Стр = Новый Структура(
		"УзелИнформационнойБазы, "
		+ "ТипИсточника, УникальныйИдентификаторИсточника, УникальныйИдентификаторИсточникаСтрокой, "
		+ "ТипПриемника, УникальныйИдентификаторПриемника",
		Узел
	);

	Сч = 0;
	Для Каждого Зн Из Выб Цикл
		Сч = Сч + 1;

		ТипПриемника = Зн.ТипИсточника;
		УИДПриемника = "" + Зн.УникальныйИдентификаторИсточника.УникальныйИдентификатор();
		СлкПриемника = СсылкаИзУИД(ТипПриемника, УИДПриемника);

		ТипИсточника = Зн.ТипПриемника;
		УИДИсточника = Зн.УникальныйИдентификаторПриемника;
		СлкИсточника = СсылкаИзУИД(ТипИсточника, УИДИсточника);

		Стр.ТипИсточника = ТипИсточника;
		Стр.УникальныйИдентификаторИсточника = СлкИсточника;
		Стр.УникальныйИдентификаторИсточникаСтрокой = УИДИсточника;

		Стр.ТипПриемника = ТипПриемника;
		Стр.УникальныйИдентификаторПриемника = УИДПриемника;

		Если Не ДействиеЗаписать Тогда
			ЗаполнитьЗначенияСвойств(МЗ, Стр);
			МЗ.Прочитать();
			Если Не МЗ.Выбран() Тогда
				Сообщить("Не выбран: " + СлкИсточника);
			КонецЕсли;
		Иначе
			ЗаполнитьЗначенияСвойств(МЗ, Стр);
			МЗ.Прочитать();
			Если МЗ.Выбран() Тогда
				Продолжить;
			КонецЕсли;

			ЗаполнитьЗначенияСвойств(МЗ, Стр);
			МЗ.Записать(Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

