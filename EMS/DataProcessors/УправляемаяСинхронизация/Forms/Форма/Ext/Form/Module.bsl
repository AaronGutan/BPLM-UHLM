			"ХранилищеНастроек"
		, Сч);
		
	КонецЕсли;
КонецФункции

&НаСервере
Процедура БуферЗаполнитьИзБазыДанныхНаСервере(ПоДокументам = Истина)
	
//	БуферДляПоиска = Новый Соответствие;
////	ЗаполнитьБуферДляПоиска(Буфер, БуферДляПоиска);
//	Для Каждого Стр Из Буфер Цикл
//		БуферДляПоиска.Вставить(Стр.Значение, Истина);
//	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	Если ПоДокументам Тогда
		ДЗ = РеквизитФормыВЗначение("Состав");
		
		Для Каждого Папка Из ДЗ.Строки Цикл
			Если Не Папка.Отметка Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого ТипВид Из Папка.Строки Цикл
				Если Не ТипВид.Отметка Тогда
					Продолжить;
				КонецЕсли;
				
				Если Запрос.Текст <> "" Тогда
					Запрос.Текст = Запрос.Текст + "
						|ОБЪЕДИНИТЬ ВСЕ
						|";
				КонецЕсли;
				
				Запрос.Текст = Запрос.Текст + "
					|ВЫБРАТЬ
					|	Таблица.Ссылка
					|ИЗ
					|	" + Папка.ТипВид + "." + ТипВид.ТипВид + " КАК Таблица
					|ГДЕ
					|	Истина
					//НЕ Таблица.ПометкаУдаления
					|";
				
				Если Папка.ТипВид = "Документ" Тогда
					Запрос.Текст = Запрос.Текст + "
						| И Таблица.Дата между &НачалоПериода И &КонецПериода
						|";
				КонецЕсли;
				Если Не Организация.Пустая() Тогда
					Если      ТипВид.Родитель.ТипВид = "Справочник" Тогда
						МД = Метаданные.Справочники;
					ИначеЕсли ТипВид.Родитель.ТипВид = "Документ" Тогда
						МД = Метаданные.Документы;
					ИначеЕсли ТипВид.Родитель.ТипВид = "ПланСчетов" Тогда
						МД = Метаданные.ПланыСчетов;
					ИначеЕсли ТипВид.Родитель.ТипВид = "ПланВидовРасчета" Тогда
						МД = Метаданные.ПланыВидовРасчета;
					ИначеЕсли ТипВид.Родитель.ТипВид = "ПланВидовХарактеристик" Тогда
						МД = Метаданные.ПланыВидовХарактеристик;
					ИначеЕсли ТипВид.Родитель.ТипВид = "РегистрСведений" Тогда
						МД = Метаданные.РегистрыСведений;
					КонецЕсли;
					МД = МД[ТипВид.ТипВид];
					
					ГдеИскать = Неопределено;
					Если ТипВид.Родитель.ТипВид = "Справочник"
					 Или ТипВид.Родитель.ТипВид = "Документ"
					Тогда
						ГдеИскать = МД.Реквизиты;
					ИначеЕсли  ТипВид.Родитель.ТипВид = "РегистрСведений" Тогда
						ГдеИскать = МД.Измерения;
					КонецЕсли;
					
					Если ГдеИскать <> Неопределено И ГдеИскать.Найти("Организация") <> Неопределено Тогда
						Запрос.Текст = Запрос.Текст + "
							| И Таблица.Организация в  Иерархии (&Организация)
							|";
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ХозрасчетныйОбороты.Регистратор КАК Ссылка
		               |ИЗ
		               |	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &КонецПериода, Регистратор, Счет В Иерархии (&Счет), , Организация = &Организация, , ) КАК ХозрасчетныйОбороты";
		
		Если ЗначениеЗаполнено(Счет) Тогда
			Запрос.УстановитьПараметр("Счет", Счет);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Счет В Иерархии (&Счет)", "");
		КонецЕсли;
		
	КонецЕсли;
	
	Если Запрос.Текст = "" Тогда
		Возврат;
	КонецЕсли;
	
	//Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеНаДату", "И Таблица.Дата между &НачалоПериода И &КонецПериода");
	
	Запрос.УстановитьПараметр("Организация"  , Организация);
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала   );
	Запрос.УстановитьПараметр("КонецПериода" , Период.ДатаОкончания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьВБуферЗначениеНаСервере(Выборка.Ссылка);
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция СохраняемоеЗначениеВРегистрируемоеЗначение(Ссылка)
	ОЗн = ОЗначении(Ссылка);
	
	Значение = Ссылка;
	
	Если ОЗн.ЭтоРегистр Тогда // Регистры: Ключ записи в Набор записей
		Если ОЗн.ПоРегистратору Тогда
			Значение = Ссылка.Регистратор;
		Иначе
			Если      ОЗн.Тип = "РегистрыСведений" Тогда
				Менеджер = РегистрыСведений;
			ИначеЕсли ОЗн.Тип = "РегистрыНакопления" Тогда
				Менеджер = РегистрыНакопления;
			КонецЕсли;
			НЗ = Менеджер[ОЗн.Вид].СоздатьНаборЗаписей();
			ЗаполнитьЗначенияСвойств(НЗ.Отбор, Ссылка);
			
			Для Каждого Эл Из НЗ.Отбор Цикл
				Эл.Значение = Ссылка[Эл.Имя];
				Эл.Использование = Истина;
			КонецЦикла;
			
			Значение = НЗ;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Значение;
КонецФункции

&НаСервереБезКонтекста
Функция ТекстОшибкиРегистрацииИзменений(Узел, Значение)
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат НСтр("ru='Не выбран узел плана обмена.'");
	КонецЕсли;
	
	МетаданныеПлана = Узел.Метаданные();
	Если Узел = ПланыОбмена[МетаданныеПлана.Имя].ЭтотУзел() Тогда
		Возврат НСтр("ru='Выбран этот узел (текущая информационная база). Регистрировать изменения можно только для узла-корреспондента.'");
	КонецЕсли;
	
	МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Если МетаданныеОбъекта = Неопределено Тогда
		Попытка
			МетаданныеОбъекта = Значение.Метаданные();
		Исключение
			Возврат НСтр("ru='Не удалось определить метаданные регистрируемого объекта.'");
		КонецПопытки;
	КонецЕсли;
	
	ОбъектВСоставе = Ложь;
	Для Каждого ЭлементСостава Из МетаданныеПлана.Состав Цикл
		Если ЭлементСостава.Метаданные = МетаданныеОбъекта Тогда
			ОбъектВСоставе = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ОбъектВСоставе Тогда
		Возврат СтрШаблон(
			НСтр("ru='Объект %1 не входит в состав плана обмена %2.'"),
			МетаданныеОбъекта.ПолноеИмя(),
			МетаданныеПлана.Имя);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОбъектНаСервере(Узел, Ссылка) Экспорт
	Значение = СохраняемоеЗначениеВРегистрируемоеЗначение(Ссылка);
	
	Если Значение = Неопределено Тогда
		Сообщить("Пустое значение: " + Ссылка);
		Возврат;
	КонецЕсли;
	
	ТекстОшибкиПроверки = ТекстОшибкиРегистрацииИзменений(Узел, Значение);
	Если ЗначениеЗаполнено(ТекстОшибкиПроверки) Тогда
		Сообщить(""
			+ "Ошибка регистрации объекта "
			+ "(" + Метаданные.НайтиПоТипу(ТипЗнч(Ссылка)) + " / " + ТипЗнч(Ссылка) + "): "
			+ Ссылка + Символы.ПС
			+ ТекстОшибкиПроверки
		);
		Возврат;
	КонецЕсли;
	
	Попытка
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, Значение);
	Исключение
		Сообщить(""
			+ "Ошибка регистрации объекта "
			+ "(" + Метаданные.НайтиПоТипу(ТипЗнч(Ссылка)) + " / " + ТипЗнч(Ссылка) + "): "
			+ Ссылка + Символы.ПС
			+ ОписаниеОшибки()
		);
	КонецПопытки;
КонецПроцедуры


