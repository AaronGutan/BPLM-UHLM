&НаСервереБезКонтекста
Процедура ОчиститьПереданныеНаСервере(Буфер, Узел)
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника КАК Ссылка
	                      |ИЗ
	                      |	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	                      |ГДЕ
	                      |	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы = &Узел
	                      |	И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника В(&Ссылки)");
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("Ссылки", Буфер.ВыгрузитьЗначения());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЭлементСписка = Буфер.НайтиПоЗначению(Выборка.Ссылка);
		Буфер.Удалить(ЭлементСписка);
		
	КонецЦикла;	
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция СтрокаВнутрВСтруктуруОбработатьСтруктуру(ТекСЗ)
	ТекСЗ.Строка = "";
	Для Каждого Тек Из ТекСЗ.Элементы Цикл
		ТекСЗ.Строка = ТекСЗ.Строка
			+ ?(ТекСЗ.Строка <> "", ", ", "")
			+ ?(ТипЗнч(Тек) = Тип("Строка"), Тек, Тек.Строка)
		;
	КонецЦикла;
	ТекСЗ.Строка = "{" + ТекСЗ.Строка + "}";
	
	Значение = Неопределено;
	Попытка
		Значение = ЗначениеИзСтрокиВнутр(ТекСЗ.Строка);
	Исключение
	КонецПопытки;
	ТекСЗ.Вставить("Значение", Значение);
КонецФункции

&НаСервереБезКонтекста
Функция СтрокаВнутрВСтруктуру(Стр) Экспорт
	ТекСЗ = Неопределено;
	
	Ном = 1;
	
	Сч = 0;
	
	Кол = СтрДлина(Стр);
	
	СтрокаОткрыта = Ложь;
	
	Пока Истина Цикл
		НайтиКавч = СтрНайти(Стр, """",, Ном); НайтиКавч = ?(НайтиКавч <> 0, НайтиКавч, Кол);
		НайтиОткр = СтрНайти(Стр, "{" ,, Ном); НайтиОткр = ?(НайтиОткр <> 0, НайтиОткр, Кол);
		НайтиЗакр = СтрНайти(Стр, "}" ,, Ном); НайтиЗакр = ?(НайтиЗакр <> 0, НайтиЗакр, Кол);
		
		Если      НайтиОткр = Ном Тогда
			НовСЗ = Новый Структура("Родитель, Элементы, Строка", ТекСЗ, Новый Массив, "");
			Если ТекСЗ <> Неопределено Тогда
				ТекСЗ.Элементы.Добавить(НовСЗ);
			КонецЕсли;
			ТекСЗ = НовСЗ;
			Ном = Ном + 1;
			
		ИначеЕсли НайтиЗакр = Ном Тогда
			СтрокаВнутрВСтруктуруОбработатьСтруктуру(ТекСЗ);
				
			ТекСЗ = ТекСЗ.Родитель;
			Ном = Ном + 1;
			
		Иначе
			Элты = Сред(Стр, Ном, Мин(НайтиОткр, НайтиЗакр) - Ном);
			Элты = СтрРазделить(Элты, ",", Истина);
			
			Если ТекСЗ.Элементы.Количество() > 0 Тогда
				Элты.Удалить(0);
			КонецЕсли;
			Если НайтиОткр < НайтиЗакр Тогда
				Элты.Удалить(Элты.Количество() - 1);
			КонецЕсли;
			
			Для Каждого Эл Из Элты Цикл
				ТекСЗ.Элементы.Добавить(Эл);
			КонецЦикла;
			Ном = Мин(НайтиОткр, НайтиЗакр);
			
		КонецЕсли;
		
		Если Ном = Кол Тогда
			Прервать;
		КонецЕсли;
		
		Сч = Сч + 1;
		Если Сч > 100 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаВнутрВСтруктуруОбработатьСтруктуру(ТекСЗ);
			
	Возврат ТекСЗ;
КонецФункции

&НаСервереБезКонтекста
Функция ОЗначении(Значение)
	МД = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	ЭтоРегистр = Ложь;
	ПоРегистратору = Неопределено;
	Тип = ""; Вид = МД.Имя;
	Если      Метаданные.РегистрыСведений  .Содержит(МД) Тогда
		ЭтоРегистр = Истина;
		ПоРегистратору = МД.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору;
		Тип = "РегистрыСведений";
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(МД) Тогда
		ЭтоРегистр = Истина;
		ПоРегистратору = Истина;
		Тип = "РегистрыНакопления";
	КонецЕсли;
	
	Открываемое = Значение;
	Представление = "" + Значение;
	
	Если ЭтоРегистр Тогда
		Представление = "";
		Если ПоРегистратору Тогда
			Открываемое = Значение.Регистратор;
			Представление = "" + Значение.Регистратор + " (по регистратору)";
		Иначе
			Для Каждого Изм Из МД.Измерения Цикл
				Если Изм.ОсновнойОтбор Тогда
					Представление = Представление
						+ ?(Представление <> "",  ", ", "")
						+ Значение[Изм.Имя]
					;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Представление = МД.Синоним + ": " + Представление;
	КонецЕсли;
	
//	ЭтоКЗ = Тип = Тип("РегистрСведенийКлючЗаписи." + МД.Имя);
	
	Возврат Новый Структура(
		"Представление, Открываемое, ЭтоРегистр, Тип, Вид, ПоРегистратору",
		 Представление, Открываемое, ЭтоРегистр, Тип, Вид, ПоРегистратору
	);
КонецФункции

&НаСервере
Процедура ДобавитьВБуферЗначениеНаСервере(Значение, ВНачало = Ложь);
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	Пред = ОЗначении(Значение).Представление;
	
	Если ВНачало Тогда
		Буфер.Вставить(0, Значение, Пред);
	Иначе
		Буфер.Добавить(Значение, Пред);
	КонецЕсли;
