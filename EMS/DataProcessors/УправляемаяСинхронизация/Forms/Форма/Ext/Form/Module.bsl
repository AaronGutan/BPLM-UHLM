&НаСервере
Процедура ОтметитьСоставНаСервере(Способ)
	Если Истина Тогда
		ДЗ = РеквизитФормыВЗначение("Состав");
	Иначе // для синтаксиса )
		ДЗ = Новый ДеревоЗначений;
	КонецЕсли;
	
	Если Способ = "Типовой" Тогда
		Типовые = ПолучитьТиповыеВиды();
	ИначеЕсли Способ = "Хозрасчетный" Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
		                      |	ТИПЗНАЧЕНИЯ(ХозрасчетныйОбороты.Регистратор) КАК ТипДокумента
		                      |ИЗ
		                      |	РегистрБухгалтерии.Хозрасчетный.Обороты(&ДатаНачала, &ДатаОкончания, Регистратор, , , Организация = &Организация, , ) КАК ХозрасчетныйОбороты");
		Запрос.УстановитьПараметр("Организация"  , Организация);
		Запрос.УстановитьПараметр("ДатаНачала"   , Период.ДатаНачала   );
		Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
		
		Выборка = Запрос.Выполнить().Выбрать();
		ТипыХозр = Новый Массив;
		Пока Выборка.Следующий() Цикл
			ТипыХозр.Добавить(""
				+ ТипОбъекта(Выборка.ТипДокумента, "Запрос")
				+ "."
				+ Метаданные.НайтиПоТипу(Выборка.ТипДокумента).Имя
			);
		КонецЦикла;
	КонецЕсли;			
	
	Для Каждого Папка Из ДЗ.Строки Цикл
		Для Каждого ТипВид Из Папка.Строки Цикл
			Если Способ = "Очистить" Тогда
				ТипВид.Отметка = Ложь;
			ИначеЕсли Способ = "Все" Тогда
				ТипВид.Отметка = Истина;
			ИначеЕсли Способ = "Типовой" Тогда
				ТипВид.Отметка = Типовые.Найти(Папка.ТипВид + "." + ТипВид.ТипВид) <> Неопределено;
			ИначеЕсли Способ = "Хозрасчетный" Тогда
				ТипВид.Отметка = ТипыХозр.Найти(Папка.ТипВид + "." + ТипВид.ТипВид) <> Неопределено;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДЗ, "Состав");
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьСостав(Команда)
	ОтметитьСоставНаСервере(СтрЗаменить(Команда.Имя, "ОтметитьСостав", ""));
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСинхронизациюКоманда(Команда)
	ВыполнятьИтерациями = Команда.Имя = "ВыполнитьСинхронизациюИтерациями";
	ВыполнитьСинхронизацию(ВыполнятьИтерациями);
КонецПроцедуры

&НаКлиенте
Процедура БуферЗаполнитьИзБазыДанных(Команда)
	Если Вопрос("Выбрать объекты базы данных в буфер?", РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	БуферЗаполнитьИзБазыДанныхНаСервере(Команда.Имя = "БуферЗаполнитьИзДокументов");
	
	ПосчитатьБуфер();
	
КонецПроцедуры

