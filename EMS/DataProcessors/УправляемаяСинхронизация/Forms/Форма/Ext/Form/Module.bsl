	                      |	Соответствия.УникальныйИдентификаторИсточника КАК Ссылка
	                      |ИЗ
	                      |	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соответствия
	                      |ГДЕ
	                      |	Соответствия.ТипИсточника = (ВЫРАЗИТЬ(&ТипИсточника КАК СТРОКА(1000)))
	                      |	И Соответствия.УзелИнформационнойБазы = &УзелИнформационнойБазы");
	Запрос.УстановитьПараметр("УзелИнформационнойБазы", Узел);
	Запрос.УстановитьПараметр("ТипИсточника", ТипИсточника);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

