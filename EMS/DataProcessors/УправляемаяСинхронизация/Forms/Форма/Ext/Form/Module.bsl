		Возврат;
	КонецЕсли;
	
	БуферОставитьВыбранныеТипыНаСервере();
	
	ПосчитатьБуфер();
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаИзБуфераНаСервере()
	Таблица.Очистить();
	
	НомСтр = 1;
	Таблица.Область(НомСтр, 1).Текст = "Тип";
	Таблица.Область(НомСтр, 2).Текст = "Вид";
	Таблица.Область(НомСтр, 3).Текст = "УИд";
	Таблица.Область(НомСтр, 4).Текст = "Версия";
	Таблица.Область(НомСтр, 5).Текст = "Представление";
	
	Для Каждого Элемент Из Буфер Цикл
		НомСтр = НомСтр + 1;
		
		Таблица.Область(НомСтр, 1).Текст = ТипОбъекта(Элемент.Значение);
		Таблица.Область(НомСтр, 2).Текст = Элемент.Значение.Метаданные().Имя;
		Таблица.Область(НомСтр, 3).Текст = Элемент.Значение.УникальныйИдентификатор();
		Таблица.Область(НомСтр, 4).Текст = Элемент.Значение.ВерсияДанных;
		Таблица.Область(НомСтр, 5).Текст = Элемент.Значение;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИзБуфера(Команда)
	ТаблицаИзБуфераНаСервере();
КонецПроцедуры

&НаСервере
Процедура ТаблицаВБуферНаСервере()
	Буфер.Очистить();
	
	Для НомСтр = 2 По Таблица.ВысотаТаблицы Цикл
		Тип = Таблица.Область(НомСтр, 1).Текст;
		Вид = Таблица.Область(НомСтр, 2).Текст;
		УИД = Таблица.Область(НомСтр, 3).Текст;
		Вер = Таблица.Область(НомСтр, 4).Текст;
		Пре = Таблица.Область(НомСтр, 5).Текст;
		
		Тип = Вычислить(Тип);
		Вид = Тип[Вид];
		Ссылка = Вид.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
		
		ДобавитьВБуферЗначениеНаСервере(Ссылка);
	КонецЦикла;
КонецПроцедуры

