// Создает и устанавливает реквизиты диалога выбора файла.
//
// Параметры
//  МножественныйВыбор – Булево, признак множественного выбора.
//  НачальныйКаталог – Строка, содержащая начальный каталог выбора файла.
//  Фильтр - Строка, фильтр диалога
//
// Возвращаемое значение:
//   Выбранный/ые файл/ы
//
&НаКлиенте
Функция ВыбратьФайл(Знач Режим = Неопределено, Знач Фильтр = "", МножественныйВыбор = Ложь, НачальныйКаталог = "", ПредварительныйПросмотр = Ложь, ПолноеИмяФайла = "") Экспорт
	Если Режим = Неопределено Тогда
		Режим = РежимДиалогаВыбораФайла.Открытие;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(Режим);
	
	Диалог.Заголовок = ?(Режим = РежимДиалогаВыбораФайла.ВыборКаталога, "Выбор каталога", "" + Режим + " файл" + ?(МножественныйВыбор, "ов", "а")) + "...";
	
	Диалог.Каталог = НачальныйКаталог;
	Диалог.ПолноеИмяФайла = СокрЛП(ПолноеИмяФайла);
	
	Если Фильтр = "" Тогда
		Фильтр = "Все файлы (*.*)|*.*|"
	      + "Текстовый документ (*.txt)|*.txt|"
	      + "Табличный документ (*.mxl)|*.mxl|"
	      + "eXtensible Markup Language (*.xml)|*.xml|"
	      + "Картинки (*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.gif;*.png;*.ico;*.wmf;*.emf)|*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.gif;*.png;*.ico;*.wmf;*.emf|"
	      + "Документ Microsoft Word (*.doc;*.docx)|*.doc;*.docx|"
	      + "Документ Microsoft Excel (*.xls;*.xlsx)|*.xls;*.xlsx|"
	      + "Документ Microsoft PowerPoint (*.ppt)|*.ppt|"
	      + "Документ Microsoft Visio (*.vsd)|*.vsd|"
	      + "Письмо электронной почты (*.msg)|*.msg|"
		;
	КонецЕсли;
	Диалог.Фильтр = Фильтр;
	
	Диалог.ПредварительныйПросмотр = ПредварительныйПросмотр;
	Диалог.МножественныйВыбор = МножественныйВыбор;
	
	Диалог.ПроверятьСуществованиеФайла = Истина;
	
	Если Не Диалог.Выбрать() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если МножественныйВыбор Тогда
		Возврат Диалог.ВыбранныеФайлы;
	Иначе
		Возврат Диалог.ПолноеИмяФайла;
	КонецЕсли;
КонецФункции // ВыбратьФайл()

Функция Ф(Расш)
	Возврат ""
		+ "Список управляемой синхронизации (*." + Расш + ")|*." + Расш + "|"
		+ "Все файлы (*.*)|*.*|"
	;
КонецФункции

