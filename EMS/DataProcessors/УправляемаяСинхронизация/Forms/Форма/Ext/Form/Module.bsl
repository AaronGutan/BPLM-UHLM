&НаСервере
Процедура БуферОставитьВыбранныеТипыНаСервере()
	сТипы = Новый Структура;
	Для Каждого ТекТип Из Состав.ПолучитьЭлементы() Цикл
		Если Не ТекТип.Отметка Тогда
			Продолжить;
		КонецЕсли;

		сВиды = Новый Структура;
		сТипы.Вставить(ТекТип.ТипВид, сВиды);
		Для Каждого ТекВид Из ТекТип.ПолучитьЭлементы() Цикл
			Если Не ТекВид.Отметка Тогда
				Продолжить;
			КонецЕсли;
			
			сВиды.Вставить(ТекВид.ТипВид);
		КонецЦикла;
	КонецЦикла;
	
	мУдаляемые = Новый Массив;
	Для Каждого ТекБуфер Из Буфер Цикл
		ТекТип = ТипОбъекта(ТекБуфер.Значение, "Запрос");
		Если Не сТипы.Свойство(ТекТип) Или Не сТипы[ТекТип].Свойство(ТекБуфер.Значение.Метаданные().Имя) Тогда
			мУдаляемые.Добавить(ТекБуфер);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекБуфер Из мУдаляемые Цикл
		Буфер.Удалить(ТекБуфер);
	КонецЦикла;
КонецПроцедуры

