// Регистрируем набор записей
// Отбор - на измерения, у которых стоит Основной отбор
&НаСервере
Функция ЗарегистрироватьНаборЗаписейРегистраСведений(Узел, ИмяРегистра, Отбор) Экспорт
	Если Истина Тогда
		НЗ = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	Иначе
		НЗ = РегистрыСведений.ПорядокОтраженияЗарплатыВБухУчете.СоздатьНаборЗаписей();
	КонецЕсли;
	
	НЗ.Отбор.СпособОтраженияЗарплатыВБухУчете.Установить(Отбор.СпособОтраженияЗарплатыВБухУчете);
	НЗ.Отбор.ЕНВД.Установить(Отбор.ЕНВД);
	
	ПланыОбмена.ЗарегистрироватьИзменения(Узел, НЗ);
КонецФункции


&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, ДПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	
	Инициализация = ДПараметры.Инициализация;
	ВыполнятьИтерациями = ДПараметры.ВыполнятьИтерациями;
	
	Если Инициализация Тогда
		
		ОбСтарт = ""; ОбИтер = 0; ОбКол = 0; ОбУдел = 0; ОбФиниш = "";
		ВыСтарт = ""; ВыИтер = 0; ВыКол = 0; ВыУдел = 0; ВыФиниш = "";
		ПрСтарт = ""; ПрИтер = 0; ПрКол = 0; ПрУдел = 0; ПрФиниш = "";
		ТкСтарт = ""; ТкИтер = 0; ТкКол = 0; ТкУдел = 0; ТкФиниш = "";
		
		ТД = ТекущаяДата();
		ОбСтарт = ТД; ОбИтер = 1; ОбКол  = 0; // замер иниц обмен
	КонецЕсли;
	
	Если ВыполнятьИтерациями И СинхронизацияПолучатьОбъектыИзРегистрации Тогда
		ОбработатьОбъектыРегистрацииНаСервере(Узел, ОбработатьОбъектыРегистрацииОтправленные, ОбработатьОбъектыРегистрацииНеОтправленные, ОбработатьОбъектыРегистрацииПолучитьВБуфер, ОбработатьОбъектыРегистрацииПолучитьВБуферВНачало, ОбработатьОбъектыРегистрацииПосчитать, ОбработатьОбъектыРегистрацииУдалить);
	КонецЕсли;
	
	ТД = ТекущаяДата();
	Если ВыполнятьИтерациями Тогда
		Остаток = Буфер.Количество();
		КПереносу = Мин(КоличествоОбъектовВИтерации, Остаток);
		
		
		Если Не Инициализация Тогда
			ТкФиниш = ТД; ТкУдел = ?(ТкКол > 0, (ТкФиниш - ТкСтарт) / ТкКол, 0); // замер финиш текущая
			
			ПрСтарт = ТкСтарт; ПрИтер = ТкИтер; ПрКол = ТкКол; ПрУдел = ТкУдел; ПрФиниш = ТкФиниш; // замер финиш предыдущая
			
			ВыКол = ВыКол + ТкКол; ВыИтер = ВыИтер + ТкИтер; // замер финиш выгружено
			ВыФиниш = ТД; ВыУдел = ?(ВыКол > 0, (ВыФиниш - ВыСтарт) / ВыКол, 0);
		КонецЕсли;
		
		ОбИтер = ВыИтер + Окр(Остаток / КоличествоОбъектовВИтерации + 0.5, 0, РежимОкругления.Окр15как20); // замер финиш обмен
		ОбКол  = ВыКол + Остаток;
		
		
		Если ПрКол = 0 И КПереносу = 0 Тогда
			ОбКол = ВыКол; ОбФиниш = ВыФиниш; ОбУдел = ВыУдел;
			
			Заголовок = "Управляемая синхронизация";
			
			Предупреждение("Синхронизация выполнена");
			
			Возврат;
		КонецЕсли;
		
		
		ТкСтарт = ТД; ТкИтер = 1; ТкКол = КПереносу; // замер старт текущая
		Если Инициализация Тогда
			ОбСтарт = ТД;
			ВыСтарт = ТД;
		Иначе
			ТкУдел = ПрУдел;
			ТкФиниш = ТкСтарт + ТкКол * (ПрФиниш - ПрСтарт) / ПрКол; // прогноз
			
			ОбУдел = ПрУдел;
			ОбФиниш = ТД + Остаток * (ПрФиниш - ПрСтарт) / ПрКол; // прогноз
		КонецЕсли;
		
		Заголовок = "Управляемая синхронизация " + Формат(ВыКол / ОбКол * 100, "ЧДЦ=0; ЧН=; ЧГ=") + "%";
		
		ЗарегистрироватьБуфер(КоличествоОбъектовВИтерации);
		
	Иначе
		Если Не Инициализация Тогда
			ОбФиниш = ТД;
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ДопПараметры = Новый Структура("ВыполнятьИтерациями", ВыполнятьИтерациями);
	Оповещение = Новый ОписаниеОповещения("ВызватьПослеИтерации", ЭтаФорма, ДопПараметры);
	ДПО = Новый Структура("ПараметрыПомощника, ОповещениеОЗакрытии", Новый Структура("ЗакрытьПриУспешнойСинхронизации", Истина), Оповещение);
	
	ОбменДаннымиКлиент.ВыполнитьОбменДаннымиОбработкаКоманды(Узел, ЭтаФорма,,, ДПО);
	

КонецПроцедуры
		


