&НаСервере
Процедура ОбработатьОбъектыРегистрацииНаСервере(Узел, Отправленные, НеОтправленные, ПолучитьВБуфер, ПолучитьВБуферВНачало, Посчитать, Удалить)
	Запросы = Новый Соответствие;
	Для Каждого ЭлСостав Из Узел.Метаданные().Состав Цикл
		МД = ЭлСостав.Метаданные;
		Тип = ТипОбъекта(МД, "Запрос");
		
		// В таблице изменений ссылочных объектов есть поле Ссылка.
		// У регистров, констант и последовательностей его нет: Регистратор или только Узел.
		Если Тип <> "Справочник"
			И Тип <> "Документ"
			И Тип <> "ПланВидовХарактеристик"
			И Тип <> "ПланСчетов"
			И Тип <> "ПланВидовРасчета"
			И Тип <> "БизнесПроцесс"
			И Тип <> "Задача"
			И Тип <> "ПланОбмена" Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = "Ссылка";
		Измерения = "Ссылка";
		ИзмеренияПути = "ТаблицаИзменения.Ссылка КАК Ссылка";
		УсловиеСоединения = "";
		
		Если Тип = "РегистрСведений" Тогда
			
			Продолжить;
			
			Если МД.Измерения.Количество()  = 0 Тогда 
				
				Продолжить;
			
			КонецЕсли;  
			
			Если МД.Имя = "НастройкиРасчетаЗарплатыРасширенный" 
				или МД.Имя = "ПравилаДляОбменаДанными" 
				или МД.Имя = "СообщенияОбменаДаннымиОбластейДанных" 
				или МД.Имя = "ОчередьРасширенийДляОповещений"
				или МД.Имя = "ПараметрыОбменСБанками" 
				или МД.Имя = "МинимальнаяОплатаТрудаРФ"
				или МД.Имя = "РазрешенияНаИспользованиеВнешнихРесурсовВМоделиСервиса" 
				или МД.Имя = "ИспользуемыеВидыДоступа" Тогда 
				
				Продолжить;
				
			КонецЕсли;
			
			Ключ = Тип + "." + МД.Имя;
			
			мИзмерения = Новый Массив;
			ИзмеренияПути = Новый Массив;
			
			Периодический  = МД.ПериодичностьРегистраСведений
				<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический
			;
			ПоРегистратору = МД.РежимЗаписи
				= Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору
			;
			
			Если ПоРегистратору Тогда
				мИзмерения   .Добавить("Регистратор");
				ИзмеренияПути.Добавить("ТаблицаИзменения.Регистратор");
			Иначе
				Если Периодический Тогда
					мИзмерения   .Добавить("Период");
					ИзмеренияПути.Добавить("ТаблицаРегистр.Период КАК Период");
				КонецЕсли;
				
					Для Каждого ТекИзм Из МД.Измерения Цикл
						Если Не ТекИзм.ОсновнойОтбор Тогда
							Продолжить;
						КонецЕсли;
						
						мИзмерения   .Добавить(ТекИзм.Имя);
						ИзмеренияПути.Добавить("ТаблицаИзменения." + ТекИзм.Имя + " КАК " + ТекИзм.Имя);
						
						УсловиеСоединения = УсловиеСоединения
						+ ?(УсловиеСоединения <> "", Символы.ВК + "			И ", "")
						+ "ТаблицаИзменения." + ТекИзм.Имя + " = ТаблицаРегистр." + ТекИзм.Имя
						;
					КонецЦикла;
					
					//Если УсловиеСоединения <>""  Тогда
						
						УсловиеСоединения = "
						|		ЛЕВОЕ СОЕДИНЕНИЕ " + Тип + "." + МД.Имя + " КАК ТаблицаРегистр
						|		ПО " + УсловиеСоединения + "
						|";
						
					//КонецЕсли;
									
				
			КонецЕсли;
			
			Измерения = СтрСоединить(мИзмерения, ", ");
			ИзмеренияПути = СтрСоединить(ИзмеренияПути, ", " + Символы.ВК);
			
		ИначеЕсли Тип = "РегистрНакопления" Тогда
			Продолжить;
		ИначеЕсли Тип = "РегистрРасчета" Тогда
			Продолжить;
		ИначеЕсли Тип = "РегистрБухгалтерии" Тогда
			Продолжить;
		КонецЕсли;
		
		СтрЗапрос = Запросы.Получить(Ключ);
		Если НЕ ЗначениеЗаполнено(СтрЗапрос) Тогда
			СтрЗапрос = Новый Структура("Тип, Измерения, Текст", Ключ, Измерения, "");
			Запросы.Вставить(Ключ, СтрЗапрос);
		КонецЕсли;
		Текст = СтрЗапрос.Текст;
		
		Если НЕ ЗначениеЗаполнено(Текст) Тогда
			Текст = "";
		Иначе
			Текст = Текст + "
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|";
		КонецЕсли;
		
		Текст = Текст + "
			|ВЫБРАТЬ
	        |	""" + Тип + "." + МД.Имя + """ КАК Тип,
			|";
		
		Если Посчитать Тогда
			Текст = Текст + "
					| СУММА(1) КАК Количество
					|";
		Иначе
			Текст = Текст + "
			        |	" + ИзмеренияПути + "
					|";
		КонецЕсли;
		
		Текст = Текст + "
		        |ИЗ
		        |	" + Тип + "." + МД.Имя + ".Изменения КАК ТаблицаИзменения
				|";
		
		Текст = Текст + УсловиеСоединения;
		
		Текст = Текст + "
		        |ГДЕ
		        |	ТаблицаИзменения.Узел = &Узел
				|";
		
		Если Посчитать Тогда
			Текст = Текст + "
		        |СГРУППИРОВАТЬ ПО
		        |	ТаблицаИзменения.Узел
				|";
		КонецЕсли;
		
		Если      Не НеОтправленные И Не Отправленные Тогда // Ничего
			Текст = Текст + "
				|	И Ложь
				|";
		ИначеЕсли Не НеОтправленные И    Отправленные Тогда // Отправленные
			Текст = Текст + "
				|	И Не ТаблицаИзменения.НомерСообщения Есть NULL
				|";
		ИначеЕсли    НеОтправленные И Не Отправленные Тогда // Не отправленные
			Текст = Текст + "
				|	И ТаблицаИзменения.НомерСообщения Есть NULL
				|";
		ИначеЕсли    НеОтправленные И    Отправленные Тогда // Все
		КонецЕсли;
		
		СтрЗапрос.Текст = Текст;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Сч = -1;
	Для Каждого СтрЗапрос Из Запросы Цикл
		Сч = Сч + 1;
		
		Запрос.Текст = Запрос.Текст + СтрЗапрос.Значение.Текст + "
				|
				|;
				|
				|";
		
		СтрЗапрос.Значение.Вставить("Номер", Сч);
	КонецЦикла;
	
	Если Запросы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Узел", Узел);
	мВыборки = Запрос.ВыполнитьПакет();
	
	Для Каждого СтрЗапрос Из Запросы Цикл
		
		//Если Лев(СтрЗапрос.Ключ, 16) = "РегистрСведений." Тогда
		//	Выборка = ПланыОбмена.ВыбратьИзменения(Узел, , );
		//Иначе
			Выборка = мВыборки[СтрЗапрос.Значение.Номер].Выбрать();
		//КонецЕсли;
		
		Пока Выборка.Следующий() Цикл
			Если Посчитать Тогда
				Сообщить(Выборка.Тип + " - " + Выборка.Количество);
			Иначе
				Если Лев(СтрЗапрос.Ключ, 16) = "РегистрСведений." Тогда
					Отбор = Новый Структура(СтрЗапрос.Значение.Измерения);
					ЗаполнитьЗначенияСвойств(Отбор, Выборка);
					Значение = РегистрыСведений[СтрЗаменить(СтрЗапрос.Ключ, "РегистрСведений.", "")].СоздатьКлючЗаписи(Отбор);
					
				Иначе
					Значение = Выборка.Ссылка;
					
				КонецЕсли;
				
				Если ПолучитьВБуфер Тогда
					ДобавитьВБуферЗначениеНаСервере(Значение, ПолучитьВБуферВНачало);
				КонецЕсли;
				
				Если Удалить Тогда
					
					Если Лев(СтрЗапрос.Ключ, 16) = "РегистрСведений." Тогда
						Значение = СохраняемоеЗначениеВРегистрируемоеЗначение(Значение);
					КонецЕсли;
					
					ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Значение);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбъектыРегистрации(Команда)
	//Если Вопрос("Обработать объекты регистрации?", РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет) <> КодВозвратаДиалога.Да Тогда
	//	Возврат;
	//КонецЕсли;    
	//
	ДополнительныеПараметры1 = Новый Структура;
	ПоказатьВопрос(Новый ОписаниеОповещения("ОбработатьОбъектыРегистрацииВопрос", ЭтотОбъект,ДополнительныеПараметры1),"Обработать объекты регистрации?",
	РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбъектыРегистрацииВопрос(РезультатВопроса,ДополнительныеПараметры1) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ОбработатьОбъектыРегистрацииПосчитать Тогда
			ОчиститьСообщения();
		КонецЕсли;
		
		ОбработатьОбъектыРегистрацииНаСервере(Узел, ОбработатьОбъектыРегистрацииОтправленные, ОбработатьОбъектыРегистрацииНеОтправленные, ОбработатьОбъектыРегистрацииПолучитьВБуфер, ОбработатьОбъектыРегистрацииПолучитьВБуферВНачало, ОбработатьОбъектыРегистрацииПосчитать, ОбработатьОбъектыРегистрацииУдалить);
		
		Если ОбработатьОбъектыРегистрацииПолучитьВБуфер Тогда
			ПосчитатьБуфер();
		КонецЕсли;
		
	Иначе 
		Возврат;	
	КонецЕсли;	

КонецПроцедуры


&НаКлиенте
Процедура УзелПриИзменении(Элемент)
	ЗаполнитьСостав();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСостав(ИзПланаОбмена = Истина)
	Если Истина Тогда
		ДЗ = РеквизитФормыВЗначение("Состав");
	Иначе // для синтаксиса )
		ДЗ = Новый ДеревоЗначений;
	КонецЕсли;
	
	ДЗ.Строки.Очистить();
	
	соТипы = Новый СписокЗначений;
	соТипы.Добавить("Справочник", "Справочники");
	соТипы.Добавить("Документ", "Документы");
	соТипы.Добавить("ПланСчетов", "Планы счетов");
	соТипы.Добавить("ПланВидовРасчета", "Планы видов расчета");
	соТипы.Добавить("ПланВидовХарактеристик", "Планы видов характеристик");
	соТипы.Добавить("РегистрСведений", "Регистры сведений");
	
	Для Каждого кзПапка Из соТипы Цикл
		Папка = ДЗ.Строки.Добавить();
		Папка.ТипВид = кзПапка.Значение;
		Папка.Представление = кзПапка.Представление;
	КонецЦикла;
	
	Если ИзПланаОбмена Тогда
		Для Каждого ЭлСостав Из Узел.Метаданные().Состав Цикл
			Тип = ТипОбъекта(ЭлСостав.Метаданные, "Запрос");
			
			Папка = ДЗ.Строки.Найти(Тип, "ТипВид", Ложь);
			Если Папка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Стр = Папка.Строки.Добавить();
			Стр.ТипВид = ЭлСостав.Метаданные.Имя;
			Стр.Представление = ЭлСостав.Метаданные.Синоним;
		КонецЦикла;
		
	Иначе
		Для Каждого ТекТип Из соТипы Цикл
			МДТип = Метаданные[СтрЗаменить(ТекТип.Представление, " ", "")];
			Папка = ДЗ.Строки.Найти(ТекТип.Значение, "ТипВид", Ложь);
			Для Каждого МДВид Из МДТип Цикл
				Стр = Папка.Строки.Добавить();
				Стр.ТипВид        = МДВид.Имя;
				Стр.Представление = МДВид.Синоним;
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого Папка Из ДЗ.Строки Цикл
		Папка.Строки.Сортировать("Представление");
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДЗ, "Состав");
КонецПроцедуры

