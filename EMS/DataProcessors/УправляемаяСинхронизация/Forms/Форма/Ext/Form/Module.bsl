КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеЛокальноеВКорреспондентаНаСервере(Значение, Узел)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
		
	ИмяТипа = XMLТипЗнч(Значение).ИмяТипа;
	Если СтрНайти(ИмяТипа, "Ref.") = 0 Тогда
		Возврат Значение;
	КонецЕсли;
	
	УИД = ПолучитьПриемник(Значение, Узел);
	Если УИД = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	
	ЗначениеКорр = XMLЗначение(Тип(ИмяТипа), УИД);
	
	Возврат ЗначениеКорр;
КонецФункции

&НаКлиенте
Функция ЗначениеКорреспондентаВЛокальное(ЗначениеКорр) Экспорт
	Возврат ЗначениеКорреспондентаВЛокальноеНаСервере(ЗначениеКорр, Узел);
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеКорреспондентаВЛокальноеНаСервере(ЗначениеКорр, Узел) Экспорт
	Если Не ЗначениеЗаполнено(ЗначениеКорр) Тогда
		Возврат ЗначениеКорр;
	КонецЕсли;
	
	ИмяТипа = XMLТипЗнч(ЗначениеКорр).ИмяТипа;
	Если СтрНайти(ИмяТипа, "Ref.") = 0 Тогда
		Возврат ЗначениеКорр;
	КонецЕсли;
	
	Значение = ПолучитьИсточник(XMLСтрока(ЗначениеКорр), Узел);
	Если Значение = Неопределено Тогда
		Возврат ЗначениеКорр;
	КонецЕсли;
	
	Возврат Значение;
КонецФункции

&НаСервереБезКонтекста
Функция КоличествоПроводок(Регистратор)
	Тип = XMLТипЗнч(Регистратор);
	Если Тип = Неопределено
	 Или Лев(Тип.ИмяТипа, 12) <> "DocumentRef."
	Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СУММА(1) КАК Количество
	                      |ИЗ
	                      |	РегистрБухгалтерии.Хозрасчетный КАК Хозрасчетный
	                      |ГДЕ
	                      |	Хозрасчетный.Регистратор = &Регистратор");
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Выборка.Количество = NULL Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Выборка.Количество;
КонецФункции

&НаКлиенте
Процедура ЗарегистрироватьБуфер(КолВоОбъектов = Неопределено, УдалятьИзБуфера = Истина)
	Строки = Новый Массив;
	
	Если      КолВоОбъектов = Неопределено Тогда          // Все
		Для Каждого Эл Из Буфер Цикл
			Строки.Добавить(Эл);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(КолВоОбъектов) = Тип("Число") Тогда  // Первые N
		Для Сч = 1 По Мин(КолВоОбъектов, Буфер.Количество()) Цикл
			ТекСтр = Буфер.Получить(Сч - 1);
			Строки.Добавить(ТекСтр);
			Если КоличествоПроводок(ТекСтр.Значение) > 5000 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(КолВоОбъектов) = Тип("Массив") Тогда // массив номеров
		Для Каждого Эл Из КолВоОбъектов Цикл
			Строки.Добавить(Буфер.Получить(Эл));
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого Эл Из Строки Цикл
		Зн = Эл.Значение;
		ЗарегистрироватьОбъектНаСервере(Узел, Зн);
		
		Если УдалятьИзБуфера Тогда
			Буфер.Удалить(Эл);
		КонецЕсли;
	КонецЦикла;
	
		//	ЗарегистрироватьОбъектНаСервере(Узел, Буфер.Получить(Эл).Значение);
		//	ЗарегистрироватьОбъектНаСервере(Узел, Эл.Значение);
		//	ЗарегистрироватьОбъектНаСервере(Узел, Буфер.Получить(0).Значение);
		//	
		//	Если УдалятьИзБуфера Тогда
		//		Буфер.Удалить(Эл);
		//	КонецЕсли;
		//Если УдалятьИзБуфера Тогда
		//	Буфер.Очистить();
		//КонецЕсли;
		//	Если УдалятьИзБуфера Тогда // Ложь - недопустима, не работает ))
		//		Буфер.Удалить(0);
		//	КонецЕсли;
		
	Если УдалятьИзБуфера Тогда
		ПосчитатьБуфер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БуферОткрыть(Команда)
	Значение = Элементы.Буфер.ТекущиеДанные.Значение;
//	Открываемое = ОткрываемоеЗначение(Значение);
	ОткрытьЗначение(ОЗначении(Значение).Открываемое);
КонецПроцедуры

&НаКлиенте
Процедура БуферЗаполнитьИзПоискГУИДиОбъектов(Команда)
	Попытка
		ФормаОбр = ПолучитьФорму("ВнешняяОбработка.ПоискГУИДОВиОбъектов.Форма");
	Исключение
		Предупреждение("Ошибка открытия формы ""Поиск ГУИДов и объектов""" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ДобавитьВБуферМассивНаСервере(ФормаОбр.ПолучитьНайденныеОбъекты());
	
	ПосчитатьБуфер();
	
КонецПроцедуры
