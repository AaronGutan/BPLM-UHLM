&НаКлиенте
Процедура ПередатьДанные(Команда)
	Источник = Неопределено;
	Приемник = Неопределено;
	
	Для Каждого Стр Из Формы Цикл
		Если Стр.Выход Тогда
			Источник  = Стр; 
			ПараметрыФ = Стр.Параметры;
		КонецЕсли;
		Если Стр.Вход Тогда
			Приемник = Стр;
		КонецЕсли;
	КонецЦикла;
	
	Если Источник = Неопределено
	 Или Приемник = Неопределено
	Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ФормаОбработки = ПолучитьФорму("Обработка." + Источник.Имя + ".Форма");
	Исключение
		Предупреждение("Источник: Ошибка открытия формы" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Попытка
		
		//Данные = Выполнить("ФормаОбработки." + Источник.Функция);
		//Если   Источник.Имя = "COMВыборка" Тогда
		ОргИД = Неопределено; 
		Период= Неопределено; 
		СчетКод="";   
		Режим="Разница"; 
		Результат = "Выборка";
		Лево = Истина;
		Право = Истина;
		Сообщать = Ложь;
			
		ВызовИсточника = СокрЛП(Строка(Источник.Функция) + Строка(ПараметрыФ));
		Если СтрНайти(ВызовИсточника, "(") = 0 Тогда
			ВызовИсточника = ВызовИсточника + "()";
		КонецЕсли;
		Данные = Вычислить("ФормаОбработки." + ВызовИсточника);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если СтрНайти(НРег(ТекстОшибки), "как к функции") > 0 Тогда
			ТекстОшибки = ТекстОшибки + Символы.ПС
				+ НСтр("ru='Метод источника должен возвращать данные (Функция). ДобавитьВБуфер указывайте как приёмник (Вход).'");
		КонецЕсли;
		ПоказатьПредупреждение(, "Источник: Ошибка вызова функции" + Символы.ПС + ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	Попытка
		ФормаОбработки = ПолучитьФорму("Обработка." + Приемник.Имя + ".Форма");
	Исключение
		Предупреждение("Приемник: Ошибка открытия формы" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Попытка
		Выполнить("ФормаОбработки." + Приемник.Функция + "(Данные)");
	Исключение
		Предупреждение("Приемник: Ошибка вызова функции" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ФормыГалкиПриИзменении(Элемент)
	Для Каждого Стр Из Формы Цикл
		Если Стр.ПолучитьИдентификатор() <> Элементы.Формы.ТекущаяСтрока Тогда
			Стр[СтрЗаменить(Элемент.Имя, "Формы", "")] = Ложь;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

