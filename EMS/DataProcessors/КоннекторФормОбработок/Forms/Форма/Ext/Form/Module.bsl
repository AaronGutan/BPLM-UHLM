	НачатьПомещениеФайла(Новый ОписаниеОповещения("НачатьВыборФайла", ЭтаФорма));
	
КонецПроцедуры


&НаКлиенте
Процедура НачатьВыборФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);  
	
	СобытиеЖР ="Загрузка эксель";	
	
	ОбработататьНаСервереДвДанные(ДвоичныеДанные, "xlsx",СобытиеЖР);
    
	ПоказатьВопрос(Новый ОписаниеОповещения("ВыборЗавершения", ЭтотОбъект,ВыбранноеИмяФайла),
	"Выполнено",РежимДиалогаВопрос.ОК);
	
КонецПроцедуры 



&НаСервере
Процедура ОбработататьНаСервереДвДанные(ДвоичныеДанные, ТипФайла,СобытиеЖР)
	
	ФайлEXCELНаСервере = ПолучитьИмяВременногоФайла(ТипФайла);
	ДвоичныеДанные.Записать(ФайлEXCELНаСервере);
	ТабличныйДокумент = Новый ТабличныйДокумент; 
	ТабличныйДокумент.Прочитать(ФайлEXCELНаСервере, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	
	ТвояОбласть    = ТабличныйДокумент.ПолучитьОбласть();
	
	Формы.Очистить(); 
	
	Для к = 2 По ТвояОбласть.ВысотаТаблицы   Цикл 
		 НоваяСтрока = Формы.Добавить();   
		 НоваяСтрока.Имя     = ТвояОбласть.Область(к,1,к,1).Текст;
		 НоваяСтрока.Функция = ТвояОбласть.Область(к,2,к,2).Текст;
		 НоваяСтрока.Выход   = ТвояОбласть.Область(к,3,к,3).Текст;
		 НоваяСтрока.Вход    = ТвояОбласть.Область(к,4,к,4).Текст;
		 
	КонецЦикла;
	
	УдалитьФайлы(ФайлEXCELНаСервере);
	//

КонецПроцедуры 


