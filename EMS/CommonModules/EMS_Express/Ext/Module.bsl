#Область ПрограммныйИнтерфейс

// Обрабатывает команды, полученные от eXpress.
// Для команд, которым нужны данные нижних баз, выполняет запрос к соответствующей базе EMS.
//
// Параметры:
//  ИдентификаторБота - Строка
//      Идентификатор бота eXpress.
//  ИдентификаторЧата - Строка
//      Идентификатор чата eXpress, из которого получена команда.
//  ИмяКоманды - Строка
//      Тело команды eXpress.
//  sync_id - Строка
//      Идентификатор синхронизации входящего запроса eXpress.
//
Процедура ОбработатьКомандыExpress(Знач ИдентификаторБота, Знач ИдентификаторЧата, Знач ИмяКоманды,
	Знач sync_id) Экспорт
	Если ЭтоКомандаОтпускаExpress(ИмяКоманды) Или ЭтоКомандаКалендаряОтпускаExpress(ИмяКоманды) Тогда  
		Попытка
			ЗаписатьЛогКомандыExpress(
				"Начало", ИмяКоманды, sync_id, ИдентификаторЧата, ИдентификаторБота, "Начало обработки команды");
			Если ЭтоКомандаКалендаряОтпускаExpress(ИмяКоманды) Тогда
				ОбработатьКомандуКалендаряОтпускаExpress(ИдентификаторБота, ИдентификаторЧата, ИмяКоманды, sync_id);
			Иначе
				ОбработатьКомандуОстаткаОтпускаExpress(ИдентификаторБота, ИдентификаторЧата, ИмяКоманды, sync_id);
			КонецЕсли;
			ЗаписатьЛогКомандыExpress(
				"Конец", ИмяКоманды, sync_id, ИдентификаторЧата, ИдентификаторБота, "Команда обработана");
		Исключение
			ЗаписатьЛогКомандыExpress(
				"Ошибка", ИмяКоманды, sync_id, ИдентификаторЧата, ИдентификаторБота, ОписаниеОшибки(),
				УровеньЖурналаРегистрации.Ошибка);
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьКомандуОстаткаОтпускаExpress(Знач ИдентификаторБота, Знач ИдентификаторЧата,
	Знач ИмяКоманды, Знач ИдентификаторСинхронизации)
	ДатаОстатка = ДатаИзКомандыОтпускаExpress(ИмяКоманды);
	Если ДатаОстатка = Неопределено Тогда
		ОткрытьКалендарьОтпускаExpress(ИдентификаторБота, ИдентификаторЧата, ИдентификаторСинхронизации);
		Возврат;
	КонецЕсли;
	ОтправитьОстатокОтпускаExpress(
		ИдентификаторБота, ИдентификаторЧата, ИдентификаторСинхронизации, ДатаОстатка);
КонецПроцедуры

Процедура ОткрытьКалендарьОтпускаExpress(Знач ИдентификаторБота, Знач ИдентификаторЧата,
	Знач ИдентификаторСинхронизации)
	ДатаПозиции = НачалоДня(ТекущаяДатаСеанса());
	ЗаписатьСостояниеВыбораДатыОтпускаExpress(
		ИдентификаторБота, ИдентификаторЧата, ДатаПозиции, КомандаОтпускаExpress(), ИдентификаторСинхронизации);
	КнопкиКалендаря = RSN_eXpress.СформироватьКнопкиКалендаряExpress(
		ДатаПозиции, ПрефиксКомандыКалендаряОтпускаExpress());
	ТекстСообщения = СтрШаблон("Выберите дату для расчета остатка отпуска (%1).",
		Формат(ДатаПозиции, "ДФ='MMMM yyyy'"));
	ОтправитьСообщениеКомандыExpress(
		ИдентификаторБота, ИдентификаторЧата, ТекстСообщения, КнопкиКалендаря, ИдентификаторСинхронизации,
		КомандаОтпускаExpress());
КонецПроцедуры

Процедура ОбработатьКомандуКалендаряОтпускаExpress(Знач ИдентификаторБота, Знач ИдентификаторЧата,
	Знач ИмяКоманды, Знач ИдентификаторСинхронизации)
	ДанныеКоманды = RSN_eXpress.РазобратьКомандуКалендаряExpress(
		ИмяКоманды, ПрефиксКомандыКалендаряОтпускаExpress());
	Если ДанныеКоманды.Действие = "noop" Тогда
		Возврат;
	КонецЕсли;
	Если ДанныеКоманды.Действие = "cancel" Тогда
		УдалитьСостояниеВыбораДатыОтпускаExpress(ИдентификаторЧата);
		ОтправитьСообщениеКомандыExpress(
			ИдентификаторБота, ИдентификаторЧата, "Выбор даты отменен.", Неопределено, ИдентификаторСинхронизации,
			ИмяКоманды);
		Возврат;
	КонецЕсли;
	СостояниеВыбора = ПолучитьСостояниеВыбораДатыОтпускаExpress(ИдентификаторЧата);
	Если СостояниеВыбора = Неопределено Тогда
		ОтправитьСообщениеКомандыExpress(
			ИдентификаторБота, ИдентификаторЧата, "Выбор даты устарел. Отправьте /VacationDays еще раз.",
			Неопределено, ИдентификаторСинхронизации, ИмяКоманды);
		Возврат;
	КонецЕсли;
	Если ДанныеКоманды.Действие = "month" Тогда
		ОбновитьМесяцКалендаряОтпускаExpress(
			ИдентификаторБота, ИдентификаторЧата, ДанныеКоманды.ДатаПозиции, ИдентификаторСинхронизации);
		Возврат;
	КонецЕсли;
	Если ДанныеКоманды.Действие = "date" Или ДанныеКоманды.Действие = "today" Тогда
		УдалитьСостояниеВыбораДатыОтпускаExpress(ИдентификаторЧата);
		ОтправитьОстатокОтпускаExpress(
			ИдентификаторБота, ИдентификаторЧата, ИдентификаторСинхронизации, ДанныеКоманды.Дата);
	КонецЕсли;
КонецПроцедуры

Процедура ОбновитьМесяцКалендаряОтпускаExpress(Знач ИдентификаторБота, Знач ИдентификаторЧата,
	Знач ДатаПозиции, Знач ИдентификаторСинхронизации)
	ЗаписатьСостояниеВыбораДатыОтпускаExpress(
		ИдентификаторБота, ИдентификаторЧата, ДатаПозиции, КомандаОтпускаExpress(), ИдентификаторСинхронизации);
	КнопкиКалендаря = RSN_eXpress.СформироватьКнопкиКалендаряExpress(
		ДатаПозиции, ПрефиксКомандыКалендаряОтпускаExpress());
	ТекстСообщения = СтрШаблон("Выберите дату для расчета остатка отпуска (%1).",
		Формат(ДатаПозиции, "ДФ='MMMM yyyy'"));
	ОтправитьСообщениеКомандыExpress(
		ИдентификаторБота, ИдентификаторЧата, ТекстСообщения, КнопкиКалендаря, ИдентификаторСинхронизации,
		ПрефиксКомандыКалендаряОтпускаExpress());
КонецПроцедуры

Процедура ОтправитьОстатокОтпускаExpress(Знач ИдентификаторБота, Знач ИдентификаторЧата,
	Знач ИдентификаторСинхронизации, Знач ДатаОстатка)
	ЭлектроннаяПочта = RSN_eXpress.ЭлектроннаяПочтаПоИдентификаторуЧата(ИдентификаторЧата);
	Сотрудник = РегистрыСведений.ZUPC_НовыеCотрудники.СотрудникПоЭлектроннойПочте(ЭлектроннаяПочта);
	ДанныеОтпуска = ПолучитьДанныеОтпускаИзНижнейБазы(
		Сотрудник, КомандаОтпускаExpress(), ИдентификаторСинхронизации, ДатаОстатка);
	ДанныеЧата = RSN_eXpress.ДанныеЧата(ИдентификаторЧата);
	КнопкиExpress = RSN_eXpress.ПолучитьКнопкиЧата(ДанныеЧата.Чат);
	ТекстСообщения = СтрШаблон(
		"Остаток дней отпуска на %1: %2", Формат(ДатаОстатка, "ДФ='dd.MM.yyyy'"), ДанныеОтпуска.ОстатокНаДату);
	ОтправитьСообщениеКомандыExpress(
		ИдентификаторБота, ИдентификаторЧата, ТекстСообщения, КнопкиExpress, ИдентификаторСинхронизации,
		КомандаОтпускаExpress());
КонецПроцедуры

Процедура ОтправитьСообщениеКомандыExpress(Знач ИдентификаторБота, Знач ИдентификаторЧата,
	Знач ТекстСообщения, Знач КнопкиExpress, Знач ИдентификаторСинхронизации, Знач ИмяКоманды)
	ДанныеБота = RSN_eXpress.ДанныеБота(ИдентификаторБота);
	Соединение = Новый HTTPСоединение(
		ДанныеБота.BaseURL, , , , , ДанныеБота.Timeout, Новый ЗащищенноеСоединениеOpenSSL());
	Токен = RSN_eXpress.ТокенБота(Соединение, ДанныеБота);
	КнопкиСообщенияExpress = ПолучитьКнопкиСообщенияExpress(ИдентификаторЧата, КнопкиExpress);
	ИмяСобытияЖурнала = СобытиеЖурналаКомандыОтпускаExpress(ИмяКоманды);
	ОписаниеКоманды = СтрШаблон("command=%1", ИмяКоманды);
	RSN_eXpress.ЗаписатьВЖурналИсходящееСообщениеExpress(УровеньЖурналаРегистрации.Информация,
		"Команда", ИмяСобытияЖурнала, ИдентификаторСинхронизации, ИдентификаторЧата, ТекстСообщения, 0, "",
		КнопкиExpressЗаполнены(КнопкиСообщенияExpress), ДанныеБота.BotID, ОписаниеКоманды);
	RSN_eXpress.ОтправитьСообщениеВExpress(
		Соединение, Токен, ИдентификаторЧата, ТекстСообщения, КнопкиСообщенияExpress, ДанныеБота.BotID);
КонецПроцедуры

Процедура ЗаписатьСостояниеВыбораДатыОтпускаExpress(Знач ИдентификаторБота, Знач ИдентификаторЧата,
	Знач ДатаПозиции, Знач КомандаРезультата, Знач ИдентификаторСинхронизации)
	НаборЗаписей = НаборЗаписейСостоянияВыбораДатыОтпускаExpress(ИдентификаторЧата);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	Запись = НаборЗаписей.Добавить();
	Запись.ИдентификаторЧата = ИдентификаторЧата;
	Запись.Сценарий = СценарийВыбораДатыОтпускаExpress();
	Запись.ИдентификаторБота = ИдентификаторБота;
	Запись.Шаг = ШагВыбораДатыОтпускаExpress();
	ДанныеСценария = Новый Структура("ДатаПозиции, КомандаРезультата", НачалоМесяца(ДатаПозиции), КомандаРезультата);
	Запись.ДанныеСценария = Новый ХранилищеЗначения(ДанныеСценария);
	Запись.ДатаСоздания = ТекущаяДатаСеанса();
	Запись.ДатаОбновления = ТекущаяДатаСеанса();
	Запись.SyncId = ИдентификаторСинхронизации;
	НаборЗаписей.Записать(Истина);
КонецПроцедуры

Процедура УдалитьСостояниеВыбораДатыОтпускаExpress(Знач ИдентификаторЧата)
	НаборЗаписей = НаборЗаписейСостоянияВыбораДатыОтпускаExpress(ИдентификаторЧата);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать(Истина);
КонецПроцедуры

Функция НаборЗаписейСостоянияВыбораДатыОтпускаExpress(Знач ИдентификаторЧата)
	НаборЗаписей = РегистрыСведений.RSN_СостоянияСценариевExpress.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторЧата.Установить(ИдентификаторЧата);
	НаборЗаписей.Отбор.Сценарий.Установить(СценарийВыбораДатыОтпускаExpress());
	Возврат НаборЗаписей;
КонецФункции

Функция ПолучитьСостояниеВыбораДатыОтпускаExpress(Знач ИдентификаторЧата)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СостоянияСценариевExpress.ИдентификаторБота КАК ИдентификаторБота,
		|	СостоянияСценариевExpress.Шаг КАК Шаг,
		|	СостоянияСценариевExpress.ДанныеСценария КАК ДанныеСценария,
		|	СостоянияСценариевExpress.SyncId КАК SyncId
		|ИЗ
		|	РегистрСведений.RSN_СостоянияСценариевExpress КАК СостоянияСценариевExpress
		|ГДЕ
		|	СостоянияСценариевExpress.ИдентификаторЧата = &ИдентификаторЧата
		|	И СостоянияСценариевExpress.Сценарий = &Сценарий";
	Запрос.УстановитьПараметр("ИдентификаторЧата", ИдентификаторЧата);
	Запрос.УстановитьПараметр("Сценарий", СценарийВыбораДатыОтпускаExpress());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Новый Структура("ИдентификаторБота, Шаг, ДанныеСценария, SyncId");
		Результат.ИдентификаторБота = Выборка.ИдентификаторБота;
		Результат.Шаг = Выборка.Шаг;
		Результат.ДанныеСценария = Выборка.ДанныеСценария;
		Результат.SyncId = Выборка.SyncId;
		Возврат Результат;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьДанныеОтпускаИзНижнейБазы(Знач Сотрудник, Знач ИмяКоманды, Знач ИдентификаторСинхронизации,
	Знач ДатаОстатка = Неопределено)
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		ВызватьИсключение "Не определен сотрудник для запроса остатка отпуска.";
	КонецЕсли;
	ПараметрыБазы = ПараметрыБазыПоСотруднику(Сотрудник);
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("ИмяКоманды", ИмяКоманды);
	ДанныеЗапроса.Вставить("ИдентификаторСотрудника", Строка(Сотрудник.УникальныйИдентификатор()));
	ДанныеЗапроса.Вставить("sync_id", ИдентификаторСинхронизации);
	Если ДатаОстатка <> Неопределено Тогда
		ДанныеЗапроса.Вставить("ДатаОстатка", ДатаОстатка);
	КонецЕсли;
	ОтветНижнейБазы = ВыполнитьЗапросДанныхExpress(ПараметрыБазы, ДанныеЗапроса);
	ДанныеОтвета = ОтветНижнейБазы.ДанныеОтвета;
	Если Не ДанныеОтвета.Свойство("result")
		Или ТипЗнч(ДанныеОтвета.result) <> Тип("Структура") Тогда
		ВызватьИсключение "Нижняя база вернула ответ без данных результата.";
	КонецЕсли;
	Если Не ДанныеОтвета.result.Свойство("ОстатокНаДату") Тогда
		ВызватьИсключение "Нижняя база вернула ответ без остатка отпуска.";
	КонецЕсли;
	Возврат Новый Структура("ОстатокНаДату", ДанныеОтвета.result.ОстатокНаДату);
КонецФункции

Функция ЭтоКомандаОтпускаExpress(Знач ИмяКоманды)
	Команда = СокрЛП(ИмяКоманды);
	Возврат Команда = КомандаОтпускаExpress()
		Или СтрНачинаетсяС(Команда, КомандаОтпускаExpress() + " ");
КонецФункции

Функция ЭтоКомандаКалендаряОтпускаExpress(Знач ИмяКоманды)
	Возврат RSN_eXpress.ЭтоКомандаКалендаряExpress(ИмяКоманды, ПрефиксКомандыКалендаряОтпускаExpress());
КонецФункции

Функция ДатаИзКомандыОтпускаExpress(Знач ИмяКоманды)
	ЧастиКоманды = СтрРазделить(СокрЛП(ИмяКоманды), " ", Ложь);
	Если ЧастиКоманды.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДатаИзСтрокиКомандыОтпускаExpress(ЧастиКоманды[1]);
КонецФункции

Функция ДатаИзСтрокиКомандыОтпускаExpress(Знач СтрокаДаты)
	Если СтрНайти(СтрокаДаты, "-") > 0 Тогда
		ЧастиДаты = СтрРазделить(СтрокаДаты, "-", Ложь);
		Если ЧастиДаты.Количество() = 3 Тогда
			Возврат Дата(Число(ЧастиДаты[0]), Число(ЧастиДаты[1]), Число(ЧастиДаты[2]));
		КонецЕсли;
	КонецЕсли;
	Если СтрНайти(СтрокаДаты, ".") > 0 Тогда
		ЧастиДаты = СтрРазделить(СтрокаДаты, ".", Ложь);
		Если ЧастиДаты.Количество() = 3 Тогда
			Возврат Дата(Число(ЧастиДаты[2]), Число(ЧастиДаты[1]), Число(ЧастиДаты[0]));
		КонецЕсли;
	КонецЕсли;
	ВызватьИсключение СтрШаблон(
		"Некорректная дата '%1'. Используйте формат ДД.ММ.ГГГГ или ГГГГ-ММ-ДД.", СтрокаДаты);
КонецФункции

Функция КнопкиExpressЗаполнены(Знач КнопкиExpress)
	Если КнопкиExpress = Неопределено Или ТипЗнч(КнопкиExpress) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Bubble = Неопределено;
	Keyboard = Неопределено;
	ЕстьBubble = Ложь;
	ЕстьKeyboard = Ложь;
	Если КнопкиExpress.Свойство("bubble", Bubble) И Bubble <> Неопределено Тогда
		ЕстьBubble = Bubble.Количество() > 0;
	КонецЕсли;
	Если КнопкиExpress.Свойство("keyboard", Keyboard) И Keyboard <> Неопределено Тогда
		ЕстьKeyboard = Keyboard.Количество() > 0;
	КонецЕсли;
	Возврат ЕстьBubble Или ЕстьKeyboard;
КонецФункции

Функция ПолучитьКнопкиСообщенияExpress(Знач ИдентификаторЧата, Знач КнопкиExpress)
	Если КнопкиExpressЗаполнены(КнопкиExpress) Тогда
		Возврат КнопкиExpress;
	КонецЕсли;
	ДанныеЧата = RSN_eXpress.ДанныеЧата(ИдентификаторЧата);
	Возврат RSN_eXpress.ПолучитьКнопкиЧата(ДанныеЧата.Чат);
КонецФункции

