	Иначе	
		мИзмерения.Добавить("Наименование");
		мИзмерения.Добавить("ИмяПредопределенныхДанных");
	КонецЕсли;
	//Рез.Вставить("Поля", мИзмерения);
	Если  Тип = "Справочники" Тогда
		 ТипЗапрос="Справочник";
	ИначеЕсли  Тип = "Документы" Тогда
		 ТипЗапрос="Документ";
	КонецЕсли;
	
	
	ЗапросТекст = 
	"ВЫБРАТЬ // Первые 100
	|	" + СтрСоединить(мИзмерения, ", ") + "
	|ИЗ
	|	" + ТипЗапрос + "." + Вид + "
	|";
	
	ЗапросПараметры = Новый Структура;
	
	//ЗапросТекст = ЗапросТекст + ЗапросУсловие(Тип, Вид, РеквОрг, ОргИд, Рекурсия, ЗапросПараметры);
    Возврат ЗапросТекст;

КонецФункции // ТекстЗапроса()

Функция ПолучитьПланСчетов()  Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Хозрасчетный.Ссылка КАК Ссылка,
	|	Хозрасчетный.Код КАК Код
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Хозрасчетный";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	мПлансСчетов = Новый Соответствие;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		мПлансСчетов.Вставить(ВыборкаДетальныеЗаписи.Код,ЗначениеВСтрокуВнутр(ВыборкаДетальныеЗаписи.Ссылка));	
	КонецЦикла;
	
	Возврат  мПлансСчетов;
	
КонецФункции 

Функция ПолучитьСпособыУчетаЗарплаты()  Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
