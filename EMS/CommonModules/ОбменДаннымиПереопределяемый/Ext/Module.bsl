		Иначе 
			Дерево = "";	
		КонецЕсли;
		ЗапросТекст = "";
		ЗапросТекст = ТекстЗапроса("Справочники",м.Имя);
		Запрос	= Новый Запрос;
		Запрос.Текст = ЗапросТекст;
		Выборка = Запрос.Выполнить().Выбрать();
		сч = 0;	    
		Пока Выборка.Следующий() Цикл
			Если  Дерево<>"" Тогда
				мРезультат = ПолучитьРодителяРекурсия(Выборка.Ссылка,мРезультат,м.Имя,Дерево,ВыбратьОбъектНеНайден);
