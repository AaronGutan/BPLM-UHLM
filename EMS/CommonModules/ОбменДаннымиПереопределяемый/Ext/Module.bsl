Функция  ОбработкаМетодовPOST(ДанныеЗапроса, перИмяМетода) Экспорт
	Результат  = Новый  Массив;    
	оРезультат = Новый Массив;
	тРезультат = Новый Массив;
	Если перИмяМетода = "Обороты" Тогда
		ЗапросТекст =  ДанныеЗапроса.ЗапросТекст;
		ЗапросПараметры  =    ДанныеЗапроса.ЗапросПараметры;
		Если ЗапросПараметры.Свойство("КонецПериода") Тогда
			ЗапросПараметры.КонецПериода = КонецДня(ПреобразоватьДатуИзJSON(ЗапросПараметры.КонецПериода));
		КонецЕсли;
		Если ЗапросПараметры.Свойство("НачалоПериода") Тогда
			ЗапросПараметры.НачалоПериода = ПреобразоватьДатуИзJSON(ЗапросПараметры.НачалоПериода);
		КонецЕсли;
		мИзмерения = ДанныеЗапроса.Поля;
		оРезультат =  ВыполнитьЗапрос(ЗапросТекст, ЗапросПараметры, мИзмерения,Истина); 
		тРезультат = СинтезТипов(оРезультат);     
		Результат.Добавить(оРезультат);
		Результат.Добавить(тРезультат);
		возврат Результат;	    
	ИначеЕсли перИмяМетода = "Объекты" Тогда
		ЗапросТекст =  ДанныеЗапроса.ЗапросТекст;
		ЗапросПараметры  =    ДанныеЗапроса.ЗапросПараметры;
		Если ЗапросПараметры.Свойство("КонецПериода") Тогда
			ЗапросПараметры.КонецПериода = КонецДня(ПреобразоватьДатуИзJSON(ЗапросПараметры.КонецПериода));
		КонецЕсли;
		Если ЗапросПараметры.Свойство("НачалоПериода") Тогда
			ЗапросПараметры.НачалоПериода = ПреобразоватьДатуИзJSON(ЗапросПараметры.НачалоПериода);
		КонецЕсли;
		мИзмерения = ДанныеЗапроса.Поля;
		оРезультат =  ВыполнитьЗапрос(ЗапросТекст, ЗапросПараметры, мИзмерения,Истина); 
		тРезультат = СинтезТипов(оРезультат);     
		Результат.Добавить(оРезультат);
		Результат.Добавить(тРезультат);
		возврат Результат;	  	
	ИначеЕсли перИмяМетода = "ВыборкаСоответствия" Тогда
		ЗапросТекст =  ДанныеЗапроса.ЗапросТекст;     
		ЗапросПараметры = Новый Структура;
		ЗапросПараметры  =    ДанныеЗапроса.ЗапросПараметры;
		//мИзмерения = Новый Массив; 
		мИзмерения = СтрРазделить("ТипИсточника, УникальныйИдентификаторПриемника, УникальныйИдентификаторИсточника", ", ", Ложь);
		Результат =  ВыполнитьЗапрос(ЗапросТекст, ЗапросПараметры, мИзмерения,Истина);   
		Результат = ПодготовитьТаблицуСоответствия(Результат);
		возврат Результат;	
	ИначеЕсли перИмяМетода = "ВыборкаОбъекНеНайден" Тогда
		ЗапросТекст =  ДанныеЗапроса.ЗапросТекст;
		мИзмерения = ДанныеЗапроса.Поля;
		ЗапросПараметры  =    ДанныеЗапроса.ЗапросПараметры;
		оРезультат =  ВыполнитьЗапрос(ЗапросТекст, ЗапросПараметры, мИзмерения,Ложь); 
		тРезультат = СинтезТипов(оРезультат);     
		Результат.Добавить(оРезультат);
		Результат.Добавить(тРезультат);
		возврат Результат;	
	КонецЕсли;

	Возврат Результат;

КонецФункции       

Функция ПодготовитьТаблицуСоответствия(Результат)
	мРезультат = Новый Массив;
	Для Каждого эл Из Результат Цикл
		Стр = Новый Массив;
		ТипСтр  =    ЗначениеИзСтрокиВнутр(эл[0]);
		СтрокаПриемник =   ЗначениеИзСтрокиВнутр(эл[1]);
		СтрокаПриемникВнутр = СтрокаИзУИД(ТипСтр, СтрокаПриемник);    
		Стр.Добавить(СтрокаПриемникВнутр); 
		СтрокаИсточник =   ЗначениеИзСтрокиВнутр(эл[2]);  
		СтрокаИсточникВнутр = СтрокаИзУИД(ТипСтр, СтрокаИсточник);    
		Стр.Добавить(СтрокаИсточникВнутр);
		мРезультат.Добавить(Стр);
	КонецЦикла;    

	Возврат мРезультат;

КонецФункции

Функция ПреобразоватьДатуИзСтроки(ДатаСтрока) Экспорт 
	ДатаСтрока =  СтрЗаменить(ДатаСтрока,"-",".");   
	ДатаСтрока =  СтрЗаменить(ДатаСтрока,"T"," ");
	Попытка
		ДатаД = Дата(ДатаСтрока);	
	Исключение
		ДатаД = ""
	КонецПопытки;
	Возврат ДатаД;
КонецФункции // ПреобразоватьДатуИзСтроки()  

Функция ПреобразоватьДатуИзJSON(ЗначениеДаты) Экспорт
	
	Если ТипЗнч(ЗначениеДаты) = Тип("Дата") Тогда
		Возврат ЗначениеДаты;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	ДатаСтрока = СокрЛП(Строка(ЗначениеДаты));
	
	// ISO: 2026-01-01T00:00:00Z → дата до T
	ПозицияT = СтрНайти(ДатаСтрока, "T");
	Если ПозицияT > 0 Тогда
		ДатаСтрока = Лев(ДатаСтрока, ПозицияT - 1);
	КонецЕсли;
	
	// Обрезать время после пробела: "01.01.2026 0:00:00"
	ПозицияПробела = СтрНайти(ДатаСтрока, " ");
	Если ПозицияПробела > 0 Тогда
		ДатаСтрока = Лев(ДатаСтрока, ПозицияПробела - 1);
	КонецЕсли;
	
	Попытка
		Если СтрНайти(ДатаСтрока, "-") > 0 Тогда
			// YYYY-MM-DD
			Части = СтрРазделить(ДатаСтрока, "-");
			Возврат Дата(Число(Части[0]), Число(Части[1]), Число(Части[2]));
		ИначеЕсли СтрНайти(ДатаСтрока, ".") > 0 Тогда
			// DD.MM.YYYY
			Части = СтрРазделить(ДатаСтрока, ".");
			Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
		ИначеЕсли СтрДлина(ДатаСтрока) >= 8 Тогда
			// YYYYMMDD
			Возврат Дата(
				Число(Лев(ДатаСтрока, 4)),
				Число(Сред(ДатаСтрока, 5, 2)),
				Число(Сред(ДатаСтрока, 7, 2)));
		КонецЕсли;
	Исключение
		ВызватьИсключение СтрШаблон(
			НСтр("ru='Не удалось преобразовать значение даты ""%1"" (%2).'"),
			ЗначениеДаты,
			ТипЗнч(ЗначениеДаты));
	КонецПопытки;
	
	ВызватьИсключение СтрШаблон(
		НСтр("ru='Неподдерживаемый формат даты ""%1"".'"),
		ДатаСтрока);
	
КонецФункции


