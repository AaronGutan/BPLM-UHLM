Функция МетаданныеОбъекта(ВыбОбъект,сч,Стр, ПараметрыВыполнения = Неопределено)
	сч = МетаданныеРеквизиты(ВыбОбъект,сч,Стр, ПараметрыВыполнения);
	
	Если ПараметрыВыполнения <> Неопределено Тогда 
		
		Если ПараметрыВыполнения.Свойство("ТолькоВерхнийУровень") Тогда 
			
			Если ПараметрыВыполнения.ТолькоВерхнийУровень  Тогда
				
				Возврат сч;
				
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЕсли;
	
			
	Если ТипЗнч(ВыбОбъект)=Тип("Число") или ТипЗнч(ВыбОбъект)=Тип("Строка")
		или ТипЗнч(ВыбОбъект)=Тип("Булево") или ТипЗнч(ВыбОбъект)=Тип("Неопределено")
		или ТипЗнч(ВыбОбъект)=Тип("Дата") или ТипЗнч(ВыбОбъект)=Тип("Null")
		или  ТипЗнч(ВыбОбъект)=Тип("ХранилищеЗначения") или ТипЗнч(ВыбОбъект)=Тип("УникальныйИдентификатор")
		Тогда
		Возврат сч;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(ВыбОбъект);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения); 
	Если Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
		Возврат сч;
	КонецЕсли;	
	
	мИменаТЧ  = ВыбОбъект.Метаданные().ТабличныеЧасти;
	Для каждого эл Из  мИменаТЧ Цикл
		Для каждого мСтрокаТЧ Из ВыбОбъект[эл.Имя] Цикл
			Для каждого   мКолонкаТабЧасти Из эл.Реквизиты  Цикл  
				зн = мСтрокаТЧ[мКолонкаТабЧасти.Имя];
				сч = МетаданныеРеквизиты(зн,сч,Стр,ПараметрыВыполнения);	
			КонецЦикла;	
			
		КонецЦикла;	
	КонецЦикла;
	
	Возврат сч;
КонецФункции // МетаданныеОбъекта()

Функция МетаданныеРеквизиты(ВыбОбъект,сч,мРезультат, ПараметрыВыполнения= Неопределено)
	Попытка
		Если ТипЗнч(ВыбОбъект)=Тип("Число") или ТипЗнч(ВыбОбъект)=Тип("Строка")
			или ТипЗнч(ВыбОбъект)=Тип("Булево") или ТипЗнч(ВыбОбъект)=Тип("Неопределено")
			или ТипЗнч(ВыбОбъект)=Тип("Дата") или ТипЗнч(ВыбОбъект)=Тип("Null") 
			или  ТипЗнч(ВыбОбъект)=Тип("ХранилищеЗначения") или ТипЗнч(ВыбОбъект)=Тип("УникальныйИдентификатор")
			Тогда
			Возврат сч;
		КонецЕсли;
		ТипЗначения = ТипЗнч(ВыбОбъект);
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения); 
		Если Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
			Возврат сч;
		КонецЕсли;	
		
		//Если ПараметрыВыполнения <> Неопределено Тогда 
			
			Если ЗначениеЗаполнено(ВыбОбъект) Тогда
				Если ПараметрыВыполнения.ВыбратьОбъектНеНайден Тогда
					Если Не СсылкаСуществует(ВыбОбъект) Тогда
						Если мРезультат.Найти(ВыбОбъект) = Неопределено Тогда
							мРезультат.Добавить(ЗначениеВСтрокуВнутр(ВыбОбъект));
							сч= сч+1;	
						КонецЕсли;
					КонецЕсли;
				Иначе 
					Если мРезультат.Найти(ВыбОбъект) = Неопределено Тогда
						мРезультат.Добавить(ЗначениеВСтрокуВнутр(ВыбОбъект));
						сч= сч+1; 
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ПараметрыВыполнения.Свойство("ТолькоВерхнийУровень") Тогда 
				
				Если ПараметрыВыполнения.ТолькоВерхнийУровень  Тогда
					
					Возврат сч;
					
				КонецЕсли;
				
			КонецЕсли; 
			
		//КонецЕсли;
		
		ВыбМетаданные = ВыбОбъект.Метаданные().Реквизиты;
			Для каждого эл Из ВыбМетаданные Цикл
				ПроверяемыйОбъект = ВыбОбъект[эл.Имя];
				Попытка
					Если ТипЗнч(ПроверяемыйОбъект)=Тип("Число") или ТипЗнч(ПроверяемыйОбъект)=Тип("Строка")
						или ТипЗнч(ПроверяемыйОбъект)=Тип("Булево") или ТипЗнч(ПроверяемыйОбъект)=Тип("Неопределено")
						или ТипЗнч(ПроверяемыйОбъект)=Тип("Дата") или ТипЗнч(ПроверяемыйОбъект)=Тип("Null")
						или ТипЗнч(ПроверяемыйОбъект)=Тип("ХранилищеЗначения") или ТипЗнч(ПроверяемыйОбъект)=Тип("УникальныйИдентификатор")
						Тогда
						Продолжить;
					КонецЕсли;
					Если  ЗначениеЗаполнено(ПроверяемыйОбъект) Тогда
						Если ПараметрыВыполнения.ВыбратьОбъектНеНайден Тогда
							Если Не СсылкаСуществует(ПроверяемыйОбъект) Тогда
								Если мРезультат.Найти(ПроверяемыйОбъект) = Неопределено Тогда
									мРезультат.Добавить(ЗначениеВСтрокуВнутр(ПроверяемыйОбъект));
									сч= сч+1;   
								КонецЕсли;
							КонецЕсли;
						Иначе 
							Если мРезультат.Найти(ПроверяемыйОбъект) = Неопределено Тогда
								мРезультат.Добавить(ЗначениеВСтрокуВнутр(ПроверяемыйОбъект));
								сч= сч+1;
							КонецЕсли;
						КонецЕсли; 
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЦикла;   
	Исключение
		
	КонецПопытки;
	Возврат сч; 
КонецФункции // МетаданныеРеквизиты()

Функция ПолучитьРодителяРекурсия(Ссылка,сРодители,Вид,Дерево,ВыбратьОбъектНеНайден)
    Тип = "Справочник";
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	"+Вид+"."+Дерево+" КАК "+Дерево+"
		|ИЗ
		|	"+Тип+"."+Вид+" КАК "+Вид+"
		|ГДЕ
		|	"+Вид+".Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи[Дерево])  Тогда
			Если ВыбратьОбъектНеНайден Тогда
				Если Не СсылкаСуществует(ВыборкаДетальныеЗаписи[Дерево]) Тогда
					Если сРодители.Найти(ВыборкаДетальныеЗаписи[Дерево]) = Неопределено Тогда
						сРодители.Добавить(ЗначениеВСтрокуВнутр(ВыборкаДетальныеЗаписи[Дерево]));
					КонецЕсли;
				КонецЕсли;
			Иначе 
				Если сРодители.Найти(ВыборкаДетальныеЗаписи[Дерево]) = Неопределено Тогда
					сРодители.Добавить(ЗначениеВСтрокуВнутр(ВыборкаДетальныеЗаписи[Дерево]));
					сч= сч+1; 
				КонецЕсли;
			КонецЕсли;
			
			Если Дерево = "Родитель"  Тогда
				ПолучитьРодителяРекурсия(ВыборкаДетальныеЗаписи.Родитель,сРодители,Вид,Дерево,ВыбратьОбъектНеНайден);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат  сРодители;
	
КонецФункции

Функция СсылкаСуществует(ЛюбаяСсылка) Экспорт
    
    ТекстЗапроса = "
        |ВЫБРАТЬ
        |    Ссылка
        |ИЗ
        |    [ИмяТаблицы]
        |ГДЕ
        |    Ссылка = &Ссылка
        |";
    
    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[ИмяТаблицы]", ИмяТаблицыПоСсылке(ЛюбаяСсылка));
    
    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапроса;
    Запрос.УстановитьПараметр("Ссылка", ЛюбаяСсылка);
    
    УстановитьПривилегированныйРежим(Истина);
    
    Возврат НЕ Запрос.Выполнить().Пустой();
    
КонецФункции

