Функция Орг2(ИД)
    Если      ИД = "" Тогда
        Возврат Справочники.Организации.ПустаяСсылка();
    ИначеЕсли ИД = "ОЭ" Тогда
        Возврат XMLЗначение(Тип("CatalogRef.Организации"), "07e4439f-5297-11ec-8d39-b89a2ab8c2ce");
    ИначеЕсли ИД = "ТЭ" Тогда
        Возврат XMLЗначение(Тип("CatalogRef.Организации"), "57e44974-0fc5-11e7-8cb3-40490f86beb6");
    ИначеЕсли ИД = "ТБ" Тогда
        Возврат XMLЗначение(Тип("CatalogRef.Организации"), "72ec8356-e68a-11ee-a6ef-00505601b51a");
    ИначеЕсли ИД = "СО" Тогда
        Возврат XMLЗначение(Тип("CatalogRef.Организации"), "0304d402-390c-11e6-8845-000c29c0d2ee");
    ИначеЕсли ИД = "ГС" Тогда
        Возврат XMLЗначение(Тип("CatalogRef.Организации"), "8030c21a-e8b2-11ec-98d4-50ebf64365f0");
	ИначеЕсли ИД = "НН" Тогда	
		Возврат XMLЗначение(Тип("CatalogRef.Организации"), "99ac51cb-b4e1-11ec-8d50-b89a2ab8c2ce");	
	ИначеЕсли ИД = "АЛ" Тогда	
		Возврат XMLЗначение(Тип("CatalogRef.Организации"), "c01f7687-df56-11ed-8421-b42e99d5aa06");
    КонецЕсли;
    
    Возврат Неопределено;
КонецФункции   

Функция Орг(Знач ИД)
	
	Если Не ЗначениеЗаполнено(ИД) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	EMS_КодСопоставленияОрганизации.ГУИД КАК ГУИД
		|ИЗ
		|	РегистрСведений.EMS_КодСопоставленияОрганизации КАК EMS_КодСопоставленияОрганизации
		|ГДЕ
		|	EMS_КодСопоставленияОрганизации.Code = &Code";
	
	Запрос.УстановитьПараметр("Code", ИД);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат XMLЗначение(Тип("CatalogRef.Организации"),ВыборкаДетальныеЗаписи.ГУИД); 
	КонецЦикла;
	
	Попытка
		Возврат XMLЗначение(Тип("CatalogRef.Организации"), Строка(ИД));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции  

