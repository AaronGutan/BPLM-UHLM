Функция ВыполнитьЗапрос(ЗапросТекст, ЗапросПараметры, мИзмерения, ЗначВнутр) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = ЗапросТекст;
    
    Для Каждого ТекПар Из ЗапросПараметры Цикл
        Ключ = ТекПар.Ключ;
        Зн = ТекПар.Значение;
        Если Ключ = "Организация" И ТипЗнч(Зн) = Тип("Строка") Тогда
            КодОрг = Зн;
            Зн = Орг(Зн);
			Если Не ЗначениеЗаполнено(Зн) Тогда
				ВызватьИсключение СтрШаблон(
					НСтр("ru='На приёмнике не найдена организация по ИД ""%1"".'"),
					КодОрг);
			КонецЕсли;
		КонецЕсли;       

        Запрос.УстановитьПараметр(Ключ, Зн);
    КонецЦикла;
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    мРезультат = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Стр = Новый Массив;
        Для Каждого Изм Из мИзмерения Цикл
			Если ЗначВнутр Тогда
				Если ТипЗнч(Выборка[Изм]) = Тип("УникальныйИдентификатор") Тогда
				
					Зн = Строка(Выборка[Изм]);
					Стр.Добавить(ЗначениеВСтрокуВнутр(Зн));	
				Иначе 	
					Стр.Добавить(ЗначениеВСтрокуВнутр(Выборка[Изм]));
	
				КонецЕсли;
							Иначе 
				Стр.Добавить(Выборка[Изм]);
			КонецЕсли;
			
        КонецЦикла;
        мРезультат.Добавить(Стр);
    КонецЦикла;
    
    Возврат мРезультат;
КонецФункции
