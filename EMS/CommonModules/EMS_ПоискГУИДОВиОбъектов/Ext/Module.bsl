#Область ПрограммныйИнтерфейс

// Заготовка параметров поиска объектов по списку ГУИД.
//
// Возвращаемое значение:
//  Структура:
//   * СписокОбъектов - ТабличныйДокумент
//   * ГУИД - Строка
//   * БитаяСсылка - Строка
//
Функция ПараметрыПоискаОбъектов() Экспорт
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("СписокОбъектов");
	ПараметрыПоиска.Вставить("ГУИД", "");
	ПараметрыПоиска.Вставить("БитаяСсылка", "");
	
	Возврат ПараметрыПоиска;
	
КонецФункции

// Ищет ссылки по строкам табличного документа.
//
// Параметры:
//  Параметры - см. ПараметрыПоискаОбъектов
//
// Возвращаемое значение:
//  Структура:
//   * НайденныеОбъекты - ТаблицаЗначений - колонка Объект
//   * ГУИД - Строка
//   * БитаяСсылка - Строка
//
Функция НайтиОбъектыПоСпискуГуидов(Параметры) Экспорт
	
	НайденныеОбъектыТЗ = Новый ТаблицаЗначений;
	НайденныеОбъектыТЗ.Колонки.Добавить("Объект");
	ГУИД = Параметры.ГУИД;
	БитаяСсылка = Параметры.БитаяСсылка;
	СписокОбъектов = Параметры.СписокОбъектов;
	
	ТвояОбласть    = СписокОбъектов.ПолучитьОбласть();
	НайденныеОбъектыТЗ.Очистить();
	
	Для к = 1 По ТвояОбласть.ВысотаТаблицы   Цикл
		Сообщить(ТвояОбласть.Область(к,1,к,1).Текст);
		
		СтрокаПоиска 		= ТвояОбласть.Область(к,1,к,1).Текст;
		Если СтрНайти(СтрокаПоиска,"<Объект не найден> (")>0  Тогда
			БитаяСсылка =   СтрокаПоиска;
		Иначе 	
			БитаяСсылка = "";
			ГУИД =  СтрокаПоиска;
		КонецЕсли;
		
		
		Если ЗначениеЗаполнено(БитаяСсылка) Тогда 
			ГУИДУдОбъкта = СокрЛП(БитаяСсылка);
			
			ГУИДУдОбъктаСтр = СтрЗаменить(ГУИДУдОбъкта,"<Объект не найден> (","");
			ГУИДУдОбъктаСтр = СтрЗаменить(ГУИДУдОбъктаСтр,")","");
			ГУИДУдОбъктаСтр = СтрЗаменить(ГУИДУдОбъктаСтр,"0x","");
			ГУИДУдОбъктаСтр = Сред(ГУИДУдОбъктаСтр, Найти(ГУИДУдОбъктаСтр,":")+1, СтрДлина(ГУИДУдОбъктаСтр));
			// Преобразуем GUID
			ГУИД = Сред(ГУИДУдОбъктаСтр,25,8)+"-"+Сред(ГУИДУдОбъктаСтр,21,4)+"-"+Сред(ГУИДУдОбъктаСтр,17,4)+"-"+Сред(ГУИДУдОбъктаСтр,1,4)+"-"+Сред(ГУИДУдОбъктаСтр,5,12);			
			//и получаем ГУИД = 05dbe824-a4c6-11dd-bf56-00145e3710ab    
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГУИД) Тогда
			
			УИ = Новый УникальныйИдентификатор(ГУИД);
			// все объекты по которым можно получить ссылку
			ПолучитьСсылкуНоМенеджеруОбъекта(Справочники,УИ, НайденныеОбъектыТЗ);
			ПолучитьСсылкуНоМенеджеруОбъекта(Документы,УИ, НайденныеОбъектыТЗ);
			ПолучитьСсылкуНоМенеджеруОбъекта(ПланыВидовХарактеристик,УИ, НайденныеОбъектыТЗ);
			ПолучитьСсылкуНоМенеджеруОбъекта(ПланыСчетов,УИ, НайденныеОбъектыТЗ);
			ПолучитьСсылкуНоМенеджеруОбъекта(ПланыОбмена,УИ, НайденныеОбъектыТЗ);
			ПолучитьСсылкуНоМенеджеруОбъекта(БизнесПроцессы,УИ, НайденныеОбъектыТЗ);
			ПолучитьСсылкуНоМенеджеруОбъекта(Задачи,УИ, НайденныеОбъектыТЗ);
		КонецЕсли;
		
		СообщитьПрогрессПоШагам(к, ТвояОбласть.ВысотаТаблицы);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("НайденныеОбъекты", НайденныеОбъектыТЗ);
	Результат.Вставить("ГУИД", ГУИД);
	Результат.Вставить("БитаяСсылка", БитаяСсылка);
	
	Возврат Результат;
	
КонецФункции

// Заполняет табличный документ уникальными идентификаторами ссылок.
//
// Параметры:
//  МассивОбъектов - Массив из ЛюбаяСсылка
//
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция СформироватьСписокГуидовПоОбъектам(МассивОбъектов) Экспорт
	
	СписокОбъектов = Новый ТабличныйДокумент;
	СписокОбъектов.Очистить();
	ТвояОбласть    = СписокОбъектов.ПолучитьОбласть();
	к = 1;
	Всего = МассивОбъектов.Количество();
	Для каждого эл Из МассивОбъектов Цикл
		ГУИД = эл.УникальныйИдентификатор();
		ТвояОбласть.Область(к,1,к,1).Текст = ГУИД;
		СообщитьПрогрессПоШагам(к, Всего);
		к = к + 1;
	КонецЦикла;
	СписокОбъектов.Вывести(ТвояОбласть);
	
	Возврат СписокОбъектов;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСсылкуНоМенеджеруОбъекта(ОбъектыМенеджер,УникальныйИдентификатор, НайденныеОбъекты)
	
	Для Каждого Менеджер Из ОбъектыМенеджер Цикл
		НайденныйОбъект = Менеджер.ПолучитьСсылку(УникальныйИдентификатор);
		
		Если НайденныйОбъект.ПолучитьОбъект() <> Неопределено Тогда
			
			СтрокаТЗ = НайденныеОбъекты.Добавить();
			СтрокаТЗ.Объект = НайденныйОбъект;
			
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;	
	
КонецФункции

Процедура СообщитьПрогрессПоШагам(Текущий, Всего)
	
	Если Всего = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МаксимумСообщений = 100;
	Шаг = Макс(1, Цел((Всего + МаксимумСообщений - 1) / МаксимумСообщений));
	Если Текущий % Шаг <> 0 И Текущий <> Всего Тогда
		Возврат;
	КонецЕсли;
	
	Процент = Окр(МаксимумСообщений * Текущий / Всего, 0);
	Текст = СтрШаблон(НСтр("ru='Обработка строки %1 из %2';en='Processing row %1 of %2'"), Текущий, Всего);
	ДлительныеОперации.СообщитьПрогресс(Процент, Текст);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
