#Область ПрограммныйИнтерфейс

// Регистрирует изменения плана обмена по пакету сообщений сверки.
// Вызывается из внешней базы по HTTP.
//
// Параметры:
//  ЭлементыПакета - Массив из Структура - массив элементов с ключами:
//    * ПолноеИмяМетаданных - Строка
//    * ВидДанныхДляРегистрации - Строка ("Catalog", "Document", "InformationRegister" и т.д.)
//    * КлючРегистрацииОтбор - Строка (JSON-объект с полями ключа/отбора)
//
// Возвращаемое значение:
//  Массив из Структура - по каждому элементу: Индекс (Число), Success (Булево), ErrorText (Строка)
//
Функция ЗарегистрироватьИзмененияПоСообщениям(ЭлементыПакета) Экспорт
	Результаты = Новый Массив;
	Узел = НайтиУзелПланаОбмена();
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Для Индекс = 0 По ЭлементыПакета.Количество() - 1 Цикл
			Результаты.Добавить(Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, "Узел плана обмена не найден"));
		КонецЦикла;
		Возврат Результаты;
	КонецЕсли;
	Индекс = 0;
	Для Каждого ЭлементПакета Из ЭлементыПакета Цикл
		РезультатЭлемента = ОбработатьЭлементПакета(Узел, ЭлементПакета, Индекс);
		Результаты.Добавить(РезультатЭлемента);
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Результаты;
КонецФункции

// Выполняет обмен данными Z по HTTP-запросу из верхней базы.
//
// Параметры:
//  ДанныеЗапроса - Структура - параметры запуска:
//    * НаименованиеУзлаИБ - Строка - наименование узла плана обмена, если его нужно выбрать явно.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - признак успешного запуска и выполнения обмена.
//   * Сообщение - Строка - текст результата.
//   * ТекстОшибки - Строка - описание ошибки.
//
Функция ВыполнитьОбменДаннымиZПоHTTP(Знач ДанныеЗапроса) Экспорт
	НаименованиеУзлаИБ = "";
	Если ДанныеЗапроса <> Неопределено Тогда
		ДанныеЗапроса.Свойство("НаименованиеУзлаИБ", НаименованиеУзлаИБ);
	КонецЕсли;
	УзелИнформационнойБазы = НайтиУзелПланаОбменаДляЗапуска(НаименованиеУзлаИБ);
	Если Не ЗначениеЗаполнено(УзелИнформационнойБазы) Тогда
		Возврат РезультатЗапускаОбменаДаннымиZ(Ложь, "Узел плана обмена ОбменДаннымиZ не найден.");
	КонецЕсли;
	Возврат ВыполнитьОбменДаннымиZПоУзлу(УзелИнформационнойБазы);
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиУзелПланаОбмена()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОбменДаннымиZ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.ОбменДаннымиZ КАК ОбменДаннымиZ
	|ГДЕ
	|	НЕ ОбменДаннымиZ.ЭтотУзел";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();      
	Возврат Выборка.Ссылка;
КонецФункции

Функция НайтиУзелПланаОбменаДляЗапуска(Знач НаименованиеУзлаИБ)
	Если ЗначениеЗаполнено(НаименованиеУзлаИБ) Тогда
		УзелИнформационнойБазы = НайтиУзелПланаОбменаПоНаименованию(НаименованиеУзлаИБ);
		Если ЗначениеЗаполнено(УзелИнформационнойБазы) Тогда
			Возврат УзелИнформационнойБазы;
		КонецЕсли;
	КонецЕсли;
	Возврат НайтиУзелПланаОбмена();
КонецФункции

Функция НайтиУзелПланаОбменаПоНаименованию(Знач НаименованиеУзлаИБ)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОбменДаннымиZ.Ссылка КАК Ссылка
		|ИЗ
		|	ПланОбмена.ОбменДаннымиZ КАК ОбменДаннымиZ
		|ГДЕ
		|	НЕ ОбменДаннымиZ.ЭтотУзел
		|	И ОбменДаннымиZ.Наименование = &НаименованиеУзлаИБ";
	Запрос.УстановитьПараметр("НаименованиеУзлаИБ", НаименованиеУзлаИБ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ВыполнитьОбменДаннымиZПоУзлу(Знач УзелИнформационнойБазы)
	Попытка
		Отказ = Ложь;
		ОбменДаннымиСервер.ПроверитьВозможностьЗапускаОбмена(УзелИнформационнойБазы, Отказ);
		Если Отказ Тогда
			Возврат РезультатЗапускаОбменаДаннымиZ(
				Ложь, "Запуск обмена запрещен стандартным механизмом обмена данными.");
		КонецЕсли;
		ПараметрыОбмена = ОбменДаннымиСервер.ПараметрыОбмена();
		ПараметрыОбмена.ИдентификаторТранспорта =
			ТранспортСообщенийОбмена.ТранспортПоУмолчанию(УзелИнформационнойБазы);
		ПараметрыОбмена.ВыполнятьЗагрузку = Истина;
		ПараметрыОбмена.ВыполнятьВыгрузку = Истина;
		ПараметрыОбмена.ДлительнаяОперацияРазрешена = Ложь;
		ОбменДаннымиСервер.ВыполнитьОбменДаннымиДляУзлаИнформационнойБазы(
			УзелИнформационнойБазы, ПараметрыОбмена, Отказ);
		Если Отказ Тогда
			Возврат РезультатЗапускаОбменаДаннымиZ(
				Ложь, "В процессе обмена возникли ошибки. Подробности см. в журнале регистрации.");
		КонецЕсли;
		Возврат РезультатЗапускаОбменаДаннымиZ(Истина, "");
	Исключение
		Возврат РезультатЗапускаОбменаДаннымиZ(
			Ложь, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецФункции

Функция РезультатЗапускаОбменаДаннымиZ(Знач Успех, Знач ТекстОшибки)
	Сообщение = ?(Успех,
		"Обмен в нижней базе завершен.",
		СтрШаблон("Ошибка обмена в нижней базе: %1", ТекстОшибки));
	Возврат Новый Структура("Успех, Сообщение, ТекстОшибки", Успех, Сообщение, ТекстОшибки);
КонецФункции

Функция ОбработатьЭлементПакета(Узел, ЭлементПакета, Индекс)
	Попытка
		ПолноеИмя = ЭлементПакета.ПолноеИмяМетаданных;
		ВидДанных = ЭлементПакета.ВидДанныхДляРегистрации;
		КлючJSON = ЭлементПакета.КлючРегистрацииОтбор;
		Если Не ЗначениеЗаполнено(ПолноеИмя) Или Не ЗначениеЗаполнено(ВидДанных) Или Не ЗначениеЗаполнено(КлючJSON) Тогда
			Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, "Не заполнены обязательные поля элемента пакета");
		КонецЕсли;
		Отбор = РазобратьКлючРегистрацииОтбор(КлючJSON);
		Если ТипЗнч(Отбор) = Тип("Строка") Тогда
			Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, Отбор);
		КонецЕсли;
		Если ВидДанных = "Catalog" Или ВидДанных = "Document" Или ВидДанных = "ChartOfCharacteristicTypes" Тогда
			Возврат ЗарегистрироватьСсылочныйОбъект(Узел, ПолноеИмя, ВидДанных, Отбор, Индекс);
		ИначеЕсли ЭтоВидДанныхРегистра(ВидДанных) Тогда
			Возврат ЗарегистрироватьРегистр(Узел, ПолноеИмя, ВидДанных, Отбор, Индекс);
		Иначе
			Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь,
				СтрШаблон("Неподдерживаемый тип метаданных: %1", ВидДанных));
		КонецЕсли;
	Исключение
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция РазобратьКлючРегистрацииОтбор(КлючJSON)
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(КлючJSON);
		Отбор = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Если ТипЗнч(Отбор) <> Тип("Соответствие") И ТипЗнч(Отбор) <> Тип("Структура") Тогда
			Возврат "Ошибка формата JSON: ожидается объект";
		КонецЕсли;
		Возврат Отбор;
	Исключение
		Возврат "Ошибка разбора JSON: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

Функция ЭтоВидДанныхРегистра(Знач ВидДанных)
	Возврат ВидДанных = "InformationRegister"
		Или ВидДанных = "AccumulationRegister"
		Или ВидДанных = "AccountingRegister"
		Или ВидДанных = "CalculationRegister";
КонецФункции

Функция ЗарегистрироватьРегистр(Знач Узел, Знач ПолноеИмяМетаданных, Знач ВидДанных, Знач Отбор, Знач Индекс)
	МетаданныеРегистра = ПолучитьМетаданныеРегистра(ПолноеИмяМетаданных, ВидДанных);
	Если ТипЗнч(МетаданныеРегистра) = Тип("Строка") Тогда
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, МетаданныеРегистра);
	КонецЕсли;
	Если УРегистраЕстьРегистратор(МетаданныеРегистра, ВидДанных) Тогда
		Возврат ЗарегистрироватьРегистратор(Узел, Отбор, Индекс);
	КонецЕсли;
	Если ВидДанных = "InformationRegister" Тогда
		Возврат ЗарегистрироватьРегистрСведений(Узел, ПолноеИмяМетаданных, Отбор, Индекс);
	КонецЕсли;
	Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь,
		СтрШаблон("Для регистра без регистратора не поддержана регистрация типа метаданных: %1", ВидДанных));
КонецФункции

Функция ПолучитьМетаданныеРегистра(Знач ПолноеИмяМетаданных, Знач ВидДанных)
	ЧастиИмени = СтрРазделить(ПолноеИмяМетаданных, ".", Ложь);
	Если ЧастиИмени.Количество() < 2 Тогда
		Возврат "Некорректное полное имя метаданных";
	КонецЕсли;
	ИмяРегистра = ЧастиИмени[1];
	Если ВидДанных = "InformationRegister" Тогда
		МД = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	ИначеЕсли ВидДанных = "AccumulationRegister" Тогда
		МД = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	ИначеЕсли ВидДанных = "CalculationRegister" Тогда
		МД = Метаданные.РегистрыРасчета.Найти(ИмяРегистра);
	ИначеЕсли ВидДанных = "AccountingRegister" Тогда
		МД = Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра);
		Если МД = Неопределено Тогда
			МД = Метаданные.РегистрыРасчета.Найти(ИмяРегистра);
		КонецЕсли;
	Иначе
		МД = Неопределено;
	КонецЕсли;
	Если МД = Неопределено Тогда
		Возврат СтрШаблон("Регистр не найден: %1", ИмяРегистра);
	КонецЕсли;
	Возврат МД;
КонецФункции

Функция УРегистраЕстьРегистратор(Знач МетаданныеРегистра, Знач ВидДанных)
	Если ВидДанных <> "InformationRegister" Тогда
		Возврат Истина;
	КонецЕсли;
	Независимый = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый;
	Возврат МетаданныеРегистра.РежимЗаписи <> Независимый;
КонецФункции

Функция ЗарегистрироватьРегистратор(Знач Узел, Знач Отбор, Знач Индекс)
	Регистратор = Неопределено;
	Отбор.Свойство("Регистратор", Регистратор);
	Если Регистратор = Неопределено Тогда
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, "В ключе регистра не найдено поле Регистратор");
	КонецЕсли;
	Попытка
		Если ТипЗнч(Регистратор) = Тип("Строка") Тогда
			Регистратор = ЗначениеИзСтрокиВнутр(Регистратор);
		КонецЕсли;
	Исключение
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь,
			СтрШаблон("Ошибка преобразования регистратора: %1", ОписаниеОшибки()));
	КонецПопытки;
	Если Метаданные.НайтиПоТипу(ТипЗнч(Регистратор)) = Неопределено Тогда
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, "Регистратор не является ссылкой на объект");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Регистратор) Тогда
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, "Регистратор не найден");
	КонецЕсли;
	Попытка
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, Регистратор);
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Истина, "");
	Исключение
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ЗарегистрироватьСсылочныйОбъект(Узел, ПолноеИмяМетаданных, ВидДанных, Отбор, Индекс)
	КлючСсылка = Отбор.Ссылка;
	Если КлючСсылка = Неопределено Тогда
		КлючСсылка = Отбор.УникальныйИдентификатор;
	КонецЕсли;
	Если КлючСсылка = Неопределено Тогда
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, "В ключе не найдено поле Ссылка или УникальныйИдентификатор");
	КонецЕсли;
	Попытка
		Ссылка = ЗначениеИзСтрокиВнутр(КлючСсылка);
	Исключение
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, "Ошибка преобразования ключа: " + ОписаниеОшибки());
	КонецПопытки;
	ТипСсылки = ТипЗнч(Ссылка);
	СсылочныйТип = Метаданные.НайтиПоТипу(ТипСсылки);
	Если СсылочныйТип = Неопределено Тогда
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, "Ключ не является ссылкой на объект");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, "Объект не найден");
	КонецЕсли;
	Попытка
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, Ссылка);
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Истина, "");
	Исключение
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ЗарегистрироватьРегистрСведений(Узел, ПолноеИмяМетаданных, Отбор, Индекс)
	ЧастиИмени = СтрРазделить(ПолноеИмяМетаданных, ".", Ложь);
	Если ЧастиИмени.Количество() < 2 Тогда
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, "Некорректное полное имя метаданных");
	КонецЕсли;
	ИмяРегистра = ЧастиИмени[1];
	МД = Метаданные.РегистрыСведений[ИмяРегистра];
	Если МД = Неопределено Тогда
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, "Регистр сведений не найден: " + ИмяРегистра);
	КонецЕсли;
	ИзмеренияОсновногоОтбора = Новый Массив;
	Для Каждого Изм Из МД.Измерения Цикл
		Если Изм.ОсновнойОтбор Тогда
			ИзмеренияОсновногоОтбора.Добавить(Изм.Имя);
		КонецЕсли;
	КонецЦикла;
	Независимый = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый;
	Непериодический = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
	Если МД.РежимЗаписи <> Независимый Тогда
		ИзмеренияОсновногоОтбора.Добавить("Регистратор");
	КонецЕсли;
	Если МД.ПериодичностьРегистраСведений <> Непериодический Тогда
		ИзмеренияОсновногоОтбора.Добавить("Период");
	КонецЕсли;
	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	Для Каждого ИмяИзмерения Из ИзмеренияОсновногоОтбора Цикл
		ЗначениеОтбора = Неопределено;
		Отбор.Свойство(ИмяИзмерения, ЗначениеОтбора);
		Если ЗначениеОтбора = Неопределено Тогда
			Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, "Недостаточный ключ регистра: отсутствует измерение " + ИмяИзмерения);
		КонецЕсли;
		Если ТипЗнч(ЗначениеОтбора) = Тип("Строка") Тогда
			ЗначениеОтбора = ЗначениеИзСтрокиВнутр(ЗначениеОтбора);
		КонецЕсли;
		НаборЗаписей.Отбор[ИмяИзмерения].Установить(ЗначениеОтбора);
	КонецЦикла;
	Попытка
		НаборЗаписей.Прочитать();
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, НаборЗаписей);
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Истина, "");
	Исключение
		Возврат Новый Структура("Индекс, Success, ErrorText", Индекс, Ложь, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

#КонецОбласти
