#Область ПрограммныйИнтерфейс

// Разбирает адрес публикации standard.odata.
//
// Параметры:
//  АдресOData - Строка
//  Пользователь - Строка
//  Пароль - Строка
//
// Возвращаемое значение:
//  Структура - Сервер, Порт, Пользователь, Пароль, Защищенное, Корень, Ошибка.
//
Функция ПараметрыПодключения(Знач АдресOData, Знач Пользователь, Знач Пароль) Экспорт

	Результат = Новый Структура("Сервер, Порт, Пользователь, Пароль, Защищенное, Корень, Ошибка",
		"", 80, Пользователь, Пароль, Ложь, "", "");

	АдресOData = СокрЛП(АдресOData);
	Если Не ЗначениеЗаполнено(АдресOData) Тогда
		Результат.Ошибка = НСтр("ru = 'Не заполнен адрес OData.'");
		Возврат Результат;
	КонецЕсли;

	АдресНижний = НРег(АдресOData);
	БезСхемы = АдресOData;
	Если СтрНачинаетсяС(АдресНижний, "https://") Тогда
		Результат.Защищенное = Истина;
		Результат.Порт = 443;
		БезСхемы = Сред(АдресOData, 9);
	ИначеЕсли СтрНачинаетсяС(АдресНижний, "http://") Тогда
		БезСхемы = Сред(АдресOData, 8);
	Иначе
		Результат.Ошибка = НСтр("ru = 'Адрес OData должен начинаться с http:// или https://.'");
		Возврат Результат;
	КонецЕсли;

	ПозицияПути = СтрНайти(БезСхемы, "/");
	ХостИПорт = БезСхемы;
	Если ПозицияПути > 0 Тогда
		ХостИПорт = Лев(БезСхемы, ПозицияПути - 1);
		Результат.Корень = Сред(БезСхемы, ПозицияПути);
	КонецЕсли;

	ПозицияПорта = СтрНайти(ХостИПорт, ":");
	Если ПозицияПорта > 0 Тогда
		Результат.Сервер = Лев(ХостИПорт, ПозицияПорта - 1);
		Результат.Порт = Число(Сред(ХостИПорт, ПозицияПорта + 1));
	Иначе
		Результат.Сервер = ХостИПорт;
	КонецЕсли;

	Если СтрЗаканчиваетсяНа(Результат.Корень, "/") Тогда
		Результат.Корень = Лев(Результат.Корень, СтрДлина(Результат.Корень) - 1);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Результат.Сервер) Или Не ЗначениеЗаполнено(Результат.Корень) Тогда
		Результат.Ошибка = НСтр("ru = 'Адрес OData должен содержать сервер и путь публикации.'");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет, что в $metadata есть функции ОСВ и движений регистра Хозрасчетный.
//
// Параметры:
//  ПараметрыПодключения - Структура
//
// Возвращаемое значение:
//  Структура - Успех, ТекстОшибки, ЕстьОстаткиИОбороты, ЕстьДвиженияССубконто, ЕстьПолеРазвернутогоОстатка.
//
Функция ПроверитьФункцииХозрасчетный(ПараметрыПодключения) Экспорт

	Результат = Новый Структура(
		"Успех, ТекстОшибки, ЕстьОстаткиИОбороты, ЕстьДвиженияССубконто, ЕстьПолеРазвернутогоОстатка",
		Ложь, "", Ложь, Ложь, Ложь);

	Ответ = ВыполнитьЗапрос(ПараметрыПодключения, ПараметрыПодключения.Корень + "/$metadata");
	Если Не Ответ.Успех Тогда
		Результат.ТекстОшибки = Ответ.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	Текст = Ответ.Тело;
	Результат.ЕстьОстаткиИОбороты = СтрНайти(Текст, "BalanceAndTurnovers") > 0
		И СтрНайти(Текст, "AccountingRegister_Хозрасчетный") > 0;
	Результат.ЕстьДвиженияССубконто = СтрНайти(Текст, "RecordsWithExtDimensions") > 0;
	Результат.ЕстьПолеРазвернутогоОстатка = СтрНайти(Текст, "OpeningSplittedBalanceDr") > 0;
	Результат.Успех = Результат.ЕстьОстаткиИОбороты И Результат.ЕстьДвиженияССубконто;

	Если Не Результат.Успех Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В $metadata нет BalanceAndTurnovers или RecordsWithExtDimensions регистра Хозрасчетный. Проверьте состав публикации standard.odata.'");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Читает все страницы набора OData.
//
// Параметры:
//  ПараметрыПодключения - Структура
//  ОтносительныйПуть - Строка - путь от корня публикации, начиная с /
//
// Возвращаемое значение:
//  Структура - Успех, Строки, ТекстОшибки.
//
Функция ПолучитьВсеСтраницы(ПараметрыПодключения, Знач ОтносительныйПуть) Экспорт

	Результат = Новый Структура("Успех, Строки, ТекстОшибки", Истина, Новый Массив, "");
	Путь = ПараметрыПодключения.Корень + ОтносительныйПуть;
	РазмерСтраницы = 1000;
	НомерСтраницы = 0;
	ПределСтраниц = 200;

	Пока ЗначениеЗаполнено(Путь) Цикл

		НомерСтраницы = НомерСтраницы + 1;
		Если НомерСтраницы > ПределСтраниц Тогда
			Результат.Успех = Ложь;
			Результат.ТекстОшибки = НСтр("ru = 'Превышен предел страниц OData. Сузьте период или счет.'");
			Возврат Результат;
		КонецЕсли;

		Ответ = ВыполнитьЗапрос(ПараметрыПодключения, Путь);
		Если Не Ответ.Успех Тогда
			Результат.Успех = Ложь;
			Результат.ТекстОшибки = Ответ.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;

		Данные = JSONВСоответствие(Ответ.Тело);
		Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
			Результат.Успех = Ложь;
			Результат.ТекстОшибки = НСтр("ru = 'Ответ OData не является объектом JSON.'");
			Возврат Результат;
		КонецЕсли;

		ТекстОшибкиСервиса = ТекстОшибкиOData(Данные);
		Если ЗначениеЗаполнено(ТекстОшибкиСервиса) Тогда
			Результат.Успех = Ложь;
			Результат.ТекстОшибки = ТекстОшибкиСервиса;
			Возврат Результат;
		КонецЕсли;

		Страница = Данные.Получить("value");
		Если ТипЗнч(Страница) <> Тип("Массив") Тогда
			Результат.Строки.Добавить(Данные);
			Прервать;
		КонецЕсли;

		Для Каждого СтрокаСтраницы Из Страница Цикл
			Результат.Строки.Добавить(СтрокаСтраницы);
		КонецЦикла;

		Следующая = Данные.Получить("@odata.nextLink");
		Если ЗначениеЗаполнено(Следующая) Тогда
			Путь = ПутьИзАбсолютнойСсылки(Следующая);
			Продолжить;
		КонецЕсли;

		Если Страница.Количество() < РазмерСтраницы Тогда
			Прервать;
		КонецЕсли;

		Путь = ПутьСледующейСтраницы(Путь, РазмерСтраницы);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает значение поля строки OData. Для ссылки предпочитает поле _Key.
//
Функция ЗначениеПоля(СтрокаOData, ИмяПоля) Экспорт

	Если ТипЗнч(СтрокаOData) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗначениеКлюча = СтрокаOData.Получить(ИмяПоля + "_Key");
	Если ЗначениеЗаполнено(ЗначениеКлюча) Тогда
		Возврат ЗначениеКлюча;
	КонецЕсли;

	Возврат СтрокаOData.Получить(ИмяПоля);

КонецФункции

Функция ЧислоПоля(СтрокаOData, ИмяПоля) Экспорт

	Если ТипЗнч(СтрокаOData) <> Тип("Соответствие") Тогда
		Возврат 0;
	КонецЕсли;

	Значение = СтрокаOData.Получить(ИмяПоля);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
		Возврат Число(СтрЗаменить(Значение, " ", ""));
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция ПустойИдентификатор(Знач Идентификатор) Экспорт

	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Истина;
	КонецЕсли;

	Текст = НРег(СокрЛП(Строка(Идентификатор)));
	Возврат Текст = "00000000-0000-0000-0000-000000000000" Или Текст = "null";

КонецФункции

Функция ДатаВФорматеOData(Дата) Экспорт

	Возврат "datetime'" + Формат(Дата, "ДФ=yyyy-MM-dd") + "T" + Формат(Дата, "ДФ=HH:mm:ss") + "'";

КонецФункции

// Один запрос количества записей набора. Страницы и массив value не читаются.
//
// Параметры:
//  ПараметрыПодключения - Структура
//  ОтносительныйПуть - Строка - путь от корня публикации, начиная с /
//
// Возвращаемое значение:
//  Структура - Успех, ТекстОшибки, Количество, СчетчикПолучен.
//
Функция КоличествоЗаписей(ПараметрыПодключения, Знач ОтносительныйПуть) Экспорт

	Результат = Новый Структура("Успех, ТекстОшибки, Количество, СчетчикПолучен", Ложь, "", 0, Ложь);
	Ответ = ВыполнитьЗапрос(ПараметрыПодключения, ПараметрыПодключения.Корень + ОтносительныйПуть);
	Если Не Ответ.Успех Тогда
		Результат.ТекстОшибки = Ответ.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	КоличествоТекстом = ЧислоТекста(Ответ.Тело);
	Если КоличествоТекстом <> Неопределено Тогда
		Результат.Количество = КоличествоТекстом;
		Результат.СчетчикПолучен = Истина;
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;

	Попытка
		Данные = JSONВСоответствие(Ответ.Тело);
	Исключение
		Результат.ТекстОшибки = НСтр("ru = 'Ответ OData не является объектом JSON.'");
		Возврат Результат;
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Ответ OData не является объектом JSON.'");
		Возврат Результат;
	КонецЕсли;

	ТекстОшибкиСервиса = ТекстОшибкиOData(Данные);
	Если ЗначениеЗаполнено(ТекстОшибкиСервиса) Тогда
		Результат.ТекстОшибки = ТекстОшибкиСервиса;
		Возврат Результат;
	КонецЕсли;

	Счетчик = Данные.Получить("@odata.count");
	Если Счетчик = Неопределено Тогда
		Счетчик = Данные.Получить("odata.count");
	КонецЕсли;
	Если ТипЗнч(Счетчик) = Тип("Число") Тогда
		Результат.Количество = Счетчик;
	ИначеЕсли ТипЗнч(Счетчик) = Тип("Строка") И ЗначениеЗаполнено(Счетчик) Тогда
		Попытка
			Результат.Количество = Число(СтрЗаменить(Счетчик, " ", ""));
		Исключение
			Результат.ТекстОшибки = НСтр("ru = 'OData не вернул количество записей.'");
			Возврат Результат;
		КонецПопытки;
	Иначе
		Результат.ТекстОшибки = НСтр("ru = 'OData не вернул количество записей.'");
		Возврат Результат;
	КонецЕсли;

	Результат.СчетчикПолучен = Истина;
	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Длина строки запроса после URL-кодирования. IIS отклоняет запрос длиннее своего лимита кодом 404.15.
//
Функция ДлинаСтрокиЗапроса(Знач Путь) Экспорт

	Закодированный = КодироватьПутьOData(Путь);
	Позиция = СтрНайти(Закодированный, "?");
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат СтрДлина(Закодированный) - Позиция;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗапомнитьАдресЗапроса(ПараметрыПодключения, Путь)

	Адреса = Неопределено;
	Если ТипЗнч(ПараметрыПодключения) <> Тип("Структура")
		Или Не ПараметрыПодключения.Свойство("АдресаЗапросов", Адреса)
		Или ТипЗнч(Адреса) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Схема = "http://";
	Если ПараметрыПодключения.Защищенное Тогда
		Схема = "https://";
	КонецЕсли;
	Порт = "";
	Если ПараметрыПодключения.Защищенное И ПараметрыПодключения.Порт <> 443
		Или Не ПараметрыПодключения.Защищенное И ПараметрыПодключения.Порт <> 80 Тогда
		Порт = ":" + Формат(ПараметрыПодключения.Порт, "ЧГ=0");
	КонецЕсли;
	Адреса.Добавить(Схема + ПараметрыПодключения.Сервер + Порт + КодироватьПутьOData(Путь));

КонецПроцедуры

Функция АдресЗапросаБезПараметров(Путь)

	Позиция = СтрНайти(Путь, "?");
	Если Позиция = 0 Тогда
		Возврат Путь;
	КонецЕсли;
	Возврат Лев(Путь, Позиция - 1);

КонецФункции

Функция ВыполнитьЗапрос(ПараметрыПодключения, Путь)

	Результат = Новый Структура("Успех, Тело, ТекстОшибки, КодСостояния", Ложь, "", "", 0);
	ЗапомнитьАдресЗапроса(ПараметрыПодключения, Путь);

	Попытка
		Защита = Неопределено;
		Если ПараметрыПодключения.Защищенное Тогда
			Защита = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);
		КонецЕсли;
		Соединение = Новый HTTPСоединение(
			ПараметрыПодключения.Сервер,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль,
			,
			300,
			Защита);
		Запрос = Новый HTTPЗапрос(КодироватьПутьOData(Путь));
		Запрос.Заголовки.Вставить("Accept", "application/json");
		Ответ = Соединение.Получить(Запрос);
	Исключение
		Результат.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ " " + АдресЗапросаБезПараметров(Путь);
		Возврат Результат;
	КонецПопытки;

	Результат.КодСостояния = Ответ.КодСостояния;
	Результат.Тело = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'OData вернул код %1. %2'"),
			Ответ.КодСостояния,
			Лев(Результат.Тело, 500));
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// IIS отвечает 400 The request URL is invalid, если в пути сырые пробел, кавычка или двоеточие.
// Пробел нельзя кодировать как "+": в пути IIS считает плюс недопустимым. Разделители URL не кодируются.
//
Функция КодироватьПутьOData(Путь)

	Части = Новый Массив;
	Длина = СтрДлина(Путь);
	Индекс = 1;
	Пока Индекс <= Длина Цикл
		Если ЭтоКодПроцента(Путь, Индекс) Тогда
			Части.Добавить(Сред(Путь, Индекс, 3));
			Индекс = Индекс + 3;
			Продолжить;
		КонецЕсли;
		Символ = Сред(Путь, Индекс, 1);
		Если Символ = " " Тогда
			Части.Добавить("%20");
		ИначеЕсли Символ = ":" Тогда
			Части.Добавить("%3A");
		ИначеЕсли Символ = "'" Тогда
			Части.Добавить("%27");
		ИначеЕсли ЭтоДопустимыйСимволПутиOData(Символ) Тогда
			Части.Добавить(Символ);
		Иначе
			Закодированный = КодироватьСтроку(Символ, СпособКодированияСтроки.URLВКодировкеURL);
			Части.Добавить(СтрЗаменить(Закодированный, "+", "%20"));
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

Функция ЭтоДопустимыйСимволПутиOData(Символ)

	Код = КодСимвола(Символ, 1);
	Если Код >= 48 И Код <= 57 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Код >= 65 И Код <= 90 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Код >= 97 И Код <= 122 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат СтрНайти("/?&=-_.~(),$", Символ) > 0;

КонецФункции

Функция ЭтоКодПроцента(Путь, Индекс)

	Если Индекс + 2 > СтрДлина(Путь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЭтоШестнадцатеричнаяЦифра(Сред(Путь, Индекс + 1, 1))
		И ЭтоШестнадцатеричнаяЦифра(Сред(Путь, Индекс + 2, 1))
		И Сред(Путь, Индекс, 1) = "%";

КонецФункции

Функция ЭтоШестнадцатеричнаяЦифра(Символ)

	Код = КодСимвола(Символ, 1);
	Возврат (Код >= 48 И Код <= 57)
		Или (Код >= 65 И Код <= 70)
		Или (Код >= 97 И Код <= 102);

КонецФункции

Функция ЧислоТекста(Знач Текст)

	Текст = СокрЛП(Текст);
	Если КодСимвола(Текст, 1) = 65279 Тогда
		Текст = СокрЛП(Сред(Текст, 2));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Индекс = 1;
	Длина = СтрДлина(Текст);
	Пока Индекс <= Длина Цикл
		Код = КодСимвола(Текст, Индекс);
		Если Код < 48 Или Код > 57 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Число(Текст);

КонецФункции

Функция JSONВСоответствие(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;

КонецФункции

Функция ТекстОшибкиOData(Данные)

	Ошибка = Данные.Получить("odata.error");
	Если ТипЗнч(Ошибка) <> Тип("Соответствие") Тогда
		Ошибка = Данные.Получить("error");
	КонецЕсли;
	Если ТипЗнч(Ошибка) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Сообщение = Ошибка.Получить("message");
	Если ТипЗнч(Сообщение) = Тип("Соответствие") Тогда
		Текст = Сообщение.Получить("value");
		Если ЗначениеЗаполнено(Текст) Тогда
			Возврат Текст;
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Сообщение) = Тип("Строка") Тогда
		Возврат Сообщение;
	КонецЕсли;

	Возврат НСтр("ru = 'Сервис OData вернул ошибку.'");

КонецФункции

Функция ПутьИзАбсолютнойСсылки(Ссылка)

	БезСхемы = Ссылка;
	ПозицияСхемы = СтрНайти(НРег(Ссылка), "://");
	Если ПозицияСхемы > 0 Тогда
		БезСхемы = Сред(Ссылка, ПозицияСхемы + 3);
	КонецЕсли;
	ПозицияПути = СтрНайти(БезСхемы, "/");
	Если ПозицияПути = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(БезСхемы, ПозицияПути);

КонецФункции

Функция ПутьСледующейСтраницы(Путь, РазмерСтраницы)

	Маркер = "$skip=";
	Позиция = СтрНайти(НРег(Путь), Маркер);
	Если Позиция = 0 Тогда
		Разделитель = "?";
		Если СтрНайти(Путь, "?") > 0 Тогда
			Разделитель = "&";
		КонецЕсли;
		Возврат Путь + Разделитель + "$skip=" + Формат(РазмерСтраницы, "ЧГ=0");
	КонецЕсли;

	НачалоЧисла = Позиция + СтрДлина(Маркер);
	Хвост = Сред(Путь, НачалоЧисла);
	КонецЧисла = СтрНайти(Хвост, "&");
	ТекстЧисла = Хвост;
	Окончание = "";
	Если КонецЧисла > 0 Тогда
		ТекстЧисла = Лев(Хвост, КонецЧисла - 1);
		Окончание = Сред(Хвост, КонецЧисла);
	КонецЕсли;

	СледующийПропуск = Число(ТекстЧисла) + РазмерСтраницы;
	Возврат Лев(Путь, НачалоЧисла - 1) + Формат(СледующийПропуск, "ЧГ=0") + Окончание;

КонецФункции

#КонецОбласти
