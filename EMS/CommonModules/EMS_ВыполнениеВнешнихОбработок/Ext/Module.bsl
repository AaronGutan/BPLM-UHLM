#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Выполняет экспортный метод объекта внешней обработки в фоновом задании.
// Точка входа для ДлительныеОперации.ВыполнитьВФоне при открытии EPF из файла.
//
// Параметры:
//  Параметры - Структура:
//   * ДвоичныеДанныеОбработки - ДвоичныеДанные - файл EPF.
//   * ИмяМетода - Строка - имя экспортного метода модуля объекта обработки.
//   * ПараметрыМетода - Произвольный - первый параметр вызываемого метода.
//  АдресРезультата - Строка - адрес временного хранилища для результата метода.
//
Процедура ВыполнитьМетодВнешнейОбработки(Параметры, АдресРезультата) Экспорт
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("epf");
	
	Попытка
		Параметры.ДвоичныеДанныеОбработки.Записать(ИмяВременногоФайла);
		
		ОписаниеЗащиты = Новый ОписаниеЗащитыОтОпасныхДействий;
		ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
		
		Обработка = ВнешниеОбработки.Создать(ИмяВременногоФайла, Ложь, ОписаниеЗащиты);
		
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(Параметры.ПараметрыМетода);
		ПараметрыМетода.Добавить(АдресРезультата);
		
		ОбщегоНазначения.ВыполнитьМетодОбъекта(Обработка, Параметры.ИмяМетода, ПараметрыМетода);
		
	Исключение
		УдалитьВременныйФайлОбработки(ИмяВременногоФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьВременныйФайлОбработки(ИмяВременногоФайла);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УдалитьВременныйФайлОбработки(ИмяВременногоФайла)
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru='EMS.Выполнение внешних обработок';en='EMS.External processors execution'"),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			НСтр("ru='Не удалось удалить временный файл внешней обработки.';en='Failed to delete temporary external processor file.'"));
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
