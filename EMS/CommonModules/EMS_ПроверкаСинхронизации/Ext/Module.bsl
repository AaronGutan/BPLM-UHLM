#Область СравнениеКлючей
 
Функция ПолучитьРазницуПоКлючам(соЛокал, соВнешн, Индекс, ДанныеБазы, ОбъектМетаданных, НаборЗаписейСообщений)
	Если ДанныеБазы.Отладка Тогда
		Сообщить("Л " + соЛокал.Количество() + ", В " + соВнешн.Количество()); 
	КонецЕсли;
	соРазница = Новый Соответствие;
	мРазница = Новый Соответствие;  
	мКлючЗаписиРС = Новый Массив;
		Для Каждого Стр Из соВнешн Цикл
			Если соЛокал.Получить(Стр.Ключ) = Неопределено Тогда
				мСтр = Стр.Значение;
				СтрокаНабора = НаборЗаписейСообщений.Добавить();
				СтрокаНабора.Дата = ТекущаяДатаСеанса();
				СтрокаНабора.База = ДанныеБазы.База.Ссылка;
				СтрокаНабора.Вид = ОбъектМетаданных.Вид;
				СтрокаНабора.Тип = ОбъектМетаданных.Тип;
				СтрокаНабора.Сообщение = СообщитьМассивСтрокуЗн(мСтр, "В<Л", ДанныеБазы.Отладка);
				Если Индекс = Неопределено Тогда
				  мКлючЗаписиРС.Добавить(Стр.Значение);      
				Иначе 
				соРазница.Вставить(мСтр[Индекс]);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

	Рез = Новый Массив;
	Для Каждого Стр Из соРазница Цикл
		мСтр = Новый Массив;
		мСтр.Добавить(Стр.Ключ);
		Рез.Добавить(мСтр);
	КонецЦикла; 
	
	Если мКлючЗаписиРС.Количество()>0   Тогда
		 Возврат мКлючЗаписиРС;
	КонецЕсли;
	Если ДанныеБазы.Отладка Тогда
		Сообщить("Разниц: " + Рез.Количество());
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

Функция СообщитьМассивСтрокуЗн(Знач мСтр, Пре, Отладка)
	Сооб = "";
	Сооб = Пре + "|";
	Для Каждого Стр Из мСтр Цикл
		Зн = ЗначениеИзСтрокиВнутр(Стр);
				
		Сооб = Сооб
			+ Зн  + ","
			+ "|"
		;
	КонецЦикла;  
	Если Отладка Тогда
		Сообщить(Сооб);
	КонецЕсли;
	Возврат Сооб;
КонецФункции

Функция ПолучитьКлючиСтр(Внешн, ИнС = Неопределено) 
	соВнешн = Новый Соответствие;
	Для Каждого Стр Из Внешн Цикл
