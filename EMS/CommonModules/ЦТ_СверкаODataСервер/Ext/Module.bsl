Функция ЛокальнаяОСВПоВыводу(Организация, ДатаНачала, ДатаОкончания, Карты, Вывод)

	Поля = Новый Массив;
	Поля.Добавить("Регистр.Счет.Код КАК КодСчета");
	Если Вывод.Измерения Тогда
		Поля.Добавить("Регистр.Подразделение КАК Подразделение");
		Поля.Добавить("ПРЕДСТАВЛЕНИЕ(Регистр.Подразделение) КАК ПодразделениеПредставление");
		Поля.Добавить("Регистр.Валюта КАК Валюта");
		Поля.Добавить("ПРЕДСТАВЛЕНИЕ(Регистр.Валюта) КАК ВалютаПредставление");
	КонецЕсли;
	ДобавитьПолеСубконто(Поля, Вывод.Субконто1, 1);
	ДобавитьПолеСубконто(Поля, Вывод.Субконто2, 2);
	ДобавитьПолеСубконто(Поля, Вывод.Субконто3, 3);
	Для Каждого ИмяСуммы Из ИменаСуммОСВ() Цикл
		Поля.Добавить("Регистр." + ИмяСуммы + " КАК " + ИмяСуммы);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	" + СтрСоединить(Поля, ",
	|	") + "
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|		&НачалоПериода, &КонецПериода, Период, , , , Организация = &Организация) КАК Регистр";
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", Организация);

	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объекты = Новый Массив;
		ЧастиКлюча = Новый Массив;
		ЧастиКлюча.Добавить(Карты.УидОрганизацииБП);
		ЧастиКлюча.Добавить(СокрЛП(Выборка.КодСчета));
		Если Вывод.Измерения Тогда
			ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Подразделение, Выборка.ПодразделениеПредставление, Карты, Объекты));
			ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Валюта, Выборка.ВалютаПредставление, Карты, Неопределено));
		Иначе
			ЧастиКлюча.Добавить("<Пусто>");
			ЧастиКлюча.Добавить("<Пусто>");
		КонецЕсли;
		ДобавитьКлючСубконтоВыборки(ЧастиКлюча, Выборка, 1, Вывод.Субконто1, Карты, Объекты);
		ДобавитьКлючСубконтоВыборки(ЧастиКлюча, Выборка, 2, Вывод.Субконто2, Карты, Объекты);
		ДобавитьКлючСубконтоВыборки(ЧастиКлюча, Выборка, 3, Вывод.Субконто3, Карты, Объекты);
		Строки.Добавить(НоваяСтрокаСверки(
			СтрСоединить(ЧастиКлюча, "|"),
			Выборка.КодСчета,
			СуммыВыборки(Выборка, ИменаСуммОСВ()),
			Объекты,
			Выборка.КодСчета));
	КонецЦикла;

	Возврат Строки;

КонецФункции

Процедура ДобавитьПолеСубконто(Поля, Включить, Номер)

	Если Не Включить Тогда
		Возврат;
	КонецЕсли;
	Имя = "Субконто" + Формат(Номер, "ЧГ=0");
	Поля.Добавить("Регистр." + Имя + " КАК " + Имя);
	Поля.Добавить("ПРЕДСТАВЛЕНИЕ(Регистр." + Имя + ") КАК " + Имя + "Представление");

