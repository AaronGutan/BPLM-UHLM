#Область ПрограммныйИнтерфейс

// Сверяет ОСВ и, при расхождениях, обороты по регистраторам.
//
// Параметры:
//  Параметры - Структура - КодОрганизации, ДатаНачала, ДатаОкончания, АдресOData,
//    ПользовательOData, ПарольOData, Допуск, ВыполнятьСтупень2.
//
// Возвращаемое значение:
//  Структура - Успех, ТекстОшибки, Сообщение, Расхождения, КРегистрации, Ступень2Выполнена.
//
Функция Сверить(Параметры) Экспорт

	Результат = НовыйРезультатСверки();
	Подключение = ЦТ_ODataКлиентСервер.ПараметрыПодключения(
		Параметры.АдресOData, Параметры.ПользовательOData, Параметры.ПарольOData);
	Если ЗначениеЗаполнено(Подключение.Ошибка) Тогда
		Результат.ТекстОшибки = Подключение.Ошибка;
		Возврат Результат;
	КонецЕсли;

	ПроверкаМетаданных = ЦТ_ODataКлиентСервер.ПроверитьФункцииХозрасчетный(Подключение);
	Если Не ПроверкаМетаданных.Успех Тогда
		Результат.ТекстОшибки = ПроверкаМетаданных.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	Если Не ПроверкаМетаданных.ЕстьПолеРазвернутогоОстатка Тогда
		Результат.Сообщение.Добавить(НСтр("ru = '$metadata не содержит OpeningSplittedBalanceDr. Суммы ОСВ читаются по суффиксам виртуальной таблицы.'"));
	КонецЕсли;

	Организация = ОбменДаннымиПереопределяемый.Орг(Параметры.КодОрганизации);
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Организация по коду EMS не найдена.'");
		Возврат Результат;
	КонецЕсли;

	Карты = КартыСопоставления(Организация);
	Если Не ЗначениеЗаполнено(Карты.УидОрганизацииУХ) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось определить идентификатор организации на стороне УХ.'");
		Возврат Результат;
	КонецЕсли;

	ПланСчетовУХ = ЗагрузитьПланСчетовУХ(Подключение);
	Если Не ПланСчетовУХ.Успех Тогда
		Результат.ТекстОшибки = ПланСчетовУХ.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	Карты.КодСчетаПоУидУХ = ПланСчетовУХ.КодПоУид;
	Карты.УидСчетаУХПоКоду = ПланСчетовУХ.УидПоКоду;

	Локальные = ЛокальнаяОСВ(Организация, Параметры.ДатаНачала, Параметры.ДатаОкончания, Карты);
	Удаленные = УдаленнаяОСВ(Подключение, Параметры.ДатаНачала, Параметры.ДатаОкончания, Карты);
	Если Не Удаленные.Успех Тогда
		Результат.ТекстОшибки = Удаленные.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	СравнениеОСВ = СравнитьНаборы(Локальные, Удаленные.Строки, Параметры.Допуск, ИменаСуммОСВ(), "ОСВ", Ложь);
	ДополнитьМассив(Результат.Расхождения, СравнениеОСВ.Расхождения);
	ДобавитьОбъектыКРегистрации(Результат.КРегистрации, СравнениеОСВ.ОбъектыБП, Ложь);

	Результат.Сообщение.Добавить(СтрШаблон(
		НСтр("ru = 'ОСВ: строк БП %1, строк УХ %2, расхождений %3.'"),
		Локальные.Количество(),
		Удаленные.Строки.Количество(),
		СравнениеОСВ.Расхождения.Количество()));

	Если Параметры.ВыполнятьСтупень2 И НужнаСтупень2(СравнениеОСВ.Расхождения) Тогда
		ТекстСтупени = СверитьРегистраторы(Результат, Подключение, Параметры, Организация, Карты, СравнениеОСВ.Расхождения);
		Результат.Сообщение.Добавить(ТекстСтупени);
		Результат.Ступень2Выполнена = Истина;
	Иначе
		Результат.Сообщение.Добавить(НСтр("ru = 'Ступень регистраторов не выполнялась: расхождений ОСВ нет или она отключена.'"));
	КонецЕсли;

	Результат.Успех = Не ЗначениеЗаполнено(Результат.ТекстОшибки);
	Возврат Результат;

КонецФункции

// Ступень 2 нужна только когда ОСВ уже дала расхождения.
//
Функция НужнаСтупень2(Расхождения) Экспорт

	Возврат ТипЗнч(Расхождения) = Тип("Массив") И Расхождения.Количество() > 0;

КонецФункции

// Регистрирует пакет в узле ОбменДаннымиZ. Сначала должны идти справочники, затем документы.
//
// Параметры:
//  ЭлементыПакета - Массив из Структура
//
// Возвращаемое значение:
//  Структура - Успех, Зарегистрировано, ТекстОшибки, Ошибки.
//
Функция Зарегистрировать(ЭлементыПакета) Экспорт

	Ответ = Новый Структура("Успех, Зарегистрировано, ТекстОшибки, Ошибки", Истина, 0, "", Новый Массив);
	ЭлементыПакета = УпорядочитьПакет(ЭлементыПакета);
	Если ЭлементыПакета.Количество() = 0 Тогда
		Ответ.ТекстОшибки = НСтр("ru = 'Нет объектов для регистрации.'");
		Ответ.Успех = Ложь;
		Возврат Ответ;
	КонецЕсли;

	Порция = Новый Массив;
	Для Каждого ЭлементПакета Из ЭлементыПакета Цикл
		Порция.Добавить(ЭлементПакета);
		Если Порция.Количество() >= 100 Тогда
			ЗафиксироватьПорцию(Порция, Ответ);
			Порция = Новый Массив;
			Если Не Ответ.Успех Тогда
				Возврат Ответ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Порция.Количество() > 0 Тогда
		ЗафиксироватьПорцию(Порция, Ответ);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УпорядочитьПакет(ЭлементыПакета)

	Справочники = Новый Массив;
	Документы = Новый Массив;
	Для Каждого ЭлементПакета Из ЭлементыПакета Цикл
		Если ЭлементПакета.Вид = "Catalog" Тогда
			Справочники.Добавить(ЭлементПакета);
		Иначе
			Документы.Добавить(ЭлементПакета);
		КонецЕсли;
	КонецЦикла;
	ДополнитьМассив(Справочники, Документы);
	Возврат Справочники;

КонецФункции

Функция НовыйРезультатСверки()

	Возврат Новый Структура(
		"Успех, ТекстОшибки, Сообщение, Расхождения, КРегистрации, Ступень2Выполнена",
		Ложь, "", Новый Массив, Новый Массив, Новый Массив, Ложь);

КонецФункции

Функция СверитьРегистраторы(Результат, Подключение, Параметры, Организация, Карты, РасхожденияОСВ)

	Отбор = ОтборСчетовАналитики(РасхожденияОСВ);
	Если Отбор.КодыСчетов.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Ступень регистраторов пропущена: нет кодов счетов.'");
	КонецЕсли;

	Локальные = ЛокальныеОборотыПоРегистраторам(
		Организация, Параметры.ДатаНачала, Параметры.ДатаОкончания, Отбор, Карты);
	Удаленные = УдаленныеОборотыПоРегистраторам(
		Подключение, Параметры.ДатаНачала, Параметры.ДатаОкончания, Отбор, Карты);
	Если Не Удаленные.Успех Тогда
		Результат.Успех = Ложь;
		Результат.ТекстОшибки = Удаленные.ТекстОшибки;
		Возврат Удаленные.ТекстОшибки;
	КонецЕсли;

	Сравнение = СравнитьНаборы(Локальные, Удаленные.Строки, Параметры.Допуск, ИменаСуммОборотов(), "Регистратор", Истина);
	ДополнитьМассив(Результат.Расхождения, Сравнение.Расхождения);
	ДобавитьОбъектыКРегистрации(Результат.КРегистрации, Сравнение.ОбъектыБП, Истина);

	Возврат СтрШаблон(
		НСтр("ru = 'Регистраторы: строк БП %1, строк УХ %2, расхождений %3.'"),
		Локальные.Количество(),
		Удаленные.Строки.Количество(),
		Сравнение.Расхождения.Количество());

КонецФункции

Функция ЛокальнаяОСВ(Организация, ДатаНачала, ДатаОкончания, Карты)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Регистр.Счет.Код КАК КодСчета,
	|	Регистр.Подразделение КАК Подразделение,
	|	ПРЕДСТАВЛЕНИЕ(Регистр.Подразделение) КАК ПодразделениеПредставление,
	|	Регистр.Валюта КАК Валюта,
	|	ПРЕДСТАВЛЕНИЕ(Регистр.Валюта) КАК ВалютаПредставление,
	|	Регистр.Субконто1 КАК Субконто1,
	|	ПРЕДСТАВЛЕНИЕ(Регистр.Субконто1) КАК Субконто1Представление,
	|	Регистр.Субконто2 КАК Субконто2,
	|	ПРЕДСТАВЛЕНИЕ(Регистр.Субконто2) КАК Субконто2Представление,
	|	Регистр.Субконто3 КАК Субконто3,
	|	ПРЕДСТАВЛЕНИЕ(Регистр.Субконто3) КАК Субконто3Представление,
	|	Регистр.СуммаНачальныйРазвернутыйОстатокДт КАК СуммаНачальныйРазвернутыйОстатокДт,
	|	Регистр.СуммаНачальныйРазвернутыйОстатокКт КАК СуммаНачальныйРазвернутыйОстатокКт,
	|	Регистр.СуммаОборотДт КАК СуммаОборотДт,
	|	Регистр.СуммаОборотКт КАК СуммаОборотКт,
	|	Регистр.СуммаКонечныйРазвернутыйОстатокДт КАК СуммаКонечныйРазвернутыйОстатокДт,
	|	Регистр.СуммаКонечныйРазвернутыйОстатокКт КАК СуммаКонечныйРазвернутыйОстатокКт,
	|	Регистр.СуммаНУНачальныйРазвернутыйОстатокДт КАК СуммаНУНачальныйРазвернутыйОстатокДт,
	|	Регистр.СуммаНУНачальныйРазвернутыйОстатокКт КАК СуммаНУНачальныйРазвернутыйОстатокКт,
	|	Регистр.СуммаНУОборотДт КАК СуммаНУОборотДт,
	|	Регистр.СуммаНУОборотКт КАК СуммаНУОборотКт,
	|	Регистр.СуммаНУКонечныйРазвернутыйОстатокДт КАК СуммаНУКонечныйРазвернутыйОстатокДт,
	|	Регистр.СуммаНУКонечныйРазвернутыйОстатокКт КАК СуммаНУКонечныйРазвернутыйОстатокКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|		&НачалоПериода, &КонецПериода, Период, , , , Организация = &Организация) КАК Регистр";
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", Организация);

	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объекты = Новый Массив;
		ЧастиКлюча = Новый Массив;
		ЧастиКлюча.Добавить(Карты.УидОрганизацииБП);
		ЧастиКлюча.Добавить(СокрЛП(Выборка.КодСчета));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Подразделение, Выборка.ПодразделениеПредставление, Карты, Объекты));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Валюта, Выборка.ВалютаПредставление, Карты, Неопределено));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Субконто1, Выборка.Субконто1Представление, Карты, Объекты));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Субконто2, Выборка.Субконто2Представление, Карты, Объекты));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Субконто3, Выборка.Субконто3Представление, Карты, Объекты));
		Строки.Добавить(НоваяСтрокаСверки(СтрСоединить(ЧастиКлюча, "|"), Выборка.КодСчета, СуммыВыборки(Выборка, ИменаСуммОСВ()), Объекты, Выборка.КодСчета));
	КонецЦикла;

	Возврат Строки;

КонецФункции

Функция УдаленнаяОСВ(Подключение, ДатаНачала, ДатаОкончания, Карты)

	Условие = "Организация_Key eq guid''" + Карты.УидОрганизацииУХ + "''";
	Путь = "/AccountingRegister_Хозрасчетный/BalanceAndTurnovers("
		+ "StartPeriod=" + ЦТ_ODataКлиентСервер.ДатаВФорматеOData(ДатаНачала)
		+ ",EndPeriod=" + ЦТ_ODataКлиентСервер.ДатаВФорматеOData(КонецДня(ДатаОкончания))
		+ ",Condition='" + Условие + "')"
		+ "?$format=json&$top=1000&$skip=0";

	Страницы = ЦТ_ODataКлиентСервер.ПолучитьВсеСтраницы(Подключение, Путь);
	Ответ = Новый Структура("Успех, Строки, ТекстОшибки", Страницы.Успех, Новый Массив, Страницы.ТекстОшибки);
	Если Не Страницы.Успех Тогда
		Возврат Ответ;
	КонецЕсли;

	Для Каждого СтрокаOData Из Страницы.Строки Цикл
		КодСчета = КодСчетаУХ(ЦТ_ODataКлиентСервер.ЗначениеПоля(СтрокаOData, "Account"), Карты);
		ЧастиКлюча = Новый Массив;
		ЧастиКлюча.Добавить(Карты.УидОрганизацииБП);
		ЧастиКлюча.Добавить(КодСчета);
		ЧастиКлюча.Добавить(КлючПоляOData(СтрокаOData, "Подразделение", Карты));
		ЧастиКлюча.Добавить(КлючПоляOData(СтрокаOData, "Валюта", Карты));
		ЧастиКлюча.Добавить(КлючСубконтоOData(СтрокаOData, 1, Карты));
		ЧастиКлюча.Добавить(КлючСубконтоOData(СтрокаOData, 2, Карты));
		ЧастиКлюча.Добавить(КлючСубконтоOData(СтрокаOData, 3, Карты));
		Ответ.Строки.Добавить(НоваяСтрокаСверки(
			СтрСоединить(ЧастиКлюча, "|"),
			КодСчета,
			СуммыПолейОСВ(СтрокаOData),
			Новый Массив,
			КодСчета));
	КонецЦикла;

	Возврат Ответ;

КонецФункции

Функция ЛокальныеОборотыПоРегистраторам(Организация, ДатаНачала, ДатаОкончания, Отбор, Карты)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ХозрасчетныйОбороты.Счет.Код, """") КАК КодСчета,
	|	ХозрасчетныйОбороты.Субконто1 КАК Субконто1,
	|	ПРЕДСТАВЛЕНИЕ(ХозрасчетныйОбороты.Субконто1) КАК Субконто1Представление,
	|	ХозрасчетныйОбороты.Субконто2 КАК Субконто2,
	|	ПРЕДСТАВЛЕНИЕ(ХозрасчетныйОбороты.Субконто2) КАК Субконто2Представление,
	|	ХозрасчетныйОбороты.Субконто3 КАК Субконто3,
	|	ПРЕДСТАВЛЕНИЕ(ХозрасчетныйОбороты.Субконто3) КАК Субконто3Представление,
	|	ЕСТЬNULL(ХозрасчетныйОбороты.КорСчет.Код, """") КАК КодКорСчета,
	|	ХозрасчетныйОбороты.Регистратор КАК Регистратор,
	|	ХозрасчетныйОбороты.Регистратор.Дата КАК Дата,
	|	ХозрасчетныйОбороты.Регистратор.Номер КАК Номер,
	|	ХозрасчетныйОбороты.СуммаОборотДт КАК СуммаОборотДт,
	|	ХозрасчетныйОбороты.СуммаОборотКт КАК СуммаОборотКт,
	|	ХозрасчетныйОбороты.СуммаНУОборотДт КАК СуммаНУОборотДт,
	|	ХозрасчетныйОбороты.СуммаНУОборотКт КАК СуммаНУОборотКт,
	|	ХозрасчетныйОбороты.СуммаПРОборотДт КАК СуммаПРОборотДт,
	|	ХозрасчетныйОбороты.СуммаПРОборотКт КАК СуммаПРОборотКт,
	|	ХозрасчетныйОбороты.СуммаВРОборотДт КАК СуммаВРОборотДт,
	|	ХозрасчетныйОбороты.СуммаВРОборотКт КАК СуммаВРОборотКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|		&НачалоПериода, &КонецПериода, Регистратор, Счет.Код В (&КодыСчетов), , Организация = &Организация, , ) КАК ХозрасчетныйОбороты";
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КодыСчетов", Отбор.КодыСчетов);

	Накопление = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючАналитики = КлючАналитикиВыборки(Выборка, Карты, Неопределено);
		Если Отбор.КлючиАналитики.Получить(КлючАналитики) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Выборка.Регистратор) Тогда
			Продолжить;
		КонецЕсли;
		ВидДокумента = ИмяМетаданныхСсылки(Выборка.Регистратор);
		ЧастиКлюча = Новый Массив;
		ЧастиКлюча.Добавить(Карты.УидОрганизацииБП);
		ЧастиКлюча.Добавить(СокрЛП(Выборка.КодСчета));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Субконто1, Выборка.Субконто1Представление, Карты, Неопределено));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Субконто2, Выборка.Субконто2Представление, Карты, Неопределено));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Субконто3, Выборка.Субконто3Представление, Карты, Неопределено));
		ЧастиКлюча.Добавить(СокрЛП(Выборка.КодКорСчета));
		ЧастиКлюча.Добавить(ВидДокумента);
		ЧастиКлюча.Добавить(Формат(Выборка.Дата, "ДФ=yyyyMMdd"));
		ЧастиКлюча.Добавить(ВРег(СокрЛП(Выборка.Номер)));
		Ключ = СтрСоединить(ЧастиКлюча, "|");
		СтрокаСверки = Накопление.Получить(Ключ);
		Если СтрокаСверки = Неопределено Тогда
			Представление = СтрШаблон("%1 %2 от %3", ВидДокумента, СокрЛП(Выборка.Номер), Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"));
			СтрокаСверки = НоваяСтрокаСверки(Ключ, Выборка.КодСчета, ПустыеСуммы(ИменаСуммОборотов()), Новый Массив, Представление);
			Накопление.Вставить(Ключ, СтрокаСверки);
		КонецЕсли;
		ДобавитьСуммы(СтрокаСверки.Суммы, СуммыВыборки(Выборка, ИменаСуммОборотов()));
		ДобавитьРегистратор(СтрокаСверки.Объекты, Выборка.Регистратор, СтрокаСверки.Представление);
	КонецЦикла;

	Возврат ЗначенияСоответствия(Накопление);

КонецФункции

Функция УдаленныеОборотыПоРегистраторам(Подключение, ДатаНачала, ДатаОкончания, Отбор, Карты)

	Ответ = Новый Структура("Успех, Строки, ТекстОшибки", Истина, Новый Массив, "");
	Движения = Новый Массив;
	Коды = Отбор.КодыСчетов;
	Индекс = 0;
	Пока Индекс < Коды.Количество() Цикл
		Порция = Новый Массив;
		Пока Индекс < Коды.Количество() И Порция.Количество() < 10 Цикл
			Порция.Добавить(Коды[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;
		Страница = ДвиженияСчетаУХ(Подключение, ДатаНачала, ДатаОкончания, Порция, Карты);
		Если Не Страница.Успех Тогда
			Ответ.Успех = Ложь;
			Ответ.ТекстОшибки = Страница.ТекстОшибки;
			Возврат Ответ;
		КонецЕсли;
		ДополнитьМассив(Движения, Страница.Строки);
	КонецЦикла;

	Документы = РеквизитыДокументовУХ(Подключение, Движения);
	Если Не Документы.Успех Тогда
		Ответ.Успех = Ложь;
		Ответ.ТекстОшибки = Документы.ТекстОшибки;
		Возврат Ответ;
	КонецЕсли;

	Накопление = Новый Соответствие;
	Для Каждого Движение Из Движения Цикл
		ДобавитьСторонуДвижения(Накопление, Движение, Истина, Отбор, Карты, Документы.Кэш);
		ДобавитьСторонуДвижения(Накопление, Движение, Ложь, Отбор, Карты, Документы.Кэш);
	КонецЦикла;
	Ответ.Строки = ЗначенияСоответствия(Накопление);
	Возврат Ответ;

КонецФункции

Функция ДвиженияСчетаУХ(Подключение, ДатаНачала, ДатаОкончания, КодыСчетов, Карты)

	УсловияСчетов = Новый Массив;
	Для Каждого КодСчета Из КодыСчетов Цикл
		УидСчета = Карты.УидСчетаУХПоКоду.Получить(СокрЛП(КодСчета));
		Если Не ЗначениеЗаполнено(УидСчета) Тогда
			Продолжить;
		КонецЕсли;
		УсловияСчетов.Добавить("AccountDr_Key eq guid''" + УидСчета + "'' or AccountCr_Key eq guid''" + УидСчета + "''");
	КонецЦикла;
	Если УсловияСчетов.Количество() = 0 Тогда
		Возврат Новый Структура("Успех, Строки, ТекстОшибки", Истина, Новый Массив, "");
	КонецЕсли;

	УсловиеОрганизации = "Организация_Key eq guid''" + Карты.УидОрганизацииУХ + "''";
	Путь = "/AccountingRegister_Хозрасчетный/RecordsWithExtDimensions("
		+ "StartPeriod=" + ЦТ_ODataКлиентСервер.ДатаВФорматеOData(ДатаНачала)
		+ ",EndPeriod=" + ЦТ_ODataКлиентСервер.ДатаВФорматеOData(КонецДня(ДатаОкончания))
		+ ",Condition='" + УсловиеОрганизации + "'"
		+ ",AccountCondition='" + СтрСоединить(УсловияСчетов, " or ") + "')"
		+ "?$format=json&$top=1000&$skip=0";

	Возврат ЦТ_ODataКлиентСервер.ПолучитьВсеСтраницы(Подключение, Путь);

КонецФункции

Функция РеквизитыДокументовУХ(Подключение, Движения)

	Ответ = Новый Структура("Успех, ТекстОшибки, Кэш", Истина, "", Новый Соответствие);
	ПоТипам = Новый Соответствие;
	Для Каждого Движение Из Движения Цикл
		Описание = ОписаниеРегистратораOData(Движение);
		Если Не ЗначениеЗаполнено(Описание.ИмяНабора) Или ЦТ_ODataКлиентСервер.ПустойИдентификатор(Описание.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Список = ПоТипам.Получить(Описание.ИмяНабора);
		Если Список = Неопределено Тогда
			Список = Новый Соответствие;
			ПоТипам.Вставить(Описание.ИмяНабора, Список);
		КонецЕсли;
		Список.Вставить(НРег(Описание.Идентификатор), Истина);
	КонецЦикла;

	Для Каждого ТипДокумента Из ПоТипам Цикл
		Идентификаторы = Новый Массив;
		Для Каждого ЭлементИдентификатора Из ТипДокумента.Значение Цикл
			Идентификаторы.Добавить(ЭлементИдентификатора.Ключ);
		КонецЦикла;
		Индекс = 0;
		Пока Индекс < Идентификаторы.Количество() Цикл
			Фильтр = Новый Массив;
			Пока Индекс < Идентификаторы.Количество() И Фильтр.Количество() < 15 Цикл
				Фильтр.Добавить("Ref_Key eq guid'" + Идентификаторы[Индекс] + "'");
				Индекс = Индекс + 1;
			КонецЦикла;
			Путь = "/" + ТипДокумента.Ключ
				+ "?$select=Ref_Key,Date,Number&$format=json&$top=100&$filter="
				+ СтрСоединить(Фильтр, " or ");
			Страница = ЦТ_ODataКлиентСервер.ПолучитьВсеСтраницы(Подключение, Путь);
			Если Не Страница.Успех Тогда
				Ответ.Успех = Ложь;
				Ответ.ТекстОшибки = Страница.ТекстОшибки;
				Возврат Ответ;
			КонецЕсли;
			Для Каждого Документ Из Страница.Строки Цикл
				Идентификатор = НРег(Строка(ЦТ_ODataКлиентСервер.ЗначениеПоля(Документ, "Ref")));
				Ответ.Кэш.Вставить(ТипДокумента.Ключ + "|" + Идентификатор, Новый Структура(
					"Дата, Номер",
					ДатаИзOData(Документ.Получить("Date")),
					Строка(Документ.Получить("Number"))));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Ответ;

КонецФункции

Процедура ДобавитьСторонуДвижения(Накопление, Движение, ЭтоДебет, Отбор, Карты, КэшДокументов)

	ИмяСчета = "AccountDr";
	ИмяКорСчета = "AccountCr";
	СуффиксСтороны = "Dr";
	Если Не ЭтоДебет Тогда
		ИмяСчета = "AccountCr";
		ИмяКорСчета = "AccountDr";
		СуффиксСтороны = "Cr";
	КонецЕсли;

	КодСчета = КодСчетаУХ(ЦТ_ODataКлиентСервер.ЗначениеПоля(Движение, ИмяСчета), Карты);
	КодКорСчета = КодСчетаУХ(ЦТ_ODataКлиентСервер.ЗначениеПоля(Движение, ИмяКорСчета), Карты);
	КлючСубконто1 = КлючСубконтоСтороны(Движение, СуффиксСтороны, 1, Карты);
	КлючСубконто2 = КлючСубконтоСтороны(Движение, СуффиксСтороны, 2, Карты);
	КлючСубконто3 = КлючСубконтоСтороны(Движение, СуффиксСтороны, 3, Карты);
	ЧастиАналитики = Новый Массив;
	ЧастиАналитики.Добавить(КодСчета);
	ЧастиАналитики.Добавить(КлючСубконто1);
	ЧастиАналитики.Добавить(КлючСубконто2);
	ЧастиАналитики.Добавить(КлючСубконто3);
	КлючАналитики = СтрСоединить(ЧастиАналитики, "|");
	Если Отбор.КлючиАналитики.Получить(КлючАналитики) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОписаниеРегистратора = ОписаниеРегистратораOData(Движение);
	Реквизиты = КэшДокументов.Получить(ОписаниеРегистратора.ИмяНабора + "|" + НРег(ОписаниеРегистратора.Идентификатор));
	ДатаДокумента = Дата(1, 1, 1);
	НомерДокумента = "";
	Если Реквизиты <> Неопределено Тогда
		ДатаДокумента = Реквизиты.Дата;
		НомерДокумента = Реквизиты.Номер;
	КонецЕсли;

	ЧастиКлюча = Новый Массив;
	ЧастиКлюча.Добавить(Карты.УидОрганизацииБП);
	ЧастиКлюча.Добавить(КодСчета);
	ЧастиКлюча.Добавить(КлючСубконто1);
	ЧастиКлюча.Добавить(КлючСубконто2);
	ЧастиКлюча.Добавить(КлючСубконто3);
	ЧастиКлюча.Добавить(КодКорСчета);
	ЧастиКлюча.Добавить(ОписаниеРегистратора.Вид);
	ЧастиКлюча.Добавить(Формат(ДатаДокумента, "ДФ=yyyyMMdd"));
	ЧастиКлюча.Добавить(ВРег(СокрЛП(НомерДокумента)));
	Ключ = СтрСоединить(ЧастиКлюча, "|");

	СтрокаСверки = Накопление.Получить(Ключ);
	Если СтрокаСверки = Неопределено Тогда
		Представление = СтрШаблон("%1 %2 от %3", ОписаниеРегистратора.Вид, СокрЛП(НомерДокумента), Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"));
		СтрокаСверки = НоваяСтрокаСверки(Ключ, КодСчета, ПустыеСуммы(ИменаСуммОборотов()), Новый Массив, Представление);
		Накопление.Вставить(Ключ, СтрокаСверки);
	КонецЕсли;

	СуммаПроводки = ЦТ_ODataКлиентСервер.ЧислоПоля(Движение, "Сумма");
	СуммыСтороны = ПустыеСуммы(ИменаСуммОборотов());
	Если ЭтоДебет Тогда
		СуммыСтороны.СуммаОборотДт = СуммаПроводки;
		СуммыСтороны.СуммаНУОборотДт = СуммаРесурсаСтороны(Движение, "СуммаНУ", "Dr");
		СуммыСтороны.СуммаПРОборотДт = СуммаРесурсаСтороны(Движение, "СуммаПР", "Dr");
		СуммыСтороны.СуммаВРОборотДт = СуммаРесурсаСтороны(Движение, "СуммаВР", "Dr");
	Иначе
		СуммыСтороны.СуммаОборотКт = СуммаПроводки;
		СуммыСтороны.СуммаНУОборотКт = СуммаРесурсаСтороны(Движение, "СуммаНУ", "Cr");
		СуммыСтороны.СуммаПРОборотКт = СуммаРесурсаСтороны(Движение, "СуммаПР", "Cr");
		СуммыСтороны.СуммаВРОборотКт = СуммаРесурсаСтороны(Движение, "СуммаВР", "Cr");
	КонецЕсли;
	ДобавитьСуммы(СтрокаСверки.Суммы, СуммыСтороны);

КонецПроцедуры

Функция СуммаРесурсаСтороны(Движение, Ресурс, Суффикс)

	Значение = ЦТ_ODataКлиентСервер.ЧислоПоля(Движение, Ресурс + Суффикс);
	Если Значение <> 0 Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЦТ_ODataКлиентСервер.ЧислоПоля(Движение, Ресурс);

КонецФункции

Функция СравнитьНаборы(Локальные, Удаленные, Допуск, ИменаСумм, Ступень, РегистрироватьРасхождениеСумм)

	ИндексУдаленных = Новый Соответствие;
	Для Каждого СтрокаУХ Из Удаленные Цикл
		ИндексУдаленных.Вставить(СтрокаУХ.Ключ, СтрокаУХ);
	КонецЦикла;

	Расхождения = Новый Массив;
	ОбъектыБП = Новый Массив;
	Обработанные = Новый Соответствие;
	Для Каждого СтрокаБП Из Локальные Цикл
		Обработанные.Вставить(СтрокаБП.Ключ, Истина);
		СтрокаУХ = ИндексУдаленных.Получить(СтрокаБП.Ключ);
		Если СтрокаУХ = Неопределено Тогда
			Расхождения.Добавить(ОписаниеРасхождения(Ступень, "Только БП", СтрокаБП, Неопределено));
			ОбъектыБП.Добавить(СтрокаБП);
			Продолжить;
		КонецЕсли;
		Если СуммыРасходятся(СтрокаБП.Суммы, СтрокаУХ.Суммы, ИменаСумм, Допуск) Тогда
			Расхождения.Добавить(ОписаниеРасхождения(Ступень, "Сумма", СтрокаБП, СтрокаУХ));
			Если РегистрироватьРасхождениеСумм Тогда
				ОбъектыБП.Добавить(СтрокаБП);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаУХ Из Удаленные Цикл
		Если Обработанные.Получить(СтрокаУХ.Ключ) = Неопределено Тогда
			Расхождения.Добавить(ОписаниеРасхождения(Ступень, "Только УХ", Неопределено, СтрокаУХ));
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Расхождения, ОбъектыБП", Расхождения, ОбъектыБП);

КонецФункции

Функция ОписаниеРасхождения(Ступень, Вид, СтрокаБП, СтрокаУХ)

	Счет = "";
	Ключ = "";
	СуммаБП = 0;
	СуммаУХ = 0;
	Представление = "";
	Если СтрокаБП <> Неопределено Тогда
		Счет = СтрокаБП.КодСчета;
		Ключ = СтрокаБП.Ключ;
		СуммаБП = СтрокаБП.Суммы.СуммаОборотДт;
		Представление = СтрокаБП.Представление;
		Если Не СтрокаБП.Суммы.Свойство("СуммаОборотДт") Тогда
			СуммаБП = СтрокаБП.Суммы.СуммаНачальныйРазвернутыйОстатокДт;
		КонецЕсли;
	КонецЕсли;
	Если СтрокаУХ <> Неопределено Тогда
		Счет = СтрокаУХ.КодСчета;
		Ключ = СтрокаУХ.Ключ;
		СуммаУХ = 0;
		Если СтрокаУХ.Суммы.Свойство("СуммаОборотДт") Тогда
			СуммаУХ = СтрокаУХ.Суммы.СуммаОборотДт;
		Иначе
			СуммаУХ = СтрокаУХ.Суммы.СуммаНачальныйРазвернутыйОстатокДт;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Представление) Тогда
			Представление = СтрокаУХ.Представление;
		КонецЕсли;
	КонецЕсли;
	Если СтрокаБП <> Неопределено И СтрокаБП.Суммы.Свойство("СуммаОборотДт") Тогда
		СуммаБП = СтрокаБП.Суммы.СуммаОборотДт;
	КонецЕсли;

	Возврат Новый Структура("Ступень, Вид, Счет, Ключ, СуммаБП, СуммаУХ, Представление",
		Ступень, Вид, Счет, Ключ, СуммаБП, СуммаУХ, Представление);

КонецФункции

Процедура ДобавитьОбъектыКРегистрации(Приемник, СтрокиБП, ТолькоРегистраторы)

	УжеДобавленные = Новый Соответствие;
	Для Каждого Существующий Из Приемник Цикл
		УжеДобавленные.Вставить(Существующий.КлючJSON, Истина);
	КонецЦикла;

	Для Каждого СтрокаБП Из СтрокиБП Цикл
		Для Каждого ОбъектРегистрации Из СтрокаБП.Объекты Цикл
			Если ТолькоРегистраторы И Не ОбъектРегистрации.ЭтоРегистратор Тогда
				Продолжить;
			КонецЕсли;
			Если Не ТолькоРегистраторы И ОбъектРегистрации.ЭтоРегистратор Тогда
				Продолжить;
			КонецЕсли;
			Если ОбъектРегистрации.Битая Или Не ЗначениеЗаполнено(ОбъектРегистрации.КлючJSON) Тогда
				Продолжить;
			КонецЕсли;
			Если УжеДобавленные.Получить(ОбъектРегистрации.КлючJSON) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			УжеДобавленные.Вставить(ОбъектРегистрации.КлючJSON, Истина);
			Приемник.Добавить(Новый Структура(
				"Пометка, Вид, ПолноеИмя, Представление, КлючJSON",
				Истина,
				ОбъектРегистрации.ВидДанных,
				ОбъектРегистрации.ПолноеИмя,
				ОбъектРегистрации.Представление,
				ОбъектРегистрации.КлючJSON));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция КартыСопоставления(Организация)

	УидОрганизацииБП = НРег(XMLСтрока(Организация));
	Карты = Новый Структура;
	Карты.Вставить("УидОрганизацииБП", УидОрганизацииБП);
	Карты.Вставить("УидОрганизацииУХ", УидОрганизацииБП);
	Карты.Вставить("УидПриемникаВУидИсточника", Новый Соответствие);
	Карты.Вставить("КодСчетаПоУидУХ", Новый Соответствие);
	Карты.Вставить("УидСчетаУХПоКоду", Новый Соответствие);
	Карты.Вставить("КодСчетаПоУидБП", КодыСчетовБП());

	Узел = УзелОбмена();
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат Карты;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Соответствия.УникальныйИдентификаторПриемника КАК Приемник,
	|	Соответствия.УникальныйИдентификаторИсточникаСтрокой КАК Источник
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соответствия
	|ГДЕ
	|	Соответствия.УзелИнформационнойБазы = &Узел";
	Запрос.УстановитьПараметр("Узел", Узел);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Источник = НРег(СокрЛП(Выборка.Источник));
		Приемник = НРег(СокрЛП(Выборка.Приемник));
		Если ЗначениеЗаполнено(Источник) И ЗначениеЗаполнено(Приемник) Тогда
			Карты.УидПриемникаВУидИсточника.Вставить(Приемник, Источник);
			Если Источник = УидОрганизацииБП Тогда
				Карты.УидОрганизацииУХ = Приемник;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Карты;

КонецФункции

Функция УзелОбмена()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОбменДаннымиZ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.ОбменДаннымиZ КАК ОбменДаннымиZ
	|ГДЕ
	|	НЕ ОбменДаннымиZ.ЭтотУзел";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция КодыСчетовБП()

	Коды = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Хозрасчетный.Ссылка КАК Ссылка,
	|	Хозрасчетный.Код КАК Код
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Хозрасчетный";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Коды.Вставить(НРег(XMLСтрока(Выборка.Ссылка)), СокрЛП(Выборка.Код));
	КонецЦикла;
	Возврат Коды;

КонецФункции

Функция ЗагрузитьПланСчетовУХ(Подключение)

	Страницы = ЦТ_ODataКлиентСервер.ПолучитьВсеСтраницы(
		Подключение,
		"/ChartOfAccounts_Хозрасчетный?$select=Ref_Key,Code&$format=json&$top=1000&$skip=0");
	Ответ = Новый Структура("Успех, ТекстОшибки, КодПоУид, УидПоКоду",
		Страницы.Успех, Страницы.ТекстОшибки, Новый Соответствие, Новый Соответствие);
	Если Не Страницы.Успех Тогда
		Возврат Ответ;
	КонецЕсли;
	Для Каждого СтрокаСчета Из Страницы.Строки Цикл
		Идентификатор = НРег(Строка(ЦТ_ODataКлиентСервер.ЗначениеПоля(СтрокаСчета, "Ref")));
		Код = СокрЛП(Строка(СтрокаСчета.Получить("Code")));
		Если ЗначениеЗаполнено(Идентификатор) И ЗначениеЗаполнено(Код) Тогда
			Ответ.КодПоУид.Вставить(Идентификатор, Код);
			Ответ.УидПоКоду.Вставить(Код, Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат Ответ;

КонецФункции

Функция ОтборСчетовАналитики(Расхождения)

	Коды = Новый Массив;
	УжеКоды = Новый Соответствие;
	Ключи = Новый Соответствие;
	Для Каждого Расхождение Из Расхождения Цикл
		Части = СтрРазделить(Расхождение.Ключ, "|", Истина);
		Если Части.Количество() < 7 Тогда
			Продолжить;
		КонецЕсли;
		КодСчета = Части[1];
		Если УжеКоды.Получить(КодСчета) = Неопределено И ЗначениеЗаполнено(КодСчета) Тогда
			УжеКоды.Вставить(КодСчета, Истина);
			Коды.Добавить(КодСчета);
		КонецЕсли;
		ЧастиАналитики = Новый Массив;
		ЧастиАналитики.Добавить(Части[1]);
		ЧастиАналитики.Добавить(Части[4]);
		ЧастиАналитики.Добавить(Части[5]);
		ЧастиАналитики.Добавить(Части[6]);
		Ключи.Вставить(СтрСоединить(ЧастиАналитики, "|"), Истина);
	КонецЦикла;
	Возврат Новый Структура("КодыСчетов, КлючиАналитики", Коды, Ключи);

КонецФункции

Функция КлючАналитикиВыборки(Выборка, Карты, Объекты)

	Части = Новый Массив;
	Части.Добавить(СокрЛП(Выборка.КодСчета));
	Части.Добавить(КлючСсылкиБП(Выборка.Субконто1, Выборка.Субконто1Представление, Карты, Объекты));
	Части.Добавить(КлючСсылкиБП(Выборка.Субконто2, Выборка.Субконто2Представление, Карты, Объекты));
	Части.Добавить(КлючСсылкиБП(Выборка.Субконто3, Выборка.Субконто3Представление, Карты, Объекты));
	Возврат СтрСоединить(Части, "|");

КонецФункции

Функция КлючСсылкиБП(Значение, Представление, Карты, Объекты)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "<Пусто>";
	КонецЕсли;

	МетаданныеЗначения = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Если МетаданныеЗначения = Неопределено Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;

	ПолноеИмя = МетаданныеЗначения.ПолноеИмя();
	Если СтрНачинаетсяС(ПолноеИмя, "ПланСчетов.") Тогда
		Код = Карты.КодСчетаПоУидБП.Получить(НРег(XMLСтрока(Значение)));
		Если ЗначениеЗаполнено(Код) Тогда
			Возврат "ChartOfAccounts_" + МетаданныеЗначения.Имя + "|" + Код;
		КонецЕсли;
	КонецЕсли;

	ИмяТипа = ИмяТипаOData(ПолноеИмя);
	Ключ = ИмяТипа + "|" + НРег(XMLСтрока(Значение));
	Если Объекты <> Неопределено И ЭтоРегистрируемыйТип(ПолноеИмя) Тогда
		Объекты.Добавить(ОписаниеОбъектаРегистрации(Значение, Представление, ПолноеИмя, Ложь));
	КонецЕсли;
	Возврат Ключ;

КонецФункции

Функция КлючПоляOData(СтрокаOData, ИмяПоля, Карты)

	Идентификатор = ЦТ_ODataКлиентСервер.ЗначениеПоля(СтрокаOData, ИмяПоля);
	Если ЦТ_ODataКлиентСервер.ПустойИдентификатор(Идентификатор) Тогда
		Возврат "<Пусто>";
	КонецЕсли;
	ТипПоля = Строка(СтрокаOData.Получить(ИмяПоля + "_Type"));
	УидИсточника = УидВКоординатахБП(Идентификатор, Карты);
	КодСчета = Карты.КодСчетаПоУидУХ.Получить(НРег(Строка(Идентификатор)));
	Если СтрНайти(ТипПоля, "ChartOfAccounts_") > 0 И ЗначениеЗаполнено(КодСчета) Тогда
		Возврат ИмяТипаБезПрефикса(ТипПоля) + "|" + КодСчета;
	КонецЕсли;
	Возврат ИмяТипаБезПрефикса(ТипПоля) + "|" + УидИсточника;

КонецФункции

Функция КлючСубконтоOData(СтрокаOData, Номер, Карты)

	Возврат КлючПоляOData(СтрокаOData, "ExtDimension" + Формат(Номер, "ЧГ=0"), Карты);

КонецФункции

Функция КлючСубконтоСтороны(Движение, СуффиксСтороны, Номер, Карты)

	ИмяПоля = "ExtDimension" + СуффиксСтороны + Формат(Номер, "ЧГ=0");
	Ключ = КлючПоляOData(Движение, ИмяПоля, Карты);
	Если Ключ <> "<Пусто>" Тогда
		Возврат Ключ;
	КонецЕсли;
	Возврат КлючСубконтоOData(Движение, Номер, Карты);

КонецФункции

Функция ОписаниеРегистратораOData(Движение)

	ТипРегистратора = Строка(Движение.Получить("Recorder_Type"));
	Идентификатор = ЦТ_ODataКлиентСервер.ЗначениеПоля(Движение, "Recorder");
	ИмяНабора = ИмяТипаБезПрефикса(ТипРегистратора);
	Вид = ИмяНабора;
	Префикс = "Document_";
	Если СтрНачинаетсяС(ИмяНабора, Префикс) Тогда
		Вид = Сред(ИмяНабора, СтрДлина(Префикс) + 1);
	КонецЕсли;
	Возврат Новый Структура("ИмяНабора, Идентификатор, Вид", ИмяНабора, Строка(Идентификатор), Вид);

КонецФункции

Функция ОписаниеОбъектаРегистрации(Ссылка, Представление, ПолноеИмя, ЭтоРегистратор)

	Битая = СтрНачинаетсяС(Строка(Представление), "<Объект не найден>");
	ВидДанных = "Catalog";
	Если СтрНачинаетсяС(ПолноеИмя, "Документ.") Тогда
		ВидДанных = "Document";
	КонецЕсли;
	Ключ = "";
	Если Не Битая Тогда
		Ключ = JSON(Новый Структура("Ссылка", ЗначениеВСтрокуВнутр(Ссылка)));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Представление = ПолноеИмя;
	КонецЕсли;
	Возврат Новый Структура(
		"ЭтоРегистратор, Битая, ВидДанных, ПолноеИмя, Представление, КлючJSON",
		ЭтоРегистратор, Битая, ВидДанных, ПолноеИмя, Представление, Ключ);

КонецФункции

Процедура ДобавитьРегистратор(Объекты, Регистратор, Представление)

	ПолноеИмя = ПолноеИмяСсылки(Регистратор);
	Если Не ЗначениеЗаполнено(ПолноеИмя) Тогда
		Возврат;
	КонецЕсли;
	Ключ = JSON(Новый Структура("Ссылка", ЗначениеВСтрокуВнутр(Регистратор)));
	Для Каждого Существующий Из Объекты Цикл
		Если Существующий.КлючJSON = Ключ Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Описание = ОписаниеОбъектаРегистрации(Регистратор, Представление, ПолноеИмя, Истина);
	Объекты.Добавить(Описание);

