Процедура ЗафиксироватьПорцию(Порция, Ответ, Узел)

	Элементы = Новый Массив;
	Для Каждого СтрокаПакета Из Порция Цикл
		Элементы.Добавить(Новый Структура(
			"ПолноеИмяМетаданных, ВидДанныхДляРегистрации, КлючРегистрацииОтбор",
			СтрокаПакета.ПолноеИмя,
			СтрокаПакета.Вид,
			СтрокаПакета.КлючJSON));
	КонецЦикла;

	Результаты = EMS_ИзмененияПланаОбмена.ЗарегистрироватьИзмененияПоСообщениям(Элементы, Узел);
	Для Каждого РезультатЭлемента Из Результаты Цикл
		Если РезультатЭлемента.Success Тогда
			Ответ.Зарегистрировано = Ответ.Зарегистрировано + 1;
		Иначе
			Ответ.Успех = Ложь;
			Ответ.Ошибки.Добавить(РезультатЭлемента.ErrorText);
		КонецЕсли;
	КонецЦикла;
	Если Ответ.Ошибки.Количество() > 0 И Не ЗначениеЗаполнено(Ответ.ТекстОшибки) Тогда
		Ответ.ТекстОшибки = Ответ.Ошибки[0];
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьМассив(Приемник, Источник)

	Для Каждого ЭлементИсточника Из Источник Цикл
		Приемник.Добавить(ЭлементИсточника);
	КонецЦикла;

КонецПроцедуры

Функция ЗначенияСоответствия(СоответствиеЗначений)

	Значения = Новый Массив;
	Для Каждого ЭлементСоответствия Из СоответствиеЗначений Цикл
		Значения.Добавить(ЭлементСоответствия.Значение);
	КонецЦикла;
	Возврат Значения;

КонецФункции

