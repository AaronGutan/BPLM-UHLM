Функция ИмяТипаOData(ПолноеИмя)

	Если СтрНачинаетсяС(ПолноеИмя, "Справочник.") Тогда
		Возврат "Catalog_" + Сред(ПолноеИмя, СтрДлина("Справочник.") + 1);
	КонецЕсли;
	Если СтрНачинаетсяС(ПолноеИмя, "Документ.") Тогда
		Возврат "Document_" + Сред(ПолноеИмя, СтрДлина("Документ.") + 1);
	КонецЕсли;
	Если СтрНачинаетсяС(ПолноеИмя, "ПланСчетов.") Тогда
		Возврат "ChartOfAccounts_" + Сред(ПолноеИмя, СтрДлина("ПланСчетов.") + 1);
	КонецЕсли;
	Если СтрНачинаетсяС(ПолноеИмя, "ПланВидовХарактеристик.") Тогда
		Возврат "ChartOfCharacteristicTypes_" + Сред(ПолноеИмя, СтрДлина("ПланВидовХарактеристик.") + 1);
	КонецЕсли;
	Если СтрНачинаетсяС(ПолноеИмя, "Перечисление.") Тогда
		Возврат "Enum_" + Сред(ПолноеИмя, СтрДлина("Перечисление.") + 1);
	КонецЕсли;
	Возврат СтрЗаменить(ПолноеИмя, ".", "_");

