Функция СуммыПолейОСВ(СтрокаOData)

	Суммы = ПустыеСуммы(ИменаСуммОСВ());
	Суффиксы = СуффиксыПолейОСВ();
	Для Каждого ИмяСуммы Из ИменаСуммОСВ() Цикл
		Ресурс = "Сумма";
		ИмяБезРесурса = ИмяСуммы;
		Если СтрНачинаетсяС(ИмяСуммы, "СуммаНУ") Тогда
			Ресурс = "СуммаНУ";
			ИмяБезРесурса = Сред(ИмяСуммы, СтрДлина("СуммаНУ") + 1);
			ИмяБезРесурса = "Сумма" + ИмяБезРесурса;
		КонецЕсли;
		Суффикс = Суффиксы.Получить(ИмяБезРесурса);
		Суммы[ИмяСуммы] = ЦТ_ODataКлиентСервер.ЧислоПоля(СтрокаOData, Ресурс + Суффикс);
	КонецЦикла;
	Возврат Суммы;

КонецФункции

Функция ПустыеСуммы(Имена)

	Суммы = Новый Структура;
	Для Каждого ИмяСуммы Из Имена Цикл
		Суммы.Вставить(ИмяСуммы, 0);
	КонецЦикла;
	Возврат Суммы;

КонецФункции

Функция СуммыВыборки(Выборка, Имена)

	Суммы = ПустыеСуммы(Имена);
	Для Каждого ИмяСуммы Из Имена Цикл
		Суммы[ИмяСуммы] = Выборка[ИмяСуммы];
	КонецЦикла;
	Возврат Суммы;

КонецФункции

Процедура ДобавитьСуммы(Приемник, Источник)

	Для Каждого ЭлементСуммы Из Источник Цикл
		Приемник[ЭлементСуммы.Ключ] = Приемник[ЭлементСуммы.Ключ] + ЭлементСуммы.Значение;
	КонецЦикла;

КонецПроцедуры

Функция СуммыРасходятся(СуммыБП, СуммыУХ, Имена, Допуск)

	Для Каждого ИмяСуммы Из Имена Цикл
		Если Макс(СуммыБП[ИмяСуммы] - СуммыУХ[ИмяСуммы], СуммыУХ[ИмяСуммы] - СуммыБП[ИмяСуммы]) > Допуск Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ДатаИзOData(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = Лев(СокрЛП(Строка(Значение)), 19);
	Текст = СтрЗаменить(Текст, "-", "");
	Текст = СтрЗаменить(Текст, "T", "");
	Текст = СтрЗаменить(Текст, ":", "");
	Если СтрДлина(Текст) < 8 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(Текст);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

Функция JSON(Данные)

	Запись = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	Запись.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

Процедура ЗафиксироватьПорцию(Порция, Ответ)

	Элементы = Новый Массив;
	Для Каждого СтрокаПакета Из Порция Цикл
		Элементы.Добавить(Новый Структура(
			"ПолноеИмяМетаданных, ВидДанныхДляРегистрации, КлючРегистрацииОтбор",
			СтрокаПакета.ПолноеИмя,
			СтрокаПакета.Вид,
			СтрокаПакета.КлючJSON));
	КонецЦикла;

	Результаты = EMS_ИзмененияПланаОбмена.ЗарегистрироватьИзмененияПоСообщениям(Элементы);
	Для Каждого РезультатЭлемента Из Результаты Цикл
		Если РезультатЭлемента.Success Тогда
			Ответ.Зарегистрировано = Ответ.Зарегистрировано + 1;
		Иначе
			Ответ.Успех = Ложь;
			Ответ.Ошибки.Добавить(РезультатЭлемента.ErrorText);
		КонецЕсли;
	КонецЦикла;
	Если Ответ.Ошибки.Количество() > 0 И Не ЗначениеЗаполнено(Ответ.ТекстОшибки) Тогда
		Ответ.ТекстОшибки = Ответ.Ошибки[0];
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьМассив(Приемник, Источник)

	Для Каждого ЭлементИсточника Из Источник Цикл
		Приемник.Добавить(ЭлементИсточника);
	КонецЦикла;

КонецПроцедуры

Функция ЗначенияСоответствия(СоответствиеЗначений)

	Значения = Новый Массив;
	Для Каждого ЭлементСоответствия Из СоответствиеЗначений Цикл
		Значения.Добавить(ЭлементСоответствия.Значение);
	КонецЦикла;
	Возврат Значения;

КонецФункции

#КонецОбласти
