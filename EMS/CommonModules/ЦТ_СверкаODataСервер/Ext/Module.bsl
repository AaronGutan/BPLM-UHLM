	Суффиксы.Вставить("СуммаНачальныйРазвернутыйОстатокДт", "OpeningSplittedBalanceDr");
	Суффиксы.Вставить("СуммаНачальныйРазвернутыйОстатокКт", "OpeningSplittedBalanceCr");
