Функция ЛокальныеОборотыПоРегистраторам(Организация, ДатаНачала, ДатаОкончания, Отбор, Карты)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ХозрасчетныйОбороты.Счет.Код, """") КАК КодСчета,
	|	ХозрасчетныйОбороты.Субконто1 КАК Субконто1,
	|	ПРЕДСТАВЛЕНИЕ(ХозрасчетныйОбороты.Субконто1) КАК Субконто1Представление,
	|	ХозрасчетныйОбороты.Субконто2 КАК Субконто2,
	|	ПРЕДСТАВЛЕНИЕ(ХозрасчетныйОбороты.Субконто2) КАК Субконто2Представление,
	|	ХозрасчетныйОбороты.Субконто3 КАК Субконто3,
	|	ПРЕДСТАВЛЕНИЕ(ХозрасчетныйОбороты.Субконто3) КАК Субконто3Представление,
	|	ЕСТЬNULL(ХозрасчетныйОбороты.КорСчет.Код, """") КАК КодКорСчета,
	|	ХозрасчетныйОбороты.Регистратор КАК Регистратор,
	|	ХозрасчетныйОбороты.Регистратор.Дата КАК Дата,
	|	ХозрасчетныйОбороты.Регистратор.Номер КАК Номер,
	|	ХозрасчетныйОбороты.СуммаОборотДт КАК СуммаОборотДт,
	|	ХозрасчетныйОбороты.СуммаОборотКт КАК СуммаОборотКт,
	|	ХозрасчетныйОбороты.СуммаНУОборотДт КАК СуммаНУОборотДт,
	|	ХозрасчетныйОбороты.СуммаНУОборотКт КАК СуммаНУОборотКт,
	|	ХозрасчетныйОбороты.СуммаПРОборотДт КАК СуммаПРОборотДт,
	|	ХозрасчетныйОбороты.СуммаПРОборотКт КАК СуммаПРОборотКт,
	|	ХозрасчетныйОбороты.СуммаВРОборотДт КАК СуммаВРОборотДт,
	|	ХозрасчетныйОбороты.СуммаВРОборотКт КАК СуммаВРОборотКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|		&НачалоПериода, &КонецПериода, Регистратор, Счет.Код В (&КодыСчетов), , Организация = &Организация, , ) КАК ХозрасчетныйОбороты";
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КодыСчетов", Отбор.КодыСчетов);

	Накопление = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючАналитики = КлючАналитикиВыборки(Выборка, Карты, Неопределено);
		Если Отбор.КлючиАналитики.Получить(КлючАналитики) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Выборка.Регистратор) Тогда
			Продолжить;
		КонецЕсли;
		ВидДокумента = ИмяМетаданныхСсылки(Выборка.Регистратор);
		ЧастиКлюча = Новый Массив;
		ЧастиКлюча.Добавить(Карты.УидОрганизацииБП);
		ЧастиКлюча.Добавить(СокрЛП(Выборка.КодСчета));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Субконто1, Выборка.Субконто1Представление, Карты, Неопределено));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Субконто2, Выборка.Субконто2Представление, Карты, Неопределено));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Субконто3, Выборка.Субконто3Представление, Карты, Неопределено));
		ЧастиКлюча.Добавить(СокрЛП(Выборка.КодКорСчета));
		ЧастиКлюча.Добавить(ВидДокумента);
		ЧастиКлюча.Добавить(Формат(Выборка.Дата, "ДФ=yyyyMMdd"));
		ЧастиКлюча.Добавить(ВРег(СокрЛП(Выборка.Номер)));
		Ключ = СтрСоединить(ЧастиКлюча, "|");
		СтрокаСверки = Накопление.Получить(Ключ);
		Если СтрокаСверки = Неопределено Тогда
			Представление = СтрШаблон("%1 %2 от %3", ВидДокумента, СокрЛП(Выборка.Номер), Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"));
			СтрокаСверки = НоваяСтрокаСверки(Ключ, Выборка.КодСчета, ПустыеСуммы(ИменаСуммОборотов()), Новый Массив, Представление);
			Накопление.Вставить(Ключ, СтрокаСверки);
		КонецЕсли;
		ДобавитьСуммы(СтрокаСверки.Суммы, СуммыВыборки(Выборка, ИменаСуммОборотов()));
		ДобавитьРегистратор(СтрокаСверки.Объекты, Выборка.Регистратор, СтрокаСверки.Представление);
	КонецЦикла;

	Возврат ЗначенияСоответствия(Накопление);

КонецФункции

Функция УдаленныеОборотыПоРегистраторам(Подключение, ДатаНачала, ДатаОкончания, Отбор, Карты)

	Ответ = Новый Структура("Успех, Строки, ТекстОшибки", Истина, Новый Массив, "");
	Движения = Новый Массив;
	Коды = Отбор.КодыСчетов;
	Индекс = 0;
	Пока Индекс < Коды.Количество() Цикл
		Порция = Новый Массив;
		Пока Индекс < Коды.Количество() И Порция.Количество() < 10 Цикл
			Порция.Добавить(Коды[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;
		Страница = ДвиженияСчетаУХ(Подключение, ДатаНачала, ДатаОкончания, Порция, Карты);
		Если Не Страница.Успех Тогда
			Ответ.Успех = Ложь;
			Ответ.ТекстОшибки = Страница.ТекстОшибки;
			Возврат Ответ;
		КонецЕсли;
		ДополнитьМассив(Движения, Страница.Строки);
	КонецЦикла;

	Документы = РеквизитыДокументовУХ(Подключение, Движения);
	Если Не Документы.Успех Тогда
		Ответ.Успех = Ложь;
		Ответ.ТекстОшибки = Документы.ТекстОшибки;
		Возврат Ответ;
	КонецЕсли;

	Накопление = Новый Соответствие;
	Для Каждого Движение Из Движения Цикл
		ДобавитьСторонуДвижения(Накопление, Движение, Истина, Отбор, Карты, Документы.Кэш);
		ДобавитьСторонуДвижения(Накопление, Движение, Ложь, Отбор, Карты, Документы.Кэш);
	КонецЦикла;
	Ответ.Строки = ЗначенияСоответствия(Накопление);
	Возврат Ответ;

КонецФункции

Функция ДвиженияСчетаУХ(Подключение, ДатаНачала, ДатаОкончания, КодыСчетов, Карты)

	УсловияСчетов = Новый Массив;
	Для Каждого КодСчета Из КодыСчетов Цикл
		УидСчета = Карты.УидСчетаУХПоКоду.Получить(СокрЛП(КодСчета));
		Если Не ЗначениеЗаполнено(УидСчета) Тогда
			Продолжить;
		КонецЕсли;
		УсловияСчетов.Добавить("AccountDr_Key eq guid''" + УидСчета + "'' or AccountCr_Key eq guid''" + УидСчета + "''");
	КонецЦикла;
	Если УсловияСчетов.Количество() = 0 Тогда
		Возврат Новый Структура("Успех, Строки, ТекстОшибки", Истина, Новый Массив, "");
	КонецЕсли;

	УсловиеОрганизации = "Организация_Key eq guid''" + Карты.УидОрганизацииУХ + "''";
	ПараметрыЗапроса = Новый Массив;
	ПараметрыЗапроса.Добавить("StartPeriod=" + ЦТ_ODataКлиентСервер.ДатаВФорматеOData(ДатаНачала));
	ПараметрыЗапроса.Добавить("EndPeriod=" + ЦТ_ODataКлиентСервер.ДатаВФорматеOData(КонецДня(ДатаОкончания)));
	ПараметрыЗапроса.Добавить("Condition='" + УсловиеОрганизации + "'");
	ПараметрыЗапроса.Добавить("AccountCondition='" + СтрСоединить(УсловияСчетов, " or ") + "'");
	ПараметрыЗапроса.Добавить("$format=json");
	ПараметрыЗапроса.Добавить("$top=1000");
	ПараметрыЗапроса.Добавить("$skip=0");
	Путь = "/AccountingRegister_Хозрасчетный/RecordsWithExtDimensions?" + СтрСоединить(ПараметрыЗапроса, "&");

	Возврат ЦТ_ODataКлиентСервер.ПолучитьВсеСтраницы(Подключение, Путь);

КонецФункции

Функция РеквизитыДокументовУХ(Подключение, Движения)

	Ответ = Новый Структура("Успех, ТекстОшибки, Кэш", Истина, "", Новый Соответствие);
	ПоТипам = Новый Соответствие;
	Для Каждого Движение Из Движения Цикл
		Описание = ОписаниеРегистратораOData(Движение);
		Если Не ЗначениеЗаполнено(Описание.ИмяНабора) Или ЦТ_ODataКлиентСервер.ПустойИдентификатор(Описание.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Список = ПоТипам.Получить(Описание.ИмяНабора);
		Если Список = Неопределено Тогда
			Список = Новый Соответствие;
			ПоТипам.Вставить(Описание.ИмяНабора, Список);
		КонецЕсли;
		Список.Вставить(НРег(Описание.Идентификатор), Истина);
	КонецЦикла;

	Для Каждого ТипДокумента Из ПоТипам Цикл
		Идентификаторы = Новый Массив;
		Для Каждого ЭлементИдентификатора Из ТипДокумента.Значение Цикл
			Идентификаторы.Добавить(ЭлементИдентификатора.Ключ);
		КонецЦикла;
		Индекс = 0;
		Пока Индекс < Идентификаторы.Количество() Цикл
			Фильтр = Новый Массив;
			Пока Индекс < Идентификаторы.Количество() И Фильтр.Количество() < 15 Цикл
				Фильтр.Добавить("Ref_Key eq guid'" + Идентификаторы[Индекс] + "'");
				Индекс = Индекс + 1;
			КонецЦикла;
			Путь = "/" + ТипДокумента.Ключ
				+ "?$select=Ref_Key,Date,Number&$format=json&$top=100&$filter="
				+ СтрСоединить(Фильтр, " or ");
			Страница = ЦТ_ODataКлиентСервер.ПолучитьВсеСтраницы(Подключение, Путь);
			Если Не Страница.Успех Тогда
				Ответ.Успех = Ложь;
				Ответ.ТекстОшибки = Страница.ТекстОшибки;
				Возврат Ответ;
			КонецЕсли;
			Для Каждого Документ Из Страница.Строки Цикл
				Идентификатор = НРег(Строка(ЦТ_ODataКлиентСервер.ЗначениеПоля(Документ, "Ref")));
				Ответ.Кэш.Вставить(ТипДокумента.Ключ + "|" + Идентификатор, Новый Структура(
					"Дата, Номер",
					ДатаИзOData(Документ.Получить("Date")),
					Строка(Документ.Получить("Number"))));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Ответ;

КонецФункции

Процедура ДобавитьСторонуДвижения(Накопление, Движение, ЭтоДебет, Отбор, Карты, КэшДокументов)

	ИмяСчета = "AccountDr";
	ИмяКорСчета = "AccountCr";
	СуффиксСтороны = "Dr";
	Если Не ЭтоДебет Тогда
		ИмяСчета = "AccountCr";
		ИмяКорСчета = "AccountDr";
		СуффиксСтороны = "Cr";
	КонецЕсли;

	КодСчета = КодСчетаУХ(ЦТ_ODataКлиентСервер.ЗначениеПоля(Движение, ИмяСчета), Карты);
	КодКорСчета = КодСчетаУХ(ЦТ_ODataКлиентСервер.ЗначениеПоля(Движение, ИмяКорСчета), Карты);
	КлючСубконто1 = КлючСубконтоСтороны(Движение, СуффиксСтороны, 1, Карты);
	КлючСубконто2 = КлючСубконтоСтороны(Движение, СуффиксСтороны, 2, Карты);
	КлючСубконто3 = КлючСубконтоСтороны(Движение, СуффиксСтороны, 3, Карты);
	ЧастиАналитики = Новый Массив;
	ЧастиАналитики.Добавить(КодСчета);
	ЧастиАналитики.Добавить(КлючСубконто1);
	ЧастиАналитики.Добавить(КлючСубконто2);
	ЧастиАналитики.Добавить(КлючСубконто3);
	КлючАналитики = СтрСоединить(ЧастиАналитики, "|");
	Если Отбор.КлючиАналитики.Получить(КлючАналитики) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОписаниеРегистратора = ОписаниеРегистратораOData(Движение);
	Реквизиты = КэшДокументов.Получить(ОписаниеРегистратора.ИмяНабора + "|" + НРег(ОписаниеРегистратора.Идентификатор));
	ДатаДокумента = Дата(1, 1, 1);
	НомерДокумента = "";
	Если Реквизиты <> Неопределено Тогда
		ДатаДокумента = Реквизиты.Дата;
		НомерДокумента = Реквизиты.Номер;
	КонецЕсли;

	ЧастиКлюча = Новый Массив;
	ЧастиКлюча.Добавить(Карты.УидОрганизацииБП);
	ЧастиКлюча.Добавить(КодСчета);
	ЧастиКлюча.Добавить(КлючСубконто1);
	ЧастиКлюча.Добавить(КлючСубконто2);
	ЧастиКлюча.Добавить(КлючСубконто3);
	ЧастиКлюча.Добавить(КодКорСчета);
	ЧастиКлюча.Добавить(ОписаниеРегистратора.Вид);
	ЧастиКлюча.Добавить(Формат(ДатаДокумента, "ДФ=yyyyMMdd"));
	ЧастиКлюча.Добавить(ВРег(СокрЛП(НомерДокумента)));
	Ключ = СтрСоединить(ЧастиКлюча, "|");

	СтрокаСверки = Накопление.Получить(Ключ);
	Если СтрокаСверки = Неопределено Тогда
		Представление = СтрШаблон("%1 %2 от %3", ОписаниеРегистратора.Вид, СокрЛП(НомерДокумента), Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"));
		СтрокаСверки = НоваяСтрокаСверки(Ключ, КодСчета, ПустыеСуммы(ИменаСуммОборотов()), Новый Массив, Представление);
		Накопление.Вставить(Ключ, СтрокаСверки);
	КонецЕсли;

	СуммаПроводки = ЦТ_ODataКлиентСервер.ЧислоПоля(Движение, "Сумма");
	СуммыСтороны = ПустыеСуммы(ИменаСуммОборотов());
	Если ЭтоДебет Тогда
		СуммыСтороны.СуммаОборотДт = СуммаПроводки;
		СуммыСтороны.СуммаНУОборотДт = СуммаРесурсаСтороны(Движение, "СуммаНУ", "Dr");
		СуммыСтороны.СуммаПРОборотДт = СуммаРесурсаСтороны(Движение, "СуммаПР", "Dr");
		СуммыСтороны.СуммаВРОборотДт = СуммаРесурсаСтороны(Движение, "СуммаВР", "Dr");
	Иначе
		СуммыСтороны.СуммаОборотКт = СуммаПроводки;
		СуммыСтороны.СуммаНУОборотКт = СуммаРесурсаСтороны(Движение, "СуммаНУ", "Cr");
		СуммыСтороны.СуммаПРОборотКт = СуммаРесурсаСтороны(Движение, "СуммаПР", "Cr");
		СуммыСтороны.СуммаВРОборотКт = СуммаРесурсаСтороны(Движение, "СуммаВР", "Cr");
	КонецЕсли;
	ДобавитьСуммы(СтрокаСверки.Суммы, СуммыСтороны);

КонецПроцедуры

Функция СуммаРесурсаСтороны(Движение, Ресурс, Суффикс)

	Значение = ЦТ_ODataКлиентСервер.ЧислоПоля(Движение, Ресурс + Суффикс);
	Если Значение <> 0 Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЦТ_ODataКлиентСервер.ЧислоПоля(Движение, Ресурс);

КонецФункции

Функция СравнитьНаборы(Локальные, Удаленные, ИменаСумм, Ступень, РегистрироватьРасхождениеСумм)

	ИндексУдаленных = Новый Соответствие;
	Для Каждого СтрокаУХ Из Удаленные Цикл
		ИндексУдаленных.Вставить(СтрокаУХ.Ключ, СтрокаУХ);
	КонецЦикла;

	Расхождения = Новый Массив;
	ОбъектыБП = Новый Массив;
	Обработанные = Новый Соответствие;
	Для Каждого СтрокаБП Из Локальные Цикл
		Обработанные.Вставить(СтрокаБП.Ключ, Истина);
		СтрокаУХ = ИндексУдаленных.Получить(СтрокаБП.Ключ);
		Если СтрокаУХ = Неопределено Тогда
			Расхождения.Добавить(ОписаниеРасхождения(Ступень, "Только БП", СтрокаБП, Неопределено));
			ОбъектыБП.Добавить(СтрокаБП);
			Продолжить;
		КонецЕсли;
		ИмяРасхождения = ИмяРасхожденияСумм(СтрокаБП.Суммы, СтрокаУХ.Суммы, ИменаСумм);
		Если ЗначениеЗаполнено(ИмяРасхождения) Тогда
			Расхождения.Добавить(ОписаниеРасхождения(Ступень, "Сумма", СтрокаБП, СтрокаУХ, ИмяРасхождения));
			Если РегистрироватьРасхождениеСумм Тогда
				ОбъектыБП.Добавить(СтрокаБП);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаУХ Из Удаленные Цикл
		Если Обработанные.Получить(СтрокаУХ.Ключ) = Неопределено Тогда
			Расхождения.Добавить(ОписаниеРасхождения(Ступень, "Только УХ", Неопределено, СтрокаУХ));
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Расхождения, ОбъектыБП", Расхождения, ОбъектыБП);

КонецФункции

Функция ОписаниеРасхождения(Ступень, Вид, СтрокаБП, СтрокаУХ, ИмяСуммы = "")

	Счет = "";
	Ключ = "";
	СуммаБП = 0;
	СуммаУХ = 0;
	Представление = "";
	Если СтрокаБП <> Неопределено Тогда
		Счет = СтрокаБП.КодСчета;
		Ключ = СтрокаБП.Ключ;
		СуммаБП = СтрокаБП.Суммы.СуммаОборотДт;
		Представление = СтрокаБП.Представление;
		Если Не СтрокаБП.Суммы.Свойство("СуммаОборотДт") Тогда
			СуммаБП = СтрокаБП.Суммы.СуммаНачальныйРазвернутыйОстатокДт;
		КонецЕсли;
	КонецЕсли;
	Если СтрокаУХ <> Неопределено Тогда
		Счет = СтрокаУХ.КодСчета;
		Ключ = СтрокаУХ.Ключ;
		СуммаУХ = 0;
		Если СтрокаУХ.Суммы.Свойство("СуммаОборотДт") Тогда
			СуммаУХ = СтрокаУХ.Суммы.СуммаОборотДт;
		Иначе
			СуммаУХ = СтрокаУХ.Суммы.СуммаНачальныйРазвернутыйОстатокДт;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Представление) Тогда
			Представление = СтрокаУХ.Представление;
		КонецЕсли;
	КонецЕсли;
	Если СтрокаБП <> Неопределено И СтрокаБП.Суммы.Свойство("СуммаОборотДт") Тогда
		СуммаБП = СтрокаБП.Суммы.СуммаОборотДт;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяСуммы) Тогда
		Если СтрокаБП <> Неопределено Тогда
			СуммаБП = СтрокаБП.Суммы[ИмяСуммы];
		КонецЕсли;
		Если СтрокаУХ <> Неопределено Тогда
			СуммаУХ = СтрокаУХ.Суммы[ИмяСуммы];
		КонецЕсли;
		Представление = ПредставлениеПоказателя(ИмяСуммы);
	КонецЕсли;

	Возврат Новый Структура("Ступень, Вид, Счет, Ключ, СуммаБП, СуммаУХ, Представление",
		Ступень, Вид, Счет, Ключ, СуммаБП, СуммаУХ, Представление);

КонецФункции

Процедура ДобавитьОбъектыКРегистрации(Приемник, СтрокиБП, ТолькоРегистраторы)

	УжеДобавленные = Новый Соответствие;
	Для Каждого Существующий Из Приемник Цикл
		УжеДобавленные.Вставить(Существующий.КлючJSON, Истина);
	КонецЦикла;

	Для Каждого СтрокаБП Из СтрокиБП Цикл
		Для Каждого ОбъектРегистрации Из СтрокаБП.Объекты Цикл
			Если ТолькоРегистраторы И Не ОбъектРегистрации.ЭтоРегистратор Тогда
				Продолжить;
			КонецЕсли;
			Если Не ТолькоРегистраторы И ОбъектРегистрации.ЭтоРегистратор Тогда
				Продолжить;
			КонецЕсли;
			Если ОбъектРегистрации.Битая Или Не ЗначениеЗаполнено(ОбъектРегистрации.КлючJSON) Тогда
				Продолжить;
			КонецЕсли;
			Если УжеДобавленные.Получить(ОбъектРегистрации.КлючJSON) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			УжеДобавленные.Вставить(ОбъектРегистрации.КлючJSON, Истина);
			Приемник.Добавить(Новый Структура(
				"Пометка, Вид, ПолноеИмя, Представление, КлючJSON",
				Истина,
				ОбъектРегистрации.ВидДанных,
				ОбъектРегистрации.ПолноеИмя,
				ОбъектРегистрации.Представление,
				ОбъектРегистрации.КлючJSON));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция НовыеКарты(Организация)

	УидОрганизацииБП = НРег(XMLСтрока(Организация));
	Карты = Новый Структура;
	Карты.Вставить("УидОрганизацииБП", УидОрганизацииБП);
	Карты.Вставить("УидОрганизацииУХ", "");
	Карты.Вставить("УидПриемникаВУидИсточника", Новый Соответствие);
	Карты.Вставить("КодСчетаПоУидУХ", Новый Соответствие);
	Карты.Вставить("УидСчетаУХПоКоду", Новый Соответствие);
	Карты.Вставить("КодСчетаПоУидБП", КодыСчетовБП());
	Возврат Карты;

КонецФункции

Функция КодЭтогоУзла(УзелБП)

	Если Не ЗначениеЗаполнено(УзелБП) Тогда
		Возврат "";
	КонецЕсли;

	ИмяПлана = УзелБП.Метаданные().Имя;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УзелПлана.Код КАК Код
	|ИЗ
	|	ПланОбмена." + ИмяПлана + " КАК УзелПлана
	|ГДЕ
	|	УзелПлана.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ПланыОбмена[ИмяПлана].ЭтотУзел());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	КодУзла = СокрЛП(Выборка.Код);
	Если СтрДлина(КодУзла) > 2 Тогда
		Возврат КодУзла;
	КонецЕсли;

	ПрефиксыУзла = РегистрыСведений.ОбщиеНастройкиУзловИнформационныхБаз.ПрефиксыУзла(УзелБП);
	ПрефиксЭтогоУзла = СокрЛП(ПрефиксыУзла.Префикс);
	Если ЗначениеЗаполнено(ПрефиксЭтогоУзла) Тогда
		Возврат ПрефиксЭтогоУзла;
	КонецЕсли;

	Возврат КодУзла;

КонецФункции

Функция УзелДляСоответствий(Подключение, Параметры)

	Если ЭтоИдентификатор(Параметры.УидУзлаПриемника) Тогда
		Возврат Новый Структура(
			"Успех, ТекстОшибки, Уид, Код",
			Истина,
			"",
			НРег(СокрЛП(Параметры.УидУзлаПриемника)),
			СокрЛП(Параметры.КодУзлаПриемника));
	КонецЕсли;

	Возврат УзелИсточникаOData(Подключение, КодЭтогоУзла(Параметры.Узел));

КонецФункции

Функция УзелИсточникаOData(Подключение, КодИсточника)

	Ответ = Новый Структура("Успех, ТекстОшибки, Уид, Код", Ложь, "", "", "");
	Если Не ЗначениеЗаполнено(КодИсточника) Тогда
		Ответ.ТекстОшибки = НСтр("ru = 'У предопределенного узла источника не заполнен код.'");
		Возврат Ответ;
	КонецЕсли;

	Путь = "/ExchangePlan_" + ИмяПланаОбменаУХ()
		+ "?$format=json&$select=Ref_Key,Code,Description"
		+ "&$filter=Code eq '" + СтрЗаменить(КодИсточника, "'", "''") + "'"
		+ "&$top=5";
	Страницы = ЦТ_ODataКлиентСервер.ПолучитьВсеСтраницы(Подключение, Путь);
	Если Не Страницы.Успех Тогда
		Ответ.ТекстОшибки = Страницы.ТекстОшибки;
		Возврат Ответ;
	КонецЕсли;

	Найденные = Новый Массив;
	Для Каждого СтрокаУзла Из Страницы.Строки Цикл
		Уид = НРег(Строка(ЦТ_ODataКлиентСервер.ЗначениеПоля(СтрокаУзла, "Ref")));
		Если Не ЭтоИдентификатор(Уид) Тогда
			Продолжить;
		КонецЕсли;
		Найденные.Добавить(Новый Структура(
			"Уид, Код",
			Уид,
			СокрЛП(Строка(СтрокаУзла.Получить("Code")))));
	КонецЦикла;

	Если Найденные.Количество() = 0 Тогда
		Ответ.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'На приемнике нет узла источника с кодом %1.'"),
			КодИсточника);
		Возврат Ответ;
	КонецЕсли;
	Если Найденные.Количество() > 1 Тогда
		Ответ.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'На приемнике несколько узлов с кодом источника %1.'"),
			КодИсточника);
		Возврат Ответ;
	КонецЕсли;

	Ответ.Успех = Истина;
	Ответ.Уид = Найденные[0].Уид;
	Ответ.Код = Найденные[0].Код;
	Возврат Ответ;

КонецФункции

Функция УзлыПриемникаOData(Подключение)

	Ответ = Новый Структура("Успех, ТекстОшибки, Узлы", Ложь, "", Новый Массив);
	Путь = "/ExchangePlan_" + ИмяПланаОбменаУХ()
		+ "?$format=json&$select=Ref_Key,Code,Description&$orderby=Code&$top=1000&$skip=0";
	Страницы = ЦТ_ODataКлиентСервер.ПолучитьВсеСтраницы(Подключение, Путь);
	Если Не Страницы.Успех Тогда
		Ответ.ТекстОшибки = Страницы.ТекстОшибки;
		Возврат Ответ;
	КонецЕсли;

	Для Каждого СтрокаУзла Из Страницы.Строки Цикл
		Уид = НРег(Строка(ЦТ_ODataКлиентСервер.ЗначениеПоля(СтрокаУзла, "Ref")));
		Если Не ЭтоИдентификатор(Уид) Тогда
			Продолжить;
		КонецЕсли;
		Ответ.Узлы.Добавить(Новый Структура(
			"Уид, Код, Наименование",
			Уид,
			СокрЛП(Строка(СтрокаУзла.Получить("Code"))),
			СокрЛП(Строка(СтрокаУзла.Получить("Description")))));
	КонецЦикла;

	Если Ответ.Узлы.Количество() = 0 Тогда
		Ответ.ТекстОшибки = НСтр("ru = 'На приемнике нет узлов плана Консолидация.'");
		Возврат Ответ;
	КонецЕсли;

	Ответ.Успех = Истина;
	Возврат Ответ;

КонецФункции

Функция ИдентификаторыПриемникаИзСтрок(СтрокиСверки, УидОрганизацииБП)

	Идентификаторы = Новый Массив;
	УжеИдентификаторы = Новый Соответствие;
	ДобавитьИдентификаторПриемника(Идентификаторы, УжеИдентификаторы, УидОрганизацииБП);
	Если ТипЗнч(СтрокиСверки) <> Тип("Массив") Тогда
		Возврат Идентификаторы;
	КонецЕсли;

	Для Каждого СтрокаСверки Из СтрокиСверки Цикл
		Части = СтрРазделить(СтрокаСверки.Ключ, "|", Истина);
		Для Каждого Часть Из Части Цикл
			ДобавитьИдентификаторПриемника(Идентификаторы, УжеИдентификаторы, Часть);
		КонецЦикла;
	КонецЦикла;

	Возврат Идентификаторы;

КонецФункции

Процедура ДобавитьИдентификаторПриемника(Идентификаторы, УжеИдентификаторы, Текст)

	Идентификатор = НРег(СокрЛП(Строка(Текст)));
	Если Не ЭтоИдентификатор(Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	Если УжеИдентификаторы.Получить(Идентификатор) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	УжеИдентификаторы.Вставить(Идентификатор, Истина);
	Идентификаторы.Добавить(Идентификатор);

КонецПроцедуры

Функция ПорцииИдентификаторов(УидУзла, Идентификаторы)

	ПределДлины = 1500;
	Порции = Новый Массив;
	Порция = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Порция.Добавить(Идентификатор);
		Длина = ЦТ_ODataКлиентСервер.ДлинаСтрокиЗапроса(ПутьСоответствий(Порция));
		Если Длина <= ПределДлины Или Порция.Количество() = 1 Тогда
			Продолжить;
		КонецЕсли;
		Порция.Удалить(Порция.Количество() - 1);
		Порции.Добавить(Порция);
		Порция = Новый Массив;
		Порция.Добавить(Идентификатор);
	КонецЦикла;
	Если Порция.Количество() > 0 Тогда
		Порции.Добавить(Порция);
	КонецЕсли;
	Возврат Порции;

КонецФункции

Функция ЗагрузитьСоответствияУХ(Подключение, Карты, УидУзла, ИдентификаторыПриемника)

	Ответ = Новый Структура("Успех, ТекстОшибки, Количество", Истина, "", 0);
	Если Не ЭтоИдентификатор(УидУзла) Тогда
		Ответ.Успех = Ложь;
		Ответ.ТекстОшибки = НСтр("ru = 'Идентификатор узла приемника не является GUID.'");
		Возврат Ответ;
	КонецЕсли;
	Если ИдентификаторыПриемника.Количество() = 0 Тогда
		Ответ.Успех = Ложь;
		Ответ.ТекстОшибки = НСтр("ru = 'Нет идентификаторов приемника для чтения соответствий.'");
		Возврат Ответ;
	КонецЕсли;

	Порции = ПорцииИдентификаторов(УидУзла, ИдентификаторыПриемника);
	Для Каждого Порция Из Порции Цикл
		Страницы = ЦТ_ODataКлиентСервер.ПолучитьВсеСтраницы(Подключение, ПутьСоответствий(Порция));
		Если Не Страницы.Успех Тогда
			Ответ.Успех = Ложь;
			Ответ.ТекстОшибки = Страницы.ТекстОшибки;
			Возврат Ответ;
		КонецЕсли;
		Для Каждого СтрокаСоответствия Из Страницы.Строки Цикл
			УзелСтроки = НРег(Строка(ЦТ_ODataКлиентСервер.ЗначениеПоля(СтрокаСоответствия, "УзелИнформационнойБазы")));
			Если ЭтоИдентификатор(УзелСтроки) И УзелСтроки <> НРег(УидУзла) Тогда
				Продолжить;
			КонецЕсли;
			ДополнитьКартуСтрокой(
				Карты,
				СтрокаСоответствия.Получить("УникальныйИдентификаторИсточникаСтрокой"),
				СтрокаСоответствия.Получить("УникальныйИдентификаторПриемника"));
		КонецЦикла;
	КонецЦикла;

	Ответ.Количество = Карты.УидПриемникаВУидИсточника.Количество();
	Возврат Ответ;

КонецФункции

Функция ПутьСоответствий(ИдентификаторыПорции)

	Условия = Новый Массив;
	Для Каждого Идентификатор Из ИдентификаторыПорции Цикл
		Условия.Добавить("УникальныйИдентификаторПриемника eq '" + Идентификатор + "'");
	КонецЦикла;

	Возврат "/InformationRegister_СоответствияОбъектовИнформационныхБаз?$format=json"
		+ "&$select=УникальныйИдентификаторИсточникаСтрокой,УникальныйИдентификаторПриемника,УзелИнформационнойБазы_Key"
		+ "&$filter=" + СтрСоединить(Условия, " or ")
		+ "&$top=1000&$skip=0";

КонецФункции

Функция УидОрганизацииПоКодуEMS(КодОрганизации)

	Ответ = Новый Структура("Успех, ТекстОшибки, Уид", Ложь, "", "");
	Код = СокрЛП(Строка(КодОрганизации));
	Если Не ЗначениеЗаполнено(Код) Тогда
		Ответ.ТекстОшибки = НСтр("ru = 'Укажите код организации.'");
		Возврат Ответ;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	EMS_КодСопоставленияОрганизации.ГУИД КАК ГУИД
	|ИЗ
	|	РегистрСведений.EMS_КодСопоставленияОрганизации КАК EMS_КодСопоставленияОрганизации
	|ГДЕ
	|	EMS_КодСопоставленияОрганизации.Code = &Code";
	Запрос.УстановитьПараметр("Code", Код);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Ответ.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'В регистре кодов сопоставления организации нет кода %1.'"),
			Код);
		Возврат Ответ;
	КонецЕсли;

	Уид = НРег(СокрЛП(Строка(Выборка.ГУИД)));
	Если Не ЭтоИдентификатор(Уид) Или ЦТ_ODataКлиентСервер.ПустойИдентификатор(Уид) Тогда
		Ответ.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Для кода организации %1 не заполнен ГУИД.'"),
			Код);
		Возврат Ответ;
	КонецЕсли;

	Ответ.Успех = Истина;
	Ответ.Уид = Уид;
	Возврат Ответ;

КонецФункции

Процедура ДополнитьКартуСтрокой(Карты, УидУХ, УидБП)

	УидУХ = НРег(СокрЛП(Строка(УидУХ)));
	УидБП = НРег(СокрЛП(Строка(УидБП)));
	Если ЦТ_ODataКлиентСервер.ПустойИдентификатор(УидУХ) Или ЦТ_ODataКлиентСервер.ПустойИдентификатор(УидБП) Тогда
		Возврат;
	КонецЕсли;
	Если Карты.УидПриемникаВУидИсточника.Получить(УидУХ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Карты.УидПриемникаВУидИсточника.Вставить(УидУХ, УидБП);
	Если УидБП = Карты.УидОрганизацииБП И Не ЗначениеЗаполнено(Карты.УидОрганизацииУХ) Тогда
		Карты.УидОрганизацииУХ = УидУХ;
	КонецЕсли;

КонецПроцедуры

Функция ЭтоОтказФильтраУзла(ТекстОшибки)

	Возврат СтрНайти(ТекстОшибки, "OData вернул код") > 0
		Или ТекстОшибки = НСтр("ru = 'OData не вернул количество записей.'")
		Или ТекстОшибки = НСтр("ru = 'Ответ OData не является объектом JSON.'")
		Или ТекстОшибки = НСтр("ru = 'Сервис OData вернул ошибку.'");

КонецФункции

Функция ИмяПланаОбменаУХ()

	Возврат "КонсолидацияZ";

КонецФункции

Функция КоличествоСоответствийУзла(Подключение, УидУзла, ИмяПлана)

	Ответ = ЦТ_ODataКлиентСервер.КоличествоЗаписей(Подключение, ПутьСчетчикаСоответствий(УидУзла, ИмяПлана, Истина));
	Если Ответ.Успех И Ответ.СчетчикПолучен Тогда
		Возврат Ответ;
	КонецЕсли;
	Если Не ЭтоОтказФильтраУзла(Ответ.ТекстОшибки) Тогда
		Возврат Ответ;
	КонецЕсли;

	Возврат ЦТ_ODataКлиентСервер.КоличествоЗаписей(Подключение, ПутьСчетчикаСоответствий(УидУзла, ИмяПлана, Ложь));

