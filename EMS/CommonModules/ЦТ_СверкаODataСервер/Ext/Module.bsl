Процедура ДобавитьКлючСубконтоВыборки(ЧастиКлюча, Выборка, Номер, Включить, Карты, Объекты)

	Если Не Включить Тогда
		ЧастиКлюча.Добавить("<Пусто>");
		Возврат;
	КонецЕсли;
	Имя = "Субконто" + Формат(Номер, "ЧГ=0");
	ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка[Имя], Выборка[Имя + "Представление"], Карты, Объекты));

