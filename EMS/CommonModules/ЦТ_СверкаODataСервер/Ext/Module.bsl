Функция КлючСубконтоСтороны(Движение, СуффиксСтороны, Номер, Карты)

	ИмяПоля = "ExtDimension" + СуффиксСтороны + Формат(Номер, "ЧГ=0");
	Ключ = КлючПоляOData(Движение, ИмяПоля, Карты);
	Если Ключ <> "<Пусто>" Тогда
		Возврат Ключ;
	КонецЕсли;
	Возврат КлючСубконтоOData(Движение, Номер, Карты);

