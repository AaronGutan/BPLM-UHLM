#Область ПрограммныйИнтерфейс

// Сверяет ОСВ и, при расхождениях, обороты по регистраторам.
//
// Параметры:
//  Параметры - Структура - КодОрганизации, ДатаНачала, ДатаОкончания, АдресOData,
//    ПользовательOData, ПарольOData, ВыполнятьСтупень2, Узел,
//    УидУзлаПриемника, КодУзлаПриемника, ВыводитьИзмерения, ВыводитьСубконто1,
//    ВыводитьСубконто2, ВыводитьСубконто3.
//
// Возвращаемое значение:
//  Структура - Успех, ТекстОшибки, Сообщение, Расхождения, КРегистрации, Ступень2Выполнена.
//
Функция Сверить(Параметры) Экспорт

	Результат = НовыйРезультатСверки();
	Подключение = ЦТ_ODataКлиентСервер.ПараметрыПодключения(
		Параметры.АдресOData, Параметры.ПользовательOData, Параметры.ПарольOData);
	Если ЗначениеЗаполнено(Подключение.Ошибка) Тогда
		Результат.ТекстОшибки = Подключение.Ошибка;
		Возврат Результат;
	КонецЕсли;
	Подключение.Вставить("АдресаЗапросов", Новый Массив);

	Организация = ОбменДаннымиПереопределяемый.Орг(Параметры.КодОрганизации);
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Организация по коду EMS не найдена.'");
		ПеренестиАдресаЗапросов(Результат, Подключение);
		Возврат Результат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Параметры.Узел) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Укажите узел источника.'");
		ПеренестиАдресаЗапросов(Результат, Подключение);
		Возврат Результат;
	КонецЕсли;

	УзелНаУХ = УзелДляСоответствий(Подключение, Параметры);
	Если Не УзелНаУХ.Успех Тогда
		Результат.ТекстОшибки = УзелНаУХ.ТекстОшибки;
		ПеренестиАдресаЗапросов(Результат, Подключение);
		Возврат Результат;
	КонецЕсли;

	Карты = НовыеКарты(Организация);

	ПланСчетовУХ = ЗагрузитьПланСчетовУХ(Подключение);
	Если Не ПланСчетовУХ.Успех Тогда
		Результат.ТекстОшибки = ПланСчетовУХ.ТекстОшибки;
		ПеренестиАдресаЗапросов(Результат, Подключение);
		Возврат Результат;
	КонецЕсли;
	Карты.КодСчетаПоУидУХ = ПланСчетовУХ.КодПоУид;
	Карты.УидСчетаУХПоКоду = ПланСчетовУХ.УидПоКоду;

	Вывод = ВыводИзмерений(Параметры);
	Локальные = ЛокальнаяОСВ(Организация, Параметры.ДатаНачала, Параметры.ДатаОкончания, Карты, Вывод);
	ОрганизацияУХ = УидОрганизацииПоКодуEMS(Параметры.КодОрганизации);
	Если Не ОрганизацияУХ.Успех Тогда
		Результат.ТекстОшибки = ОрганизацияУХ.ТекстОшибки;
		ПеренестиАдресаЗапросов(Результат, Подключение);
		Возврат Результат;
	КонецЕсли;
	Карты.УидОрганизацииУХ = ОрганизацияУХ.Уид;
	Если НужнаКартаАналитики(Вывод) Тогда
		ЗагрузкаСоответствий = ЗагрузитьСоответствияУХ(
			Подключение,
			Карты,
			УзелНаУХ.Уид,
			ИдентификаторыПриемникаИзСтрок(Локальные, Карты.УидОрганизацииБП));
		Если Не ЗагрузкаСоответствий.Успех Тогда
			Результат.ТекстОшибки = ЗагрузкаСоответствий.ТекстОшибки;
			ПеренестиАдресаЗапросов(Результат, Подключение);
			Возврат Результат;
		КонецЕсли;
		Результат.Сообщение.Добавить(СтрШаблон(
			НСтр("ru = 'Соответствия УХ: узел %1, Ref_Key %2, строк %3.'"),
			УзелНаУХ.Код,
			УзелНаУХ.Уид,
			ЗагрузкаСоответствий.Количество));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Карты.УидОрганизацииУХ) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось определить идентификатор организации на стороне УХ.'");
		ПеренестиАдресаЗапросов(Результат, Подключение);
		Возврат Результат;
	КонецЕсли;

	Удаленные = УдаленнаяОСВ(Подключение, Параметры.ДатаНачала, Параметры.ДатаОкончания, Карты, Локальные, Вывод);
	Если Не Удаленные.Успех Тогда
		Результат.ТекстОшибки = Удаленные.ТекстОшибки;
		ПеренестиАдресаЗапросов(Результат, Подключение);
		Возврат Результат;
	КонецЕсли;

	СравнениеОСВ = СравнитьНаборы(Локальные, Удаленные.Строки, ИменаСуммОСВ(), "ОСВ", Ложь);
	ДополнитьМассив(Результат.Расхождения, СравнениеОСВ.Расхождения);
	ДобавитьОбъектыКРегистрации(Результат.КРегистрации, СравнениеОСВ.ОбъектыБП, Ложь);

	Результат.Сообщение.Добавить(СтрШаблон(
		НСтр("ru = 'ОСВ: строк БП %1, строк УХ %2, расхождений %3.'"),
		Локальные.Количество(),
		Удаленные.Строки.Количество(),
		СравнениеОСВ.Расхождения.Количество()));

	Если Параметры.ВыполнятьСтупень2 И НужнаСтупень2(СравнениеОСВ.Расхождения) Тогда
		ТекстСтупени = СверитьРегистраторы(Результат, Подключение, Параметры, Организация, Карты, СравнениеОСВ.Расхождения);
		Результат.Сообщение.Добавить(ТекстСтупени);
		Результат.Ступень2Выполнена = Истина;
	Иначе
		Результат.Сообщение.Добавить(НСтр("ru = 'Ступень регистраторов не выполнялась: расхождений ОСВ нет или она отключена.'"));
	КонецЕсли;

	Результат.Успех = Не ЗначениеЗаполнено(Результат.ТекстОшибки);
	ПеренестиАдресаЗапросов(Результат, Подключение);
	Возврат Результат;

КонецФункции

Процедура ПеренестиАдресаЗапросов(Результат, Подключение)

	Адреса = Неопределено;
	Если ТипЗнч(Подключение) <> Тип("Структура")
		Или Не Подключение.Свойство("АдресаЗапросов", Адреса)
		Или ТипЗнч(Адреса) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Индекс = 0;
	Для Каждого Адрес Из Адреса Цикл
		Результат.Сообщение.Вставить(Индекс, Адрес);
		Индекс = Индекс + 1;
	КонецЦикла;
	Адреса.Очистить();

КонецПроцедуры

// Ступень 2 нужна только когда ОСВ уже дала расхождения.
//
Функция НужнаСтупень2(Расхождения) Экспорт

	Возврат ТипЗнч(Расхождения) = Тип("Массив") И Расхождения.Количество() > 0;

КонецФункции

// Регистрирует пакет в выбранном узле плана обмена. Сначала должны идти справочники, затем документы.
//
// Параметры:
//  ЭлементыПакета - Массив из Структура
//  Узел - ПланОбменаСсылка - узел, в который регистрируются изменения.
//
// Возвращаемое значение:
//  Структура - Успех, Зарегистрировано, ТекстОшибки, Ошибки.
//
Функция Зарегистрировать(ЭлементыПакета, Узел) Экспорт

	Ответ = Новый Структура("Успех, Зарегистрировано, ТекстОшибки, Ошибки", Истина, 0, "", Новый Массив);
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Ответ.ТекстОшибки = НСтр("ru = 'Укажите узел плана обмена.'");
		Ответ.Успех = Ложь;
		Возврат Ответ;
	КонецЕсли;

	ЭлементыПакета = УпорядочитьПакет(ЭлементыПакета);
	Если ЭлементыПакета.Количество() = 0 Тогда
		Ответ.ТекстОшибки = НСтр("ru = 'Нет объектов для регистрации.'");
		Ответ.Успех = Ложь;
		Возврат Ответ;
	КонецЕсли;

	Порция = Новый Массив;
	Для Каждого ЭлементПакета Из ЭлементыПакета Цикл
		Порция.Добавить(ЭлементПакета);
		Если Порция.Количество() >= 100 Тогда
			ЗафиксироватьПорцию(Порция, Ответ, Узел);
			Порция = Новый Массив;
			Если Не Ответ.Успех Тогда
				Возврат Ответ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Порция.Количество() > 0 Тогда
		ЗафиксироватьПорцию(Порция, Ответ, Узел);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

// Узлы плана обмена приемника, кроме узла этой базы УХ.
//
// Параметры:
//  Параметры - Структура - АдресOData, ПользовательOData, ПарольOData, Узел.
//
// Возвращаемое значение:
//  Структура - Успех, ТекстОшибки, Узлы, КодИсточника.
//
Функция УзлыПриемника(Параметры) Экспорт

	Ответ = Новый Структура("Успех, ТекстОшибки, Узлы, КодИсточника", Ложь, "", Новый Массив, "");
	Подключение = ЦТ_ODataКлиентСервер.ПараметрыПодключения(
		Параметры.АдресOData, Параметры.ПользовательOData, Параметры.ПарольOData);
	Если ЗначениеЗаполнено(Подключение.Ошибка) Тогда
		Ответ.ТекстОшибки = Подключение.Ошибка;
		Возврат Ответ;
	КонецЕсли;

	Ответ.КодИсточника = КодЭтогоУзла(Параметры.Узел);
	Узлы = УзлыПриемникаOData(Подключение);
	Ответ.Успех = Узлы.Успех;
	Ответ.ТекстОшибки = Узлы.ТекстОшибки;
	Ответ.Узлы = Узлы.Узлы;
	Возврат Ответ;

КонецФункции

// Проверяет выбранный узел приемника и наличие записей регистра соответствий.
//
// Параметры:
//  Параметры - Структура - Узел, АдресOData, ПользовательOData, ПарольOData,
//    УидУзлаПриемника, КодУзлаПриемника.
//
// Возвращаемое значение:
//  Структура - Успех, Текст.
//
Функция ПроверитьСвязьСоответствий(Параметры) Экспорт

	Ответ = Новый Структура("Успех, Текст", Ложь, "");
	Если Не ЗначениеЗаполнено(Параметры.Узел) Тогда
		Ответ.Текст = НСтр("ru = 'Укажите узел источника.'");
		Возврат Ответ;
	КонецЕсли;

	Подключение = ЦТ_ODataКлиентСервер.ПараметрыПодключения(
		Параметры.АдресOData, Параметры.ПользовательOData, Параметры.ПарольOData);
	Если ЗначениеЗаполнено(Подключение.Ошибка) Тогда
		Ответ.Текст = Подключение.Ошибка;
		Возврат Ответ;
	КонецЕсли;

	УзелНаУХ = УзелДляСоответствий(Подключение, Параметры);
	Если Не УзелНаУХ.Успех Тогда
		Ответ.Текст = УзелНаУХ.ТекстОшибки;
		Возврат Ответ;
	КонецЕсли;

	Счетчик = КоличествоСоответствийУзла(Подключение, УзелНаУХ.Уид, ИмяПланаОбменаУХ());
	КодИсточника = КодЭтогоУзла(Параметры.Узел);
	Если Не Счетчик.СчетчикПолучен Тогда
		Если Счетчик.ТекстОшибки = НСтр("ru = 'OData не вернул количество записей.'") Или Не ЗначениеЗаполнено(Счетчик.ТекстОшибки) Тогда
			Ответ.Текст = СтрШаблон(
				НСтр("ru = 'OData не вернул количество записей регистра соответствий. Узел УХ: %1. Ref_Key: %2. Идентификатор базы источника: %3.'"),
				УзелНаУХ.Код,
				УзелНаУХ.Уид,
				КодИсточника);
		Иначе
			Ответ.Текст = Счетчик.ТекстОшибки;
		КонецЕсли;
		Возврат Ответ;
	КонецЕсли;

	Если Счетчик.Количество = 0 Тогда
		Ответ.Текст = СтрШаблон(
			НСтр("ru = 'Связь с узлом УХ есть, но регистр соответствий на этом узле пуст. Узел УХ: %1. Ref_Key: %2. Идентификатор базы источника: %3. Записей: 0.'"),
			УзелНаУХ.Код,
			УзелНаУХ.Уид,
			КодИсточника);
		Возврат Ответ;
	КонецЕсли;

	Ответ.Успех = Истина;
	Ответ.Текст = СтрШаблон(
		НСтр("ru = 'Связь с регистром соответствий установлена. Узел УХ: %1. Ref_Key: %2. Идентификатор базы источника: %3. Записей: %4.'"),
		УзелНаУХ.Код,
		УзелНаУХ.Уид,
		КодИсточника,
		Счетчик.Количество);
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УпорядочитьПакет(ЭлементыПакета)

	Справочники = Новый Массив;
	Документы = Новый Массив;
	Для Каждого ЭлементПакета Из ЭлементыПакета Цикл
		Если ЭлементПакета.Вид = "Catalog" Тогда
			Справочники.Добавить(ЭлементПакета);
		Иначе
			Документы.Добавить(ЭлементПакета);
		КонецЕсли;
	КонецЦикла;
	ДополнитьМассив(Справочники, Документы);
	Возврат Справочники;

КонецФункции

Функция НовыйРезультатСверки()

	Возврат Новый Структура(
		"Успех, ТекстОшибки, Сообщение, Расхождения, КРегистрации, Ступень2Выполнена",
		Ложь, "", Новый Массив, Новый Массив, Новый Массив, Ложь);

КонецФункции

Функция СверитьРегистраторы(Результат, Подключение, Параметры, Организация, Карты, РасхожденияОСВ)

	Отбор = ОтборСчетовАналитики(РасхожденияОСВ);
	Если Отбор.КодыСчетов.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Ступень регистраторов пропущена: нет кодов счетов.'");
	КонецЕсли;

	Локальные = ЛокальныеОборотыПоРегистраторам(
		Организация, Параметры.ДатаНачала, Параметры.ДатаОкончания, Отбор, Карты);
	Удаленные = УдаленныеОборотыПоРегистраторам(
		Подключение, Параметры.ДатаНачала, Параметры.ДатаОкончания, Отбор, Карты);
	Если Не Удаленные.Успех Тогда
		Результат.Успех = Ложь;
		Результат.ТекстОшибки = Удаленные.ТекстОшибки;
		Возврат Удаленные.ТекстОшибки;
	КонецЕсли;

	Сравнение = СравнитьНаборы(Локальные, Удаленные.Строки, ИменаСуммОборотов(), "Регистратор", Истина);
	ДополнитьМассив(Результат.Расхождения, Сравнение.Расхождения);
	ДобавитьОбъектыКРегистрации(Результат.КРегистрации, Сравнение.ОбъектыБП, Истина);

	Возврат СтрШаблон(
		НСтр("ru = 'Регистраторы: строк БП %1, строк УХ %2, расхождений %3.'"),
		Локальные.Количество(),
		Удаленные.Строки.Количество(),
		Сравнение.Расхождения.Количество());

КонецФункции

Функция ЛокальнаяОСВ(Организация, ДатаНачала, ДатаОкончания, Карты, Вывод)

	Если Не ВыводПолный(Вывод) Тогда
		Возврат ЛокальнаяОСВПоВыводу(Организация, ДатаНачала, ДатаОкончания, Карты, Вывод);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Регистр.Счет.Код КАК КодСчета,
	|	Регистр.Подразделение КАК Подразделение,
	|	ПРЕДСТАВЛЕНИЕ(Регистр.Подразделение) КАК ПодразделениеПредставление,
	|	Регистр.Валюта КАК Валюта,
	|	ПРЕДСТАВЛЕНИЕ(Регистр.Валюта) КАК ВалютаПредставление,
	|	Регистр.Субконто1 КАК Субконто1,
	|	ПРЕДСТАВЛЕНИЕ(Регистр.Субконто1) КАК Субконто1Представление,
	|	Регистр.Субконто2 КАК Субконто2,
	|	ПРЕДСТАВЛЕНИЕ(Регистр.Субконто2) КАК Субконто2Представление,
	|	Регистр.Субконто3 КАК Субконто3,
	|	ПРЕДСТАВЛЕНИЕ(Регистр.Субконто3) КАК Субконто3Представление,
	|	Регистр.СуммаНачальныйРазвернутыйОстатокДт КАК СуммаНачальныйРазвернутыйОстатокДт,
	|	Регистр.СуммаНачальныйРазвернутыйОстатокКт КАК СуммаНачальныйРазвернутыйОстатокКт,
	|	Регистр.СуммаОборотДт КАК СуммаОборотДт,
	|	Регистр.СуммаОборотКт КАК СуммаОборотКт,
	|	Регистр.СуммаКонечныйРазвернутыйОстатокДт КАК СуммаКонечныйРазвернутыйОстатокДт,
	|	Регистр.СуммаКонечныйРазвернутыйОстатокКт КАК СуммаКонечныйРазвернутыйОстатокКт,
	|	Регистр.СуммаНУНачальныйРазвернутыйОстатокДт КАК СуммаНУНачальныйРазвернутыйОстатокДт,
	|	Регистр.СуммаНУНачальныйРазвернутыйОстатокКт КАК СуммаНУНачальныйРазвернутыйОстатокКт,
	|	Регистр.СуммаНУОборотДт КАК СуммаНУОборотДт,
	|	Регистр.СуммаНУОборотКт КАК СуммаНУОборотКт,
	|	Регистр.СуммаНУКонечныйРазвернутыйОстатокДт КАК СуммаНУКонечныйРазвернутыйОстатокДт,
	|	Регистр.СуммаНУКонечныйРазвернутыйОстатокКт КАК СуммаНУКонечныйРазвернутыйОстатокКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|		&НачалоПериода, &КонецПериода, Период, , , , Организация = &Организация) КАК Регистр";
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", Организация);

	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объекты = Новый Массив;
		ЧастиКлюча = Новый Массив;
		ЧастиКлюча.Добавить(Карты.УидОрганизацииБП);
		ЧастиКлюча.Добавить(СокрЛП(Выборка.КодСчета));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Подразделение, Выборка.ПодразделениеПредставление, Карты, Объекты));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Валюта, Выборка.ВалютаПредставление, Карты, Неопределено));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Субконто1, Выборка.Субконто1Представление, Карты, Объекты));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Субконто2, Выборка.Субконто2Представление, Карты, Объекты));
		ЧастиКлюча.Добавить(КлючСсылкиБП(Выборка.Субконто3, Выборка.Субконто3Представление, Карты, Объекты));
		Строки.Добавить(НоваяСтрокаСверки(СтрСоединить(ЧастиКлюча, "|"), Выборка.КодСчета, СуммыВыборки(Выборка, ИменаСуммОСВ()), Объекты, Выборка.КодСчета));
	КонецЦикла;

	Возврат Строки;

КонецФункции

Функция УдаленнаяОСВ(Подключение, ДатаНачала, ДатаОкончания, Карты, СтрокиЛокальные, Вывод)

	Ответ = Новый Структура("Успех, Строки, ТекстОшибки", Истина, Новый Массив, "");
	Накопление = Новый Соответствие;
	Для Каждого КодСчетаЛокальный Из КодыСчетовСтрок(СтрокиЛокальные) Цикл
		УидСчета = Карты.УидСчетаУХПоКоду.Получить(КодСчетаЛокальный);
		Если Не ЗначениеЗаполнено(УидСчета) Тогда
			Продолжить;
		КонецЕсли;
		Страницы = ЦТ_ODataКлиентСервер.ПолучитьВсеСтраницы(
			Подключение,
			ПутьОСВСчета(ДатаНачала, ДатаОкончания, Карты.УидОрганизацииУХ, УидСчета));
		Если Не Страницы.Успех Тогда
			Ответ.Успех = Ложь;
			Ответ.ТекстОшибки = Страницы.ТекстОшибки;
			Возврат Ответ;
		КонецЕсли;
		Для Каждого СтрокаOData Из Страницы.Строки Цикл
			КодСчета = КодСчетаУХ(ЦТ_ODataКлиентСервер.ЗначениеПоля(СтрокаOData, "Account"), Карты);
			ЧастиКлюча = Новый Массив;
			ЧастиКлюча.Добавить(Карты.УидОрганизацииБП);
			ЧастиКлюча.Добавить(КодСчета);
			Если Вывод.Измерения Тогда
				ЧастиКлюча.Добавить(КлючПоляOData(СтрокаOData, "Подразделение", Карты));
				ЧастиКлюча.Добавить(КлючПоляOData(СтрокаOData, "Валюта", Карты));
			Иначе
				ЧастиКлюча.Добавить("<Пусто>");
				ЧастиКлюча.Добавить("<Пусто>");
			КонецЕсли;
			ДобавитьКлючСубконтоOData(ЧастиКлюча, СтрокаOData, 1, Вывод.Субконто1, Карты);
			ДобавитьКлючСубконтоOData(ЧастиКлюча, СтрокаOData, 2, Вывод.Субконто2, Карты);
			ДобавитьКлючСубконтоOData(ЧастиКлюча, СтрокаOData, 3, Вывод.Субконто3, Карты);
			ДобавитьСтрокуОСВ(Накопление, СтрСоединить(ЧастиКлюча, "|"), КодСчета, СуммыПолейОСВ(СтрокаOData));
		КонецЦикла;
	КонецЦикла;

	Ответ.Строки = ЗначенияСоответствия(Накопление);
	Возврат Ответ;

КонецФункции

Процедура ДобавитьСтрокуОСВ(Накопление, Ключ, КодСчета, СуммыСтроки)

	СтрокаСверки = Накопление.Получить(Ключ);
	Если СтрокаСверки = Неопределено Тогда
		Накопление.Вставить(Ключ, НоваяСтрокаСверки(Ключ, КодСчета, СуммыСтроки, Новый Массив, КодСчета));
		Возврат;
	КонецЕсли;
	ДобавитьСуммы(СтрокаСверки.Суммы, СуммыСтроки);

КонецПроцедуры

Функция КодыСчетовСтрок(СтрокиСверки)

	Коды = Новый Массив;
	УжеКоды = Новый Соответствие;
	Если ТипЗнч(СтрокиСверки) <> Тип("Массив") Тогда
		Возврат Коды;
	КонецЕсли;
	Для Каждого СтрокаСверки Из СтрокиСверки Цикл
		КодСчета = СокрЛП(СтрокаСверки.КодСчета);
		Если Не ЗначениеЗаполнено(КодСчета) Или УжеКоды.Получить(КодСчета) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеКоды.Вставить(КодСчета, Истина);
		Коды.Добавить(КодСчета);
	КонецЦикла;
	Возврат Коды;

КонецФункции

Функция ПутьОСВСчета(ДатаНачала, ДатаОкончания, УидОрганизацииУХ, УидСчета)

	ПараметрыЗапроса = Новый Массив;
	ПараметрыЗапроса.Добавить("StartPeriod=" + ЦТ_ODataКлиентСервер.ДатаВФорматеOData(ДатаНачала));
	ПараметрыЗапроса.Добавить("EndPeriod=" + ЦТ_ODataКлиентСервер.ДатаВФорматеOData(КонецДня(ДатаОкончания)));
	ПараметрыЗапроса.Добавить("Condition='Организация_Key eq guid''" + УидОрганизацииУХ + "'''");
	ПараметрыЗапроса.Добавить("AccountCondition='Account_Key eq guid''" + УидСчета + "'''");
	ПараметрыЗапроса.Добавить("$format=json");
	ПараметрыЗапроса.Добавить("$top=1000");
	ПараметрыЗапроса.Добавить("$skip=0");
	// Параметры виртуальной таблицы в строке запроса: двоеточие datetime в пути IIS считает недопустимым адресом.
	Возврат "/AccountingRegister_Хозрасчетный/BalanceAndTurnovers?" + СтрСоединить(ПараметрыЗапроса, "&");

КонецФункции

Функция ВыводИзмерений(Параметры)

	Вывод = Новый Структура("Измерения, Субконто1, Субконто2, Субконто3", Истина, Истина, Истина, Истина);
	Если Параметры.Свойство("ВыводитьИзмерения") Тогда
		Вывод.Измерения = Параметры.ВыводитьИзмерения;
	КонецЕсли;
	Если Параметры.Свойство("ВыводитьСубконто1") Тогда
		Вывод.Субконто1 = Параметры.ВыводитьСубконто1;
	КонецЕсли;
	Если Параметры.Свойство("ВыводитьСубконто2") Тогда
		Вывод.Субконто2 = Параметры.ВыводитьСубконто2;
	КонецЕсли;
	Если Параметры.Свойство("ВыводитьСубконто3") Тогда
		Вывод.Субконто3 = Параметры.ВыводитьСубконто3;
	КонецЕсли;
	Возврат Вывод;

КонецФункции

Функция ВыводПолный(Вывод)

	Возврат Вывод.Измерения И Вывод.Субконто1 И Вывод.Субконто2 И Вывод.Субконто3;

КонецФункции

Функция НужнаКартаАналитики(Вывод)

	Возврат Вывод.Измерения Или Вывод.Субконто1 Или Вывод.Субконто2 Или Вывод.Субконто3;

