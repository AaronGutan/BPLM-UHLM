Функция ДатаИзOData(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = Лев(СокрЛП(Строка(Значение)), 19);
	Текст = СтрЗаменить(Текст, "-", "");
	Текст = СтрЗаменить(Текст, "T", "");
	Текст = СтрЗаменить(Текст, ":", "");
	Если СтрДлина(Текст) < 8 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(Текст);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

