#Область ПрограммныйИнтерфейс

// Регистрирует изменения объектов для узлов плана обмена Консолидация
//
// Параметры:
//  Узел - ПланОбменаСсылка.Консолидация - узел плана обмена
//  Объект - ЛюбаяСсылка - регистрируемый объект
//
Процедура ЗарегистрироватьИзмененияОбъекта(Узел, Объект) Экспорт

	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект) Тогда
		Возврат;
	КонецЕсли;

	ПланыОбмена.ЗарегистрироватьИзменения(Узел, Объект);

КонецПроцедуры

// Проверяет, нужно ли регистрировать изменения документа
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - проверяемый документ
//
// Возвращаемое значение:
//  Булево - Истина, если документ имеет движения по регистру Хозрасчетный
//
Функция ДокументИмеетДвиженияХозрасчетный(ДокументОбъект) Экспорт

	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Хозрасчетный.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный КАК Хозрасчетный
	|ГДЕ
	|	Хозрасчетный.Регистратор = &Регистратор";

	Запрос.УстановитьПараметр("Регистратор", ДокументОбъект.Ссылка);

	РезультатЗапроса = Запрос.Выполнить();

	Возврат НЕ РезультатЗапроса.Пустой();

КонецФункции

// Регистрирует изменения для всех узлов плана обмена
//
// Параметры:
//  Объект - ЛюбаяСсылка - регистрируемый объект
//
Процедура ЗарегистрироватьИзмененияДляВсехУзлов(Объект) Экспорт

	Если НЕ ЗначениеЗаполнено(Объект) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Консолидация.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.Консолидация КАК Консолидация
	|ГДЕ
	|	НЕ Консолидация.ЭтотУзел";

	ВыборкаУзлов = Запрос.Выполнить().Выбрать();

	Пока ВыборкаУзлов.Следующий() Цикл
		ЗарегистрироватьИзмененияОбъекта(ВыборкаУзлов.Ссылка, Объект);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
