#Область ОбработчикиURL

// GET /hs/recon/v1/ping
//
Функция ПингGET(Запрос)

	Возврат СформироватьОтветJSON(200, Consd_СверкаСервис.ПроверкаДоступности());

КонецФункции

// GET /hs/recon/v1/nodes
//
Функция УзлыGET(Запрос)

	Данные = Новый Структура;
	Данные.Вставить("Success", Истина);
	Данные.Вставить("Nodes", Consd_СверкаСервис.ПолучитьУзлыПланаОбмена());

	Возврат СформироватьОтветJSON(200, Данные);

КонецФункции

// POST /hs/recon/v1/register
//
Функция ЗарегистрироватьPOST(Запрос)

	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();

	Если ПустаяСтрока(ТелоЗапроса) Тогда
		Возврат СформироватьОтветJSON(400, Новый Структура("Success, Error", Ложь,
			НСтр("ru = 'Пустое тело запроса.'")));
	КонецЕсли;

	Попытка
		ПараметрыЗапроса = Consd_СверкаСервис.ДесериализоватьJSON(ТелоЗапроса);
	Исключение
		Возврат СформироватьОтветJSON(400, Новый Структура("Success, Error", Ложь,
			СтрШаблон(НСтр("ru = 'Ошибка разбора JSON: %1'"), ОписаниеОшибки())));
	КонецПопытки;

	Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура")
		И ТипЗнч(ПараметрыЗапроса) <> Тип("Соответствие") Тогда
		Возврат СформироватьОтветJSON(400, Новый Структура("Success, Error", Ложь,
			НСтр("ru = 'Ожидается JSON-объект в теле запроса.'")));
	КонецЕсли;

	Результат = Consd_СверкаСервис.ЗарегистрироватьОбъекты(ПараметрыЗапроса);
	КодОтвета = ?(Результат.Success, 200, 422);

	Возврат СформироватьОтветJSON(КодОтвета, Результат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьОтветJSON(КодСостояния, Данные)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Consd_СверкаСервис.СериализоватьJSON(Данные), КодировкаТекста.UTF8);

	Возврат Ответ;

КонецФункции

#КонецОбласти
