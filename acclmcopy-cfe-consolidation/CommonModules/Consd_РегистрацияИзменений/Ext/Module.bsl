#Область ОбработчикиПодписокНаСобытия

// Обработчик подписки на событие ПриЗаписи документов
//
// Параметры:
//  Источник - ДокументОбъект - записываемый документ
//  Отказ - Булево - признак отказа от записи
//
Процедура ДокументПриЗаписи(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Источник.Проведен Тогда
		Возврат;
	КонецЕсли;

	// Проверяем наличие движений по регистру Хозрасчетный
	Если ПланыОбмена.Консолидация.ДокументИмеетДвиженияХозрасчетный(Источник) Тогда
		ПланыОбмена.Консолидация.ЗарегистрироватьИзмененияДляВсехУзлов(Источник.Ссылка);

		// Регистрируем справочники из реквизитов документа
		ЗарегистрироватьСправочникиИзРеквизитов(Источник);
	КонецЕсли;

КонецПроцедуры

// Обработчик подписки на событие ПриЗаписи справочников-субконто
//
// Параметры:
//  Источник - СправочникОбъект - записываемый справочник
//  Отказ - Булево - признак отказа от записи
//
Процедура СправочникПриЗаписи(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Проверяем, является ли справочник субконто для Хозрасчетного
	Если ЭтоСубконтоХозрасчетный(Источник) Тогда
		ПланыОбмена.Консолидация.ЗарегистрироватьИзмененияДляВсехУзлов(Источник.Ссылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Регистрирует справочники из реквизитов документа
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - документ для анализа
//
Процедура ЗарегистрироватьСправочникиИзРеквизитов(ДокументОбъект)

	МетаданныеДокумента = ДокументОбъект.Метаданные();

	// Обходим реквизиты документа
	Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
		ОбработатьРеквизит(ДокументОбъект, Реквизит);
	КонецЦикла;

	// Обходим табличные части
	Для Каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
		Для Каждого СтрокаТЧ Из ДокументОбъект[ТабличнаяЧасть.Имя] Цикл
			Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
				ОбработатьРеквизитТабличнойЧасти(СтрокаТЧ, Реквизит);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Обрабатывает реквизит документа
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - документ
//  Реквизит - ОбъектМетаданных - описание реквизита
//
Процедура ОбработатьРеквизит(ДокументОбъект, Реквизит)

	ТипыРеквизита = Реквизит.Тип.Типы();

	Для Каждого Тип Из ТипыРеквизита Цикл
		Если Метаданные.НайтиПоТипу(Тип) <> Неопределено
			И СтрНачинаетсяС(Метаданные.НайтиПоТипу(Тип).ПолноеИмя(), "Справочник.") Тогда

			ЗначениеРеквизита = ДокументОбъект[Реквизит.Имя];
			Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
				ПланыОбмена.Консолидация.ЗарегистрироватьИзмененияДляВсехУзлов(ЗначениеРеквизита);
			КонецЕсли;

		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Обрабатывает реквизит табличной части
//
// Параметры:
//  СтрокаТЧ - СтрокаТабличнойЧасти - строка табличной части
//  Реквизит - ОбъектМетаданных - описание реквизита
//
Процедура ОбработатьРеквизитТабличнойЧасти(СтрокаТЧ, Реквизит)

	ТипыРеквизита = Реквизит.Тип.Типы();

	Для Каждого Тип Из ТипыРеквизита Цикл
		Если Метаданные.НайтиПоТипу(Тип) <> Неопределено
			И СтрНачинаетсяС(Метаданные.НайтиПоТипу(Тип).ПолноеИмя(), "Справочник.") Тогда

			ЗначениеРеквизита = СтрокаТЧ[Реквизит.Имя];
			Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
				ПланыОбмена.Консолидация.ЗарегистрироватьИзмененияДляВсехУзлов(ЗначениеРеквизита);
			КонецЕсли;

		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Проверяет, является ли справочник субконто для Хозрасчетного
//
// Параметры:
//  СправочникОбъект - СправочникОбъект - проверяемый справочник
//
// Возвращаемое значение:
//  Булево - Истина, если справочник является субконто
//
Функция ЭтоСубконтоХозрасчетный(СправочникОбъект)

	ПолноеИмяСправочника = СправочникОбъект.Метаданные().ПолноеИмя();

	// Получаем список субконто из ВидыСубконтоХозрасчетные
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВидыСубконтоХозрасчетные.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ВидыСубконтоХозрасчетные КАК ВидыСубконтоХозрасчетные
	|ГДЕ
	|	ВидыСубконтоХозрасчетные.ТипЗначения.Типы СОДЕРЖИТ ТИП(&ТипСправочника)";

	Попытка
		Запрос.УстановитьПараметр("ТипСправочника", ТипЗнч(СправочникОбъект.Ссылка));
		РезультатЗапроса = Запрос.Выполнить();
		Возврат НЕ РезультатЗапроса.Пустой();
	Исключение
		// Если не удалось выполнить запрос, считаем что не является субконто
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти
