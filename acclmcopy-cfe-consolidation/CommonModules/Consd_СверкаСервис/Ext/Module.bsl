#Область ПрограммныйИнтерфейс

// Возвращает признак доступности HTTP-сервиса сверки.
//
// Возвращаемое значение:
//  Структура - Success, Service.
//
Функция ПроверкаДоступности() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Success", Истина);
	Результат.Вставить("Service", "Consd_Reconciliation");

	Возврат Результат;

КонецФункции

// Возвращает список узлов плана обмена "Консолидация".
//
// Возвращаемое значение:
//  Массив из Структура - Ref, Code, Description, ThisNode, SentNo, ReceivedNo.
//
Функция ПолучитьУзлыПланаОбмена() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Консолидация.Ссылка КАК Ссылка,
	|	Консолидация.Код КАК Код,
	|	Консолидация.Наименование КАК Наименование,
	|	Консолидация.ЭтотУзел КАК ЭтотУзел,
	|	Консолидация.НомерОтправленного КАК НомерОтправленного,
	|	Консолидация.НомерПринятого КАК НомерПринятого
	|ИЗ
	|	ПланОбмена.Консолидация КАК Консолидация
	|ГДЕ
	|	НЕ Консолидация.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Узлы = Новый Массив;

	Пока Выборка.Следующий() Цикл

		Узел = Новый Структура;
		Узел.Вставить("Ref", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Узел.Вставить("Code", Выборка.Код);
		Узел.Вставить("Description", Выборка.Наименование);
		Узел.Вставить("ThisNode", Выборка.ЭтотУзел);
		Узел.Вставить("SentNo", Выборка.НомерОтправленного);
		Узел.Вставить("ReceivedNo", Выборка.НомерПринятого);
		Узлы.Добавить(Узел);

	КонецЦикла;

	Возврат Узлы;

КонецФункции

// Регистрирует объекты на узле плана обмена "Консолидация".
//
// Параметры:
//  ПараметрыЗапроса - Структура - поля NodeGuid или NodeCode, Objects (массив структур ODataName, Guid).
//
// Возвращаемое значение:
//  Структура - Success, RegisteredCount, Errors (массив).
//
Функция ЗарегистрироватьОбъекты(ПараметрыЗапроса) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Результат = Новый Структура;
	Результат.Вставить("Success", Ложь);
	Результат.Вставить("RegisteredCount", 0);
	Результат.Вставить("Errors", Новый Массив);

	Узел = НайтиУзелПланаОбмена(ПараметрыЗапроса);
	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		ДобавитьОшибкуРегистрации(Результат.Errors, "", "", НСтр("ru = 'Не найден узел плана обмена.'"));
		Возврат Результат;
	КонецЕсли;

	Если Узел.ЭтотУзел Тогда
		ДобавитьОшибкуРегистрации(Результат.Errors, "", "", НСтр("ru = 'Нельзя регистрировать изменения на узле ""Этот узел"".'"));
		Возврат Результат;
	КонецЕсли;

	Объекты = ЗначениеСвойстваJSON(ПараметрыЗапроса, "Objects");
	Если Объекты = Неопределено Тогда
		Объекты = ЗначениеСвойстваJSON(ПараметрыЗапроса, "Объекты");
	КонецЕсли;

	Если Объекты = Неопределено ИЛИ ТипЗнч(Объекты) <> Тип("Массив") ИЛИ Объекты.Количество() = 0 Тогда
		ДобавитьОшибкуРегистрации(Результат.Errors, "", "", НСтр("ru = 'Не передан список объектов для регистрации.'"));
		Возврат Результат;
	КонецЕсли;

	КоличествоЗарегистрированных = 0;

	Для Каждого ОписаниеОбъекта Из Объекты Цикл

		ИмяOData = ЗначениеСвойстваJSON(ОписаниеОбъекта, "ODataName");
		Если ПустаяСтрока(ИмяOData) Тогда
			ИмяOData = ЗначениеСвойстваJSON(ОписаниеОбъекта, "ИмяOData");
		КонецЕсли;

		СтрокаGUID = ЗначениеСвойстваJSON(ОписаниеОбъекта, "Guid");
		Если ПустаяСтрока(СтрокаGUID) Тогда
			СтрокаGUID = ЗначениеСвойстваJSON(ОписаниеОбъекта, "GUID");
		КонецЕсли;

		Попытка
			Ссылка = ПолучитьСсылкуПоИмениODataИGUID(ИмяOData, СтрокаGUID);
			Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
				ВызватьИсключение НСтр("ru = 'Объект не найден в информационной базе.'");
			КонецЕсли;

			ПланыОбмена.Консолидация.ЗарегистрироватьИзмененияОбъекта(Узел, Ссылка);
			КоличествоЗарегистрированных = КоличествоЗарегистрированных + 1;
		Исключение
			ДобавитьОшибкуРегистрации(Результат.Errors, ИмяOData, СтрокаGUID, ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Результат.RegisteredCount = КоличествоЗарегистрированных;
	Результат.Success = (КоличествоЗарегистрированных > 0 И Результат.Errors.Количество() = 0)
		ИЛИ (КоличествоЗарегистрированных > 0);

	Возврат Результат;

КонецФункции

// Преобразует значение в JSON-текст.
//
// Параметры:
//  Значение - Произвольный - сериализуемое значение.
//
// Возвращаемое значение:
//  Строка - текст JSON.
//
Функция СериализоватьJSON(Значение) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Разбирает JSON-текст в структуру, массив или примитив.
//
// Параметры:
//  ТекстJSON - Строка - текст JSON.
//
// Возвращаемое значение:
//  Произвольный - результат разбора.
//
Функция ДесериализоватьJSON(ТекстJSON) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Возврат Результат;

КонецФункции

// Формирует URL HTTP-сервиса регистрации по адресу OData источника.
//
// Параметры:
//  URLСервераOData - Строка - адрес OData, например "http://server/base/odata/standard.odata".
//  ИмяМетода       - Строка - имя метода после /v1/, по умолчанию "register".
//
// Возвращаемое значение:
//  Строка - полный URL HTTP-сервиса.
//
Функция ПолучитьURLСервисаПоАдресуOData(URLСервераOData, ИмяМетода = "register") Экспорт

	БазовыйURL = URLСервераOData;
	ПозицияOData = СтрНайти(НРег(БазовыйURL), "/odata/");

	Если ПозицияOData > 0 Тогда
		БазовыйURL = Лев(БазовыйURL, ПозицияOData - 1);
	КонецЕсли;

	Если Прав(БазовыйURL, 1) = "/" Тогда
		БазовыйURL = Лев(БазовыйURL, СтрДлина(БазовыйURL) - 1);
	КонецЕсли;

	Возврат БазовыйURL + "/hs/recon/v1/" + ИмяМетода;

КонецФункции

// Вызывает HTTP-сервис регистрации на базе-источнике.
//
// Параметры:
//  URLСервераOData   - Строка - адрес OData источника;
//  ИмяПользователя   - Строка - пользователь для Basic-авторизации;
//  Пароль            - Строка - пароль;
//  Узел              - ПланОбменаСсылка.Консолидация - узел на источнике;
//  Объекты           - Массив из Структура - ODataName, Guid;
//  Таймаут           - Число - таймаут HTTP в секундах.
//
// Возвращаемое значение:
//  Структура - Success, RegisteredCount, Errors, TextError.
//
Функция ВызватьРегистрациюНаИсточнике(URLСервераOData, ИмяПользователя, Пароль, Узел, Объекты, Таймаут = 30) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Success", Ложь);
	Результат.Вставить("RegisteredCount", 0);
	Результат.Вставить("Errors", Новый Массив);
	Результат.Вставить("TextError", "");

	Если Объекты.Количество() = 0 Тогда
		Результат.TextError = НСтр("ru = 'Не переданы объекты для регистрации.'");
		Возврат Результат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		Результат.TextError = НСтр("ru = 'Не указан узел плана обмена на источнике.'");
		Возврат Результат;
	КонецЕсли;

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("NodeGuid", Строка(Узел.УникальныйИдентификатор()));
	ТелоЗапроса.Вставить("Objects", Объекты);

	URLЗапроса = ПолучитьURLСервисаПоАдресуOData(URLСервераOData, "register");
	ЧастиURL = РазложитьURL(URLЗапроса);

	Попытка
		Соединение = СоздатьHTTPСоединение(ЧастиURL, ИмяПользователя, Пароль, Таймаут);
		HTTPЗапрос = Новый HTTPЗапрос(ЧастиURL.ПутьРесурса);
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		HTTPЗапрос.УстановитьТелоИзСтроки(СериализоватьJSON(ТелоЗапроса), КодировкаТекста.UTF8);

		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

		Если HTTPОтвет.КодСостояния < 200 ИЛИ HTTPОтвет.КодСостояния >= 300 Тогда
			Результат.TextError = СтрШаблон(НСтр("ru = 'HTTP %1: %2'"), HTTPОтвет.КодСостояния, ТекстОтвета);
			Возврат Результат;
		КонецЕсли;

		ДанныеОтвета = ДесериализоватьJSON(ТекстОтвета);
		Если ТипЗнч(ДанныеОтвета) <> Тип("Структура")
			И ТипЗнч(ДанныеОтвета) <> Тип("Соответствие") Тогда
			Результат.TextError = НСтр("ru = 'Некорректный формат ответа сервиса регистрации.'");
			Возврат Результат;
		КонецЕсли;

		ЗначениеSuccess = ЗначениеСвойстваJSON(ДанныеОтвета, "Success");
		Если ЗначениеSuccess <> Неопределено Тогда
			Результат.Success = ЗначениеSuccess;
		КонецЕсли;

		ЗначениеRegisteredCount = ЗначениеСвойстваJSON(ДанныеОтвета, "RegisteredCount");
		Если ЗначениеRegisteredCount <> Неопределено Тогда
			Результат.RegisteredCount = ЗначениеRegisteredCount;
		КонецЕсли;

		ЗначениеErrors = ЗначениеСвойстваJSON(ДанныеОтвета, "Errors");
		Если ТипЗнч(ЗначениеErrors) = Тип("Массив") Тогда
			Результат.Errors = ЗначениеErrors;
		КонецЕсли;

		ЗначениеError = ЗначениеСвойстваJSON(ДанныеОтвета, "Error");
		Если ЗначениеError <> Неопределено И НЕ ПустаяСтрока(Строка(ЗначениеError)) Тогда
			Результат.TextError = Строка(ЗначениеError);
		КонецЕсли;
	Исключение
		Результат.TextError = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Проверяет доступность HTTP-сервиса регистрации изменений на базе-источнике.
//
// Параметры:
//  URLСервераOData - Строка - адрес OData источника;
//  ИмяПользователя - Строка - пользователь для Basic-авторизации;
//  Пароль          - Строка - пароль;
//  Таймаут         - Число - таймаут HTTP в секундах.
//
// Возвращаемое значение:
//  Структура - Успешно, ТекстОшибки.
//
Функция ПроверитьСервисРегистрацииНаИсточнике(URLСервераOData, ИмяПользователя, Пароль, Таймаут = 30) Экспорт

	Результат = Новый Структура("Успешно, ТекстОшибки", Ложь, "");

	Если НЕ ЗначениеЗаполнено(URLСервераOData) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнен URL сервера OData.'");
		Возврат Результат;
	КонецЕсли;

	URLЗапроса = ПолучитьURLСервисаПоАдресуOData(URLСервераOData, "ping");
	ЧастиURL = РазложитьURL(URLЗапроса);

	Попытка
		Соединение = СоздатьHTTPСоединение(ЧастиURL, ИмяПользователя, Пароль, Таймаут);
		HTTPЗапрос = Новый HTTPЗапрос(ЧастиURL.ПутьРесурса);
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");

		HTTPОтвет = Соединение.Получить(HTTPЗапрос);
		ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

		Если HTTPОтвет.КодСостояния < 200 ИЛИ HTTPОтвет.КодСостояния >= 300 Тогда
			Результат.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Сервер вернул код ответа %1: %2'"),
				HTTPОтвет.КодСостояния,
				ТекстОтвета);
			Возврат Результат;
		КонецЕсли;

		ДанныеОтвета = ДесериализоватьJSON(ТекстОтвета);
		Если ТипЗнч(ДанныеОтвета) <> Тип("Структура")
			И ТипЗнч(ДанныеОтвета) <> Тип("Соответствие") Тогда
			Результат.ТекстОшибки = НСтр("ru = 'Некорректный формат ответа сервиса регистрации.'");
			Возврат Результат;
		КонецЕсли;

		ЗначениеSuccess = ЗначениеСвойстваJSON(ДанныеОтвета, "Success");
		Если ЗначениеSuccess = Истина Тогда
			Результат.Успешно = Истина;
		Иначе
			Результат.ТекстОшибки = НСтр("ru = 'Сервис регистрации изменений недоступен.'");
		КонецЕсли;
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиУзелПланаОбмена(ПараметрыЗапроса)

	Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура")
		И ТипЗнч(ПараметрыЗапроса) <> Тип("Соответствие") Тогда
		Возврат ПланыОбмена.Консолидация.ПустаяСсылка();
	КонецЕсли;

	СтрокаGUID = ЗначениеСвойстваJSON(ПараметрыЗапроса, "NodeGuid");
	Если ПустаяСтрока(СтрокаGUID) Тогда
		СтрокаGUID = ЗначениеСвойстваJSON(ПараметрыЗапроса, "УзелGuid");
	КонецЕсли;

	КодУзла = ЗначениеСвойстваJSON(ПараметрыЗапроса, "NodeCode");
	Если ПустаяСтрока(КодУзла) Тогда
		КодУзла = ЗначениеСвойстваJSON(ПараметрыЗапроса, "КодУзла");
	КонецЕсли;

	Если ЗначениеЗаполнено(СтрокаGUID) Тогда
		Возврат ПланыОбмена.Консолидация.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаGUID));
	КонецЕсли;

	Если ЗначениеЗаполнено(КодУзла) Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Консолидация.Ссылка КАК Ссылка
		|ИЗ
		|	ПланОбмена.Консолидация КАК Консолидация
		|ГДЕ
		|	Консолидация.Код = &Код
		|	И НЕ Консолидация.ПометкаУдаления";
		Запрос.УстановитьПараметр("Код", КодУзла);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;

	КонецЕсли;

	Возврат ПланыОбмена.Консолидация.ПустаяСсылка();

КонецФункции

Функция ПолучитьСсылкуПоИмениODataИGUID(ИмяOData, СтрокаGUID) Экспорт

	Если ПустаяСтрока(ИмяOData) Тогда
		ВызватьИсключение НСтр("ru = 'Не указано имя коллекции OData.'");
	КонецЕсли;

	Если ПустаяСтрока(СтрокаGUID) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан GUID объекта.'");
	КонецЕсли;

	УникальныйИдентификатор = Новый УникальныйИдентификатор(СтрокаGUID);

	Если СтрНачинаетсяС(ИмяOData, "Catalog_") Тогда

		ИмяМетаданных = Сред(ИмяOData, СтрДлина("Catalog_") + 1);
		Если Метаданные.Справочники.Найти(ИмяМетаданных) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Справочник ""%1"" не найден.'"), ИмяМетаданных);
		КонецЕсли;

		Возврат Справочники[ИмяМетаданных].ПолучитьСсылку(УникальныйИдентификатор);

	ИначеЕсли СтрНачинаетсяС(ИмяOData, "Document_") Тогда

		ИмяМетаданных = Сред(ИмяOData, СтрДлина("Document_") + 1);
		Если Метаданные.Документы.Найти(ИмяМетаданных) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Документ ""%1"" не найден.'"), ИмяМетаданных);
		КонецЕсли;

		Возврат Документы[ИмяМетаданных].ПолучитьСсылку(УникальныйИдентификатор);

	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неподдерживаемая коллекция OData: %1.'"), ИмяOData);
	КонецЕсли;

КонецФункции

Процедура ДобавитьОшибкуРегистрации(МассивОшибок, ИмяOData, СтрокаGUID, ТекстОшибки)

	Ошибка = Новый Структура;
	Ошибка.Вставить("ODataName", ИмяOData);
	Ошибка.Вставить("Guid", СтрокаGUID);
	Ошибка.Вставить("Error", ТекстОшибки);
	МассивОшибок.Добавить(Ошибка);

КонецПроцедуры

Функция ЗначениеСвойстваJSON(ОбъектJSON, ИмяСвойства)

	Если ОбъектJSON = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(ОбъектJSON) = Тип("Структура") Тогда
		Для Каждого ЭлементСтруктуры Из ОбъектJSON Цикл
			Если ЭлементСтруктуры.Ключ = ИмяСвойства Тогда
				Возврат ЭлементСтруктуры.Значение;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(ОбъектJSON) = Тип("Соответствие") Тогда
		Значение = ОбъектJSON.Получить(ИмяСвойства);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат ОбъектJSON.Получить(НРег(ИмяСвойства));
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция РазложитьURL(URL)

	Результат = Новый Структура("Схема, Сервер, Порт, ПутьРесурса");

	ПозицияСхемы = СтрНайти(URL, "://");
	Если ПозицияСхемы = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный URL. Ожидается http:// или https://'");
	КонецЕсли;

	Результат.Схема = НРег(Лев(URL, ПозицияСхемы - 1));
	Остаток = Сред(URL, ПозицияСхемы + 3);

	ПозицияПути = СтрНайти(Остаток, "/");
	Если ПозицияПути = 0 Тогда
		ХостПорт = Остаток;
		Результат.ПутьРесурса = "/";
	Иначе
		ХостПорт = Лев(Остаток, ПозицияПути - 1);
		Результат.ПутьРесурса = Сред(Остаток, ПозицияПути);
	КонецЕсли;

	ПозицияПорта = СтрНайти(ХостПорт, ":");
	Если ПозицияПорта > 0 Тогда
		Результат.Сервер = Лев(ХостПорт, ПозицияПорта - 1);
		Результат.Порт = Число(Сред(ХостПорт, ПозицияПорта + 1));
	Иначе
		Результат.Сервер = ХостПорт;
		Результат.Порт = ?(Результат.Схема = "https", 443, 80);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СоздатьHTTPСоединение(ЧастиURL, ИмяПользователя, Пароль, Таймаут)

	Если ЧастиURL.Схема = "https" Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
		Возврат Новый HTTPСоединение(ЧастиURL.Сервер, ЧастиURL.Порт,
			ИмяПользователя, Пароль, , Таймаут, ЗащищенноеСоединение);
	Иначе
		Возврат Новый HTTPСоединение(ЧастиURL.Сервер, ЧастиURL.Порт,
			ИмяПользователя, Пароль, , Таймаут);
	КонецЕсли;

КонецФункции

