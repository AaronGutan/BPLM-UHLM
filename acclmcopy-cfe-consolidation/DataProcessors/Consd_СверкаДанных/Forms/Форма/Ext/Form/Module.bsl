&НаКлиенте
Процедура ПутьПравилаКонвертацииПослеПомещенияФайла(Результат, Адрес, ВыбранноеИмяФайла, ДопПараметры) Экспорт

	Если НЕ Результат Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось передать файл правил конвертации на сервер.'"));
		Возврат;
	КонецЕсли;

	РезультатЗагрузки = ЗагрузитьОбъектыСверкиИзПравилНаСервере(Адрес);

	Если ЗначениеЗаполнено(РезультатЗагрузки.ТекстОшибки) Тогда
		ПоказатьПредупреждение(, РезультатЗагрузки.ТекстОшибки);
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, СтрШаблон(
		НСтр("ru = 'Загружено объектов сверки из правил: %1.'"),
		РезультатЗагрузки.Количество));

КонецПроцедуры

