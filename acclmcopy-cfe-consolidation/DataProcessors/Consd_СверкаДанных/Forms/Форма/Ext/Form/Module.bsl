#Область ПеременныеМодуля

// Кэш объекта обработки между порционными серверными вызовами сверки и ОСВ.
Перем мОбработкаОбъект;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		Объект.ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Объект.ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;

	Если Объект.ТаймаутЗапроса = 0 Тогда
		Объект.ТаймаутЗапроса = 30;
	КонецЕсли;

	//Если НЕ ЗначениеЗаполнено(Объект.ТипСверки) Тогда
	//	Объект.ТипСверки = НСтр("ru = 'Полная'");
	//КонецЕсли;

	Если Объект.ИсточникиСверки.Количество() = 0 ИЛИ Объект.ОбъектыСверки.Количество() = 0 Тогда
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		Если ОбработкаОбъект.ИсточникиСверки.Количество() = 0 Тогда
			ОбработкаОбъект.ЗаполнитьИсточникиИзРегистра();
		КонецЕсли;
		Если ОбработкаОбъект.ОбъектыСверки.Количество() = 0
			И НЕ ЗначениеЗаполнено(ОбработкаОбъект.ПутьПравилаКонвертации) Тогда
			ОбработкаОбъект.ЗаполнитьСписокОбъектов();
		КонецЕсли;
		ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПутьПравилаКонвертацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр("ru = 'Выбор файла правил конвертации'");
	Диалог.Фильтр = НСтр("ru = 'Файлы XML (*.xml)|*.xml'");
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Диалог.МножественныйВыбор = Ложь;

	Если ЗначениеЗаполнено(Объект.ПутьПравилаКонвертации) Тогда
		ФайлПравил = Новый Файл(Объект.ПутьПравилаКонвертации);
		Диалог.Каталог = ФайлПравил.Путь;
		Диалог.ПолноеИмяФайла = Объект.ПутьПравилаКонвертации;
	КонецЕсли;

	Если Диалог.Выбрать() Тогда
		Объект.ПутьПравилаКонвертации = Диалог.ПолноеИмяФайла;
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПутьПравилаКонвертацииПослеПомещенияФайла", ЭтотОбъект);
		НачатьПомещениеФайла(
			ОписаниеОповещения,
			,
			Диалог.ПолноеИмяФайла,
			Ложь,
			УникальныйИдентификатор);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбъектыСверкиВыбранПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ОбъектыСверки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьВыборРасхожденийПоОбъекту(
		ТекущиеДанные.ИмяOData,
		ТекущиеДанные.ИмяОбъекта,
		ТекущиеДанные.Выбран);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьИсточникиИзРегистраВыполнить(Команда)

	ЗагрузитьИсточникиИзРегистраНаСервере();

	Если Объект.ИсточникиСверки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'В регистре сведений ""Consd_Источники"" нет записей.
			|Заполните регистр адресами баз-источников и повторите загрузку.'"));
	Иначе
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Загружено источников из регистра: %1.'"),
			Объект.ИсточникиСверки.Количество()));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СформироватьОСВВыполнить(Команда)

	Если Объект.ИсточникиСверки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не заполнен список источников сверки.'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Формирование ОСВ по счетам...'"));
	СформироватьОСВНаСервере();
	Состояние();

	Если ОСВ.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет данных для отображения ОСВ по счетам.'"));
	КонецЕсли;

	УстановитьОтборРасхожденийОСВ();

КонецПроцедуры

&НаКлиенте
Процедура СкрытьБезРасхожденийВыполнить(Команда)

	ТолькоРасхожденияОСВ = НЕ ТолькоРасхожденияОСВ;
	УстановитьОтборРасхожденийОСВ();

КонецПроцедуры

&НаКлиенте
Процедура СкрытьБезРасхожденийОбъектыСверкиВыполнить(Команда)

	ТолькоРасхожденияОбъектыСверки = НЕ ТолькоРасхожденияОбъектыСверки;
	УстановитьОтборРасхожденийОбъектыСверки();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключенияВыполнить(Команда)

	Результат = ПроверитьПодключенияНаСервере();

	Если Результат.Успешно Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Подключение установлено ко всем источникам сверки.'"));
	Иначе
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Не удалось подключиться к части источников:
			|%1'"), Результат.ТекстОшибки));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСервисРегистрацииИзмененийВыполнить(Команда)

	Результат = ПроверитьСервисРегистрацииИзмененийНаСервере();

	Если Результат.Успешно Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Сервис регистрации изменений доступен на всех источниках сверки.'"));
	Иначе
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Сервис регистрации изменений недоступен на части источников:
			|%1'"), Результат.ТекстОшибки));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокОбъектовВыполнить(Команда)

	Если ЗначениеЗаполнено(Объект.ПутьПравилаКонвертации) Тогда
		ПоместитьФайлПравилИЗагрузитьОбъекты();
	Иначе
		ЗаполнитьСписокОбъектовНаСервере();
		ПоказатьПредупреждение(, НСтр("ru = 'Список объектов сверки обновлен.'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСверкуВыполнить(Команда)

	ТекстОшибкиЗаполнения = ПроверитьЗаполнениеПередСверкой();
	Если ЗначениеЗаполнено(ТекстОшибкиЗаполнения) Тогда
		ПоказатьПредупреждение(, ТекстОшибкиЗаполнения);
		Возврат;
	КонецЕсли;

	ИндексыВыбранныхОбъектов = ПолучитьИндексыВыбранныхОбъектовСверки();
	Если ИндексыВыбранныхОбъектов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбрано ни одного объекта для сверки.'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Выполняется сверка объектов...'"));
	ВыполнитьСверкуВыбранныхОбъектовНаСервере(ИндексыВыбранныхОбъектов);
	Состояние();
	УстановитьОтборРасхожденийОбъектыСверки();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетВыполнить(Команда)

	ТабличныйДокументОтчета = СформироватьОтчетНаСервере();

	ПараметрыФормы = Новый Структура("ТабличныйДокумент", ТабличныйДокументОтчета);
	ОткрытьФорму("Обработка.Consd_СверкаДанных.Форма.ФормаОтчета", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсеОбъектыСверкиВыполнить(Команда)

	УстановитьВыборОбъектовСверки(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВыборОбъектовСверкиВыполнить(Команда)

	УстановитьВыборОбъектовСверки(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериод(Команда)

	ПараметрыВыбора = Новый Структура("НачалоПериода, КонецПериода", Объект.ДатаНачала, Объект.ДатаОкончания);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериода", ПараметрыВыбора, Элементы.ВыбратьПериод, , , , ОписаниеОповещения);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт

	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.ДатаНачала = РезультатВыбора.НачалоПериода;
	Объект.ДатаОкончания = РезультатВыбора.КонецПериода;

КонецПроцедуры

// Устанавливает или снимает флаг "Выбран" у всех строк табличной части "ОбъектыСверки".
//
// Параметры:
// Выбран - Булево - значение флага выбора для всех строк.
//
&НаКлиенте
Процедура УстановитьВыборОбъектовСверки(Выбран)

	Для Каждого СтрокаОбъекта Из Объект.ОбъектыСверки Цикл
		СтрокаОбъекта.Выбран = Выбран;
	КонецЦикла;

	УстановитьВыборРасхожденийGUID(Выбран);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВыборРасхожденийПоОбъекту(ИмяOData, ИмяОбъекта, Выбран)

	Для Каждого СтрокаРасхождения Из РасхожденияGUID Цикл
		Если (НЕ ПустаяСтрока(ИмяOData) И СтрокаРасхождения.ИмяOData = ИмяOData)
			ИЛИ (ПустаяСтрока(ИмяOData) И СтрокаРасхождения.ИмяОбъекта = ИмяОбъекта) Тогда
			СтрокаРасхождения.Выбран = Выбран;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВыборРасхожденийGUID(Выбран)

	Для Каждого СтрокаРасхождения Из РасхожденияGUID Цикл
		СтрокаРасхождения.Выбран = Выбран;
	КонецЦикла;

КонецПроцедуры

// Проверяет заполнение обязательных параметров перед запуском сверки.
//
// Возвращаемое значение:
// Строка - текст ошибки или пустая строка, если проверка пройдена успешно.
//
&НаКлиенте
Функция ПроверитьЗаполнениеПередСверкой()

	Если Объект.ИсточникиСверки.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Не заполнен список источников сверки.'");
	КонецЕсли;

	ЕстьВыбранныеИсточники = Ложь;
	Для Каждого СтрокаИсточника Из Объект.ИсточникиСверки Цикл
		Если СтрокаИсточника.Выбран Тогда
			ЕстьВыбранныеИсточники = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЕстьВыбранныеИсточники Тогда
		Возврат НСтр("ru = 'Не выбрано ни одного источника для сверки.'");
	КонецЕсли;

	Для Каждого СтрокаИсточника Из Объект.ИсточникиСверки Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаИсточника.URLСервераOData) Тогда
			Возврат НСтр("ru = 'В списке источников есть строка с незаполненным URL сервера OData.'");
		КонецЕсли;
	КонецЦикла;

	Если Объект.ДатаНачала > Объект.ДатаОкончания Тогда
		Возврат НСтр("ru = 'Дата начала периода не может быть позже даты окончания периода.'");
	КонецЕсли;

	ЕстьВыбранныеСтроки = Ложь;
	Для Каждого СтрокаОбъекта Из Объект.ОбъектыСверки Цикл
		Если СтрокаОбъекта.Выбран Тогда
			ЕстьВыбранныеСтроки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЕстьВыбранныеСтроки Тогда
		Возврат НСтр("ru = 'Не выбрано ни одного объекта для сверки.'");
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает индексы выбранных строк табличной части "ОбъектыСверки".
//
// Возвращаемое значение:
// Массив - индексы строк (с нуля).
//
&НаКлиенте
Функция ПолучитьИндексыВыбранныхОбъектовСверки()

	Индексы = Новый Массив;

	Для Индекс = 0 По Объект.ОбъектыСверки.Количество() - 1 Цикл
		Если Объект.ОбъектыСверки[Индекс].Выбран Тогда
			Индексы.Добавить(Индекс);
		КонецЕсли;
	КонецЦикла;

	Возврат Индексы;

КонецФункции

&НаСервере
Процедура ЗагрузитьИсточникиИзРегистраНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗаполнитьИсточникиИзРегистра();
	СинхронизироватьУчетныеДанныеOData(ОбработкаОбъект);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");

КонецПроцедуры

&НаСервере
Процедура СформироватьОСВНаСервере()

	мОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СинхронизироватьУчетныеДанныеOData(мОбработкаОбъект);
	ОСВ.Очистить();
	ТаблицаОСВ = мОбработкаОбъект.ПолучитьОСВСравнениеПоСчетам();
	ОСВ.Загрузить(ТаблицаОСВ);
	ЗначениеВРеквизитФормы(мОбработкаОбъект, "Объект");
	мОбработкаОбъект = Неопределено;

КонецПроцедуры

&НаСервере
Процедура ВыполнитьСверкуВыбранныхОбъектовНаСервере(ИндексыВыбранныхОбъектов)

	мОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СинхронизироватьУчетныеДанныеOData(мОбработкаОбъект);
	мОбработкаОбъект.НачатьСверку();

	Для Каждого ИндексСтроки Из ИндексыВыбранныхОбъектов Цикл
		мОбработкаОбъект.ВыполнитьСверкуОбъекта(ИндексСтроки, Ложь);
	КонецЦикла;

	ЗначениеВРеквизитФормы(мОбработкаОбъект, "Объект");
	РасхожденияGUID.Загрузить(мОбработкаОбъект.ПолучитьРасхожденияGUID());
	мОбработкаОбъект = Неопределено;

КонецПроцедуры

// Копирует логин и пароль OData из шапки в строки источников сверки.
//
// Параметры:
// ОбработкаОбъект - ОбработкаОбъект.Consd_СверкаДанных - объект обработки;
//                    если не передан, используется реквизит формы "Объект".
//
&НаСервере
Процедура СинхронизироватьУчетныеДанныеOData(ОбработкаОбъект = Неопределено)

	Если ОбработкаОбъект = Неопределено Тогда
		ОбработкаОбъект = Объект;
	КонецЕсли;

	Для Каждого СтрокаИсточника Из ОбработкаОбъект.ИсточникиСверки Цикл
		СтрокаИсточника.ИмяПользователяOData = ОбработкаОбъект.ИмяПользователяOData;
		СтрокаИсточника.ПарольOData = ОбработкаОбъект.ПарольOData;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборРасхожденийОСВ()

	Если ТолькоРасхожденияОСВ Тогда
		Элементы.ТаблицаОСВ.ОтборСтрок = Новый ФиксированнаяСтруктура("ЕстьРасхождение", Истина);
		Элементы.СкрытьБезРасхождений.Заголовок = НСтр("ru = 'Показать все строки'");
	Иначе
		Элементы.ТаблицаОСВ.ОтборСтрок = Неопределено;
		Элементы.СкрытьБезРасхождений.Заголовок = НСтр("ru = 'Скрыть без расхождений'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборРасхожденийОбъектыСверки()

	Если ТолькоРасхожденияОбъектыСверки Тогда
		Элементы.ОбъектыСверки.ОтборСтрок = Новый ФиксированнаяСтруктура("ЕстьРасхождение", Истина);
		Элементы.ОбъектыСверкиСкрытьБезРасхождений.Заголовок = НСтр(
			"ru = 'Показать все строки'; en = 'Show all rows'");
	Иначе
		Элементы.ОбъектыСверки.ОтборСтрок = Неопределено;
		Элементы.ОбъектыСверкиСкрытьБезРасхождений.Заголовок = НСтр(
			"ru = 'Скрыть без расхождений'; en = 'Hide rows without discrepancies'");
	КонецЕсли;

КонецПроцедуры

