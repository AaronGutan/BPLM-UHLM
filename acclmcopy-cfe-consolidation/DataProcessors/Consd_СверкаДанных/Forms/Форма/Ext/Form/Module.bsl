	Оповещение = Новый ОписаниеОповещения("ПометитьНаУдалениеРасхожденияЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Пометить выбранные объекты на удаление в текущей информационной базе?'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПометитьНаУдалениеРасхожденияЗавершение(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	РезультатПометки = ПометитьНаУдалениеРасхожденийНаСервере();

	Если РезультатПометки.Success Тогда
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Помечено на удаление объектов: %1.'"),
			Формат(РезультатПометки.MarkedCount, "ЧГ=0")));
	Иначе
		ТекстСообщения = ?(ПустаяСтрока(РезультатПометки.TextError),
			НСтр("ru = 'Не удалось пометить объекты на удаление.'"),
			РезультатПометки.TextError);
		ПоказатьПредупреждение(, ТекстСообщения);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПометитьНаУдалениеРасхожденийНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаРасхождений = РасхожденияGUID.Выгрузить();
	ТекстТолькоВПриемнике = НСтр("ru = 'Только в приемнике'");
	ВыбранныеСтроки = ТаблицаРасхождений.НайтиСтроки(
		Новый Структура("Выбран, Сторона", Истина, ТекстТолькоВПриемнике));
	ТаблицаВыбранныхРасхождений = ТаблицаРасхождений.Скопировать(ВыбранныеСтроки);

	Возврат ОбработкаОбъект.ПометитьРасхожденияПриемникаНаУдаление(ТаблицаВыбранныхРасхождений);

КонецФункции

&НаКлиенте
Функция ЕстьВыбранныеРасхожденияДляРегистрации()

	ТекстТолькоВИсточнике = НСтр("ru = 'Только в источнике';en = 'Source only'");

	Для Каждого СтрокаРасхождения Из РасхожденияGUID Цикл
		Если СтрокаРасхождения.Выбран И СтрокаРасхождения.Сторона = ТекстТолькоВИсточнике Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура ТаблицаРасхожденияGUIDВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Поле <> Неопределено И Поле.Имя = "ТаблицаРасхожденияGUIDВыбран" Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	ДанныеСтроки = Элемент.ДанныеСтроки(ВыбраннаяСтрока);
	ТекстТолькоВИсточнике = НСтр("ru = 'Только в источнике';en = 'Source only'");

	Если ДанныеСтроки.Сторона <> ТекстТолькоВИсточнике Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки.Выбран = НЕ ДанныеСтроки.Выбран;

КонецПроцедуры

