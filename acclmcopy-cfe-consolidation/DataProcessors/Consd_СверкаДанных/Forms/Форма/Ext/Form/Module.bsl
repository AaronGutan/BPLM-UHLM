&НаКлиенте
Процедура ЗарегистрироватьКОбмену(Команда)

	Если НЕ ЕстьВыбранныеРасхожденияДляРегистрации() Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Не выбрано ни одного объекта ""Только в источнике"" для регистрации.';en = 'No ""Source only"" objects selected for registration.'"));
		Возврат;
	КонецЕсли;

	Результат = ЗарегистрироватьКОбменуНаСервере();

	Если Результат.Success Тогда
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Зарегистрировано объектов: %1.'"),
			Формат(Результат.RegisteredCount, "ЧГ=0")));
	Иначе
		ТекстСообщения = ?(ПустаяСтрока(Результат.TextError),
			НСтр("ru = 'Не удалось зарегистрировать объекты на источниках.'"),
			Результат.TextError);
		ПоказатьПредупреждение(, ТекстСообщения);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьКОбменуНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаРасхождений = РасхожденияGUID.Выгрузить();
	ТекстТолькоВИсточнике = НСтр("ru = 'Только в источнике'");
	ВыбранныеСтроки = ТаблицаРасхождений.НайтиСтроки(
		Новый Структура("Выбран, Сторона", Истина, ТекстТолькоВИсточнике));
	ТаблицаВыбранныхРасхождений = ТаблицаРасхождений.Скопировать(ВыбранныеСтроки);

	Возврат ОбработкаОбъект.ЗарегистрироватьРасхожденияНаИсточниках(
		ТаблицаВыбранныхРасхождений,
		ОбработкаОбъект.ИсточникиСверки.Выгрузить());

КонецФункции

