Процедура ПоместитьФайлПравилИЗагрузитьОбъекты()

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПутьПравилаКонвертацииПослеПомещенияФайла", ЭтотОбъект);
	НачатьПомещениеФайла(
		ОписаниеОповещения,
		,
		Объект.ПутьПравилаКонвертации,
		Ложь,
		УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Функция ЗагрузитьОбъектыСверкиИзПравилНаСервере(АдресФайла)

	Результат = Новый Структура("Количество, ТекстОшибки", 0, "");
	ИмяВременногоФайла = "";

	Попытка
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
		ДвоичныеДанные.Записать(ИмяВременногоФайла);

		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		ОбработкаОбъект.ЗаполнитьСписокОбъектовИзПравилКонвертации(ИмяВременногоФайла);
		Результат.Количество = ОбработкаОбъект.ОбъектыСверки.Количество();
		ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Если ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

