// Формирует параметры StartPeriod/EndPeriod для виртуальных таблиц OData.
//
Функция СформироватьПараметрыПериодаOData(ДатаНачала, ДатаОкончания)

	ПараметрыФункции = Новый Массив;

	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		ПараметрыФункции.Добавить(СтрШаблон("StartPeriod=datetime'%1'",
			Формат(ДатаНачала, "ДФ=yyyy-MM-ddT00:00:00")));
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПараметрыФункции.Добавить(СтрШаблон("EndPeriod=datetime'%1'",
			Формат(КонецДня(ДатаОкончания), "ДФ=yyyy-MM-ddT23:59:59")));
	КонецЕсли;

	Возврат ПараметрыФункции;

КонецФункции

// Добавляет в параметры OData отбор по организации источника.
//
Процедура ДобавитьУсловиеОрганизацииOData(ПараметрыФункции, Организация)

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;

	// Формат OData: Condition='Организация_Key eq guid'uuid''
	// В строковом литерале 1С одинарная кавычка пишется один раз.
	GUIDОрганизации = НормализоватьGUIDOData(Организация.УникальныйИдентификатор());
	ПараметрыФункции.Добавить(СтрШаблон(
		"Condition='Организация_Key eq guid'%1''",
		GUIDОрганизации));

КонецПроцедуры

// Возвращает числовое значение поля OData, перебирая допустимые имена свойства.
//
Функция ПолучитьЧислоПоляOData(ЭлементOData, ИменаПолей)

	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЗначениеПоля = ЭлементOData.Получить(ИмяПоля);
		Если ЗначениеПоля <> Неопределено Тогда
			Возврат Число(ЗначениеПоля);
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

