// Разбирает текст JSON в дерево значений Соответствие/Массив/примитивы.
// Объекты JSON читаются как Соответствие (а не Структура), чтобы корректно обрабатывать
// ключи с точками, например "odata.nextLink".
//
// Параметры:
// ТекстJSON - Строка - текст ответа сервера в формате JSON.
//
Функция РазобратьJSON(ТекстJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Возврат Результат;

КонецФункции

// Создает HTTP-соединение с сервером OData по параметрам конкретного источника.
//
// Параметры:
// ЧастиURL       - Структура - результат РазложитьURL(...);
// ИмяПользователя - Строка - имя пользователя OData источника;
// Пароль          - Строка - пароль пользователя OData источника.
//
Функция СоздатьHTTPСоединение(ЧастиURL, ИмяПользователя, Пароль)

	Таймаут = ?(ТаймаутЗапроса > 0, ТаймаутЗапроса, 30);

	Если ЧастиURL.Схема = "https" Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
		Возврат Новый HTTPСоединение(ЧастиURL.Сервер, ЧастиURL.Порт,
			ИмяПользователя, Пароль, , Таймаут, ЗащищенноеСоединение);
	Иначе
		Возврат Новый HTTPСоединение(ЧастиURL.Сервер, ЧастиURL.Порт,
			ИмяПользователя, Пароль, , Таймаут);
	КонецЕсли;

КонецФункции

// Разбирает URL сервиса OData на составные части.
//
// Параметры:
// URL - Строка - полный URL OData-сервиса, например "http://server/base/odata/standard.odata".
//
// Возвращаемое значение:
// Структура - Схема, Сервер, Порт, ПутьРесурса.
//
Функция РазложитьURL(URL)

	Результат = Новый Структура("Схема, Сервер, Порт, ПутьРесурса");

	ПозицияСхемы = СтрНайти(URL, "://");
	Если ПозицияСхемы = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный URL сервера OData. Ожидается http:// или https://'");
	КонецЕсли;

	Результат.Схема = НРег(Лев(URL, ПозицияСхемы - 1));
	Остаток = Сред(URL, ПозицияСхемы + 3);

	ПозицияПути = СтрНайти(Остаток, "/");
	Если ПозицияПути = 0 Тогда
		ХостПорт = Остаток;
		Результат.ПутьРесурса = "";
	Иначе
		ХостПорт = Лев(Остаток, ПозицияПути - 1);
		ПутьРесурса = Сред(Остаток, ПозицияПути);
		Если Прав(ПутьРесурса, 1) = "/" Тогда
			ПутьРесурса = Лев(ПутьРесурса, СтрДлина(ПутьРесурса) - 1);
		КонецЕсли;
		Результат.ПутьРесурса = ПутьРесурса;
	КонецЕсли;

	ПозицияПорта = СтрНайти(ХостПорт, ":");
	Если ПозицияПорта > 0 Тогда
		Результат.Сервер = Лев(ХостПорт, ПозицияПорта - 1);
		Результат.Порт = Число(Сред(ХостПорт, ПозицияПорта + 1));
	Иначе
		Результат.Сервер = ХостПорт;
		Результат.Порт = ?(Результат.Схема = "https", 443, 80);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Преобразует абсолютную ссылку из "odata.nextLink" в относительный путь запроса.
//
// Параметры:
// АбсолютнаяСсылка - Строка - абсолютный URL, полученный в свойстве "odata.nextLink".
//
Функция ПолучитьОтносительныйПутьИзСсылки(АбсолютнаяСсылка)

	ПозицияСхемы = СтрНайти(АбсолютнаяСсылка, "://");
	Если ПозицияСхемы = 0 Тогда
		Возврат АбсолютнаяСсылка;
	КонецЕсли;

	Остаток = Сред(АбсолютнаяСсылка, ПозицияСхемы + 3);
	ПозицияПути = СтрНайти(Остаток, "/");

	Если ПозицияПути = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Сред(Остаток, ПозицияПути);

КонецФункции

