// Возвращает массив описаний показателей ОСВ для сравнения.
//
Функция ОписанияПоказателейОСВ()

	Результат = Новый Массив;
	ДобавитьОписаниеПоказателяОСВ(Результат, "СальдоНачалоДт", НСтр("ru = 'Сальдо на начало периода (Дт)'"));
	ДобавитьОписаниеПоказателяОСВ(Результат, "СальдоНачалоКт", НСтр("ru = 'Сальдо на начало периода (Кт)'"));
	ДобавитьОписаниеПоказателяОСВ(Результат, "ОборотДт", НСтр("ru = 'Обороты за период (Дт)'"));
	ДобавитьОписаниеПоказателяОСВ(Результат, "ОборотКт", НСтр("ru = 'Обороты за период (Кт)'"));
	ДобавитьОписаниеПоказателяОСВ(Результат, "СальдоКонецДт", НСтр("ru = 'Сальдо на конец периода (Дт)'"));
	ДобавитьОписаниеПоказателяОСВ(Результат, "СальдоКонецКт", НСтр("ru = 'Сальдо на конец периода (Кт)'"));

	Возврат Результат;

