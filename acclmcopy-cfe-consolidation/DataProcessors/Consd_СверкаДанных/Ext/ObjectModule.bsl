#Область ПеременныеМодуля

// Кэш детализации сверки ОСВ по ключу строки табличной части "ОбъектыСверки".
// Заполняется при выполнении сверки, используется при формировании отчета.
Перем мДетализацияОСВ;

// Таблица расхождений GUID по источникам, заполняется при сверке ссылочных объектов.
Перем мРасхожденияGUID;

// Промежуточные данные порционного формирования ОСВ на форме.
Перем мТаблицаОСВ;
Перем мСтрокиПоКлючуОСВ;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет доступность OData-сервисов всех источников, перечисленных в табличной
// части "ИсточникиСверки". Консолидация выполняется из нескольких баз-источников,
// поэтому проверяется каждое подключение по отдельности.
//
// Возвращаемое значение:
// Структура - результат проверки:
//   * Успешно - Булево - Истина, если подключение установлено ко всем источникам;
//   * ТекстОшибки - Строка - перечень источников с ошибками подключения (каждый с новой строки).
//
Функция ПроверитьПодключения() Экспорт

	Результат = Новый Структура("Успешно, ТекстОшибки", Истина, "");

	Если ИсточникиСверки.Количество() = 0 Тогда
		Результат.Успешно = Ложь;
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнен список источников сверки.'");
		Возврат Результат;
	КонецЕсли;

	ТекстыОшибок = Новый Массив;

	Для Каждого СтрокаИсточника Из ИсточникиСверки Цикл
		РезультатИсточника = ПроверитьПодключениеКИсточнику(СтрокаИсточника);
		Если НЕ РезультатИсточника.Успешно Тогда
			Результат.Успешно = Ложь;
			ТекстыОшибок.Добавить(СтрШаблон("%1: %2", СтрокаИсточника.URLСервераOData, РезультатИсточника.ТекстОшибки));
		КонецЕсли;
	КонецЦикла;

	Результат.ТекстОшибки = СтрСоединить(ТекстыОшибок, Символы.ПС);

	Возврат Результат;

КонецФункции

// Заполняет табличную часть "ИсточникиСверки" данными из регистра сведений
// "Consd_Источники". Каждая запись регистра описывает базу-источник консолидации:
// адрес OData-сервиса, узел плана обмена и организацию приемника. Ранее введенные
// строки табличной части замещаются данными регистра.
//
Процедура ЗаполнитьИсточникиИзРегистра() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Источники.Организация КАК Организация,
	|	Источники.Адрес КАК Адрес,
	|	Источники.Узел КАК Узел
	|ИЗ
	|	РегистрСведений.Consd_Источники КАК Источники";

	Выборка = Запрос.Выполнить().Выбрать();

	ИсточникиСверки.Очистить();

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ИсточникиСверки.Добавить();
		НоваяСтрока.URLСервераOData = Выборка.Адрес;
		НоваяСтрока.Организация = Выборка.Организация;
		НоваяСтрока.Узел = Выборка.Узел;
	КонецЦикла;

КонецПроцедуры

// Заполняет табличную часть "ОбъектыСверки" документами и справочниками из состава
// плана обмена "Консолидация" (объекты источника БП, без типовых объектов УХ).
// Ранее выбранные пользователем строки (по имени OData) сохраняются.
//
Процедура ЗаполнитьСписокОбъектов() Экспорт

	ВыбранныеРанее = Новый Соответствие;
	Для Каждого СтарСтрока Из ОбъектыСверки Цикл
		Если СтарСтрока.Выбран Тогда
			ВыбранныеРанее.Вставить(СтарСтрока.ИмяOData, Истина);
		КонецЕсли;
	КонецЦикла;

	ОбъектыСверки.Очистить();

	СтатусСверкиНеВыполнена = НСтр("ru = 'Не выполнена'");
	ПланОбменаМетаданные = Метаданные.ПланыОбмена.Найти("Консолидация");

	Если ПланОбменаМетаданные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементСостава Из ПланОбменаМетаданные.Состав Цикл

		МетаданныеОбъекта = ЭлементСостава.Метаданные;
		Если МетаданныеОбъекта = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(МетаданныеОбъекта.Имя, "Удалить") Тогда
			Продолжить;
		КонецЕсли;

		Если Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
			ДобавитьСтрокуОбъектаСверки(МетаданныеОбъекта, "Документ", ВыбранныеРанее, СтатусСверкиНеВыполнена);
		ИначеЕсли Метаданные.Справочники.Содержит(МетаданныеОбъекта) Тогда
			ДобавитьСтрокуОбъектаСверки(МетаданныеОбъекта, "Справочник", ВыбранныеРанее, СтатусСверкиНеВыполнена);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Подготавливает таблицу расхождений GUID перед порционной или полной сверкой.
//
Процедура НачатьСверку() Экспорт

	мРасхожденияGUID = СоздатьТаблицуРасхожденийGUID();

КонецПроцедуры

// Выполняет сверку одной строки табличной части "ОбъектыСверки" по индексу.
//
// Параметры:
// ИндексСтроки    - Число - индекс строки в табличной части "ОбъектыСверки" (с нуля);
// ПроверятьВыбор  - Булево - если Ложь, сверка выполняется по переданному индексу
//                     без повторной проверки флага "Выбран" (для вызова с формы).
//
Процедура ВыполнитьСверкуОбъекта(ИндексСтроки, ПроверятьВыбор = Истина) Экспорт

	Если ИндексСтроки < 0 ИЛИ ИндексСтроки >= ОбъектыСверки.Количество() Тогда
		Возврат;
	КонецЕсли;

	СтрокаОбъекта = ОбъектыСверки[ИндексСтроки];

	Если ПроверятьВыбор И НЕ СтрокаОбъекта.Выбран Тогда
		Возврат;
	КонецЕсли;

	СтрокаОбъекта.ТекстОшибки = "";

	Попытка
		ВыполнитьСверкуСсылочногоОбъекта(СтрокаОбъекта);
	Исключение
		СтрокаОбъекта.СтатусСверки = НСтр("ru = 'Ошибка'");
		СтрокаОбъекта.ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Сверка данных OData'"),
			УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Выполняет сверку данных по всем отмеченным строкам табличной части "ОбъектыСверки".
// Для справочников и документов сравнивается состав объектов по UUID в разрезе
// каждого источника сверки.
//
Процедура ВыполнитьСверку() Экспорт

	Если ИсточникиСверки.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен список источников сверки.'");
	КонецЕсли;

	НачатьСверку();

	Для ИндексСтроки = 0 По ОбъектыСверки.Количество() - 1 Цикл
		ВыполнитьСверкуОбъекта(ИндексСтроки);
	КонецЦикла;

КонецПроцедуры

// Возвращает таблицу расхождений GUID, накопленную при последней сверке.
//
// Возвращаемое значение:
// ТаблицаЗначений - только отличия с указанием источника.
//
Функция ПолучитьРасхожденияGUID() Экспорт

	Если мРасхожденияGUID = Неопределено Тогда
		Возврат СоздатьТаблицуРасхожденийGUID();
	КонецЕсли;

	Возврат мРасхожденияGUID;

КонецФункции

// Регистрирует на базах-источниках объекты, отсутствующие в приемнике.
//
// Параметры:
//  ТаблицаРасхождений - ТаблицаЗначений - колонки Источник, ИмяOData, GUID, Сторона;
//  ТаблицаИсточников  - ТаблицаЗначений - колонки URLСервераOData, ИмяПользователяOData,
//                       ПарольOData, Организация, Узел.
//
// Возвращаемое значение:
//  Структура - Success, RegisteredCount, TextError.
//
Функция ЗарегистрироватьРасхожденияНаИсточниках(ТаблицаРасхождений, ТаблицаИсточников) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Success", Ложь);
	Результат.Вставить("RegisteredCount", 0);
	Результат.Вставить("TextError", "");

	ТекстТолькоВИсточнике = НСтр("ru = 'Только в источнике'");
	ОбъектыПоИсточникам = Новый Соответствие;

	Для Каждого СтрокаРасхождения Из ТаблицаРасхождений Цикл

		Если СтрокаРасхождения.Сторона <> ТекстТолькоВИсточнике Тогда
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(СтрокаРасхождения.ИмяOData) ИЛИ ПустаяСтрока(СтрокаРасхождения.GUID) Тогда
			Продолжить;
		КонецЕсли;

		МассивОбъектов = ОбъектыПоИсточникам.Получить(СтрокаРасхождения.Источник);
		Если МассивОбъектов = Неопределено Тогда
			МассивОбъектов = Новый Массив;
			ОбъектыПоИсточникам.Вставить(СтрокаРасхождения.Источник, МассивОбъектов);
		КонецЕсли;

		ОписаниеОбъекта = Новый Структура("ODataName, Guid", СтрокаРасхождения.ИмяOData, СтрокаРасхождения.GUID);
		МассивОбъектов.Добавить(ОписаниеОбъекта);

	КонецЦикла;

	Если ОбъектыПоИсточникам.Количество() = 0 Тогда
		Результат.TextError = НСтр("ru = 'Нет объектов ""Только в источнике"" для регистрации.'");
		Возврат Результат;
	КонецЕсли;

	Таймаут = ?(ТаймаутЗапроса > 0, ТаймаутЗапроса, 30);
	КоличествоЗарегистрированных = 0;
	ТекстыОшибок = Новый Массив;

	Для Каждого ЭлементИсточника Из ОбъектыПоИсточникам Цикл

		СтрокаИсточника = НайтиСтрокуИсточникаСверки(ТаблицаИсточников, ЭлементИсточника.Ключ);
		Если СтрокаИсточника = Неопределено Тогда
			ТекстыОшибок.Добавить(СтрШаблон(НСтр("ru = '%1: не найден источник в списке сверки.'"),
				ЭлементИсточника.Ключ));
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(СтрокаИсточника.Узел) Тогда
			ТекстыОшибок.Добавить(СтрШаблон(НСтр("ru = '%1: не указан узел плана обмена.'"),
				ЭлементИсточника.Ключ));
			Продолжить;
		КонецЕсли;

		РезультатИсточника = Consd_СверкаСервис.ВызватьРегистрациюНаИсточнике(
			СтрокаИсточника.URLСервераOData,
			СтрокаИсточника.ИмяПользователяOData,
			СтрокаИсточника.ПарольOData,
			СтрокаИсточника.Узел,
			ЭлементИсточника.Значение,
			Таймаут);

		Если РезультатИсточника.Success Тогда
			КоличествоЗарегистрированных = КоличествоЗарегистрированных + РезультатИсточника.RegisteredCount;
		Иначе
			ТекстОшибки = РезультатИсточника.TextError;
			Если ПустаяСтрока(ТекстОшибки) И РезультатИсточника.Errors.Количество() > 0 Тогда
				ТекстОшибки = Строка(РезультатИсточника.Errors[0]);
			КонецЕсли;
			ТекстыОшибок.Добавить(СтрШаблон("%1: %2", ЭлементИсточника.Ключ, ТекстОшибки));
		КонецЕсли;

	КонецЦикла;

	Результат.RegisteredCount = КоличествоЗарегистрированных;
	Результат.Success = (КоличествоЗарегистрированных > 0 И ТекстыОшибок.Количество() = 0)
		ИЛИ (КоличествоЗарегистрированных > 0);
	Результат.TextError = СтрСоединить(ТекстыОшибок, Символы.ПС);

	Возврат Результат;

КонецФункции

// Формирует табличный документ с результатами последней выполненной сверки.
//
// Возвращаемое значение:
// ТабличныйДокумент - готовый к показу отчет сверки.
//
Функция СформироватьОтчет() Экспорт

	Макет = ПолучитьМакет("ОтчетСверки");
	ТабДок = Новый ТабличныйДокумент;

	ОбластьЗаголовка = Макет.ПолучитьОбласть("Заголовок");
	//ОбластьЗаголовка.Параметры.ТекстЗаголовка = СтрШаблон(НСтр("ru = 'Отчет сверки данных: %1'"), ТипСверки);
	ОбластьЗаголовка.Параметры.ТекстПериода = СтрШаблон(
		НСтр("ru = 'Период: %1 - %2. Источников: %3. Сформирован: %4'"),
		Формат(ДатаНачала, "ДЛФ=D"), Формат(ДатаОкончания, "ДЛФ=D"),
		Формат(ИсточникиСверки.Количество(), "ЧГ=0"), Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
	ТабДок.Вывести(ОбластьЗаголовка);

	ТабДок.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));

	ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
	ОбластьОшибки = Макет.ПолучитьОбласть("СтрокаОшибка");

	ИтогоИсточник = 0;
	ИтогоПриемник = 0;
	ИтогоРасхождений = 0;
	НомерСтроки = 0;

	Для Каждого СтрокаОбъекта Из ОбъектыСверки Цикл

		Если НЕ СтрокаОбъекта.Выбран Тогда
			Продолжить;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;

		ОбластьСтроки.Параметры.НомерСтроки = НомерСтроки;
		ОбластьСтроки.Параметры.ИмяОбъекта = СтрокаОбъекта.ИмяОбъекта;
		ОбластьСтроки.Параметры.КоличествоИсточник = СтрокаОбъекта.КоличествоИсточник;
		ОбластьСтроки.Параметры.КоличествоПриемник = СтрокаОбъекта.КоличествоПриемник;
		ОбластьСтроки.Параметры.КоличествоРасхождений = СтрокаОбъекта.КоличествоРасхождений;
		ОбластьСтроки.Параметры.СтатусСверки = СтрокаОбъекта.СтатусСверки;
		ТабДок.Вывести(ОбластьСтроки);

		Если ЗначениеЗаполнено(СтрокаОбъекта.ТекстОшибки) Тогда
			ОбластьОшибки.Параметры.ТекстОшибки = СтрокаОбъекта.ТекстОшибки;
			ТабДок.Вывести(ОбластьОшибки);
		КонецЕсли;

		ИтогоИсточник = ИтогоИсточник + СтрокаОбъекта.КоличествоИсточник;
		ИтогоПриемник = ИтогоПриемник + СтрокаОбъекта.КоличествоПриемник;
		ИтогоРасхождений = ИтогоРасхождений + СтрокаОбъекта.КоличествоРасхождений;

	КонецЦикла;

	ОбластьИтого = Макет.ПолучитьОбласть("Итого");
	ОбластьИтого.Параметры.ИтогоИсточник = ИтогоИсточник;
	ОбластьИтого.Параметры.ИтогоПриемник = ИтогоПриемник;
	ОбластьИтого.Параметры.ИтогоРасхождений = ИтогоРасхождений;
	ОбластьИтого.Параметры.ИтогоСтатус = ?(ИтогоРасхождений = 0,
		НСтр("ru = 'Совпадает'"), НСтр("ru = 'Есть расхождения'"));
	ТабДок.Вывести(ОбластьИтого);

	УстановитьШиринуКолонокОтчета(ТабДок);
	ТабДок.АвтоМасштаб = Ложь;

	Возврат ТабДок;

КонецФункции

// Инициализирует порционное формирование таблицы ОСВ.
//
Процедура НачатьФормированиеОСВ() Экспорт

	мТаблицаОСВ = СоздатьТаблицуОСВСравнения();
	мСтрокиПоКлючуОСВ = Новый Соответствие;

КонецПроцедуры

// Добавляет в таблицу ОСВ данные одного источника сверки.
//
// Параметры:
// ИндексИсточника - Число - индекс строки в табличной части "ИсточникиСверки" (с нуля).
//
Процедура ДобавитьОСВПоИсточнику(ИндексИсточника) Экспорт

	Если мТаблицаОСВ = Неопределено Тогда
		НачатьФормированиеОСВ();
	КонецЕсли;

	Если ИндексИсточника < 0 ИЛИ ИндексИсточника >= ИсточникиСверки.Количество() Тогда
		Возврат;
	КонецЕсли;

	СтрокаИсточника = ИсточникиСверки[ИндексИсточника];
	ПредставлениеИсточника = ПредставлениеИсточникаОСВ(СтрокаИсточника);

	ОСВПриемника = ПолучитьОСВПоСчетамПриемник(СтрокаИсточника.Организация);
	Для Каждого ЭлементСчета Из ОСВПриемника Цикл
		СтрокаТаблицы = ПолучитьСтрокуОСВ(мТаблицаОСВ, мСтрокиПоКлючуОСВ,
			ЭлементСчета.Ключ, ЭлементСчета.Значение.Наименование, ПредставлениеИсточника);
		НакопитьСуммыОСВ(СтрокаТаблицы, ЭлементСчета.Значение, "Пр");
	КонецЦикла;

	ОСВИсточника = ПолучитьОСВПоСчетамИсточник(СтрокаИсточника);
	Для Каждого ЭлементСчета Из ОСВИсточника Цикл
		СтрокаТаблицы = ПолучитьСтрокуОСВ(мТаблицаОСВ, мСтрокиПоКлючуОСВ,
			ЭлементСчета.Ключ, ЭлементСчета.Значение.Наименование, ПредставлениеИсточника);
		НакопитьСуммыОСВ(СтрокаТаблицы, ЭлементСчета.Значение, "Ист");
	КонецЦикла;

КонецПроцедуры

// Завершает порционное формирование таблицы ОСВ.
//
// Возвращаемое значение:
// ТаблицаЗначений - готовая таблица сравнения ОСВ.
//
Функция ЗавершитьФормированиеОСВ() Экспорт

	Если мТаблицаОСВ = Неопределено Тогда
		Возврат СоздатьТаблицуОСВСравнения();
	КонецЕсли;

	мТаблицаОСВ.Сортировать("Источник, КодСчета");
	ЗаполнитьПризнакиРасхожденийОСВ(мТаблицаОСВ);

	Результат = мТаблицаОСВ;
	мТаблицаОСВ = Неопределено;
	мСтрокиПоКлючуОСВ = Неопределено;

	Возврат Результат;

КонецФункции

// Формирует таблицу сравнения ОСВ регистра "Хозрасчетный" в разрезе счетов и источников.
//
// Возвращаемое значение:
// ТаблицаЗначений - строки в разрезе источника и счета.
//
Функция ПолучитьОСВСравнениеПоСчетам() Экспорт

	НачатьФормированиеОСВ();

	Для ИндексИсточника = 0 По ИсточникиСверки.Количество() - 1 Цикл
		ДобавитьОСВПоИсточнику(ИндексИсточника);
	КонецЦикла;

	Возврат ЗавершитьФормированиеОСВ();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает пустую таблицу расхождений GUID для формы и отчета.
//
Функция СоздатьТаблицуРасхожденийGUID()

	КвалификаторыСтроки150 = Новый КвалификаторыСтроки(150);
	КвалификаторыGUID = Новый КвалификаторыСтроки(36);
	ТипСтрока150 = Новый ОписаниеТипов("Строка", , КвалификаторыСтроки150);
	ТипGUID = Новый ОписаниеТипов("Строка", , КвалификаторыGUID);

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Источник", ТипСтрока150);
	Таблица.Колонки.Добавить("ИмяОбъекта", ТипСтрока150);
	Таблица.Колонки.Добавить("ИмяOData", ТипСтрока150);
	Таблица.Колонки.Добавить("GUID", ТипGUID);
	Таблица.Колонки.Добавить("Сторона", ТипСтрока150);

	Возврат Таблица;

КонецФункции

// Добавляет в таблицу расхождений GUID отличия между множествами источника и приемника.
//
Процедура ДобавитьРасхожденияGUIDПоМножествам(ПредставлениеИсточника, ИмяОбъекта, ИмяOData,
		МножествоИсточника, МножествоПриемника)

	Если мРасхожденияGUID = Неопределено Тогда
		мРасхожденияGUID = СоздатьТаблицуРасхожденийGUID();
	КонецЕсли;

	ТекстТолькоВИсточнике = НСтр("ru = 'Только в источнике'");
	ТекстТолькоВПриемнике = НСтр("ru = 'Только в приемнике'");

	Для Каждого ЭлементИсточника Из МножествоИсточника Цикл
		Если МножествоПриемника.Получить(ЭлементИсточника.Ключ) = Неопределено Тогда
			СтрокаРасхождения = мРасхожденияGUID.Добавить();
			СтрокаРасхождения.Источник = ПредставлениеИсточника;
			СтрокаРасхождения.ИмяОбъекта = ИмяОбъекта;
			СтрокаРасхождения.ИмяOData = ИмяOData;
			СтрокаРасхождения.GUID = ЭлементИсточника.Ключ;
			СтрокаРасхождения.Сторона = ТекстТолькоВИсточнике;
		КонецЕсли;
	КонецЦикла;

	Для Каждого ЭлементПриемника Из МножествоПриемника Цикл
		Если МножествоИсточника.Получить(ЭлементПриемника.Ключ) = Неопределено Тогда
			СтрокаРасхождения = мРасхожденияGUID.Добавить();
			СтрокаРасхождения.Источник = ПредставлениеИсточника;
			СтрокаРасхождения.ИмяОбъекта = ИмяОбъекта;
			СтрокаРасхождения.ИмяOData = ИмяOData;
			СтрокаРасхождения.GUID = ЭлементПриемника.Ключ;
			СтрокаРасхождения.Сторона = ТекстТолькоВПриемнике;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Проверяет наличие реквизита "Организация" у метаданных справочника или документа.
//
Функция МетаданныеИмеютРеквизитОрганизация(ТипОбъекта, ИмяOData)

	МетаданныеОбъекта = ПолучитьМетаданныеСсылочногоОбъекта(ТипОбъекта, ИмяOData);

	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат МетаданныеОбъекта.Реквизиты.Найти("Организация") <> Неопределено;

КонецФункции

// Возвращает метаданные справочника или документа по имени OData-коллекции.
//
Функция ПолучитьМетаданныеСсылочногоОбъекта(ТипОбъекта, ИмяOData)

	Если ТипОбъекта = "Справочник" Тогда
		ИмяМетаданных = Сред(ИмяOData, СтрДлина("Catalog_") + 1);
		Возврат Метаданные.Справочники.Найти(ИмяМетаданных);
	ИначеЕсли ТипОбъекта = "Документ" Тогда
		ИмяМетаданных = Сред(ИмяOData, СтрДлина("Document_") + 1);
		Возврат Метаданные.Документы.Найти(ИмяМетаданных);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Создает пустую таблицу значений для сравнения ОСВ по счетам.
// Структура колонок должна совпадать с реквизитом формы "ОСВ" (используется Загрузить).
//
Функция СоздатьТаблицуОСВСравнения()

	КвалификаторыКода = Новый КвалификаторыСтроки(20);
	КвалификаторыНаименования = Новый КвалификаторыСтроки(150);
	КвалификаторыИсточника = Новый КвалификаторыСтроки(150);
	КвалификаторыСуммы = Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой);

	ТипКода = Новый ОписаниеТипов("Строка", , КвалификаторыКода);
	ТипНаименования = Новый ОписаниеТипов("Строка", , КвалификаторыНаименования);
	ТипИсточника = Новый ОписаниеТипов("Строка", , КвалификаторыИсточника);
	ТипСуммы = Новый ОписаниеТипов("Число", КвалификаторыСуммы);

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("КодСчета", ТипКода);
	Таблица.Колонки.Добавить("Счет", ТипНаименования);
	Таблица.Колонки.Добавить("Источник", ТипИсточника);

	Для Каждого Префикс Из СтрРазделить("Ист,Пр", ",", Ложь) Цикл
		Таблица.Колонки.Добавить(Префикс + "СальдоНачалоДт", ТипСуммы);
		Таблица.Колонки.Добавить(Префикс + "СальдоНачалоКт", ТипСуммы);
		Таблица.Колонки.Добавить(Префикс + "ОборотДт", ТипСуммы);
		Таблица.Колонки.Добавить(Префикс + "ОборотКт", ТипСуммы);
		Таблица.Колонки.Добавить(Префикс + "СальдоКонецДт", ТипСуммы);
		Таблица.Колонки.Добавить(Префикс + "СальдоКонецКт", ТипСуммы);
	КонецЦикла;

	Таблица.Колонки.Добавить("ЕстьРасхождение", Новый ОписаниеТипов("Булево"));

	Возврат Таблица;

КонецФункции

// Возвращает строку таблицы ОСВ для указанного источника и кода счета.
//
Функция ПолучитьСтрокуОСВ(ТаблицаОСВ, СтрокиПоКлючу, КодСчета, Наименование, ПредставлениеИсточника)

	КлючСчета = СокрЛП(КодСчета);
	КлючСтроки = ПредставлениеИсточника + "|" + КлючСчета;
	СтрокаТаблицы = СтрокиПоКлючу.Получить(КлючСтроки);

	Если СтрокаТаблицы = Неопределено Тогда
		СтрокаТаблицы = ТаблицаОСВ.Добавить();
		СтрокаТаблицы.КодСчета = КлючСчета;
		СтрокаТаблицы.Счет = ПредставлениеСчетаОСВ(КлючСчета, Наименование);
		СтрокаТаблицы.Источник = ПредставлениеИсточника;
		СтрокиПоКлючу.Вставить(КлючСтроки, СтрокаТаблицы);
	ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаТаблицы.Счет) И ЗначениеЗаполнено(Наименование) Тогда
		СтрокаТаблицы.Счет = ПредставлениеСчетаОСВ(КлючСчета, Наименование);
	КонецЕсли;

	Возврат СтрокаТаблицы;

КонецФункции

// Возвращает строку источника сверки по представлению из таблицы расхождений.
//
Функция НайтиСтрокуИсточникаСверки(ТаблицаИсточников, ПредставлениеИсточника)

	Для Каждого СтрокаИсточника Из ТаблицаИсточников Цикл
		Если ПредставлениеИсточникаОСВ(СтрокаИсточника) = ПредставлениеИсточника Тогда
			Возврат СтрокаИсточника;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает представление источника для таблицы ОСВ.
//
Функция ПредставлениеИсточникаОСВ(СтрокаИсточника)

	Если ЗначениеЗаполнено(СтрокаИсточника.Организация) Тогда
		Возврат Строка(СтрокаИсточника.Организация);
	КонецЕсли;

	Если ЗначениеЗаполнено(СтрокаИсточника.URLСервераOData) Тогда
		Возврат СтрокаИсточника.URLСервераOData;
	КонецЕсли;

	Возврат НСтр("ru = 'Источник без организации'");

КонецФункции

// Возвращает представление счета для таблицы ОСВ: код и наименование.
//
Функция ПредставлениеСчетаОСВ(КодСчета, Наименование)

	Если ЗначениеЗаполнено(Наименование) Тогда
		Возврат СокрЛП(КодСчета) + " " + СокрЛП(Наименование);
	КонецЕсли;

	Возврат СокрЛП(КодСчета);

КонецФункции

// Прибавляет показатели ОСВ к строке таблицы сравнения по указанной стороне.
//
// Параметры:
// СтрокаТаблицы - СтрокаТаблицыЗначений - строка таблицы сравнения ОСВ;
// Итоги         - Структура - показатели ОСВ (сальдо на начало, обороты, сальдо на конец);
// Префикс       - Строка - "Ист" (источник) или "Пр" (приемник).
//
Процедура НакопитьСуммыОСВ(СтрокаТаблицы, Итоги, Префикс)

	СтрокаТаблицы[Префикс + "СальдоНачалоДт"] = СтрокаТаблицы[Префикс + "СальдоНачалоДт"] + Итоги.СальдоНачалоДт;
	СтрокаТаблицы[Префикс + "СальдоНачалоКт"] = СтрокаТаблицы[Префикс + "СальдоНачалоКт"] + Итоги.СальдоНачалоКт;
	СтрокаТаблицы[Префикс + "ОборотДт"] = СтрокаТаблицы[Префикс + "ОборотДт"] + Итоги.ОборотДт;
	СтрокаТаблицы[Префикс + "ОборотКт"] = СтрокаТаблицы[Префикс + "ОборотКт"] + Итоги.ОборотКт;
	СтрокаТаблицы[Префикс + "СальдоКонецДт"] = СтрокаТаблицы[Префикс + "СальдоКонецДт"] + Итоги.СальдоКонецДт;
	СтрокаТаблицы[Префикс + "СальдоКонецКт"] = СтрокаТаблицы[Префикс + "СальдоКонецКт"] + Итоги.СальдоКонецКт;

КонецПроцедуры

// Заполняет признак "ЕстьРасхождение" для строк таблицы ОСВ.
// Расхождением считается отличие любого из шести показателей источника и приемника.
//
Процедура ЗаполнитьПризнакиРасхожденийОСВ(ТаблицаОСВ)

	ИменаПоказателей = СтрРазделить(
		"СальдоНачалоДт,СальдоНачалоКт,ОборотДт,ОборотКт,СальдоКонецДт,СальдоКонецКт",
		",",
		Ложь);

	Для Каждого СтрокаТаблицы Из ТаблицаОСВ Цикл

		ЕстьРасхождение = Ложь;
		Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
			Если Окр(СтрокаТаблицы["Ист" + ИмяПоказателя] - СтрокаТаблицы["Пр" + ИмяПоказателя], 2) <> 0 Тогда
				ЕстьРасхождение = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		СтрокаТаблицы.ЕстьРасхождение = ЕстьРасхождение;

	КонецЦикла;

КонецПроцедуры

// Возвращает показатели ОСВ приемника (эта база) в разрезе счетов.
// При заполненной организации применяется отбор по ней; иначе - без отбора.
//
// Параметры:
// Организация - СправочникСсылка.Организации, Неопределено - организация приемника.
//
// Возвращаемое значение:
// Соответствие - ключ: код счета (Строка); значение: Структура итогов ОСВ с полем "Наименование".
//
Функция ПолучитьОСВПоСчетамПриемник(Организация = Неопределено)

	ТекстОтбораПоОрганизации = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстОтбораПоОрганизации = "
		|	И ОстаткиИОбороты.Организация = &Организация";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиИОбороты.Счет.Код КАК КодСчета,
	|	ОстаткиИОбороты.Счет.Наименование КАК НаименованиеСчета,
	|	ЕСТЬNULL(СУММА(ОстаткиИОбороты.СуммаНачальныйОстатокДт), 0) КАК СальдоНачалоДт,
	|	ЕСТЬNULL(СУММА(ОстаткиИОбороты.СуммаНачальныйОстатокКт), 0) КАК СальдоНачалоКт,
	|	ЕСТЬNULL(СУММА(ОстаткиИОбороты.СуммаОборотДт), 0) КАК ОборотДт,
	|	ЕСТЬNULL(СУММА(ОстаткиИОбороты.СуммаОборотКт), 0) КАК ОборотКт,
	|	ЕСТЬNULL(СУММА(ОстаткиИОбороты.СуммаКонечныйОстатокДт), 0) КАК СальдоКонецДт,
	|	ЕСТЬNULL(СУММА(ОстаткиИОбороты.СуммаКонечныйОстатокКт), 0) КАК СальдоКонецКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&ДатаНачала, &ДатаОкончания, , , ) КАК ОстаткиИОбороты
	|ГДЕ
	|	ИСТИНА"
	+ ТекстОтбораПоОрганизации + "
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиИОбороты.Счет.Код,
	|	ОстаткиИОбороты.Счет.Наименование";

	Запрос.УстановитьПараметр("ДатаНачала", ?(ЗначениеЗаполнено(ДатаНачала), ДатаНачала, Дата(1, 1, 1)));
	Запрос.УстановитьПараметр("ДатаОкончания", ?(ЗначениеЗаполнено(ДатаОкончания), КонецДня(ДатаОкончания), Дата(9999, 12, 31)));
	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Итоги = НовыеИтогиОСВ();
		ЗаполнитьИтогиОСВИзВыборки(Итоги, Выборка);
		Итоги.Вставить("Наименование", Выборка.НаименованиеСчета);
		Результат.Вставить(СокрЛП(Выборка.КодСчета), Итоги);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает показатели ОСВ одного источника (OData) в разрезе счетов. Счета
// сопоставляются по коду через карту счетов источника (Ref_Key -> код).
//
// Параметры:
// СтрокаИсточника - СтрокаТаблицыЗначений - строка табличной части "ИсточникиСверки".
//
// Возвращаемое значение:
// Соответствие - ключ: код счета (Строка); значение: Структура итогов ОСВ с полем "Наименование".
//
Функция ПолучитьОСВПоСчетамИсточник(СтрокаИсточника)

	Результат = Новый Соответствие;
	КартаСчетов = ПолучитьКартуСчетовOData(СтрокаИсточника);

	ЧастиURL = РазложитьURL(СтрокаИсточника.URLСервераOData);
	Соединение = СоздатьHTTPСоединение(ЧастиURL, СтрокаИсточника.ИмяПользователяOData, СтрокаИсточника.ПарольOData);

	ПараметрыФункции = СформироватьПараметрыПериодаOData(ДатаНачала, ДатаОкончания);
	ДобавитьУсловиеОрганизацииOData(ПараметрыФункции, СтрокаИсточника.Организация);

	ИменаПолейСчет = ИменаПолейСчетKeyOData();
	РазмерСтраницы = 1000;
	ОтносительныйПуть = ЧастиURL.ПутьРесурса + "/AccountingRegister_Хозрасчетный/BalanceAndTurnovers("
		+ СтрСоединить(ПараметрыФункции, ",") + ")"
		+ "?$format=json&$top=" + Формат(РазмерСтраницы, "ЧГ=0");

	Пока ЗначениеЗаполнено(ОтносительныйПуть) Цикл

		HTTPЗапрос = Новый HTTPЗапрос(ОтносительныйПуть);
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");

		Ответ = Соединение.Получить(HTTPЗапрос);

		Если Ответ.КодСостояния <> КодСостоянияHTTPУспешно() Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Ошибка получения ОСВ по счетам источника %1: код ответа %2.'"),
				СтрокаИсточника.URLСервераOData, Формат(Ответ.КодСостояния, "ЧГ=0"));
		КонецЕсли;

		ТелоОтвета = РазобратьJSON(Ответ.ПолучитьТелоКакСтроку());
		СписокЭлементов = ТелоОтвета.Получить("value");

		Если СписокЭлементов <> Неопределено Тогда
			Для Каждого Элемент Из СписокЭлементов Цикл

				GUIDСчета = НормализоватьGUIDOData(ПолучитьСтрокуПоляOData(Элемент, ИменаПолейСчет));
				Если НЕ ЗначениеЗаполнено(GUIDСчета) Тогда
					Продолжить;
				КонецЕсли;

				ОписаниеСчета = КартаСчетов.Получить(GUIDСчета);
				Если ОписаниеСчета = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				Итоги = Результат.Получить(ОписаниеСчета.Код);
				Если Итоги = Неопределено Тогда
					Итоги = НовыеИтогиОСВ();
					Итоги.Вставить("Наименование", ОписаниеСчета.Наименование);
					Результат.Вставить(ОписаниеСчета.Код, Итоги);
				КонецЕсли;

				ДобавитьИтогиОСВИзOData(Итоги, Элемент);

			КонецЦикла;
		КонецЕсли;

		СледующаяСсылка = ТелоОтвета.Получить("odata.nextLink");
		Если ЗначениеЗаполнено(СледующаяСсылка) Тогда
			ОтносительныйПуть = ПолучитьОтносительныйПутьИзСсылки(СледующаяСсылка);
		Иначе
			ОтносительныйПуть = "";
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает карту счетов источника: соответствие уникального идентификатора счета
// (Ref_Key в нижнем регистре) описанию счета (код и наименование). Список счетов
// считывается постранично из коллекции OData "ChartOfAccounts_Хозрасчетный".
//
// Параметры:
// СтрокаИсточника - СтрокаТаблицыЗначений - строка табличной части "ИсточникиСверки".
//
Функция ПолучитьКартуСчетовOData(СтрокаИсточника)

	Результат = Новый Соответствие;

	ЧастиURL = РазложитьURL(СтрокаИсточника.URLСервераOData);
	Соединение = СоздатьHTTPСоединение(ЧастиURL, СтрокаИсточника.ИмяПользователяOData, СтрокаИсточника.ПарольOData);

	РазмерСтраницы = 1000;
	ОтносительныйПуть = ЧастиURL.ПутьРесурса
		+ "/ChartOfAccounts_Хозрасчетный?$select=Ref_Key,Code,Description&$format=json&$top="
		+ Формат(РазмерСтраницы, "ЧГ=0");

	Пока ЗначениеЗаполнено(ОтносительныйПуть) Цикл

		HTTPЗапрос = Новый HTTPЗапрос(ОтносительныйПуть);
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");

		Ответ = Соединение.Получить(HTTPЗапрос);

		Если Ответ.КодСостояния <> КодСостоянияHTTPУспешно() Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Ошибка получения плана счетов источника %1: код ответа %2.'"),
				СтрокаИсточника.URLСервераOData, Формат(Ответ.КодСостояния, "ЧГ=0"));
		КонецЕсли;

		ТелоОтвета = РазобратьJSON(Ответ.ПолучитьТелоКакСтроку());
		СписокЭлементов = ТелоОтвета.Получить("value");

		Если СписокЭлементов <> Неопределено Тогда
			Для Каждого Элемент Из СписокЭлементов Цикл
				RefKey = НормализоватьGUIDOData(Элемент.Получить("Ref_Key"));
				Если НЕ ЗначениеЗаполнено(RefKey) Тогда
					Продолжить;
				КонецЕсли;
				ОписаниеСчета = Новый Структура("Код, Наименование");
				ОписаниеСчета.Код = СокрЛП(Строка(Элемент.Получить("Code")));
				ОписаниеСчета.Наименование = Строка(Элемент.Получить("Description"));
				Результат.Вставить(RefKey, ОписаниеСчета);
			КонецЦикла;
		КонецЕсли;

		СледующаяСсылка = ТелоОтвета.Получить("odata.nextLink");
		Если ЗначениеЗаполнено(СледующаяСсылка) Тогда
			ОтносительныйПуть = ПолучитьОтносительныйПутьИзСсылки(СледующаяСсылка);
		Иначе
			ОтносительныйПуть = "";
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает строковое значение поля OData, перебирая допустимые имена свойства.
//
Функция ПолучитьСтрокуПоляOData(ЭлементOData, ИменаПолей)

	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЗначениеПоля = ЭлементOData.Получить(ИмяПоля);
		Если ЗначениеПоля <> Неопределено Тогда
			Возврат Строка(ЗначениеПоля);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает допустимые имена поля ссылки на счет в ответе OData виртуальной таблицы
// BalanceAndTurnovers регистра бухгалтерии.
//
Функция ИменаПолейСчетKeyOData()

	Имена = Новый Массив;
	Имена.Добавить("Account_Key");
	Имена.Добавить("Счет_Key");
	Имена.Добавить("AccountKey");
	Имена.Добавить("СчетKey");
	Возврат Имена;

КонецФункции

// Приводит GUID из ответа OData к единому виду для сопоставления
// (нижний регистр, без фигурных скобок).
//
Функция НормализоватьGUIDOData(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Результат = НРег(СокрЛП(Строка(Значение)));
	Результат = СтрЗаменить(Результат, "{", "");
	Результат = СтрЗаменить(Результат, "}", "");

	Возврат Результат;

КонецФункции

// Устанавливает ширину колонок сформированного табличного документа отчета.
//
// Параметры:
// ТабДок - ТабличныйДокумент - сформированный отчет сверки.
//
Процедура УстановитьШиринуКолонокОтчета(ТабДок)

	ШириныКолонок = Новый Массив;
	ШириныКолонок.Добавить(6);  // №
	ШириныКолонок.Добавить(55); // Объект сверки
	ШириныКолонок.Добавить(12); // Источник
	ШириныКолонок.Добавить(12); // Приемник
	ШириныКолонок.Добавить(14); // Расхождения
	ШириныКолонок.Добавить(20); // Статус

	Для НомерКолонки = 1 По ШириныКолонок.Количество() Цикл
		ТабДок.Область(1, НомерКолонки, ТабДок.ВысотаТаблицы, НомерКолонки).ШиринаКолонки =
			ШириныКолонок[НомерКолонки - 1];
	КонецЦикла;

КонецПроцедуры

// Инициализирует кэш детализации ОСВ перед новой сверкой.
//
Процедура ИнициализироватьДетализациюОСВ()

	мДетализацияОСВ = Новый Соответствие;

КонецПроцедуры

// Возвращает ключ строки табличной части "ОбъектыСверки" для кэша детализации ОСВ.
//
Функция КлючСтрокиОбъектаСверки(СтрокаОбъекта)

	Возврат СтрокаОбъекта.ТипОбъекта + "#" + СтрокаОбъекта.ИмяOData;

КонецФункции

// Сохраняет детализацию сверки ОСВ по строке объекта в кэше модуля.
//
Процедура СохранитьДетализациюОСВ(СтрокаОбъекта, ДетализацияПоИсточникам)

	Если мДетализацияОСВ = Неопределено Тогда
		мДетализацияОСВ = Новый Соответствие;
	КонецЕсли;

	мДетализацияОСВ.Вставить(КлючСтрокиОбъектаСверки(СтрокаОбъекта), ДетализацияПоИсточникам);

КонецПроцедуры

// Возвращает сохраненную детализацию сверки ОСВ по строке объекта.
//
Функция ПолучитьДетализациюОСВ(СтрокаОбъекта)

	Если мДетализацияОСВ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат мДетализацияОСВ.Получить(КлючСтрокиОбъектаСверки(СтрокаОбъекта));

КонецФункции

// Выводит в табличный документ детализацию сверки ОСВ по источникам.
//
Процедура ВывестиДетализациюОСВВОтчет(ТабДок, Макет, СтрокаОбъекта)

	ДетализацияПоИсточникам = ПолучитьДетализациюОСВ(СтрокаОбъекта);
	Если ДетализацияПоИсточникам = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбластьИсточник = Макет.ПолучитьОбласть("СтрокаИсточникОСВ");
	ОбластьШапкаОСВ = Макет.ПолучитьОбласть("ШапкаОСВ");
	ОбластьСтрокаОСВ = Макет.ПолучитьОбласть("СтрокаОСВ");
	ОбластьОшибки = Макет.ПолучитьОбласть("СтрокаОшибка");

	Для Каждого ДетализацияИсточника Из ДетализацияПоИсточникам Цикл

		ОбластьИсточник.Параметры.ПредставлениеИсточника = СтрШаблон(
			НСтр("ru = 'Источник: %1'"), ДетализацияИсточника.ПредставлениеИсточника);
		ТабДок.Вывести(ОбластьИсточник);

		Если ЗначениеЗаполнено(ДетализацияИсточника.ТекстОшибки) Тогда
			ОбластьОшибки.Параметры.ТекстОшибки = ДетализацияИсточника.ТекстОшибки;
			ТабДок.Вывести(ОбластьОшибки);
			Продолжить;
		КонецЕсли;

		ТабДок.Вывести(ОбластьШапкаОСВ);

		Для Каждого СтрокаСравнения Из ДетализацияИсточника.РезультатСравнения.СтрокиСравнения Цикл
			ОбластьСтрокаОСВ.Параметры.Показатель = СтрокаСравнения.Показатель;
			ОбластьСтрокаОСВ.Параметры.ЗначениеИсточник = ФорматСуммыОСВ(СтрокаСравнения.ЗначениеИсточник);
			ОбластьСтрокаОСВ.Параметры.ЗначениеПриемник = ФорматСуммыОСВ(СтрокаСравнения.ЗначениеПриемник);
			ОбластьСтрокаОСВ.Параметры.Расхождение = ФорматСуммыОСВ(СтрокаСравнения.Расхождение);
			ТабДок.Вывести(ОбластьСтрокаОСВ);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Возвращает код состояния HTTP, соответствующий успешному ответу сервера.
//
Функция КодСостоянияHTTPУспешно()

	Возврат 200;

КонецФункции

// Добавляет строку в табличную часть "ОбъектыСверки" по метаданным документа или справочника.
//
Процедура ДобавитьСтрокуОбъектаСверки(МетаданныеОбъекта, ТипОбъекта, ВыбранныеРанее, СтатусСверки)

	ПрефиксOData = ?(ТипОбъекта = "Документ", "Document_", "Catalog_");
	ИмяOData = ПрефиксOData + МетаданныеОбъекта.Имя;

	НоваяСтрока = ОбъектыСверки.Добавить();
	НоваяСтрока.ТипОбъекта = ТипОбъекта;
	НоваяСтрока.ИмяОбъекта = МетаданныеОбъекта.Синоним;
	НоваяСтрока.ИмяOData = ИмяOData;
	НоваяСтрока.СтатусСверки = СтатусСверки;
	НоваяСтрока.Выбран = (ВыбранныеРанее.Получить(ИмяOData) <> Неопределено);

КонецПроцедуры

// Проверяет доступность OData-сервиса одного источника.
//
// Параметры:
// СтрокаИсточника - СтрокаТаблицыЗначений - строка табличной части "ИсточникиСверки".
//
// Возвращаемое значение:
// Структура - результат проверки:
//   * Успешно - Булево - Истина, если подключение установлено;
//   * ТекстОшибки - Строка - описание причины неудачи.
//
Функция ПроверитьПодключениеКИсточнику(СтрокаИсточника)

	Результат = Новый Структура("Успешно, ТекстОшибки", Ложь, "");

	Если НЕ ЗначениеЗаполнено(СтрокаИсточника.URLСервераOData) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнен URL сервера OData.'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		ЧастиURL = РазложитьURL(СтрокаИсточника.URLСервераOData);
		Соединение = СоздатьHTTPСоединение(ЧастиURL, СтрокаИсточника.ИмяПользователяOData, СтрокаИсточника.ПарольOData);

		// Корень стандартного OData-интерфейса 1С обязательно требует завершающий
		// разделитель, иначе сервер отвечает переадресацией (код 301).
		HTTPЗапрос = Новый HTTPЗапрос(ЧастиURL.ПутьРесурса + "/");
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");

		Ответ = Соединение.Получить(HTTPЗапрос);

		Если Ответ.КодСостояния = КодСостоянияHTTPУспешно() Тогда
			Результат.Успешно = Истина;
		Иначе
			Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Сервер вернул код ответа %1.'"), Формат(Ответ.КодСостояния, "ЧГ=0"));
		КонецЕсли;
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Выполняет сверку итогов регистра бухгалтерии "Хозрасчетный" в формате ОСВ между
// каждым источником (через OData, виртуальная таблица BalanceAndTurnovers) и
// соответствующей организацией приемника (запрос к ОстаткиИОбороты). Сравниваются
// шесть показателей: сальдо на начало (Дт/Кт), обороты за период (Дт/Кт),
// сальдо на конец (Дт/Кт).
//
// Параметры:
// СтрокаОбъекта - СтрокаТаблицыЗначений - строка табличной части "ОбъектыСверки".
//
Процедура ВыполнитьСверкуРегистраХозрасчетный(СтрокаОбъекта)

	КоличествоПоказателей = 0;
	КоличествоСовпадений = 0;
	КоличествоРасхождений = 0;
	ТекстыОшибокИсточников = Новый Массив;
	ДетализацияПоИсточникам = Новый Массив;

	Для Каждого СтрокаИсточника Из ИсточникиСверки Цикл

		ПредставлениеИсточника = СтрокаИсточника.URLСервераOData;
		Если ЗначениеЗаполнено(СтрокаИсточника.Организация) Тогда
			ПредставлениеИсточника = ПредставлениеИсточника + " (" + Строка(СтрокаИсточника.Организация) + ")";
		КонецЕсли;

		Попытка
			ИтогиИсточника = ПолучитьИтогиОСВРегистраБухгалтерииOData(
				СтрокаОбъекта.ИмяOData, ДатаНачала, ДатаОкончания, СтрокаИсточника);
		Исключение
			ТекстыОшибокИсточников.Добавить(СтрШаблон("%1: %2", СтрокаИсточника.URLСервераOData, ОписаниеОшибки()));
			ДетализацияПоИсточникам.Добавить(Новый Структура(
				"ПредставлениеИсточника, ТекстОшибки, РезультатСравнения",
				ПредставлениеИсточника, ОписаниеОшибки(), Неопределено));
			Продолжить;
		КонецПопытки;

		ИтогиПриемника = ПолучитьИтогиОСВХозрасчетныйПриемник(СтрокаИсточника.Организация);
		РезультатСравнения = СравнитьИтогиОСВ(ИтогиИсточника, ИтогиПриемника);

		КоличествоПоказателей = КоличествоПоказателей + РезультатСравнения.КоличествоПоказателей;
		КоличествоСовпадений = КоличествоСовпадений + РезультатСравнения.КоличествоСовпадений;
		КоличествоРасхождений = КоличествоРасхождений + РезультатСравнения.КоличествоРасхождений;

		ДетализацияПоИсточникам.Добавить(Новый Структура(
			"ПредставлениеИсточника, ТекстОшибки, РезультатСравнения",
			ПредставлениеИсточника, "", РезультатСравнения));

	КонецЦикла;

	СтрокаОбъекта.КоличествоИсточник = КоличествоПоказателей;
	СтрокаОбъекта.КоличествоПриемник = КоличествоСовпадений;
	СтрокаОбъекта.КоличествоРасхождений = КоличествоРасхождений;

	СохранитьДетализациюОСВ(СтрокаОбъекта, ДетализацияПоИсточникам);

	Если ДетализацияПоИсточникам.Количество() > 0 Тогда
		СтрокаОбъекта.ТекстОшибки = ФорматироватьДетализациюОСВДляФормы(ДетализацияПоИсточникам);
	КонецЕсли;

	Если ТекстыОшибокИсточников.Количество() > 0 Тогда
		ТекстОшибок = СтрСоединить(ТекстыОшибокИсточников, Символы.ПС);
		Если ЗначениеЗаполнено(СтрокаОбъекта.ТекстОшибки) Тогда
			СтрокаОбъекта.ТекстОшибки = СтрокаОбъекта.ТекстОшибки + Символы.ПС + Символы.ПС + ТекстОшибок;
		Иначе
			СтрокаОбъекта.ТекстОшибки = ТекстОшибок;
		КонецЕсли;
	КонецЕсли;

	СтрокаОбъекта.СтатусСверки = ?(КоличествоРасхождений = 0 И ТекстыОшибокИсточников.Количество() = 0,
		НСтр("ru = 'Совпадает'"), НСтр("ru = 'Есть расхождения'"));

КонецПроцедуры

// Выполняет постатейную сверку ссылочного объекта (справочника или документа) по
// уникальным идентификаторам в разрезе каждого источника сверки.
//
// Параметры:
// СтрокаОбъекта - СтрокаТаблицыЗначений - строка табличной части "ОбъектыСверки".
//
Процедура ВыполнитьСверкуСсылочногоОбъекта(СтрокаОбъекта)

	ТекстыОшибокИсточников = Новый Массив;
	СуммаИсточник = 0;
	СуммаПриемник = 0;
	СуммаРасхождений = 0;
	ОтборПоОрганизации = МетаданныеИмеютРеквизитОрганизация(СтрокаОбъекта.ТипОбъекта, СтрокаОбъекта.ИмяOData);

	Для Каждого СтрокаИсточника Из ИсточникиСверки Цикл

		ПредставлениеИсточника = ПредставлениеИсточникаОСВ(СтрокаИсточника);

		ОрганизацияПриемника = Неопределено;
		Если ОтборПоОрганизации Тогда
			ОрганизацияПриемника = СтрокаИсточника.Организация;
		КонецЕсли;

		Попытка
			МножествоИсточника = ПолучитьUUIDОбъектовOData(СтрокаОбъекта.ИмяOData, СтрокаИсточника);
		Исключение
			ТекстыОшибокИсточников.Добавить(СтрШаблон("%1: %2",
				СтрокаИсточника.URLСервераOData, ОписаниеОшибки()));
			Продолжить;
		КонецПопытки;

		МножествоПриемника = ПолучитьUUIDОбъектовПриемника(
			СтрокаОбъекта.ТипОбъекта, СтрокаОбъекта.ИмяOData, ОрганизацияПриемника);

		СуммаИсточник = СуммаИсточник + МножествоИсточника.Количество();
		СуммаПриемник = СуммаПриемник + МножествоПриемника.Количество();

		КоличествоРасхожденийИсточника = 0;

		Для Каждого ЭлементИсточника Из МножествоИсточника Цикл
			Если МножествоПриемника.Получить(ЭлементИсточника.Ключ) = Неопределено Тогда
				КоличествоРасхожденийИсточника = КоличествоРасхожденийИсточника + 1;
			КонецЕсли;
		КонецЦикла;

		Для Каждого ЭлементПриемника Из МножествоПриемника Цикл
			Если МножествоИсточника.Получить(ЭлементПриемника.Ключ) = Неопределено Тогда
				КоличествоРасхожденийИсточника = КоличествоРасхожденийИсточника + 1;
			КонецЕсли;
		КонецЦикла;

		СуммаРасхождений = СуммаРасхождений + КоличествоРасхожденийИсточника;

		ДобавитьРасхожденияGUIDПоМножествам(
			ПредставлениеИсточника,
			СтрокаОбъекта.ИмяОбъекта,
			СтрокаОбъекта.ИмяOData,
			МножествоИсточника,
			МножествоПриемника);

	КонецЦикла;

	СтрокаОбъекта.КоличествоИсточник = СуммаИсточник;
	СтрокаОбъекта.КоличествоПриемник = СуммаПриемник;
	СтрокаОбъекта.КоличествоРасхождений = СуммаРасхождений;

	Если ТекстыОшибокИсточников.Количество() > 0 Тогда
		СтрокаОбъекта.ТекстОшибки = СтрСоединить(ТекстыОшибокИсточников, Символы.ПС);
	КонецЕсли;

	СтрокаОбъекта.СтатусСверки = ?(СуммаРасхождений = 0 И ТекстыОшибокИсточников.Количество() = 0,
		НСтр("ru = 'Совпадает'"), НСтр("ru = 'Есть расхождения'"));

КонецПроцедуры

// Возвращает итоги ОСВ регистра бухгалтерии "Хозрасчетный" в приемнике за период,
// указанный в реквизитах "ДатаНачала" и "ДатаОкончания", в разрезе организации,
// соответствующей проверяемому источнику.
//
// Параметры:
// Организация - СправочникСсылка - организация приемника, соответствующая источнику;
//               Неопределено, если строка источника не указывает организацию.
//
// Возвращаемое значение:
// Структура - итоги ОСВ (сальдо на начало, обороты, сальдо на конец по Дт и Кт).
//
Функция ПолучитьИтогиОСВХозрасчетныйПриемник(Организация = Неопределено)

	ТекстОтбораПоОрганизации = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстОтбораПоОрганизации = "
		|	И ОстаткиИОбороты.Организация = &Организация";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ОстаткиИОбороты.СуммаНачальныйОстатокДт), 0) КАК СальдоНачалоДт,
	|	ЕСТЬNULL(СУММА(ОстаткиИОбороты.СуммаНачальныйОстатокКт), 0) КАК СальдоНачалоКт,
	|	ЕСТЬNULL(СУММА(ОстаткиИОбороты.СуммаОборотДт), 0) КАК ОборотДт,
	|	ЕСТЬNULL(СУММА(ОстаткиИОбороты.СуммаОборотКт), 0) КАК ОборотКт,
	|	ЕСТЬNULL(СУММА(ОстаткиИОбороты.СуммаКонечныйОстатокДт), 0) КАК СальдоКонецДт,
	|	ЕСТЬNULL(СУММА(ОстаткиИОбороты.СуммаКонечныйОстатокКт), 0) КАК СальдоКонецКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&ДатаНачала, &ДатаОкончания, , , ) КАК ОстаткиИОбороты
	|ГДЕ
	|	ИСТИНА"
	+ ТекстОтбораПоОрганизации;

	ДатаНачалаОтбора = ?(ЗначениеЗаполнено(ДатаНачала), ДатаНачала, Дата(1, 1, 1));
	ДатаОкончанияОтбора = ?(ЗначениеЗаполнено(ДатаОкончания), КонецДня(ДатаОкончания), Дата(9999, 12, 31));
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаОтбора);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияОтбора);
	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Итоги = НовыеИтогиОСВ();

	Если Выборка.Следующий() Тогда
		ЗаполнитьИтогиОСВИзВыборки(Итоги, Выборка);
	КонецЕсли;

	Возврат Итоги;

КонецФункции

// Возвращает соответствие уникальных идентификаторов ссылок приемника для справочника
// или документа, соответствующего указанной OData-коллекции.
//
// Параметры:
// ТипОбъекта  - Строка - "Справочник" или "Документ";
// ИмяOData    - Строка - имя коллекции OData вида "Catalog_Имя" или "Document_Имя";
// Организация - СправочникСсылка - организация приемника для отбора, если реквизит есть.
//
Функция ПолучитьUUIDОбъектовПриемника(ТипОбъекта, ИмяOData, Организация = Неопределено)

	Результат = Новый Соответствие;

	Если ТипОбъекта = "Справочник" Тогда
		ИмяМетаданных = Сред(ИмяOData, СтрДлина("Catalog_") + 1);
		ТекстЗапроса = "ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + ИмяМетаданных + " КАК Т";
	ИначеЕсли ТипОбъекта = "Документ" Тогда
		ИмяМетаданных = Сред(ИмяOData, СтрДлина("Document_") + 1);
		ТекстЗапроса = "ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Документ." + ИмяМетаданных + " КАК Т";
	Иначе
		Возврат Результат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ГДЕ
		|	Т.Организация = &Организация";
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		UUID = НРег(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Результат.Вставить(UUID, Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает соответствие уникальных идентификаторов (Ref_Key) элементов коллекции
// OData одного источника, постранично обходя весь список через odata.nextLink.
//
// Параметры:
// ИмяКоллекции    - Строка - имя коллекции OData, например "Catalog_Номенклатура";
// СтрокаИсточника - СтрокаТаблицыЗначений - строка табличной части "ИсточникиСверки".
//
Функция ПолучитьUUIDОбъектовOData(ИмяКоллекции, СтрокаИсточника)

	Результат = Новый Соответствие;

	ЧастиURL = РазложитьURL(СтрокаИсточника.URLСервераOData);
	Соединение = СоздатьHTTPСоединение(ЧастиURL, СтрокаИсточника.ИмяПользователяOData, СтрокаИсточника.ПарольOData);

	РазмерСтраницы = 1000;
	ОтносительныйПуть = ЧастиURL.ПутьРесурса + "/" + ИмяКоллекции
		+ "?$select=Ref_Key&$format=json&$top=" + Формат(РазмерСтраницы, "ЧГ=0");

	Пока ЗначениеЗаполнено(ОтносительныйПуть) Цикл

		HTTPЗапрос = Новый HTTPЗапрос(ОтносительныйПуть);
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");

		Ответ = Соединение.Получить(HTTPЗапрос);

		Если Ответ.КодСостояния <> КодСостоянияHTTPУспешно() Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Ошибка запроса к коллекции %1: код ответа %2.'"),
				ИмяКоллекции, Формат(Ответ.КодСостояния, "ЧГ=0"));
		КонецЕсли;

		ТелоОтвета = РазобратьJSON(Ответ.ПолучитьТелоКакСтроку());
		СписокЭлементов = ТелоОтвета.Получить("value");

		Если СписокЭлементов <> Неопределено Тогда
			Для Каждого Элемент Из СписокЭлементов Цикл
				UUID = НРег(Элемент.Получить("Ref_Key"));
				Результат.Вставить(UUID, Истина);
			КонецЦикла;
		КонецЕсли;

		СледующаяСсылка = ТелоОтвета.Получить("odata.nextLink");
		Если ЗначениеЗаполнено(СледующаяСсылка) Тогда
			ОтносительныйПуть = ПолучитьОтносительныйПутьИзСсылки(СледующаяСсылка);
		Иначе
			ОтносительныйПуть = "";
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет доступность указанной коллекции в стандартном интерфейсе OData одного
// источника. Выполняет минимальный запрос ($top=0), не считывая записи коллекции.
//
// Параметры:
// ИмяКоллекции    - Строка - имя коллекции OData, например "AccountingRegister_Хозрасчетный";
// СтрокаИсточника - СтрокаТаблицыЗначений - строка табличной части "ИсточникиСверки".
//
// Возвращаемое значение:
// Структура - результат проверки:
//   * Существует - Булево - Истина, если коллекция доступна;
//   * ТекстОшибки - Строка - описание причины неудачи.
//
Функция ПроверитьНаличиеКоллекцииOData(ИмяКоллекции, СтрокаИсточника)

	Результат = Новый Структура("Существует, ТекстОшибки", Ложь, "");

	Если НЕ ЗначениеЗаполнено(СтрокаИсточника.URLСервераOData) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнен URL сервера OData.'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		ЧастиURL = РазложитьURL(СтрокаИсточника.URLСервераOData);
		Соединение = СоздатьHTTPСоединение(ЧастиURL, СтрокаИсточника.ИмяПользователяOData, СтрокаИсточника.ПарольOData);

		ОтносительныйПуть = ЧастиURL.ПутьРесурса + "/" + ИмяКоллекции + "?$top=0&$format=json";
		HTTPЗапрос = Новый HTTPЗапрос(ОтносительныйПуть);
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");

		Ответ = Соединение.Получить(HTTPЗапрос);

		Если Ответ.КодСостояния = КодСостоянияHTTPУспешно() Тогда
			Результат.Существует = Истина;
		ИначеЕсли Ответ.КодСостояния = 404 Тогда
			Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Коллекция %1 не найдена в стандартном интерфейсе OData
				|источника (код ответа 404). Проверьте, что объект включен в состав стандартного
				|интерфейса OData на источнике.'"), ИмяКоллекции);
		Иначе
			Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Сервер вернул код ответа %1 при обращении к коллекции %2.'"),
				Формат(Ответ.КодСостояния, "ЧГ=0"), ИмяКоллекции);
		КонецЕсли;
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает итоги ОСВ регистра бухгалтерии одного источника за период.
//
// Используется виртуальная таблица OData "BalanceAndTurnovers" (аналог
// "ОстаткиИОбороты"). Данные постранично считываются и агрегируются по шести
// показателям ОСВ. При заполненной организации в строке источника применяется
// отбор Condition по полю "Организация_Key" (GUID организации приемника
// предполагается синхронизированным с источником).
//
// Параметры:
// ИмяКоллекции    - Строка - имя коллекции OData регистра бухгалтерии;
// ДатаНачала      - Дата - начало периода отбора (необязательно);
// ДатаОкончания   - Дата - окончание периода отбора (необязательно);
// СтрокаИсточника - СтрокаТаблицыЗначений - строка табличной части "ИсточникиСверки".
//
// Возвращаемое значение:
// Структура - итоги ОСВ (сальдо на начало, обороты, сальдо на конец по Дт и Кт).
//
Функция ПолучитьИтогиОСВРегистраБухгалтерииOData(ИмяКоллекции, ДатаНачала, ДатаОкончания, СтрокаИсточника)

	ЧастиURL = РазложитьURL(СтрокаИсточника.URLСервераOData);
	Соединение = СоздатьHTTPСоединение(ЧастиURL, СтрокаИсточника.ИмяПользователяOData, СтрокаИсточника.ПарольOData);

	ПараметрыФункции = СформироватьПараметрыПериодаOData(ДатаНачала, ДатаОкончания);
	ДобавитьУсловиеОрганизацииOData(ПараметрыФункции, СтрокаИсточника.Организация);

	Итоги = НовыеИтогиОСВ();
	РазмерСтраницы = 1000;
	ОтносительныйПуть = ЧастиURL.ПутьРесурса + "/" + ИмяКоллекции
		+ "/BalanceAndTurnovers(" + СтрСоединить(ПараметрыФункции, ",") + ")"
		+ "?$format=json&$top=" + Формат(РазмерСтраницы, "ЧГ=0");

	Пока ЗначениеЗаполнено(ОтносительныйПуть) Цикл

		HTTPЗапрос = Новый HTTPЗапрос(ОтносительныйПуть);
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");

		Ответ = Соединение.Получить(HTTPЗапрос);

		Если Ответ.КодСостояния <> КодСостоянияHTTPУспешно() Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Ошибка получения итогов ОСВ регистра %1: код ответа %2.'"),
				ИмяКоллекции, Формат(Ответ.КодСостояния, "ЧГ=0"));
		КонецЕсли;

		ТелоОтвета = РазобратьJSON(Ответ.ПолучитьТелоКакСтроку());
		СписокЭлементов = ТелоОтвета.Получить("value");

		Если СписокЭлементов <> Неопределено Тогда
			Для Каждого Элемент Из СписокЭлементов Цикл
				ДобавитьИтогиОСВИзOData(Итоги, Элемент);
			КонецЦикла;
		КонецЕсли;

		СледующаяСсылка = ТелоОтвета.Получить("odata.nextLink");
		Если ЗначениеЗаполнено(СледующаяСсылка) Тогда
			ОтносительныйПуть = ПолучитьОтносительныйПутьИзСсылки(СледующаяСсылка);
		Иначе
			ОтносительныйПуть = "";
		КонецЕсли;

	КонецЦикла;

	Возврат Итоги;

КонецФункции

// Создает пустую структуру итогов ОСВ.
//
Функция НовыеИтогиОСВ()

	Итоги = Новый Структура;
	Итоги.Вставить("СальдоНачалоДт", 0);
	Итоги.Вставить("СальдоНачалоКт", 0);
	Итоги.Вставить("ОборотДт", 0);
	Итоги.Вставить("ОборотКт", 0);
	Итоги.Вставить("СальдоКонецДт", 0);
	Итоги.Вставить("СальдоКонецКт", 0);

	Возврат Итоги;

КонецФункции

// Заполняет структуру итогов ОСВ значениями из выборки запроса.
