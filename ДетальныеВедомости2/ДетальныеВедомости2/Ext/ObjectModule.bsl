Функция ПолучитьВедомостьКС_МСФО(Выводить, Организация, Счет, ДатаНачала, ДатаОкончания, ОтборОбъектНеНайден = Ложь) Экспорт // Не надо
	Запрос = Новый Запрос;
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	Регистр.Счет КАК Счет,
		               |	Регистр.Субконто1 КАК Субконто1,
		               |	Регистр.Субконто2 КАК Субконто2,
		               |	Регистр.Субконто3 КАК Субконто3,
		               |	Регистр.СуммаВВалютеУчетаНачальныйРазвернутыйОстатокДт КАК СуммаВВалютеУчетаНачальныйРазвернутыйОстатокДт,
		               |	Регистр.СуммаВВалютеУчетаНачальныйРазвернутыйОстатокКт КАК СуммаВВалютеУчетаНачальныйРазвернутыйОстатокКт,
		               |	Регистр.СуммаВВалютеУчетаОборотДт КАК СуммаВВалютеУчетаОборотДт,
		               |	Регистр.СуммаВВалютеУчетаОборотКт КАК СуммаВВалютеУчетаОборотКт,
		               |	Регистр.СуммаВВалютеУчетаКонечныйРазвернутыйОстатокДт КАК СуммаВВалютеУчетаКонечныйРазвернутыйОстатокДт,
		               |	Регистр.СуммаВВалютеУчетаКонечныйРазвернутыйОстатокКт КАК СуммаВВалютеУчетаКонечныйРазвернутыйОстатокКт,
		               |	Регистр.СуммаВВалютеОтчетностиНачальныйРазвернутыйОстатокДт КАК СуммаВВалютеОтчетностиНачальныйРазвернутыйОстатокДт,
		               |	Регистр.СуммаВВалютеОтчетностиНачальныйРазвернутыйОстатокКт КАК СуммаВВалютеОтчетностиНачальныйРазвернутыйОстатокКт,
		               |	Регистр.СуммаВВалютеОтчетностиОборотДт КАК СуммаВВалютеОтчетностиОборотДт,
		               |	Регистр.СуммаВВалютеОтчетностиОборотКт КАК СуммаВВалютеОтчетностиОборотКт,
		               |	Регистр.СуммаВВалютеОтчетностиКонечныйРазвернутыйОстатокДт КАК СуммаВВалютеОтчетностиКонечныйРазвернутыйОстатокДт,
		               |	Регистр.СуммаВВалютеОтчетностиКонечныйРазвернутыйОстатокКт КАК СуммаВВалютеОтчетностиКонечныйРазвернутыйОстатокКт
		               |ИЗ
		               |	РегистрБухгалтерии.КС_МСФО.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Период, , , , Организация = &Организация) КАК Регистр
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Регистр.Счет.Код,
		               |	Регистр.Субконто1.Представление,
		               |	Регистр.Субконто2.Представление,
		               |	Регистр.Субконто3.Представление";
		Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
		Запрос.УстановитьПараметр("КонецПериода" , ДатаОкончания);
		Запрос.УстановитьПараметр("Организация", Организация);
		
		Возврат ТаблицаЗначенийВТабличныйДокумент(Запрос.Выполнить().Выгрузить());
КонецФункции

&НаСервере
Функция Сформировать(Выводить, Период, Организация, ХозрасчетныйСчет, МСФОСчет, Результат, ВыводитьРасшифровки, ОтборОбъектНеНайден = Ложь) Экспорт
	Если Ложь Тогда
		Результат = Новый ТабличныйДокумент;
	КонецЕсли;
	
	Результат.Очистить();
	
	Если Выводить.Хозрасчетный Тогда
		ТЗ = ПолучитьВедомостьХозрасчетный(Выводить, Организация, ХозрасчетныйСчет, Период.ДатаНачала, Период.ДатаОкончания, ОтборОбъектНеНайден);
		ВывестиТаблицу(ТЗ, Выводить, Результат, "Хозрасчетный", "Ведомость", ВыводитьРасшифровки);
	КонецЕсли;
	
	Если Выводить.МСФО Тогда
		ТЗ = ПолучитьВедомостьМСФО(Выводить, Организация, МСФОСчет, Период.ДатаНачала, Период.ДатаОкончания, ОтборОбъектНеНайден);
		ВывестиТаблицу(ТЗ, Выводить, Результат, "МСФО", "Ведомость", ВыводитьРасшифровки);
	КонецЕсли;
	
	Если Ложь Тогда
		ТЗ = ПолучитьВедомостьКС_МСФО(Выводить, Организация, Неопределено, Период.ДатаНачала, Период.ДатаОкончания, ОтборОбъектНеНайден);
		ВывестиТаблицу(ТЗ, Выводить, Результат, "КС_МСФО", "Ведомость", ВыводитьРасшифровки);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Формирует ведомость в фоновом задании и помещает табличный документ во временное хранилище.
//
// Параметры:
//  Параметры - Структура - параметры формирования (см. ПараметрыФормированияНаСервере модуля формы).
//  АдресРезультата - Строка - адрес временного хранилища для табличного документа.
//
Процедура СформироватьВФоне(Параметры, АдресРезультата) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Сформировать(
		Параметры.Выводить,
		Параметры.Период,
		Параметры.Организация,
		Параметры.ХозрасчетныйСчет,
		Параметры.МСФОСчет,
		ТабличныйДокумент,
		Параметры.ВыводитьРасшифровки,
		Параметры.ОтборОбъектНеНайден);
	
	ПоместитьВоВременноеХранилище(ТабличныйДокумент, АдресРезультата);
	
КонецПроцедуры

Функция ДоработатьПредставления(ТЗ, Реквизиты, ВыводитьТипыПустыхЗначений)
	мКолонки = Новый Массив;
	Для Каждого ТекИмя Из СтрРазделить(СтрЗаменить(Реквизиты, " ", ""), ",", Ложь) Цикл
		Если ТЗ.Колонки.Найти(ТекИмя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		мКолонки.Добавить(ТекИмя);
	КонецЦикла;
	
	Для Каждого ТЗСтр Из ТЗ Цикл
		Для Каждого ТекИмя Из мКолонки Цикл
			ТекРекв     = ТЗСтр[ТекИмя];
			ТекПред = ТЗСтр[ТекИмя + "_Представление"];
			ТекТип = ТипЗнч(ТекРекв);
			
			Если Не ЗначениеЗаполнено(ТекПред) Тогда
				Если      ВыводитьТипыПустыхЗначений И ТекРекв = NULL Тогда
					ТекПред = "<NULL>";
				ИначеЕсли ВыводитьТипыПустыхЗначений И ТекРекв = Неопределено Тогда
					ТекПред = "<Неопределено>";
				Иначе
					ТекПред = "" + ТекРекв;
					Если ТекПред = "" Тогда
						ТекПред = "<Пустое значение"
							+ ?(ВыводитьТипыПустыхЗначений, " [" + ТекТип + "]", "")
							+ ">";
					КонецЕсли;
				КонецЕсли;
				ТЗСтр[ТекИмя + "_Представление"] = ТекПред;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецФункции

Функция ПолучитьКарточку(Выводить, РегистрБухгалтерии, Организация, ДатаНачала, ДатаОкончания, Счет, ОтборСубконто1, Субконто1, ОтборСубконто2, Субконто2, ОтборСубконто3, Субконто3, Расшифровка) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Обороты.Регистратор КАК Регистратор,
	               |	Обороты.Период КАК Период,
	               |	Обороты.НомерСтроки КАК НомерСтроки,
	               |	Обороты.Счет КАК Счет,
	               |	Обороты.КорСчет КАК КорСчет,
				   |" + ?(Выводить.Измерения, "
	               |	Обороты.Подразделение КАК Подразделение,
	               |	Обороты.Подразделение.Представление КАК Подразделение_Представление,
	               |	Обороты.Валюта КАК Валюта,
	               |	Обороты.Валюта.Представление КАК Валюта_Представление,
				   |", "") + "
				   |" + ?(РегистрБухгалтерии = "МСФО" И Выводить.ИзмеренияМСФО, "
				   |	Обороты.Сценарий КАК Сценарий,
				   |	Обороты.Сценарий.Представление КАК Сценарий_Представление,
				   |	Обороты.ВидОперации КАК ВидОперации,
				   |	Обороты.ВидОперации.Представление КАК ВидОперации_Представление,
				   |	Обороты.НаправлениеДеятельности КАК НаправлениеДеятельности,
				   |	Обороты.НаправлениеДеятельности.Представление КАК НаправлениеДеятельности_Представление,
				   |", "") + "
				   |" + ?(Выводить.Субконто1, "
	               |	Обороты.Субконто1 КАК Субконто1,
	               |	Обороты.Субконто1.Представление КАК Субконто1_Представление,
				   |", "") + "
				   |" + ?(Выводить.Субконто2, "
	               |	Обороты.Субконто2 КАК Субконто2,
	               |	Обороты.Субконто2.Представление КАК Субконто2_Представление,
				   |", "") + "
				   |" + ?(Выводить.Субконто3, "
	               |	Обороты.Субконто3 КАК Субконто3,
	               |	Обороты.Субконто3.Представление КАК Субконто3_Представление,
				   |", "") + "
				   |" + ?(РегистрБухгалтерии = "Хозрасчетный", "
	               |	Обороты.СуммаОборотДт КАК СуммаОборотДт,
	               |	Обороты.СуммаОборотКт КАК СуммаОборотКт,
	               |	Обороты.СуммаНУОборотДт КАК СуммаНУОборотДт,
	               |	Обороты.СуммаНУОборотКт КАК СуммаНУОборотКт
				   |", "
	               |	Обороты.СуммаВВалютеУчетаОборотДт КАК СуммаВВалютеУчетаОборотДт,
	               |	Обороты.СуммаВВалютеУчетаОборотКт КАК СуммаВВалютеУчетаОборотКт,
	               |	Обороты.СуммаВВалютеОтчетностиОборотДт КАК СуммаВВалютеОтчетностиОборотДт,
	               |	Обороты.СуммаВВалютеОтчетностиОборотКт КАК СуммаВВалютеОтчетностиОборотКт
				   |") + "
	               |ИЗ
	               |	РегистрБухгалтерии." + РегистрБухгалтерии + ".Обороты(
	               |			&НачалоПериода,
	               |			&КонецПериода,
	               |			Запись,
	               |			Счет = &Счет,
	               |			,
	               |			&Отбор,
	               |			,
	               |			) КАК Обороты
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Обороты.Счет.Представление,
				   |" + ?(Выводить.Субконто1, "
	               |	Обороты.Субконто1.Представление,
				   |", "") + "
				   |" + ?(Выводить.Субконто2, "
	               |	Обороты.Субконто2.Представление,
				   |", "") + "
				   |" + ?(Выводить.Субконто3, "
	               |	Обороты.Субконто3.Представление,
				   |", "") + "
				   |	1";
				   
	Запрос.УстановитьПараметр("Счет", Счет);
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода" , ДатаОкончания);
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("Организация", Организация);
	
	Для Каждого ТекОтбор Из СтрРазделить(""
		+ ?(Выводить.Измерения, "Подразделение,Валюта,", "")
		+ ?(РегистрБухгалтерии = "МСФО" И Выводить.ИзмеренияМСФО, "Сценарий,ВидОперации,НаправлениеДеятельности,", ""),
		",", Ложь
	) Цикл
		Отбор.Вставить(ТекОтбор, Расшифровка[ТекОтбор]);
	КонецЦикла;
	
	Для НомерСубконто = 1 По 3 Цикл
		Если Выводить["Субконто" + НомерСубконто] И Вычислить("ОтборСубконто" + НомерСубконто) Тогда
			Отбор.Вставить("Субконто" + НомерСубконто, Расшифровка["Субконто" + НомерСубконто]);
		КонецЕсли;
	КонецЦикла;
	
	ОтборСтр = "";
	Для Каждого ТекОтбор Из Отбор Цикл
		ОтборСтр = ОтборСтр
			+ ?(ОтборСтр <> "", " И ", "")
			+ ТекОтбор.Ключ + " "
			+ ?(ТекОтбор.Значение <> NULL,
				"= &" + ТекОтбор.Ключ,
				"Есть NULL"
				)
		;
		Если ТекОтбор.Значение <> NULL Тогда
			Запрос.УстановитьПараметр(ТекОтбор.Ключ, ТекОтбор.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отбор", ОтборСтр);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ДоработатьПредставления(ТЗ, ""
		+ ?(Выводить.Измерения, "Подразделение,Валюта,", "")
		+ ?(РегистрБухгалтерии = "МСФО" И Выводить.ИзмеренияМСФО, "Сценарий,ВидОперации,НаправлениеДеятельности,", "")
		+ ?(Выводить.Субконто1, "Субконто1, ", "")
		+ ?(Выводить.Субконто2, "Субконто2, ", "")
		+ ?(Выводить.Субконто3, "Субконто3, ", "")
		,
		Выводить.ТипыПустыхЗначений
	);
	
	 ДобавитьГУИДВРасшифровку(ТЗ);
	
	Возврат ТЗ;
КонецФункции


&НаСервере
Процедура ДобавитьГУИДВРасшифровку(ТЗ)
КС = Новый КвалификаторыСтроки(40);
Массив = Новый Массив;
Массив.Добавить(Тип("Строка"));
ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
	
ТЗ.Колонки.Добавить("ГУИД",ОписаниеТиповС)

КонецПроцедуры // ДобавитьГУИДВРасшифровку()

&НаСервере
Функция КарточкаНаСервере(Выводить, Период, Организация, Расшифровка, РезультатРасшифровки, ОтборСубконто1, ОтборСубконто2, ОтборСубконто3) Экспорт
	ТЗ = ПолучитьКарточку(Выводить, Расшифровка.РегистрБухгалтерии, Организация, Период.ДатаНачала, Период.ДатаОкончания, Расшифровка.Счет, ОтборСубконто1, Расшифровка["Субконто1"], ОтборСубконто2, Расшифровка["Субконто2"], ОтборСубконто3, Расшифровка["Субконто3"], Расшифровка);
	
	РезультатРасшифровки.Очистить();
	ВывестиТаблицу(ТЗ, Выводить, РезультатРасшифровки, Расшифровка.РегистрБухгалтерии, "Карточка", Истина);
КонецФункции

Процедура ВывестиТаблицу(ТЗ, Выводить, Результат, РегистрБухгалтерии, Отчет, ВыводитьРасшифровки);
//	Результат = Новый ТабличныйДокумент;
	
//		Результат.Очистить();
		
		Результат.ФиксацияСверху = 1;
		
		Макет = ПолучитьМакет("Макет");
		
		Шапка = Макет.ПолучитьОбласть("Шапка|Колонка");
		НомерКолонки = 0;
		Для Каждого Колонка Из ТЗ.Колонки Цикл
			КолонкаИмя = Колонка.Имя;
			Если Прав(КолонкаИмя, 14) = "_Представление" Тогда
				Продолжить;
			КонецЕсли;
			Если Прав(КолонкаИмя, 4) = "_Тип" Тогда
				Продолжить;
			КонецЕсли;
			
			НомерКолонки = НомерКолонки + 1;
			
			Шапка.Параметры.Заголовок = Колонка.Заголовок;
			
			Если НомерКолонки = 1 Тогда
				Результат.Вывести(Шапка);
			Иначе
				Результат.Присоединить(Шапка);
			КонецЕсли;
		КонецЦикла;
		
		Строка = Макет.ПолучитьОбласть("Строка|Колонка");
		ПрошлыйСчет = Неопределено; Цвет = Новый Цвет;
		Расшифровка = Неопределено;
		
		Сч = 0;
		Для Каждого ТЗСтр Из ТЗ Цикл
			Сч = Сч + 1;
			
			Попытка
				ТЗСтр.ГУИД = ТЗСтр.Регистратор.УникальныйИдентификатор();	
			Исключение
			КонецПопытки;
			
			Если ВыводитьРасшифровки Тогда
				Если ТЗСтр.Счет <> ПрошлыйСчет Тогда
					Цвет = ?(Цвет = Новый Цвет, WebЦвета.Роса, Новый Цвет);
				КонецЕсли;
				
				Расшифровка = Новый Структура(""
					+ "Отчет, РегистрБухгалтерии, Счет, "
					+ ?(Выводить.Измерения, "Подразделение, Валюта, ", "")
					+ ?(РегистрБухгалтерии = "МСФО" И Выводить.ИзмеренияМСФО, "ВидОперации, Сценарий, НаправлениеДеятельности, ", "")
					+ "Субконто1, Субконто2, Субконто3, "
					+ "Регистратор,ГУИД"
				);
				Расшифровка.Отчет = Отчет;
				Расшифровка.РегистрБухгалтерии = РегистрБухгалтерии;
				ЗаполнитьЗначенияСвойств(Расшифровка, ТЗСтр);
			КонецЕсли;
			
			НомерКолонки = 0;
			Для Каждого Колонка Из ТЗ.Колонки Цикл
				КолонкаИмя = Колонка.Имя;
				Если Прав(КолонкаИмя, 14) = "_Представление" Тогда
					Продолжить;
				КонецЕсли;
				Если Прав(КолонкаИмя, 4) = "_Тип" Тогда
					Продолжить;
				КонецЕсли;
				
				НомерКолонки = НомерКолонки + 1;
				
				Строка.Параметры.Представление = ТЗСтр[КолонкаИмя];
				Если КолонкаИмя = "Подразделение"
				 Или КолонкаИмя = "Валюта"
				 Или КолонкаИмя = "ВидОперации"
				 Или КолонкаИмя = "Сценарий"
				 Или КолонкаИмя = "НаправлениеДеятельности"
				 Или КолонкаИмя = "Субконто1"
				 Или КолонкаИмя = "Субконто2"
				 Или КолонкаИмя = "Субконто3"
				Тогда
					Строка.Параметры.Представление = ТЗСтр[КолонкаИмя + "_Представление"];
				КонецЕсли;
				
				Если ВыводитьРасшифровки Тогда
//					Расшифровка.Представление = ТЗСтр[КолонкаИмя];
					Строка.Параметры.Расшифровка = Расшифровка;
				КонецЕсли;
				
				Если НомерКолонки = 1 Тогда
					Результат.Вывести(Строка);
				Иначе
					Результат.Присоединить(Строка);
				КонецЕсли;
			КонецЦикла;
			
			Результат.Область(Сч,,Сч,).ЦветФона = Цвет;
			
			ПрошлыйСчет = ТЗСтр.Счет;
		КонецЦикла;
		
