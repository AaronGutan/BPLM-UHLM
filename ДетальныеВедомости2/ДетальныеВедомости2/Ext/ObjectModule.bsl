#Область ПрограммныйИнтерфейс

// Возвращает сведения для регистрации в подсистеме дополнительных отчетов и обработок.
//
// Возвращаемое значение:
//  Структура - параметры регистрации БСП.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	МетаданныеОбработки = Метаданные();
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = МетаданныеОбработки.Представление();
	НоваяКоманда.Идентификатор = МетаданныеОбработки.Имя;
	НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

#КонецОбласти

Функция ТаблицаЗначенийВТабличныйДокумент(ТабЗн) Экспорт // Из "Функций"
	ТабДок = Новый ТабличныйДокумент;

	СчСтр = 1;
	СчКол = 0;
	Для Каждого Кол Из ТабЗн.Колонки Цикл
		СчКол = СчКол + 1;
		ТабДок.Область(СчСтр, СчКол).Текст = Кол.Имя;
	КонецЦикла;

	Колво = ТабЗн.Количество();
	
	Для Каждого стрТабЗн из ТабЗн Цикл
		СчСтр = СчСтр + 1;
		
#Если Клиент Тогда
		ОбработкаПрерыванияПользователя();
		Состояние("Вывод таблицы значений в табличный документ (" + СчСтр + " / " + Колво + ")");
#КонецЕсли
		
		СчКол = 0;
		Для Каждого Кол Из ТабЗн.Колонки Цикл
			СчКол = СчКол + 1;
			ТабДок.Область(СчСтр, СчКол).Текст = стрТабЗн[Кол.Имя];
		КонецЦикла;
	КонецЦикла;
	
#Если Клиент Тогда
		Состояние(" ");
#КонецЕсли

	Возврат ТабДок;
КонецФункции

Процедура ОтобратьОбъектНеНайден(ТЗ, Реквизиты)
	КУдалению = Новый Массив;
	Для Каждого ТекСтр Из ТЗ Цикл
		Ошибка = Ложь;
		Для Каждого Рекв Из СтрРазделить(СтрЗаменить(Реквизиты, " ", ""), ",", Ложь) Цикл // Подразделение,
			Если Лев(ТекСтр[Рекв + "_Представление"], 20) = "<Объект не найден> (" Тогда
				Ошибка = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Не Ошибка Тогда
			КУдалению.Добавить(ТекСтр);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТекСтр Из КУдалению Цикл
		ТЗ.Удалить(ТекСтр);
	КонецЦикла;
КонецПроцедуры
		
Функция ПолучитьВедомостьХозрасчетный(Выводить, Организация, Счет, ДатаНачала, ДатаОкончания, ОтборОбъектНеНайден = Ложь) Экспорт
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Регистр.Счет КАК Счет,
	               |	Регистр.Счет.Представление КАК Счет_Представление,
				   |" + ?(Выводить.Измерения, "
	               |	Регистр.Подразделение КАК Подразделение,
	               |	Регистр.Подразделение.Представление КАК Подразделение_Представление,
	               |	Регистр.Валюта КАК Валюта,
	               |	Регистр.Валюта.Представление КАК Валюта_Представление,
				   |", "") + "
				   |" + ?(Выводить.Субконто1, "
	               |	Регистр.Субконто1 КАК Субконто1,
	               |	Регистр.Субконто1.Представление КАК Субконто1_Представление,
	               |	ТИПЗНАЧЕНИЯ(Регистр.Субконто1) КАК Субконто1_Тип,
				   |", "") + "
				   |" + ?(Выводить.Субконто2, "
	               |	Регистр.Субконто2 КАК Субконто2,
	               |	Регистр.Субконто2.Представление КАК Субконто2_Представление,
	               |	ТИПЗНАЧЕНИЯ(Регистр.Субконто2) КАК Субконто2_Тип,
				   |", "") + "
				   |" + ?(Выводить.Субконто3, "
	               |	Регистр.Субконто3 КАК Субконто3,
	               |	Регистр.Субконто3.Представление КАК Субконто3_Представление,
	               |	ТИПЗНАЧЕНИЯ(Регистр.Субконто3) КАК Субконто3_Тип,
				   |", "") + "
	               |	Регистр.СуммаНачальныйРазвернутыйОстатокДт КАК СуммаНачальныйРазвернутыйОстатокДт,
	               |	Регистр.СуммаНачальныйРазвернутыйОстатокКт КАК СуммаНачальныйРазвернутыйОстатокКт,
	               |	Регистр.СуммаОборотДт КАК СуммаОборотДт,
	               |	Регистр.СуммаОборотКт КАК СуммаОборотКт,
	               |	Регистр.СуммаКонечныйРазвернутыйОстатокДт КАК СуммаКонечныйРазвернутыйОстатокДт,
	               |	Регистр.СуммаКонечныйРазвернутыйОстатокКт КАК СуммаКонечныйРазвернутыйОстатокКт,
	               |	Регистр.СуммаНУНачальныйРазвернутыйОстатокДт КАК СуммаНУНачальныйРазвернутыйОстатокДт,
	               |	Регистр.СуммаНУНачальныйРазвернутыйОстатокКт КАК СуммаНУНачальныйРазвернутыйОстатокКт,
	               |	Регистр.СуммаНУОборотДт КАК СуммаНУОборотДт,
	               |	Регистр.СуммаНУОборотКт КАК СуммаНУОборотКт,
	               |	Регистр.СуммаНУКонечныйРазвернутыйОстатокДт КАК СуммаНУКонечныйРазвернутыйОстатокДт,
	               |	Регистр.СуммаНУКонечныйРазвернутыйОстатокКт КАК СуммаНУКонечныйРазвернутыйОстатокКт
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Период, , Счет В ИЕРАРХИИ (&Счет), , Организация = &Организация) КАК Регистр
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Регистр.Счет.Представление,
				   |" + ?(Выводить.Измерения, "
	               |	Регистр.Подразделение.Представление,
	               |	Регистр.Валюта.Представление,
				   |", "") + "
				   |" + ?(Выводить.Субконто1, "
	               |	Регистр.Субконто1.Представление,
				   |", "") + "
				   |" + ?(Выводить.Субконто2, "
	               |	Регистр.Субконто2.Представление,
				   |", "") + "
				   |" + ?(Выводить.Субконто3, "
	               |	Регистр.Субконто3.Представление,
				   |", "") + "
				   |	1";
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода" , ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Если ЗначениеЗаполнено(Счет) Тогда
		Запрос.УстановитьПараметр("Счет", Счет);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Счет В ИЕРАРХИИ (&Счет)", "");
	КонецЕсли;
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ДоработатьПредставления(ТЗ, ""
		+ ?(Выводить.Измерения, "Подразделение, Валюта, ", "")
//		+ "Субконто1,Субконто2,Субконто3"
		+ ?(Выводить.Субконто1, "Субконто1, ", "")
		+ ?(Выводить.Субконто2, "Субконто2, ", "")
		+ ?(Выводить.Субконто3, "Субконто3, ", "")
		,
		Выводить.ТипыПустыхЗначений
	);
	
	ТЗ.Сортировать("Счет_Представление, "
		+ ?(Выводить.Измерения, "Подразделение_Представление, Валюта_Представление,", "")
		+ ?(Выводить.Субконто1, "Субконто1_Представление, ", "")
		+ ?(Выводить.Субконто2, "Субконто2_Представление, ", "")
		+ ?(Выводить.Субконто3, "Субконто3_Представление, ", "")
		+ "СуммаНачальныйРазвернутыйОстатокДт, СуммаНачальныйРазвернутыйОстатокКт, СуммаОборотДт, СуммаОборотКт, СуммаКонечныйРазвернутыйОстатокДт, СуммаКонечныйРазвернутыйОстатокКт,"
		+ "СуммаНУНачальныйРазвернутыйОстатокДт, СуммаНУНачальныйРазвернутыйОстатокКт, СуммаНУОборотДт, СуммаНУОборотКт, СуммаНУКонечныйРазвернутыйОстатокДт, СуммаНУКонечныйРазвернутыйОстатокКт"
	);
	//ТЗ.Колонки.Удалить("СчетКод");
	//ТЗ.Колонки.Удалить("Субконто1");
	//ТЗ.Колонки.Удалить("Субконто2");
	//ТЗ.Колонки.Удалить("Субконто3");
	
	Если ОтборОбъектНеНайден Тогда
		ОтобратьОбъектНеНайден(ТЗ, ""
			+ ?(Выводить.Измерения, "Подразделение,Валюта,", "")
//			+ "Субконто1,Субконто2,Субконто3"
			+ ?(Выводить.Субконто1, "Субконто1, ", "")
			+ ?(Выводить.Субконто2, "Субконто2, ", "")
			+ ?(Выводить.Субконто3, "Субконто3, ", "")
		);
	КонецЕсли;
	
	Возврат ТЗ;
КонецФункции

